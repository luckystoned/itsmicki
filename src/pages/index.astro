---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeStage from '@/components/HomeStage.astro';

// Side A home (Figma 884:635): instead of the carousel, one GIF that flashes through the twelve project compositions of
// Figma 990:1323 (Winona, Lumen, Max Maher, Outliant, Genova, Blend360, Textures & Body), 0.1 s each, in a loop.
---
<BaseLayout
  title="itsmicki©2026"
  hideFooter
  customCursor
  themeColor="#fafafa"
  preloadFonts={['/fonts/OTNeueMontreal-MediumSemiSqueezed.otf', '/fonts/OTNeueMontreal-MediumExtraSqueezed.otf']}
>
  <HomeStage
    intro={[
      "I'm micki, a creative director ①, designer ②, and mom of two insane cats ③. Born and raised in Buenos Aires, Argentina, surviving my early thirties",
      "For the past 10 years, I've worked across every medium I could get my hands on—analog craft, print, digital, and my favorite, web and product design. When inspiration strikes, you'll catch me illustrating, shooting and editing photos, or animating",
    ]}
    plusHref="/deets"
    reel={{ base: '/01_Home/01_Home_Reel', label: 'Photos from Winona, Lumen, Max Maher, Outliant, Genova, Blend360 and Textures & Body', width: 582, height: 328, href: '/projects' }}
    wordmark="Itsmicki"
  />
</BaseLayout>
