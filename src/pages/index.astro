---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeStage, { type HomeCard } from '@/components/HomeStage.astro';
import { imageMetadata } from '@/data/imageMetadata';
import { carouselProjects } from '@/data/carousel';

const cards: HomeCard[] = carouselProjects.map((project) => ({
  title: project.title,
  label: project.carouselLayout.label,
  src: project.carouselCover,
  alt: `${project.title} project`,
  width: project.carouselLayout.width,
  height: project.carouselLayout.height,
  imageWidth: imageMetadata[project.carouselCover]?.width,
  imageHeight: imageMetadata[project.carouselCover]?.height,
  href: project.comingSoon ? undefined : `/projects/${project.slug}`,
  video: project.carouselLayout.video,
}));
---
<BaseLayout
  hideFooter
  customCursor
  themeColor="#fafafa"
  preloadFonts={['/fonts/OTNeueMontreal-MediumSemiSqueezed.otf', '/fonts/OTNeueMontreal-MediumExtraSqueezed.otf']}
>
  <HomeStage
    intro={[
      "I'm micki, a creative director ①, designer ②, and mom of two insane cats ③. Born and raised in Buenos Aires, Argentina, surviving my early thirties",
      "For the past 10 years, I've worked across every medium I could get my hands on—analog craft, print, digital, and my favorite, web and product design. When inspiration strikes, you'll catch me illustrating, shooting and editing photos, or animating",
    ]}
    plusHref="/deets"
    cards={cards}
    wordmark="Itsmicki"
  />
</BaseLayout>
