---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projects } from '@/data/projects';
import { imageMetadata } from '@/data/imageMetadata';

const carouselLayout: Record<string, { width: number; height: number; label: string; cover?: string; vimeoId?: string }> = {
  winona: { width: 430.069, height: 427.462, label: '01_Winona_UX—UI Lead, Visual & Motion Designer', cover: '/02_Projects/01_Winona/01_Winona_Home.webp' },
  genova: { width: 430.937, height: 570.818, label: '02_Genova_Art Direction+Visual Design' },
  amazon: { width: 427.462, height: 282.368, label: '03_Amazon_UXUI Lead+Art Direction+Visual Design', cover: 'https://vumbnail.com/1215371786.jpg', vimeoId: '1215371786' },
  maxmaher: { width: 430.069, height: 426.593, label: '04_MaxMaher_Art Direction+Visual Design' },
  outliant: { width: 429.582, height: 508.909, label: '05_Outliant_Art Direction+Visual Design+UXUI Lead' },
  lumen: { width: 430.069, height: 257.354, label: '06_Lumen_Art Direction+Visual Design' },
  blend360: { width: 430.937, height: 570.818, label: '07_Blend360_UX—UI Lead, Visual & Motion Designer', cover: '/02_Projects/07_Blend360/01_Blend360_Home.webp' },
};
const carouselProjects = projects.flatMap((project) => {
  const layout = carouselLayout[project.slug];
  const carouselCover = layout?.cover ?? project.cover;
  if (!layout || !carouselCover) return [];
  return [{ ...project, carouselCover, carouselLayout: layout }];
});
const desktopLength = (value: number) => `min(${value}px, ${(value / 16).toFixed(6)}vw, ${(value / 10.33).toFixed(6)}svh)`;
const loops = [0, 1, 2];
const vimeoBackground = (id: string) => `https://player.vimeo.com/video/${id}?background=1&autoplay=1&loop=1&muted=1&controls=0&dnt=1`;
---
<BaseLayout
  hideFooter
  customCursor
  themeColor="#fafafa"
  preconnectOrigins={['https://vumbnail.com']}
  preloadFonts={['/fonts/OTNeueMontreal-MediumSemiSqueezed.otf', '/fonts/OTNeueMontreal-MediumExtraSqueezed.otf']}
>
  <div class="home-stage">
    <section class="home-intro" data-reveal>
      <p>I'm micki, a creative director ①, designer ②, and mom of two insane cats ③. Born and raised in Buenos Aires, Argentina, surviving my late twenties<span class="desktop-period"> .</span><span class="mobile-plus"> <a class="intro-plus" href="/deets" aria-label="More about me">(+)</a>.</span></p>
      <p>I've had the chance to explore all kinds of supports during the past 9 years—analog craft, digital to print, and my favorite, web/product design. Occasionally,  you can catch me illustrating, taking photos and editing them, or animating when inspiration strikes <a class="intro-plus" href="/deets" aria-label="More about me">(+)</a>.</p>
    </section>

    <section class="home-carousel" aria-label="Selected projects" data-carousel data-reveal>
      <div class="carousel-track" data-carousel-track>
        {loops.map((loop) => carouselProjects.map((project, index) => {
          const dimensions = imageMetadata[project.carouselCover] ?? (project.slug === 'amazon' ? { width: 640, height: 360 } : undefined);
          const cardStyle = `--card-aspect:${project.carouselLayout.width / project.carouselLayout.height};--card-width:${desktopLength(project.carouselLayout.width)}`;
          const content = (
            <>
              <span class="carousel-name" aria-hidden="true"><span class="carousel-name-text">{project.carouselLayout.label}</span></span>
              <span class="carousel-picture">
                <img src={project.carouselCover} alt={loop === 0 ? `${project.title} project` : ''} width={dimensions?.width} height={dimensions?.height} loading={index < 3 && loop === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 && loop === 0 ? 'high' : undefined} decoding="async" />
                {project.carouselLayout.vimeoId && <iframe src={vimeoBackground(project.carouselLayout.vimeoId)} title={`${project.title} project video`} loading="lazy" allow="autoplay; fullscreen; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" tabindex="-1" aria-hidden="true" data-carousel-video></iframe>}
              </span>
            </>
          );
          return project.comingSoon
            ? <div class="carousel-card" data-project-preview="coming" aria-label={`${project.title}, coming soon`} style={cardStyle} aria-hidden={loop !== 0 ? 'true' : undefined}>{content}</div>
            : <a class="carousel-card" data-project-preview="ready" style={cardStyle} href={`/projects/${project.slug}`} aria-hidden={loop !== 0 ? 'true' : undefined} tabindex={loop !== 0 ? -1 : undefined}>{content}</a>;
        }))}
      </div>
    </section>

    <footer class="home-footer" data-reveal>
      <div class="home-footer-meta">
        <span class="footer-dev-label">DEV BY</span>
        <a class="footer-dev-name" href="https://www.instagram.com/luckystoned/" target="_blank" rel="noopener noreferrer">@luckystoned</a>
        <span class="footer-say-one">SAY HI</span>
        <span class="footer-say-two">SAY HI</span>
        <a class="footer-mail" href="mailto:hey@itsmicki.com">hey@itsmicki.com</a>
        <span class="footer-rights">All rights reserved.</span>
        <span class="home-socials"><span class="socials-label">SOCIALS</span> <span class="socials-links"><a href="https://www.linkedin.com/in/micaelagalimberti/" target="_blank" rel="noopener noreferrer">LinkedIn</a>, <a href="https://www.behance.net/itsmicki" target="_blank" rel="noopener noreferrer">Behance</a>, <a href="https://dribbble.com/micaelagalimberti" target="_blank" rel="noopener noreferrer">Dribbble</a>, <a href="https://www.instagram.com/its.micki/" target="_blank" rel="noopener noreferrer">Instagram</a>, <a href="https://www.tiktok.com/@mickivainillla" target="_blank" rel="noopener noreferrer">Tiktok</a></span></span>
      </div>
      <div class="home-subfooter" aria-label="Itsmicki copyright 2026"><span>Itsmicki</span><span>©2026</span></div>
    </footer>
  </div>

  <script>
    const carousel = document.querySelector<HTMLElement>('[data-carousel]');
    const track = document.querySelector<HTMLElement>('[data-carousel-track]');
    if (carousel && track) {
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduceMotion) track.querySelectorAll<HTMLIFrameElement>('[data-carousel-video]').forEach((video) => {
        video.addEventListener('load', () => video.contentWindow?.postMessage(JSON.stringify({ method: 'pause' }), 'https://player.vimeo.com'));
      });
      // `target` is where the strip wants to be; `offset` eases toward it every frame for a soft, inertial feel.
      let target = 0, offset = 0, cycle = 0, speed = 1, velocity = 0, dragging = false, hovered = false, lastX = 0, moved = 0, wheelUntil = 0;
      let previousTime = 0;
      let pointerId = -1;
      const measure = () => { const first = track.children[0] as HTMLElement; const repeat = track.children[track.children.length / 3] as HTMLElement; cycle = repeat.offsetLeft - first.offsetLeft; };
      const wrap = () => {
        if (cycle <= 0) return;
        while (offset > 0) { offset -= cycle; target -= cycle; }
        while (offset <= -cycle) { offset += cycle; target += cycle; }
      };
      const frame = (time: number) => {
        const elapsed = previousTime ? Math.min(time - previousTime, 32) / (1000 / 60) : 1;
        previousTime = time;
        const autoSpeed = matchMedia('(max-width: 760px)').matches ? .5 : .6;
        const designWidth = matchMedia('(max-width: 760px)').matches ? 390 : 1600;
        const scale = Math.min(innerWidth / designWidth, innerHeight / (designWidth === 390 ? 844 : 1033));
        speed += ((hovered ? .16 : 1) - speed) * (1 - Math.pow(.95, elapsed));
        if (!reduceMotion && !dragging && time >= wheelUntil) target -= autoSpeed * scale * speed * elapsed;
        offset = reduceMotion ? target : offset + (target - offset) * (1 - Math.pow(dragging ? .7 : .91, elapsed));
        wrap();
        track.style.transform = `translate3d(${offset}px, 0, 0)`;
        if (hovered) document.dispatchEvent(new Event('project-preview-refresh'));
        requestAnimationFrame(frame);
      };
      measure(); addEventListener('resize', measure); requestAnimationFrame(frame);
      carousel.addEventListener('mouseenter', () => { hovered = true; });
      carousel.addEventListener('mouseleave', () => { hovered = false; });
      carousel.addEventListener('dragstart', (event) => event.preventDefault());
      carousel.addEventListener('pointerdown', (event) => { if (!event.isPrimary || event.button !== 0) return; dragging = true; pointerId = event.pointerId; moved = 0; velocity = 0; lastX = event.clientX; });
      carousel.addEventListener('pointermove', (event) => { if (!dragging || event.pointerId !== pointerId) return; const dx = event.clientX - lastX; lastX = event.clientX; moved += Math.abs(dx); if (moved > 10 && !carousel.hasPointerCapture(pointerId)) carousel.setPointerCapture(pointerId); target += dx; velocity = velocity * .6 + dx * .4; });
      const release = (event: PointerEvent) => {
        if (event.pointerId !== pointerId || !dragging) return;
        dragging = false;
        if (moved > 10 && !reduceMotion) { target += velocity * 14; wheelUntil = performance.now() + 500; }
      };
      window.addEventListener('pointerup', release); window.addEventListener('pointercancel', release); carousel.addEventListener('lostpointercapture', release);
      carousel.addEventListener('click', (event) => { if (moved > 10) event.preventDefault(); }, true);
      carousel.addEventListener('wheel', (event) => {
        const delta = Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.deltaY;
        event.preventDefault();
        wheelUntil = performance.now() + 300;
        if (dragging) return;
        const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? carousel.clientWidth : 1;
        target -= delta * unit;
      }, { passive: false });
    }
  </script>
</BaseLayout>

<style>
  @font-face { font-family: 'OT Neue Montreal Home'; src: url('/fonts/OTNeueMontreal-MediumSemiSqueezed.otf') format('opentype'); font-style: normal; font-weight: 400 600; font-display: swap; }
  @font-face { font-family: 'OT Neue Montreal Home Extra'; src: url('/fonts/OTNeueMontreal-MediumExtraSqueezed.otf') format('opentype'); font-style: normal; font-weight: 400 600; font-display: swap; }
  :global(body:has(.home-carousel)) { background: #fafafa; color: #2e2e2e; }
  :global(body:has(.home-carousel) .cursor) { display: none !important; }
  :global(body:has(.home-carousel) .site-header) { background: color-mix(in srgb, #fafafa 90%, transparent); color: #2e2e2e; font-family: 'OT Neue Montreal Home', 'Arial Narrow', sans-serif; font-weight: 500; }
  .home-intro, .home-carousel, .home-footer { font-family: 'OT Neue Montreal Home', 'Arial Narrow', sans-serif; font-weight: 500; }
  .home-intro { grid-template-columns: 29% 46%; justify-content: space-between; min-height: clamp(250px, 17.4vw, 278px); padding-top: clamp(36px, 4.35vw, 70px); font-size: clamp(13px, 1.42vw, 24px); line-height: 1.24; letter-spacing: -.01em; }
  .home-intro sup { font-size: .55em; }
  .home-carousel { position: relative; z-index: 2; height: clamp(315px, 29.25vw, 468px); overflow: visible; padding-left: 0; touch-action: pan-y; user-select: none; }
  .carousel-track { isolation: isolate; display: flex; align-items: flex-start; width: max-content; overflow: visible; will-change: transform; }
  .carousel-card { position: relative; z-index: 0; flex: 0 0 clamp(210px, 22vw, 352px); aspect-ratio: var(--card-aspect); margin-right: clamp(9px, .8vw, 13px); overflow: visible; }
  .carousel-card { --name-size: clamp(14px, 1.25vw, 20px); }
  .carousel-name { position: absolute; z-index: 3; top: 0; left: 0; display: block; max-width: 100%; overflow: hidden; color: #2e2e2e; font-size: var(--name-size); line-height: 1.24; letter-spacing: -.01em; white-space: nowrap; pointer-events: none; }
  .carousel-name-text { display: block; transform: translateY(105%); transition: transform .16s cubic-bezier(.55,0,.75,0); }
  .carousel-picture { position: absolute; z-index: 1; inset: 0; display: block; overflow: hidden; transition: transform .6s cubic-bezier(.65,0,.35,1) .14s; }
  .carousel-picture img { pointer-events: none; transition: transform .8s cubic-bezier(.16,1,.3,1); }
  .carousel-picture iframe { position: absolute; top: 50%; left: 50%; width: auto; min-width: 100%; height: 100%; aspect-ratio: 426 / 240; border: 0; pointer-events: none; transform: translate(-50%, -50%); transition: transform .8s cubic-bezier(.16,1,.3,1); }
  @media (hover: hover) and (pointer: fine) {
    .carousel-card:is(:hover, :focus-visible) { z-index: 1000; }
    .carousel-card:is(:hover, :focus-visible) .carousel-picture { transform: translateY(calc(var(--name-size) * 1.24 + 8px)); transition: transform .6s cubic-bezier(.65,0,.35,1); }
    .carousel-card:is(:hover, :focus-visible) img { transform: scale(1.15); }
    .carousel-card:is(:hover, :focus-visible) iframe { transform: translate(-50%, -50%) scale(1.15); }
    .carousel-card:is(:hover, :focus-visible) .carousel-name-text { transform: none; transition: transform .65s cubic-bezier(.22,1,.36,1) .28s; }
  }
  @media not ((hover: hover) and (pointer: fine)) { .carousel-name { display: none; } }
  .intro-plus { color: inherit; text-decoration: none; text-decoration-thickness: 1px; text-underline-offset: .08em; }
  .intro-plus:is(:hover, :focus-visible) { text-decoration-line: underline; }
  @media (hover: none) { .intro-plus { text-decoration-line: underline; } }
  .home-footer { position: relative; z-index: 1; height: clamp(315px, 36vw, 576px); margin-top: max(-160px, -10vw); padding-top: 0; padding-bottom: 0; overflow: hidden; }
  .home-footer-meta { position: absolute; z-index: 3; right: var(--gutter); bottom: 14.4%; left: var(--gutter); display: grid; grid-template-columns: 1.05fr .55fr 1.25fr 1fr 2.1fr; align-items: end; gap: 18px; padding: 0; font-size: clamp(11px, 1.3vw, 21px); line-height: 1; text-transform: uppercase; }
  .home-footer-meta > * { justify-self: start; width: fit-content; background: #2e2e2e; color: #fafafa; padding-top: 1px; white-space: nowrap; }
  .home-footer-meta a { color: #fafafa; }
  .footer-dev-name:is(:hover, :focus-visible), .footer-mail:is(:hover, :focus-visible), .socials-links a:is(:hover, :focus-visible) { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .08em; }
  .home-socials { text-align: right; }
  .home-subfooter { position: absolute; z-index: 1; right: 0; bottom: 0; left: 0; display: flex; justify-content: space-between; align-items: flex-end; color: #2e2e2e; font-family: 'OT Neue Montreal Home Extra', Impact, sans-serif; font-size: clamp(150px, 36.45vw, 583px); font-weight: 500; line-height: .8; letter-spacing: -.04em; text-transform: none; white-space: nowrap; }
  .home-subfooter span:first-child { margin-left: -.035em; }
  .home-subfooter span:last-child { margin-right: -.03em; }
  .mobile-plus { display: none; }
  @media (hover: none) {
    .footer-dev-name:active, .footer-mail:active, .socials-links a:active { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .08em; }
  }
  @media (max-width: 760px) {
    .home-intro { grid-template-columns: 1fr; gap: 24px; min-height: 0; padding-top: 34px; padding-bottom: 68px; font-size: clamp(20px, 5.65vw, 25px); line-height: 1.08; overflow-wrap: anywhere; }
    .home-carousel { height: min(105vw, 410px); }
    .carousel-card { flex-basis: min(64vw, 270px); margin-right: 8px; }
    .home-footer { height: 330px; margin-top: -72px; }
    .home-footer-meta { right: var(--gutter); bottom: 36px; left: var(--gutter); grid-template-columns: 1fr 1fr; gap: 10px 14px; font-size: 11px; line-height: 1.15; }
    .home-socials { grid-column: 1 / -1; text-align: left; }
    .home-subfooter { flex-direction: column; align-items: flex-start; padding-top: 12px; font-size: clamp(96px, 29vw, 180px); line-height: .72; white-space: normal; }
    .home-subfooter span:last-child { align-self: flex-end; }
  }
  :global(html:has(.home-stage)), :global(body:has(.home-stage)) { --bg: #fafafa; --fg: #2e2e2e; background: #fafafa; color: #2e2e2e; -webkit-font-smoothing: antialiased; }
  @media (min-width: 761px) {
    :global(html:has(.home-stage)) { --gutter: 18px; }
    :global(body:has(.home-stage)) { height: 100svh; overflow: hidden; }
    :global(body:has(.home-stage) > main) { position: fixed; inset: 0; width: 100vw; height: 100svh; max-height: none; overflow: hidden; background: #fafafa; transform: none; }
    .home-stage { position: relative; width: 100%; height: 100%; overflow: hidden; background: #fafafa; container-type: inline-size; }
    .home-stage [data-reveal] { transform: none; transition: opacity .9s cubic-bezier(.16, 1, .3, 1); }

    :global(body:has(.home-stage) .site-header) { position: fixed; inset: 0; display: block; width: 100vw; height: 100svh; max-height: none; min-height: 0; padding: 0; background: transparent; backdrop-filter: none; transform: none; pointer-events: none; }
    :global(body:has(.home-stage) .site-header .wordmark) { position: absolute; top: min(23.21px, 1.450625vw, 2.246854svh); left: 18px; font-size: clamp(14px, 1.74vw, 27.117px); font-weight: 400; line-height: normal; letter-spacing: -.02em; text-decoration: underline; pointer-events: auto; }
    :global(body:has(.home-stage) .site-header nav) { position: absolute; top: min(23.21px, 1.450625vw, 2.246854svh); right: 18px; display: flex; gap: min(10px, .625vw, .968054svh); font-size: clamp(14px, 1.74vw, 27.117px); font-weight: 400; line-height: normal; letter-spacing: -.02em; pointer-events: auto; }
    :global(body:has(.home-stage) .site-header a::after) { display: none; }
    :global(body:has(.home-stage) .site-header a:hover) { text-decoration: underline; }

    .home-intro { position: absolute; inset: 0; display: block; min-height: 0; padding: 0; color: #2e2e2e; font-size: min(24px, 1.5vw, 2.32333svh); font-weight: 400; line-height: 1.24; letter-spacing: -.01em; }
    .home-intro p { position: absolute; top: min(78.63px, 4.914375vw, 7.61181svh); }
    .home-intro p:first-child { left: 18px; width: min(441.914px, 27.619625vw, 42.779671svh); }
    .home-intro p:nth-child(2) { left: min(500.45px, 31.278125vw, 48.446273svh); width: min(704.492px, 44.03075vw, 68.198645svh); white-space: pre-wrap; }

    .home-carousel { position: absolute; z-index: 2; top: min(219.31px, 13.706875vw, 21.230397svh); left: 0; width: 100vw; height: min(570.818px, 35.676125vw, 55.258277svh); overflow: visible; }
    .carousel-card { z-index: 0; flex-basis: var(--card-width); margin-right: 6px; overflow: visible; }
    .carousel-card { --name-size: min(20px, 1.25vw, 1.936108svh); }
    .carousel-name { z-index: 2; color: #2e2e2e; font-weight: 400; line-height: 1.24; letter-spacing: -.01em; }

    .home-footer { position: absolute; z-index: auto; inset: 0; width: auto; height: auto; margin: 0; padding: 0; overflow: visible; pointer-events: none; }
    .home-subfooter { position: absolute; z-index: 1; inset: 0; display: block; color: #2e2e2e; font-size: var(--footer-wordmark-size); font-weight: 500; line-height: .8; letter-spacing: -.04em; }
    .home-subfooter span { position: absolute; bottom: 0; transform: translateY(var(--footer-wordmark-edge)); }
    .home-subfooter span:first-child { left: max(-22.69px, -1.418125vw, -2.196515svh); margin: 0; }
    .home-subfooter span:last-child { right: max(-22px, -1.375vw, -2.129719svh); margin: 0; }

    .home-footer-meta { position: absolute; z-index: 3; inset: auto 0 min(86.46px, 5.40375vw, 8.369797svh); display: block; padding: 0; font-size: min(21px, 1.3125vw, 2.032914svh); font-weight: 400; line-height: 1; letter-spacing: -.02em; pointer-events: none; }
    .home-footer-meta a { pointer-events: auto; }
    .home-footer-meta > * { position: absolute; bottom: 0; justify-self: auto; padding: min(1px, .0625vw, .096805svh) 0 0; }
    .footer-dev-label { left: 0; }
    .footer-dev-name { left: min(66.03px, 4.126875vw, 6.392062svh); }
    .footer-say-one { left: min(415.49px, 25.968125vw, 40.221684svh); }
    .footer-say-two { left: min(560.17px, 35.010625vw, 54.227493svh); }
    .footer-mail { left: min(731.02px, 45.68875vw, 70.766699svh); }
    .footer-rights { left: min(1261.94px, 78.87125vw, 122.162633svh); }
    .home-socials { right: 0; text-align: left; }
  }
  @media (max-width: 760px) {
    :global(body:has(.home-stage)) { height: 100svh; overflow: hidden; }
    :global(body:has(.home-stage) > main) { position: fixed; inset: 0; width: 100vw; height: 100svh; max-height: none; overflow: hidden; background: #fafafa; transform: none; }
    .home-stage { --wordmark-bottom: max(min(76px, 19.487179cqw), calc(env(safe-area-inset-bottom) + 42px)); --carousel-bottom: calc(var(--wordmark-bottom) + 32.051282cqw); --carousel-min-top: min(204px, 52.307692cqw); position: relative; width: 100%; height: 100%; overflow: hidden; background: #fafafa; container-type: inline-size; }
    .home-stage [data-reveal] { transform: none; transition: opacity .9s cubic-bezier(.16, 1, .3, 1); }

    :global(body:has(.home-stage) .site-header) { position: fixed !important; z-index: 2000 !important; inset: auto 0 0 !important; display: flex !important; justify-content: space-between; align-items: flex-start; gap: calc((100vw - 36px - min(332px, 85.128205vw)) / 3); width: 100vw !important; height: auto !important; max-height: none; min-height: 0 !important; padding: min(8px, 2.051282cqw) 18px !important; background: #fafafa !important; backdrop-filter: none; color: #2e2e2e; font-size: min(26.498px, 6.794359cqw); font-weight: 400; line-height: normal; letter-spacing: -.02em; transform: none; container-type: inline-size; pointer-events: auto !important; }
    :global(body:has(.home-stage) .site-header .wordmark) { position: static; flex: 0 0 auto; text-decoration: underline; pointer-events: auto; }
    :global(body:has(.home-stage) .site-header nav) { display: flex; flex: 1 1 auto; justify-content: space-between; gap: 0; min-width: 0; pointer-events: auto; }
    :global(body:has(.home-stage) .site-header a) { white-space: nowrap; }
    :global(body:has(.home-stage) .site-header a::after) { display: none; }

    .home-intro { position: absolute; inset: 0; display: block; min-height: 0; padding: 0; color: #2e2e2e; font-size: min(26px, 6.666667cqw); font-weight: 400; line-height: 1; letter-spacing: -.015em; }
    .home-intro p:first-child { position: absolute; top: min(64px, 16.394872cqw); left: 18px; width: calc(100% - 36px); transform: none; overflow-wrap: normal; }
    .home-intro p:nth-child(2), .desktop-period { display: none; }
    .mobile-plus { display: inline; }

