---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectRow from '@/components/ProjectRow.astro';
import { projects } from '@/data/projects';
import { imageMetadata } from '@/data/imageMetadata';

const collageImages = [
  { className: 'c1', src: '/02_Projects/06_Lumen/01_Lumen_Drag.webp', alt: 'Lumen art and technology project' },
  { className: 'c2', src: '/02_Projects/01_Winona/01_Winona_Drag.webp', alt: 'Winona wellness brand project' },
  { className: 'c3', src: '/02_Projects/04_MaxMaher/02_MaxMaher_Drag.webp', alt: 'Max Maher visual design project' },
  { className: 'c4', src: '/02_Projects/05_Outliant/01_OTL_Drag.webp', alt: 'Outliant brand project' },
];
---
<BaseLayout>
  <section class="home-intro page-gutter" data-reveal>
    <p>I’m Micki, a creative director <sup>①</sup>, designer <sup>②</sup>, and mom of two insane cats <sup>③</sup>. Born and raised in Buenos Aires, Argentina, surviving my late twenties.</p>
    <p>I’ve had the chance to explore all kinds of supports during the past 9 years—from analog craft and digital to print, to my favorite: web and product design. Occasionally, you can catch me illustrating, taking photos, editing them or animating when inspiration strikes <sup>(+)</sup>.</p>
  </section>

  <section class="home-collage" aria-label="Selected work collage" data-reveal>
    {collageImages.map((image, index) => {
      const dimensions = imageMetadata[image.src];
      return <figure class={`collage-item ${image.className}`}><img src={image.src} alt={image.alt} width={dimensions.width} height={dimensions.height} fetchpriority={index === 0 ? 'high' : undefined} decoding="async" /></figure>;
    })}
    <p class="collage-note">Drag me around<br />or keep scrolling ↓</p>
  </section>

  <section class="projects-section page-gutter" data-reveal>
    <div class="section-heading"><h1>(Picked projects)</h1><span>2020—today</span></div>
    <div class="project-list">{projects.map((project) => <ProjectRow project={project} />)}</div>
  </section>

  <script>
    document.querySelectorAll<HTMLElement>('.collage-item').forEach((item) => {
      let startX = 0, startY = 0, originX = 0, originY = 0;
      item.addEventListener('pointerdown', (event: PointerEvent) => {
        item.setPointerCapture(event.pointerId);
        startX = event.clientX; startY = event.clientY;
        originX = Number(item.dataset.x || 0); originY = Number(item.dataset.y || 0);
        item.classList.add('is-dragging');
      });
      item.addEventListener('pointermove', (event: PointerEvent) => {
        if (!item.hasPointerCapture(event.pointerId)) return;
        const x = originX + event.clientX - startX;
        const y = originY + event.clientY - startY;
        item.dataset.x = String(x); item.dataset.y = String(y);
        item.style.transform = `translate(${x}px, ${y}px) rotate(var(--rotate))`;
      });
      item.addEventListener('pointerup', () => item.classList.remove('is-dragging'));
    });
  </script>
</BaseLayout>
