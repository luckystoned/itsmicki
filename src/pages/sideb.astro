---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { imageMetadata } from '@/data/imageMetadata';

const asset = (number: number, alt = '') => {
  const src = `/04_SideB/${String(number).padStart(2, '0')}_SideB.webp`;
  return { src, alt, ...imageMetadata[src] };
};

const stripImages = [
  { ...asset(1), widthCss: '31.1vw', ratio: '484 / 580' },
  { ...asset(2), widthCss: '38.2vw', ratio: '595 / 497' },
  { ...asset(3), widthCss: '26vw', ratio: '405 / 623' },
  { ...asset(4), widthCss: '25.4vw', ratio: '395 / 555' },
  { ...asset(5), widthCss: '37.1vw', ratio: '578 / 439' },
  { ...asset(6), widthCss: '27.9vw', ratio: '434 / 463' },
  { ...asset(7), widthCss: '27.1vw', ratio: '422 / 494' },
  { ...asset(8), widthCss: '36.6vw', ratio: '569 / 680' },
].map((item) => ({
  ...item,
  style: `--strip-width:${item.widthCss};--strip-ratio:${item.ratio}`,
}));

const filmPairs = [
  'A subway passenger reflected in a black-and-white train window beside a close-up of green leaves.',
  'A profile portrait in red sunglasses beside people reclining together outdoors.',
  'A black-and-white cat behind a shop window beside a portrait with a cat paw across the face.',
  'A black-and-white street vendor beneath an umbrella beside a person waving a colorful fan.',
  'A pizza maker tossing dough beside a black-and-white ice-cream truck portrait.',
  'A woman sitting beside a pool beside a black cat peeking above a dark window ledge.',
].map((alt, index) => {
  const src = `/04_SideB/Film_${String(index + 1).padStart(2, '0')}_SideB.webp`;
  return { src, alt, ...imageMetadata[src] };
});
const fashion = {
  src: '/04_SideB/Fashion_SideB.webp',
  alt: 'A fashion lookbook collage of four outfits against a blue background.',
  ...imageMetadata['/04_SideB/Fashion_SideB.webp'],
};
---

<BaseLayout
  title="Side B: Personal Work — Itsmicki"
  description="The personal side of Micaela Galimberti: fashion, music, film photography and the visual references that shape her work."
  active="sideb"
  hideFooter
  customCursor
  themeColor="#fafafa"
  preconnectOrigins={['https://open.spotify.com']}
  preloadFonts={[
    '/fonts/OTNeueMontreal-MediumSemiSqueezed.otf',
    '/fonts/OTNeueMontreal-MediumExtraSqueezed.otf',
  ]}
>
  <div class="sideb-page">
    <aside class="sideb-mobile-meta" aria-label="Contact and social links">
      <span>SAY HI</span>
      <a target="_blank" rel="noopener noreferrer" class="sideb-mobile-mail" href="mailto:hey@itsmicki.com">HEY@ITSMICKI.COM</a>
      <span>SOCIALS</span>
      <span class="sideb-mobile-socials">
        <a href="https://www.linkedin.com/in/micaelagalimberti/" target="_blank" rel="noopener noreferrer">LINKEDIN</a>,
        <a href="https://www.behance.net/itsmicki" target="_blank" rel="noopener noreferrer">BEHANCE</a>,
        <a href="https://dribbble.com/micaelagalimberti" target="_blank" rel="noopener noreferrer">DRIBBBLE</a>,
        <a href="https://www.instagram.com/its.micki/" target="_blank" rel="noopener noreferrer">INSTAGRAM</a>,
        <span>TIKTOK</span>
      </span>
    </aside>

    <article class="sideb-content" aria-labelledby="sideb-title">
      <h1 class="sideb-title" id="sideb-title">(Some bits of irrelevant<br />sh!t I’m into)</h1>

      <div class="sideb-main">
        <section class="sideb-intro-block" aria-label="About Side B">
          <div class="sideb-intro-grid">
            <div>
              <h2 class="sideb-label">Related Links</h2>
              <p class="sideb-big sideb-related" aria-label="Related profiles">
                <a target="_blank" rel="noopener noreferrer" class="sideb-pseudo-link" href="https://letterboxd.com/mikigalimberti/">Letterboxd</a><br />
                <span class="sideb-pseudo-link">Lomography</span><br />
                <a target="_blank" rel="noopener noreferrer" class="sideb-pseudo-link" href="https://opencloset.myindyx.com/user/mickivainilla">Indyx</a><br />
                <a target="_blank" rel="noopener noreferrer" class="sideb-pseudo-link" href="https://substack.com/@itsmicki">Substack</a>
              </p>
            </div>
            <div>
              <h2 class="sideb-label">In a Nutshell</h2>
              <p class="sideb-big">Hey — On my B-side, I’m still micki, just a little more laid-back and messy. I study fashion design, take photos, make endless playlists, sell vintage and secondhand clothes, and can spend hours scrolling or watching the most cursed YouTube videos imaginable.</p>
            </div>
          </div>

          <div class="sideb-strip" data-marquee aria-label="A moving collage of Micaela's visual references">
            <div class="sideb-strip-track" data-marquee-track>
              {[false, true].map((duplicate) => (
                <div class="sideb-strip-set" data-marquee-set={duplicate ? undefined : ''} aria-hidden={duplicate ? 'true' : undefined}>
                  {stripImages.map((item) => (
                    <figure class="sideb-strip-item" style={item.style}>
                      <img
                        src={item.src}
                        alt=""
                        width={item.width}
                        height={item.height}
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                    </figure>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </section>

        <section class="sideb-section" aria-labelledby="fashion-title">
          <h2 class="sideb-section-title" id="fashion-title">(fashion &amp;<br />aesthetics)</h2>
          <div class="sideb-section-column">
            <p class="sideb-big">I run a <span class="sideb-pseudo-link">digital vintage shop</span> centered on curating designer pieces and extending their life through reuse. I'm fascinated by the way objects can be recontextualized, transformed, and given new meaning over time in a world where trends are fleeting.</p>

            <div class="sideb-fashion-reveal" data-sideb-reveal>
              <figure class="sideb-fashion-media">
                <video
                  data-parallax
                  src="/04_SideB/Fashion_SideB.mp4"
                  poster={fashion.src}
                  width={fashion.width}
                  height={fashion.height}
                  aria-label="Fashion looks from Micaela's digital vintage shop"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  disablepictureinpicture
                ></video>
              </figure>
            </div>

            <div class="sideb-body-pair">
              <p>I'm currently pursuing a Bachelor's degree in Design and Aesthetic Management, a multidisciplinary program that explores fashion, graphic, interior, and product design. What fascinates me most is the idea that aesthetics are never superficial. Every visual decision, from the spaces we inhabit to the clothes we wear, communicates identity, values, and culture.</p>
              <p>I see the way I dress as an extension of my design practice. It's one of the most immediate ways I present myself to the world, just as branding, art direction, or digital experiences shape how people perceive a brand. Studying aesthetics across different disciplines has expanded the way I think about communication, helping me design with greater intention, coherence, and emotional depth.</p>
            </div>
          </div>
        </section>

        <section class="sideb-section sideb-music-section" aria-labelledby="music-title">
          <h2 class="sideb-section-title" id="music-title">(music)</h2>
          <div class="sideb-section-column">
            <p class="sideb-big">Music taught me that complexity doesn't have to feel chaotic. I'm fascinated by sound, noise, and the absence of both. Through music, I found the same eclectic spirit that defines my work across design, fashion, and aesthetics: different influences, multiple layers, and unexpected contrasts coming together to create something cohesive. My next creative goal is to dive deeper into sound design and music production, expanding the way I think about storytelling beyond the visual.</p>
          </div>
        </section>

        <section class="sideb-spotify" data-sideb-reveal aria-label="Micaela's Spotify playlist">
          <div class="sideb-spotify-frame">
            <iframe
              title="Micaela's Spotify playlist"
              src="https://open.spotify.com/embed/playlist/4WzNfZg1nlNPVuNooWu7FZ?utm_source=generator&theme=0&si=da993964294346ec"
              loading="lazy"
              allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              referrerpolicy="strict-origin-when-cross-origin"
            ></iframe>
          </div>
          <a href="https://open.spotify.com/playlist/4WzNfZg1nlNPVuNooWu7FZ" target="_blank" rel="noopener noreferrer">Abrir la playlist en Spotify ↗</a>
        </section>

        <section class="sideb-section sideb-film-section" aria-labelledby="film-title">
          <h2 class="sideb-section-title" id="film-title">(film)</h2>
          <div class="sideb-section-column">
            <p class="sideb-big">Shooting on film completely changed the way I approach uncertainty. I fell in love with its grain, textures, light leaks, and chemical imperfections, elements that digital workflows often try to eliminate.</p>

            <div class="sideb-film-carousel" data-film-carousel role="group" aria-label="Film photography pairs">
              <div class="sideb-film-track" data-film-track>
                {filmPairs.map((item, index) => (
                  <figure class="sideb-film-cell" aria-hidden={index === 0 ? 'false' : 'true'}>
                    <img src={item.src} alt={item.alt} width={item.width} height={item.height} loading="lazy" decoding="async" draggable="false" />
                  </figure>
                ))}
              </div>
              <span class="sideb-film-progress" aria-hidden="true">
                {filmPairs.map((_, index) => (
                  <i class:list={{ 'is-active': index === 0 }}><b></b></i>
                ))}
              </span>
            </div>

            <div class="sideb-body-pair">
              <p>What fascinates me most is capturing moments that might seem ordinary or even unnoticed to everyone else, but somehow feel worth preserving to me. Photography gives me the chance to steal those fleeting moments and reveal the beauty hidden in what others might overlook.</p>
              <p>Every frame demands patience, intention, and the acceptance that the outcome is never fully under your control. That process has deeply influenced the way I approach design: slowing down, trusting the process, and finding beauty in what wasn't planned. I learned that uncertainty isn't the opposite of good design. Sometimes it's what gives it character.</p>
            </div>
          </div>
        </section>
      </div>
    </article>

    <footer class="sideb-footer" id="sideb-footer">
      <div class="sideb-footer-wordmark" aria-label="Itsmicki, copyright 2026">
        <span data-sideb-reveal>Itsmicki</span>
        <span data-sideb-reveal>©2026</span>
      </div>
      <div class="sideb-footer-info" id="sideb-footer-info">
        <span data-sideb-reveal style="--reveal-delay:0ms">DEV BY</span>
        <a data-sideb-reveal style="--reveal-delay:70ms" href="https://www.instagram.com/luckystoned/" target="_blank" rel="noopener noreferrer">@LUCKYSTONED</a>
        <span data-sideb-reveal style="--reveal-delay:140ms">SAY HI</span>
        <a target="_blank" rel="noopener noreferrer" data-sideb-reveal style="--reveal-delay:210ms" href="mailto:hey@itsmicki.com">HEY@ITSMICKI.COM</a>
        <span data-sideb-reveal style="--reveal-delay:280ms">ALL RIGHTS RESERVED.</span>
        <span class="sideb-footer-socials" data-sideb-reveal style="--reveal-delay:350ms">
          SOCIALS <a href="https://www.linkedin.com/in/micaelagalimberti/" target="_blank" rel="noopener noreferrer">LINKEDIN</a>,
          <a href="https://www.behance.net/itsmicki" target="_blank" rel="noopener noreferrer">BEHANCE</a>,
          <a href="https://dribbble.com/micaelagalimberti" target="_blank" rel="noopener noreferrer">DRIBBBLE</a>,
          <a href="https://www.instagram.com/its.micki/" target="_blank" rel="noopener noreferrer">INSTAGRAM</a>,
          <span>TIKTOK</span>
        </span>
      </div>
    </footer>
  </div>

  <script>
    /* Native scrolling with the same damped wheel interpolation as the reference. */
    (function () {
      const reduceMotion = matchMedia('(prefers-reduced-motion:reduce)').matches;
      if (reduceMotion || !matchMedia('(pointer:fine)').matches) return;

      let targetY = window.scrollY;
      let currentY = targetY;
      let running = false;
      let frame: number | null = null;
      let locked = false;
      let previousTime = 0;

      const maxScroll = () => Math.max(0, document.documentElement.scrollHeight - window.innerHeight);

      function tick(now: number) {
        if (!previousTime) previousTime = now;
        const deltaTime = Math.min(64, now - previousTime) / 1000;
        previousTime = now;
        currentY += (targetY - currentY) * (1 - Math.exp(-6.5 * deltaTime));
        if (Math.abs(targetY - currentY) < 0.12) {
          currentY = targetY;
          running = false;
          previousTime = 0;
        }
        locked = true;
        window.scrollTo(0, currentY);
        locked = false;
        frame = running ? requestAnimationFrame(tick) : null;
      }

      addEventListener('wheel', (event) => {
        if (event.ctrlKey) return;
        event.preventDefault();
        let delta = event.deltaY;
        if (event.deltaMode === 1) delta *= 16;
        else if (event.deltaMode === 2) delta *= window.innerHeight;
        targetY = Math.max(0, Math.min(maxScroll(), targetY + delta));
        if (!running) {
          running = true;
          if (!frame) frame = requestAnimationFrame(tick);
        }
      }, { passive: false });

      addEventListener('scroll', () => {
        if (!locked && !running) targetY = currentY = window.scrollY;
      });

      addEventListener('resize', () => {
        targetY = currentY = window.scrollY;
      });

      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (event) => {
          const href = anchor.getAttribute('href');
          if (!href || href === '#') return;
          const target = document.querySelector<HTMLElement>(href);
          if (!target) return;
          event.preventDefault();
          targetY = Math.max(0, Math.min(maxScroll(), target.getBoundingClientRect().top + window.scrollY));
          if (!running) {
            running = true;
            if (!frame) frame = requestAnimationFrame(tick);
          }
        });
      });
    })();

    const reduceSideBMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLElement>('[data-sideb-reveal]').forEach((node) => {
      if (reduceSideBMotion) node.classList.add('is-visible');
    });

    if (!reduceSideBMotion) {
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => entry.target.classList.toggle('is-visible', entry.isIntersecting));
      }, { threshold: .02, rootMargin: '-2% 0px -6% 0px' });
      document.querySelectorAll<HTMLElement>('[data-sideb-reveal]').forEach((node) => revealObserver.observe(node));
    }

    const marquee = document.querySelector<HTMLElement>('[data-marquee]');
    const marqueeTrack = marquee?.querySelector<HTMLElement>('[data-marquee-track]');
    const marqueeSet = marquee?.querySelector<HTMLElement>('[data-marquee-set]');

    if (marquee && marqueeTrack && marqueeSet) {
      let setWidth = 0;
      let offset = 0;
      let lastTime = performance.now();
      let resizeFrame = 0;

      const normalizeOffset = () => {
        if (!setWidth) return;
        while (offset <= -setWidth * 2) offset += setWidth;
        while (offset > -setWidth) offset -= setWidth;
      };

      const renderMarquee = () => {
        marqueeTrack.style.transform = `translate3d(${offset}px, 0, 0)`;
      };

      const measureMarquee = () => {
        const gap = parseFloat(getComputedStyle(marqueeTrack).columnGap || getComputedStyle(marqueeTrack).gap) || 0;
        setWidth = marqueeSet.getBoundingClientRect().width + gap;
        offset = -setWidth;
        renderMarquee();
      };

      const animateMarquee = (now: number) => {
        const deltaTime = Math.min(64, now - lastTime);
        lastTime = now;
        if (!reduceSideBMotion) {
          offset -= deltaTime * .03;
          normalizeOffset();
          renderMarquee();
        }
        requestAnimationFrame(animateMarquee);
      };

      addEventListener('resize', () => {
        cancelAnimationFrame(resizeFrame);
        resizeFrame = requestAnimationFrame(measureMarquee);
      });

      if (document.fonts?.ready) document.fonts.ready.then(measureMarquee);
      else measureMarquee();
      if (!reduceSideBMotion) requestAnimationFrame(animateMarquee);
    }

    const filmCarousel = document.querySelector<HTMLElement>('[data-film-carousel]');
    if (filmCarousel) {
      const track = filmCarousel.querySelector<HTMLElement>('[data-film-track]');
      const progressItems = Array.from(filmCarousel.querySelectorAll<HTMLElement>('.sideb-film-progress i'));
      const count = track?.children.length ?? 0;
      const duration = 3800;
      let index = 0;
      let timer: number | undefined;
      let isVisible = false;
      let dragging = false;
      let pointerId = -1;
      let dragStartX = 0;
      let dragDistance = 0;
      let wheelTimer: number | undefined;
      let wheelDistance = 0;

      const renderFilm = () => {
        if (!track) return;
        track.style.transform = `translate3d(${-index * 100}%, 0, 0)`;
        Array.from(track.children).forEach((cell, cellIndex) => {
          cell.setAttribute('aria-hidden', cellIndex === index ? 'false' : 'true');
        });
        progressItems.forEach((item, itemIndex) => {
          const fill = item.querySelector<HTMLElement>('b');
          item.classList.toggle('is-active', itemIndex === index);
          if (!fill) return;
          fill.getAnimations().forEach((animation) => animation.cancel());
          fill.style.transform = itemIndex === index && reduceSideBMotion ? 'scaleX(1)' : 'scaleX(0)';
          if (itemIndex === index && !reduceSideBMotion && isVisible && !dragging && wheelTimer === undefined && !document.hidden) {
            fill.animate(
              [{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }],
              { duration, easing: 'linear', fill: 'forwards' },
            );
          }
        });
      };

      const goTo = (nextIndex: number) => {
        if (!count) return;
        index = (nextIndex + count) % count;
        renderFilm();
      };

      const stopFilm = () => {
        if (timer !== undefined) window.clearTimeout(timer);
        timer = undefined;
      };

      const startFilm = () => {
        stopFilm();
        if (reduceSideBMotion || !isVisible || document.hidden || count < 2 || dragging || wheelTimer !== undefined) return;
        timer = window.setTimeout(() => {
          goTo(index + 1);
          startFilm();
        }, duration);
      };

      filmCarousel.addEventListener('dragstart', (event) => event.preventDefault());
      filmCarousel.addEventListener('pointerdown', (event) => {
        if (!event.isPrimary || event.button !== 0 || wheelTimer !== undefined) return;
        if (!track || count < 2) return;
        dragging = true;
        pointerId = event.pointerId;
        dragStartX = event.clientX;
        dragDistance = 0;
        stopFilm();
        progressItems.forEach((item) => item.querySelector('b')?.getAnimations().forEach((animation) => animation.pause()));
        track.style.transition = 'none';
        filmCarousel.setPointerCapture(pointerId);
      });

      filmCarousel.addEventListener('pointermove', (event) => {
        if (!track || !dragging || event.pointerId !== pointerId) return;
        dragDistance = event.clientX - dragStartX;
        track.style.transform = `translate3d(calc(${-index * 100}% + ${dragDistance}px), 0, 0)`;
      });

      const finishFilmDrag = (event: PointerEvent) => {
        if (!track || !dragging || event.pointerId !== pointerId) return;
        dragging = false;
        if (filmCarousel.hasPointerCapture(pointerId)) filmCarousel.releasePointerCapture(pointerId);
        const threshold = Math.min(90, filmCarousel.clientWidth * .14);
        const direction = Math.abs(dragDistance) >= threshold ? (dragDistance < 0 ? 1 : -1) : 0;
        track.style.removeProperty('transition');
        goTo(index + direction);
        startFilm();
      };

      filmCarousel.addEventListener('pointerup', finishFilmDrag);
      filmCarousel.addEventListener('pointercancel', finishFilmDrag);
      filmCarousel.addEventListener('lostpointercapture', finishFilmDrag);
      filmCarousel.addEventListener('wheel', (event) => {
        if (Math.abs(event.deltaX) <= Math.abs(event.deltaY) || count < 2 || !track) return;
        event.preventDefault();
        if (dragging) return;
        stopFilm();
        progressItems.forEach((item) => item.querySelector('b')?.getAnimations().forEach((animation) => animation.pause()));
        if (wheelTimer !== undefined) window.clearTimeout(wheelTimer);
        const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? filmCarousel.clientWidth : 1;
        wheelDistance = Math.max(-filmCarousel.clientWidth, Math.min(filmCarousel.clientWidth, wheelDistance + event.deltaX * unit));
        // Follow the gesture directly; settle once its momentum events have ended.
        const previewDistance = (index === 0 && wheelDistance < 0) || (index === count - 1 && wheelDistance > 0) ? wheelDistance * .15 : wheelDistance;
        track.style.transition = 'none';
        track.style.transform = `translate3d(calc(${-index * 100}% - ${previewDistance}px), 0, 0)`;
        wheelTimer = window.setTimeout(() => {
          wheelTimer = undefined;
          const direction = Math.abs(wheelDistance) >= Math.min(90, filmCarousel.clientWidth * .14) ? Math.sign(wheelDistance) : 0;
          wheelDistance = 0;
          track.style.removeProperty('transition');
          goTo(index + direction);
          startFilm();
        }, 200);
      }, { passive: false });

      const visibilityObserver = new IntersectionObserver(([entry]) => {
        isVisible = entry.isIntersecting;
        if (!dragging && wheelTimer === undefined) renderFilm();
        startFilm();
      }, { threshold: .08, rootMargin: '10% 0px' });

      document.addEventListener('visibilitychange', startFilm);
      visibilityObserver.observe(filmCarousel);
      renderFilm();
    }

    if (!reduceSideBMotion) {
      const parallaxItems = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
      let parallaxFrame = 0;

      const updateParallax = () => {
        parallaxFrame = 0;
        parallaxItems.forEach((item) => {
          const frame = item.parentElement;
          if (!frame) return;
          const rect = frame.getBoundingClientRect();
          if (rect.bottom < -300 || rect.top > innerHeight + 300) return;
          const progress = (rect.top + rect.height / 2 - innerHeight / 2) / (innerHeight + rect.height);
          item.style.transform = `translate3d(0, ${progress * rect.height * -.14}px, 0)`;
        });
      };

      const requestParallax = () => {
        if (!parallaxFrame) parallaxFrame = requestAnimationFrame(updateParallax);
      };

      addEventListener('scroll', requestParallax, { passive: true });
      addEventListener('resize', requestParallax);
      requestParallax();
    }
  </script>
</BaseLayout>

<style is:global>
  @font-face {
    font-family: 'OT Neue Montreal SideB';
    src: url('/fonts/OTNeueMontreal-MediumSemiSqueezed.otf') format('opentype');
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
  }

  @font-face {
    font-family: 'OT Neue Montreal SideB Extra';
    src: url('/fonts/OTNeueMontreal-MediumExtraSqueezed.otf') format('opentype');
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
  }

  html:has(.sideb-page),
  body:has(.sideb-page) {
    --sideb-ink: #2e2e2e;
    --sideb-paper: #fafafa;
    --sideb-pad: clamp(14px, 1.42vw, 22px);
    --sideb-ease: cubic-bezier(.19, 1, .22, 1);
    background: var(--sideb-paper);
    color: var(--sideb-ink);
    cursor: url('/cursors/view.png') 0 0, auto;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  html:has(.sideb-page) {
    scroll-behavior: auto;
  }

  body:has(.sideb-page) a {
    cursor: url('/cursors/view.png') 0 0, auto;
    -webkit-tap-highlight-color: transparent;
  }

  body:has(.sideb-page) a:hover,
  body:has(.sideb-page) a:focus-visible {
    cursor: url('/cursors/view-hover.png') 0 0, pointer;
  }

  body:has(.sideb-page) ::selection {
    background: var(--sideb-ink);
    color: var(--sideb-paper);
  }

  body:has(.sideb-page) .site-header {
    position: relative;
    z-index: 20;
    top: auto;
    padding: 24px var(--sideb-pad) 0;
    background: transparent;
    color: var(--sideb-ink);
    backdrop-filter: none;
    font-family: 'OT Neue Montreal SideB', 'Arial Narrow', sans-serif;
    font-size: clamp(14px, 1.74vw, 27.117px);
    font-weight: 500;
    line-height: normal;
    letter-spacing: -.02em;
  }

  body:has(.sideb-page) .site-header nav {
    gap: 10px;
  }

  body:has(.sideb-page) .site-header a::after {
    display: none;
  }

  body:has(.sideb-page) .site-header a:is(:hover, :focus-visible, .active) {
