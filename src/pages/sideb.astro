---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { imageMetadata } from '@/data/imageMetadata';

const asset = (number: number, alt = '') => {
  const src = `/04_SideB/${String(number).padStart(2, '0')}_SideB.webp`;
  return { src, alt, ...imageMetadata[src] };
};

// Desktop sizes from Figma 392:9991 (1600px frame), with the stickers cropped to their visible edge so every gap is the
// same: `width` is the slot (the tilted sticker's bounding box), `inner` the sticker inside it, `rotate` its tilt.
const stripImages = [
  { ...asset(1), width: '28.910vw', inner: '100.00%', rotate: '0deg' },
  { ...asset(2), width: '33.763vw', inner: '90.70%', rotate: '8.92deg' },
  { ...asset(3), width: '22.917vw', inner: '88.55%', rotate: '-4.98deg' },
  { ...asset(4), width: '23.287vw', inner: '100.00%', rotate: '0deg' },
  { ...asset(5), width: '34.381vw', inner: '100.00%', rotate: '0deg' },
  { ...asset(6), width: '25.675vw', inner: '100.00%', rotate: '0deg' },
  { ...asset(7), width: '25.195vw', inner: '100.00%', rotate: '0deg' },
  { ...asset(8), width: '27.974vw', inner: '87.21%', rotate: '6.33deg' },
].map((item) => ({
  ...item,
  style: `--strip-w:${item.width};--strip-inner:${item.inner};--strip-rotate:${item.rotate}`,
}));

const filmPairs = [
  'A subway passenger reflected in a black-and-white train window beside a close-up of green leaves.',
  'A profile portrait in red sunglasses beside people reclining together outdoors.',
  'A black-and-white cat behind a shop window beside a portrait with a cat paw across the face.',
  'A black-and-white street vendor beneath an umbrella beside a person waving a colorful fan.',
  'A pizza maker tossing dough beside a black-and-white ice-cream truck portrait.',
  'A woman sitting beside a pool beside a black cat peeking above a dark window ledge.',
].map((alt, index) => {
  const src = `/04_SideB/Film_${String(index + 1).padStart(2, '0')}_SideB.webp`;
  return { src, alt, ...imageMetadata[src] };
});

const fashion = {
  src: '/04_SideB/Fashion_SideB.webp',
  alt: 'A fashion lookbook collage of four outfits against a blue background.',
  ...imageMetadata['/04_SideB/Fashion_SideB.webp'],
};
---

<BaseLayout
  title="(Side B) — Micaela Galimberti | Itsmicki"
  description="The personal side of Micaela Galimberti: fashion, music, film photography and the visual references that shape her work."
  active="sideb"
  hideFooter
  customCursor
  themeColor="#fafafa"
  preconnectOrigins={['https://open.spotify.com']}
  preloadFonts={[
    '/fonts/OTNeueMontreal-MediumSemiSqueezed.otf',
    '/fonts/OTNeueMontreal-MediumExtraSqueezed.otf',
  ]}
>
  <div class="sideb-page">
    <aside class="sideb-mobile-meta" aria-label="Contact and social links" data-scroll-bar>
      <span>SAY HI</span>
      <a class="sideb-mobile-mail" href="mailto:hey@itsmicki.com" target="_blank" rel="noopener noreferrer">HEY@ITSMICKI.COM</a>
      <span>SOCIALS</span>
      <span class="sideb-mobile-socials">
        <a href="https://www.linkedin.com/in/itsmicki/" target="_blank" rel="noopener noreferrer">LINKEDIN</a>, <a href="https://www.behance.net/itsmicki" target="_blank" rel="noopener noreferrer">BEHANCE</a>, <a href="https://dribbble.com/micaelagalimberti" target="_blank" rel="noopener noreferrer">DRIBBBLE</a>, <a href="https://www.instagram.com/its.micki/" target="_blank" rel="noopener noreferrer">INSTAGRAM</a>, <a href="https://www.tiktok.com/@mickivainillla" target="_blank" rel="noopener noreferrer">TIKTOK</a>
      </span>
    </aside>

    <article class="sideb-content" aria-labelledby="sideb-title">
      <h1 class="sideb-title sideb-appear-text" id="sideb-title" data-appear>(Some bits of irrelevant<br />sh!t I’m into)</h1>

      <div class="sideb-main">
        <section class="sideb-intro-block" aria-label="About Side B">
          <div class="sideb-intro-grid">
            <div>
              <h2 class="sideb-label" data-appear>Related Links</h2>
              <p class="sideb-big sideb-related" aria-label="Related profiles" data-appear>
                <a target="_blank" rel="noopener noreferrer" class="sideb-pseudo-link" href="https://letterboxd.com/mikigalimberti/">Letterboxd</a>
                <a target="_blank" rel="noopener noreferrer" class="sideb-pseudo-link" href="https://www.lomography.es/homes/itsmicki">Lomography</a>
                <a target="_blank" rel="noopener noreferrer" class="sideb-pseudo-link" href="https://opencloset.myindyx.com/user/mickivainilla">Indyx</a>
                <a target="_blank" rel="noopener noreferrer" class="sideb-pseudo-link" href="https://substack.com/@itsmicki">Substack</a>
              </p>
            </div>
            <div>
              <h2 class="sideb-label" data-appear>In a Nutshell</h2>
              <p class="sideb-big" data-appear>Hey — On my B-side, I’m still micki, just a little more laid-back and messy. I study fashion design, take photos, make endless playlists, sell vintage and secondhand clothes, and can spend hours scrolling or watching the most cursed YouTube videos imaginable.</p>
            </div>
          </div>

          <div class="sideb-strip" data-marquee data-appear aria-label="A moving collage of Micaela's visual references">
            <div class="sideb-strip-track" data-marquee-track>
              {[false, true].map((duplicate) => (
                <div class="sideb-strip-set" data-marquee-set={duplicate ? undefined : ''} aria-hidden={duplicate ? 'true' : undefined}>
                  {stripImages.map((item) => (
                    <figure class="sideb-strip-item" style={item.style}>
                      <img
                        src={item.src}
                        alt=""
                        width={item.width}
                        height={item.height}
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                    </figure>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </section>

        <section class="sideb-section" aria-labelledby="fashion-title">
          <h2 class="sideb-section-title" id="fashion-title" data-appear>(fashion &amp;<br />aesthetics)</h2>
          <div class="sideb-section-column">
            <p class="sideb-big" data-appear>I run a <span class="sideb-pseudo-link">digital vintage shop</span> centered on curating designer pieces and extending their life through reuse. I'm fascinated by the way objects can be recontextualized, transformed, and given new meaning over time in a world where trends are fleeting.</p>

            <div class="sideb-fashion-reveal" data-appear>
              <figure class="sideb-fashion-media" data-parallax>
                <video
                  class="sideb-fashion-video"
                  src="/04_SideB/Fashion_SideB.mp4"
                  poster={fashion.src}
                  width={fashion.width}
                  height={fashion.height}
                  aria-label="Fashion looks from Micaela's digital vintage shop"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  disablepictureinpicture
                  controlslist="nodownload"
                ></video>
              </figure>
            </div>

            <div class="sideb-body-pair">
              <p data-appear>I'm currently pursuing a Bachelor's degree in Design and Aesthetic Management, a multidisciplinary program that explores fashion, graphic, interior, and product design. What fascinates me most is the idea that aesthetics are never superficial. Every visual decision, from the spaces we inhabit to the clothes we wear, communicates identity, values, and culture.</p>
              <p data-appear>I see the way I dress as an extension of my design practice. It's one of the most immediate ways I present myself to the world, just as branding, art direction, or digital experiences shape how people perceive a brand. Studying aesthetics across different disciplines has expanded the way I think about communication, helping me design with greater intention, coherence, and emotional depth.</p>
            </div>
          </div>
        </section>

        <section class="sideb-section sideb-music-section" aria-labelledby="music-title">
          <h2 class="sideb-section-title" id="music-title" data-appear>(music)</h2>
          <div class="sideb-section-column">
            <p class="sideb-big" data-appear><span class="sideb-music-lead">Music taught me that complexity doesn't have to feel chaotic. I'm fascinated by sound, noise, and the absence of both.</span> <span class="sideb-music-body">Through music, I found the same eclectic spirit that defines my work across design, fashion, and aesthetics: different influences, multiple layers, and unexpected contrasts coming together to create something cohesive. My next creative goal is to dive deeper into sound design and music production, expanding the way I think about storytelling beyond the visual.</span></p>
          </div>
        </section>

        <section class="sideb-spotify" data-appear aria-label="Micaela's Spotify playlist">
          <div class="sideb-spotify-frame">
            <iframe
              title="Micaela's Spotify playlist"
              src="https://open.spotify.com/embed/playlist/4WzNfZg1nlNPVuNooWu7FZ?utm_source=generator&theme=0&si=da993964294346ec"
              loading="lazy"
              allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              referrerpolicy="strict-origin-when-cross-origin"
            ></iframe>
          </div>
          <a href="https://open.spotify.com/playlist/4WzNfZg1nlNPVuNooWu7FZ" target="_blank" rel="noopener noreferrer">Abrir la playlist en Spotify ↗</a>
        </section>

        <section class="sideb-section sideb-film-section" aria-labelledby="film-title">
          <h2 class="sideb-section-title" id="film-title" data-appear>(film)</h2>
          <div class="sideb-section-column">
            <p class="sideb-big" data-appear>Shooting on film completely changed the way I approach uncertainty. I fell in love with its grain, textures, light leaks, and chemical imperfections, elements that digital workflows often try to eliminate.</p>

            <div class="sideb-film-strip" data-marquee data-appear role="group" aria-label="Film photography">
              <div class="sideb-film-strip-track" data-marquee-track>
                {[false, true].map((duplicate) => (
                  <div class="sideb-film-strip-set" data-marquee-set={duplicate ? undefined : ''} aria-hidden={duplicate ? 'true' : undefined}>
                    {filmPairs.map((item) => (
                      <figure class="sideb-film-strip-item">
                        <img src={item.src} alt={duplicate ? '' : item.alt} width={item.width} height={item.height} loading="lazy" decoding="async" draggable="false" />
                      </figure>
                    ))}
                  </div>
                ))}
              </div>
            </div>

            <div class="sideb-body-pair">
              <p data-appear>What fascinates me most is capturing moments that might seem ordinary or even unnoticed to everyone else, but somehow feel worth preserving to me. Photography gives me the chance to steal those fleeting moments and reveal the beauty hidden in what others might overlook.</p>
              <p data-appear>Every frame demands patience, intention, and the acceptance that the outcome is never fully under your control. That process has deeply influenced the way I approach design: slowing down, trusting the process, and finding beauty in what wasn't planned. I learned that uncertainty isn't the opposite of good design. Sometimes it's what gives it character.</p>
            </div>
          </div>
        </section>
      </div>
    </article>

    <footer class="sideb-footer" id="sideb-footer">
      <div class="sideb-footer-wordmark" aria-label="Itsmicki, copyright 2026">
        <span data-sideb-reveal>Itsmicki</span>
        <span data-sideb-reveal>©2026</span>
      </div>
      <div class="sideb-footer-info" id="sideb-footer-info">
        <span data-sideb-reveal style="--reveal-delay:0ms">DEV BY</span>
        <a data-sideb-reveal style="--reveal-delay:70ms" href="https://www.instagram.com/luckystoned/" target="_blank" rel="noopener noreferrer">@LUCKYSTONED</a>
        <span data-sideb-reveal style="--reveal-delay:140ms">SAY HI</span>
        <a data-sideb-reveal style="--reveal-delay:210ms" href="mailto:hey@itsmicki.com" target="_blank" rel="noopener noreferrer">HEY@ITSMICKI.COM</a>
        <span data-sideb-reveal style="--reveal-delay:280ms">ALL RIGHTS RESERVED.</span>
        <span class="sideb-footer-socials" data-sideb-reveal style="--reveal-delay:350ms">
          SOCIALS <a href="https://www.linkedin.com/in/itsmicki/" target="_blank" rel="noopener noreferrer">LINKEDIN</a>,
          {" "}<a href="https://www.behance.net/itsmicki" target="_blank" rel="noopener noreferrer">BEHANCE</a>,
          {" "}<a href="https://dribbble.com/micaelagalimberti" target="_blank" rel="noopener noreferrer">DRIBBBLE</a>,
          {" "}<a href="https://www.instagram.com/its.micki/" target="_blank" rel="noopener noreferrer">INSTAGRAM</a>,
          {" "}<a href="https://www.tiktok.com/@mickivainillla" target="_blank" rel="noopener noreferrer">TIKTOK</a>
        </span>
      </div>
    </footer>
  </div>

  <script>
    import { initPageMotion } from '@/scripts/pageMotion';

    /* Native scrolling with the same damped wheel interpolation as the reference. */
    (function () {
      const reduceMotion = matchMedia('(prefers-reduced-motion:reduce)').matches;
      if (reduceMotion || !matchMedia('(pointer:fine)').matches) return;

      let targetY = window.scrollY;
      let currentY = targetY;
      let running = false;
      let frame: number | null = null;
      let locked = false;
      let previousTime = 0;

      const maxScroll = () => Math.max(0, document.documentElement.scrollHeight - window.innerHeight);

      function tick(now: number) {
        if (!previousTime) previousTime = now;
        const deltaTime = Math.min(64, now - previousTime) / 1000;
        previousTime = now;
        currentY += (targetY - currentY) * (1 - Math.exp(-6.5 * deltaTime));
        if (Math.abs(targetY - currentY) < 0.12) {
          currentY = targetY;
          running = false;
          previousTime = 0;
        }
        locked = true;
        window.scrollTo(0, currentY);
        locked = false;
        frame = running ? requestAnimationFrame(tick) : null;
      }

      addEventListener('wheel', (event) => {
        if (event.ctrlKey) return;
        event.preventDefault();
        let delta = event.deltaY;
        if (event.deltaMode === 1) delta *= 16;
        else if (event.deltaMode === 2) delta *= window.innerHeight;
        targetY = Math.max(0, Math.min(maxScroll(), targetY + delta));
        if (!running) {
          running = true;
          if (!frame) frame = requestAnimationFrame(tick);
        }
      }, { passive: false });

      addEventListener('scroll', () => {
        if (!locked && !running) targetY = currentY = window.scrollY;
      });

      addEventListener('resize', () => {
        targetY = currentY = window.scrollY;
      });

      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (event) => {
          const href = anchor.getAttribute('href');
          if (!href || href === '#') return;
          const target = document.querySelector<HTMLElement>(href);
          if (!target) return;
          event.preventDefault();
          targetY = Math.max(0, Math.min(maxScroll(), target.getBoundingClientRect().top + window.scrollY));
          if (!running) {
            running = true;
            if (!frame) frame = requestAnimationFrame(tick);
          }
        });
      });
    })();

    const reduceSideBMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLElement>('[data-sideb-reveal]').forEach((node) => {
      if (reduceSideBMotion) node.classList.add('is-visible');
    });

    if (!reduceSideBMotion) {
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => entry.target.classList.toggle('is-visible', entry.isIntersecting));
      }, { threshold: .02, rootMargin: '-2% 0px -6% 0px' });
      document.querySelectorAll<HTMLElement>('[data-sideb-reveal]').forEach((node) => revealObserver.observe(node));
    }

    /* ============ IMAGE STRIP: drifts on its own and can be dragged, swiped or scrolled sideways ============ */
    const initStrip = (strip: HTMLElement) => {
      const stripTrack = strip.querySelector<HTMLElement>('[data-marquee-track]');
      const stripSet = strip.querySelector<HTMLElement>('[data-marquee-set]');
      if (!stripTrack || !stripSet) return;
      // `target` is where the strip wants to be; `offset` eases toward it for a soft, inertial feel.
      let setWidth = 0, target = 0, offset = 0, velocity = 0, lastX = 0, moved = 0, holdUntil = 0;
      let dragging = false, pointerId = -1, previousTime = 0;

      const wrap = () => {
        if (!setWidth) return;
        while (offset > 0) { offset -= setWidth; target -= setWidth; }
        while (offset <= -setWidth) { offset += setWidth; target += setWidth; }
      };
      const measure = () => {
        const gap = parseFloat(getComputedStyle(stripTrack).columnGap || getComputedStyle(stripTrack).gap) || 0;
        setWidth = stripSet.getBoundingClientRect().width + gap;
        wrap();
      };
      const frame = (now: number) => {
        const elapsed = previousTime ? Math.min(64, now - previousTime) : 16;
        previousTime = now;
        if (!reduceSideBMotion && !dragging && now >= holdUntil) target -= elapsed * .03;
        offset = reduceSideBMotion ? target : offset + (target - offset) * (1 - Math.exp(-(dragging ? 25 : 9) * elapsed / 1000));
        wrap();
        stripTrack.style.transform = `translate3d(${offset}px, 0, 0)`;
        requestAnimationFrame(frame);
      };

      strip.addEventListener('dragstart', (event) => event.preventDefault());
      strip.addEventListener('pointerdown', (event) => {
        if (!event.isPrimary || event.button !== 0) return;
        dragging = true; pointerId = event.pointerId; lastX = event.clientX; moved = 0; velocity = 0;
      });
      strip.addEventListener('pointermove', (event) => {
        if (!dragging || event.pointerId !== pointerId) return;
        const dx = event.clientX - lastX;
        lastX = event.clientX;
        moved += Math.abs(dx);
        if (moved > 6 && !strip.hasPointerCapture(pointerId)) strip.setPointerCapture(pointerId);
        target += dx;
        velocity = velocity * .6 + dx * .4;
      });
      const release = (event: PointerEvent) => {
        if (!dragging || event.pointerId !== pointerId) return;
        dragging = false;
        if (moved > 6 && !reduceSideBMotion) target += velocity * 14;
        holdUntil = performance.now() + 600;
      };
      addEventListener('pointerup', release);
      addEventListener('pointercancel', release);
      strip.addEventListener('lostpointercapture', release);
      // Sideways trackpad/wheel gestures move the strip; vertical ones keep scrolling the page.
      strip.addEventListener('wheel', (event) => {
        if (Math.abs(event.deltaX) <= Math.abs(event.deltaY)) return;
        event.preventDefault();
        const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? strip.clientWidth : 1;
        target -= event.deltaX * unit;
        holdUntil = performance.now() + 400;
      }, { passive: false });

      addEventListener('resize', measure);
      if (document.fonts?.ready) document.fonts.ready.then(measure);
      measure();
      requestAnimationFrame(frame);
    };
    document.querySelectorAll<HTMLElement>('[data-marquee]').forEach(initStrip);

    initPageMotion(document.querySelector<HTMLElement>('.sideb-page'));
  </script>
</BaseLayout>

<style is:global>
  @font-face {
    font-family: 'OT Neue Montreal SideB';
    src: url('/fonts/OTNeueMontreal-MediumSemiSqueezed.otf') format('opentype');
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
  }

  @font-face {
    font-family: 'OT Neue Montreal SideB Extra';
    src: url('/fonts/OTNeueMontreal-MediumExtraSqueezed.otf') format('opentype');
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
  }

  html:has(.sideb-page),
  body:has(.sideb-page) {
    --sideb-ink: #2e2e2e;
    --sideb-paper: #fafafa;
    --sideb-pad: var(--gutter);
    --sideb-ease: cubic-bezier(.19, 1, .22, 1);
    background: var(--sideb-paper);
    color: var(--sideb-ink);
    cursor: url('/cursors/view.png') 0 0, auto;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  html:has(.sideb-page) {
    scroll-behavior: auto;
  }

  body:has(.sideb-page) a {
    cursor: url('/cursors/view.png') 0 0, auto;
    -webkit-tap-highlight-color: transparent;
  }

  body:has(.sideb-page) a:hover,
  body:has(.sideb-page) a:focus-visible {
    cursor: url('/cursors/view-hover.png') 0 0, pointer;
  }

  body:has(.sideb-page) ::selection {
    background: var(--sideb-ink);
    color: var(--sideb-paper);
  }

  body:has(.sideb-page) .site-header {
    position: relative;
    z-index: 20;
    top: auto;
    padding: 24px var(--sideb-pad) 0;
    background: transparent;
    color: var(--sideb-ink);
    backdrop-filter: none;
    font-family: 'OT Neue Montreal SideB', 'Arial Narrow', sans-serif;
    font-size: clamp(14px, 1.74vw, 27.117px);
    font-weight: 500;
    line-height: normal;
    letter-spacing: -.02em;
  }

  body:has(.sideb-page) .site-header nav {
    gap: 10px;
  }

  body:has(.sideb-page) .site-header a::after {
    display: none;
  }

  body:has(.sideb-page) .site-header a:is(:hover, :focus-visible, .active) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: .08em;
  }

  .sideb-page {
    min-height: 100vh;
    background: var(--sideb-paper);
    color: var(--sideb-ink);
    font-family: 'OT Neue Montreal SideB', 'Arial Narrow', sans-serif;
    font-weight: 500;
    letter-spacing: -.01em;
  }

  .sideb-mobile-meta {
    display: none;
  }

  /* Same size, left edge and first baseline as the titles on /projects and /deets. */
  .sideb-title {
    margin: 5.9375vw 0 0;
    padding-inline: var(--gutter);
    font-family: 'OT Neue Montreal SideB Extra', Impact, sans-serif;
    font-size: 20.2vw;
    font-weight: 500;
    line-height: .854;
    letter-spacing: -.04em;
  }

  .sideb-main {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 7.25vw, 116px);
    margin-top: clamp(40px, 3.7vw, 59px);
  }

  .sideb-intro-grid {
    display: grid;
    grid-template-columns: 556fr 994fr;
    gap: 0;
    padding-inline: var(--sideb-pad);
  }

  .sideb-label {
    margin: 0 0 18px;
    font-size: clamp(16px, 1.54vw, 24px);
    font-weight: 500;
    line-height: 1;
  }

  .sideb-big,
  .sideb-section-title {
    margin: 0;
    font-size: clamp(30px, 4.137vw, 64.53px);
    font-weight: 500;
    line-height: .868;
    letter-spacing: -.025em;
  }

  .sideb-related a { display: block; width: fit-content; }

  .sideb-related {
    line-height: .91;
  }

  .sideb-pseudo-link {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: .08em;
  }

  .sideb-strip {
    height: 40.4vw;
    margin-top: clamp(20px, 2.6vw, 40px);
    overflow: hidden;
    touch-action: pan-y;
    user-select: none;
  }

  .sideb-strip-track,
  .sideb-strip-set {
    display: flex;
    align-items: center;
    width: max-content;
    height: 100%;
    gap: 3.08vw;
  }

  .sideb-strip-track {
    will-change: transform;
  }

  .sideb-strip-item {
    display: flex;
    flex: 0 0 var(--strip-width, var(--strip-w));
    align-items: center;
    justify-content: center;
    width: var(--strip-width, var(--strip-w));
    margin: 0;
  }

  .sideb-strip-item img {
    display: block;
    width: var(--strip-inner, 100%);
    height: auto;
    pointer-events: none;
    rotate: var(--strip-rotate, 0deg);
  }

  /* Film photos: an endless strip that drifts on its own and can be dragged or scrolled sideways. */
  .sideb-film-strip {
    width: 100%;
    height: 42.25vw;
    overflow: hidden;
    touch-action: pan-y;
    user-select: none;
  }

  .sideb-film-strip-track,
  .sideb-film-strip-set {
    display: flex;
    width: max-content;
    height: 100%;
    gap: 8px; /* 4px on phones. */
  }

