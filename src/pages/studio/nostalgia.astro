---
// Recording studio for Nostalgia as Agony (not linked anywhere, noindex): a vertical 1080×1920 desktop, in the style
// of a Mac screen, with the piece live in a Preview window, the camera (mirrored, the hand's points drawn on it) in
// a small window and folders (no cursor: the hand is seen in the camera). "rec" records it with the broken song and
// downloads the video. Without the camera, the mouse plays the piece (press and hold to break it).
import NostalgiaField from '@/components/NostalgiaField.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Nostalgia studio</title>
  </head>
  <body>
    <main class="studio">
      <canvas class="studio-stage" width="1080" height="1920" aria-label="Recording preview" data-studio-stage></canvas>
      <div class="studio-controls">
        <button type="button" data-studio-camera>camera on</button>
        <button type="button" data-studio-sound>sound on</button>
        <button type="button" class="studio-rec" data-studio-rec>● rec</button>
        <p data-studio-status aria-live="polite">Turn the camera on (or use the mouse), then rec. R starts and stops.</p>
      </div>
    </main>
    <div class="studio-field" aria-hidden="true">
      <NostalgiaField label="Nostalgia as Agony, live" studio />
    </div>
  </body>
</html>

<script>
  type Point = { x: number; y: number };
  type Api = {
    canvas: HTMLCanvasElement;
    state: () => { hand: Point | null; fist: number; near: number; cameraOn: boolean; landmarks: Point[] | null; video: HTMLVideoElement | null };
    point: (at: Point | null, pressed: boolean) => void;
    startCamera: () => Promise<void> | undefined;
    stopCamera: () => void;
    soundOn: () => Promise<void>;
    audio: () => MediaStream | null;
  };

  const W = 1080, H = 1920;
  const FONT = 'system-ui, -apple-system, "SF Pro Text", "Helvetica Neue", Arial, sans-serif';
  // Where things sit on the 1080×1920 desktop.
  const LAYOUT = {
    folder: { x: 540, y: 96, size: 140, label: '𝄞⨾💿✮˚.⋆' }, // (x is its centre)
    preview: { x: 80, y: 330, w: 920, h: 1000, bar: 66, title: 'nostalgia_as_agony.mov' },
    camera: { x: 560, y: 1400, w: 440, h: 330, bar: 52, title: 'camera.mov' },
    folders: [{ x: 150, y: 1430, label: '🎧ྀི♪⋆.✮' }, { x: 150, y: 1600, label: 'portfolio' }],
  };
  // The hand's bones (MediaPipe's 21 points).
  const BONES = [[0, 1], [1, 2], [2, 3], [3, 4], [0, 5], [5, 6], [6, 7], [7, 8], [5, 9], [9, 10], [10, 11], [11, 12], [9, 13], [13, 14], [14, 15], [15, 16], [13, 17], [17, 18], [18, 19], [19, 20], [0, 17]];

  const stage = document.querySelector<HTMLCanvasElement>('[data-studio-stage]')!;
  const ctx = stage.getContext('2d')!;
  const root = document.querySelector<HTMLElement>('[data-nostalgia-field]')!;
  const holder = document.querySelector<HTMLElement>('.studio-field')!;
  const status = document.querySelector<HTMLElement>('[data-studio-status]')!;
  const api = () => (root as HTMLElement & { nostalgia?: Api }).nostalgia;

  // The piece renders at the Preview window's size (its canvas caps at 1.5× the screen's pixels).
  const ratio = Math.min(devicePixelRatio || 1, 1.5);
  holder.style.width = `${LAYOUT.preview.w / ratio}px`;
  holder.style.height = `${(LAYOUT.preview.h - LAYOUT.preview.bar) / ratio}px`;

  const roundRect = (x: number, y: number, w: number, h: number, r: number) => { ctx.beginPath(); ctx.roundRect(x, y, w, h, r); };

  // A window like Preview's: white, rounded, a soft shadow, the three lights, a title and the toolbar icons.
  const windowFrame = (x: number, y: number, w: number, h: number, bar: number, title: string, subtitle: string, icons: boolean) => {
    ctx.save();
    ctx.shadowColor = 'rgba(0,0,0,.22)'; ctx.shadowBlur = 70; ctx.shadowOffsetY = 26;
    roundRect(x, y, w, h, 20); ctx.fillStyle = '#ffffff'; ctx.fill();
    ctx.restore();
    ctx.save(); roundRect(x, y, w, h, 20); ctx.clip();
    ctx.fillStyle = '#f6f6f6'; ctx.fillRect(x, y, w, bar);
    ctx.fillStyle = '#dedede'; ctx.fillRect(x, y + bar - 1, w, 1);
    const s = bar / 66, cy = y + bar / 2;
    ['#ff5f57', '#febc2e', '#28c840'].forEach((c, i) => { ctx.beginPath(); ctx.arc(x + 30 * s + i * 26 * s, cy, 8.5 * s, 0, Math.PI * 2); ctx.fillStyle = c; ctx.fill(); ctx.strokeStyle = 'rgba(0,0,0,.12)'; ctx.lineWidth = 1; ctx.stroke(); });
    ctx.strokeStyle = '#6b6b6b'; ctx.lineWidth = 2 * s; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
    let tx = x + 112 * s;
    if (icons) {
      // Sidebar toggle.
      roundRect(x + 116 * s, cy - 11 * s, 26 * s, 22 * s, 4 * s); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(x + 126 * s, cy - 11 * s); ctx.lineTo(x + 126 * s, cy + 11 * s); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(x + 150 * s, cy - 3 * s); ctx.lineTo(x + 155 * s, cy + 2 * s); ctx.lineTo(x + 160 * s, cy - 3 * s); ctx.stroke();
      tx = x + 182 * s;
    }
    ctx.fillStyle = '#262626'; ctx.textBaseline = 'alphabetic';
    ctx.font = `600 ${21 * s}px ${FONT}`; ctx.fillText(title, tx, cy + (subtitle ? -1 : 7) * s);
    if (subtitle) { ctx.fillStyle = '#8a8a8a'; ctx.font = `500 ${15 * s}px ${FONT}`; ctx.fillText(subtitle, tx, cy + 18 * s); }
    if (icons) {
      // Info, zoom out, zoom in, share, rotate.
      let ix = x + w - 330 * s;
      const glass = (plus: boolean) => { ctx.beginPath(); ctx.arc(ix, cy - 2 * s, 9 * s, 0, Math.PI * 2); ctx.stroke(); ctx.beginPath(); ctx.moveTo(ix + 6.5 * s, cy + 4.5 * s); ctx.lineTo(ix + 12 * s, cy + 10 * s); ctx.moveTo(ix - 4.5 * s, cy - 2 * s); ctx.lineTo(ix + 4.5 * s, cy - 2 * s); if (plus) { ctx.moveTo(ix, cy - 6.5 * s); ctx.lineTo(ix, cy + 2.5 * s); } ctx.stroke(); };
      ctx.beginPath(); ctx.arc(ix, cy, 11 * s, 0, Math.PI * 2); ctx.stroke(); ctx.beginPath(); ctx.moveTo(ix, cy - 1 * s); ctx.lineTo(ix, cy + 6 * s); ctx.stroke(); ctx.beginPath(); ctx.arc(ix, cy - 5.5 * s, 1.2 * s, 0, Math.PI * 2); ctx.fillStyle = '#6b6b6b'; ctx.fill();
      ix += 52 * s; glass(false); ix += 46 * s; glass(true);
      ix += 50 * s; ctx.beginPath(); ctx.moveTo(ix - 9 * s, cy - 2 * s); ctx.lineTo(ix - 9 * s, cy + 11 * s); ctx.lineTo(ix + 9 * s, cy + 11 * s); ctx.lineTo(ix + 9 * s, cy - 2 * s); ctx.moveTo(ix, cy + 3 * s); ctx.lineTo(ix, cy - 13 * s); ctx.moveTo(ix - 5 * s, cy - 8 * s); ctx.lineTo(ix, cy - 13 * s); ctx.lineTo(ix + 5 * s, cy - 8 * s); ctx.stroke();
      ix += 60 * s; roundRect(ix - 9 * s, cy - 6 * s, 16 * s, 17 * s, 3 * s); ctx.stroke(); ctx.beginPath(); ctx.arc(ix + 2 * s, cy - 6 * s, 9 * s, Math.PI * 1.1, Math.PI * 1.75); ctx.stroke();
      ix += 54 * s; ctx.beginPath(); ctx.moveTo(ix - 6 * s, cy - 7 * s); ctx.lineTo(ix, cy); ctx.lineTo(ix - 6 * s, cy + 7 * s); ctx.moveTo(ix + 2 * s, cy - 7 * s); ctx.lineTo(ix + 8 * s, cy); ctx.lineTo(ix + 2 * s, cy + 7 * s); ctx.stroke();
    }
    ctx.restore();
  };

  // A Finder folder, with its name under it.
  const folder = (x: number, y: number, size: number, label: string) => {
    const w = size, h = size * .74, tab = size * .36;
    const g = ctx.createLinearGradient(0, y, 0, y + h);
    g.addColorStop(0, '#9fd0fb'); g.addColorStop(1, '#5aa5ec');
    ctx.save();
    ctx.shadowColor = 'rgba(0,0,0,.12)'; ctx.shadowBlur = 10; ctx.shadowOffsetY = 3;
    ctx.fillStyle = '#7dbcf4'; roundRect(x - w / 2, y, tab, h * .3, size * .05); ctx.fill();
    ctx.fillStyle = '#8cc4f6'; roundRect(x - w / 2, y + h * .1, w, h * .9, size * .06); ctx.fill();
    ctx.shadowColor = 'transparent';
    ctx.fillStyle = g; roundRect(x - w / 2, y + h * .22, w, h * .78, size * .06); ctx.fill();
    ctx.fillStyle = 'rgba(255,255,255,.35)'; ctx.fillRect(x - w / 2 + size * .04, y + h * .22 + 2, w - size * .08, 2);
    ctx.restore();
    ctx.fillStyle = '#2b2b2b'; ctx.textAlign = 'center'; ctx.font = `500 ${Math.round(size * .19)}px ${FONT}`;
    ctx.fillText(label, x, y + h + size * .26); ctx.textAlign = 'left';
  };

  // The camera, mirrored and cover-fitted, with the hand's points and bones over it.
  const cameraView = (x: number, y: number, w: number, h: number, video: HTMLVideoElement | null, landmarks: Point[] | null) => {
    ctx.save(); ctx.beginPath(); ctx.rect(x, y, w, h); ctx.clip();
    ctx.fillStyle = '#111'; ctx.fillRect(x, y, w, h);
    if (video && video.readyState >= 2) {
      const vw = video.videoWidth, vh = video.videoHeight, sc = Math.max(w / vw, h / vh), dw = vw * sc, dh = vh * sc, dx = x + (w - dw) / 2, dy = y + (h - dh) / 2;
      ctx.save(); ctx.translate(2 * x + w, 0); ctx.scale(-1, 1); ctx.drawImage(video, dx, dy, dw, dh); ctx.restore();
      if (landmarks) {
        const at = (p: Point) => [x + w - (dx - x + p.x * dw), dy + p.y * dh];
        ctx.strokeStyle = 'rgba(255,255,255,.85)'; ctx.lineWidth = 2;
        for (const [a, b] of BONES) { const [ax, ay] = at(landmarks[a]), [bx, by] = at(landmarks[b]); ctx.beginPath(); ctx.moveTo(ax, ay); ctx.lineTo(bx, by); ctx.stroke(); }
        ctx.fillStyle = '#ffffff';
        for (const p of landmarks) { const [px, py] = at(p); ctx.fillRect(px - 4, py - 4, 8, 8); }
      }
    } else {
      ctx.fillStyle = '#8a8a8a'; ctx.textAlign = 'center'; ctx.font = `500 22px ${FONT}`; ctx.fillText('camera off', x + w / 2, y + h / 2 + 8); ctx.textAlign = 'left';
    }
    ctx.restore();
  };

  let recording: { recorder: MediaRecorder; started: number } | null = null;
  const draw = () => {
    const piece = api();
    const g = ctx.createRadialGradient(W / 2, H * .45, 200, W / 2, H * .45, H * .8);
    g.addColorStop(0, '#ececec'); g.addColorStop(1, '#d9d9d9');
    ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);

    const { folder: big, preview: p, camera: c } = LAYOUT;
    folder(big.x, big.y, big.size, big.label);
    LAYOUT.folders.forEach((f) => folder(f.x, f.y, 110, f.label));

    windowFrame(p.x, p.y, p.w, p.h, p.bar, p.title, recording ? 'Recording' : 'Edited', true);
    const state = piece?.state();
    if (piece) { ctx.save(); roundRect(p.x, p.y, p.w, p.h, 20); ctx.clip(); ctx.drawImage(piece.canvas, p.x, p.y + p.bar, p.w, p.h - p.bar); ctx.restore(); }

    windowFrame(c.x, c.y, c.w, c.h + c.bar, c.bar, c.title, '', false);
    ctx.save(); roundRect(c.x, c.y, c.w, c.h + c.bar, 20); ctx.clip(); cameraView(c.x, c.y + c.bar, c.w, c.h, state?.video ?? null, state?.landmarks ?? null); ctx.restore();

    if (recording) {
      const t = Math.floor((performance.now() - recording.started) / 1000);
      status.textContent = `● recording ${String(Math.floor(t / 60)).padStart(2, '0')}:${String(t % 60).padStart(2, '0')} — R or the button stops and downloads it.`;
    }
    requestAnimationFrame(draw);
  };
  requestAnimationFrame(draw);

  // The mouse over the Preview window plays the piece (when the camera is off).
  let pressed = false;
  const toPiece = (event: PointerEvent): Point | null => {
    const r = stage.getBoundingClientRect(), sx = (event.clientX - r.left) / r.width * W, sy = (event.clientY - r.top) / r.height * H, p = LAYOUT.preview;
    const x = (sx - p.x) / p.w, y = (sy - p.y - p.bar) / (p.h - p.bar);
    return x >= 0 && x <= 1 && y >= 0 && y <= 1 ? { x, y } : null;
  };
  stage.addEventListener('pointermove', (event) => api()?.point(toPiece(event), pressed));
  stage.addEventListener('pointerdown', (event) => { pressed = true; stage.setPointerCapture(event.pointerId); api()?.point(toPiece(event), true); });
  const release = (event: PointerEvent) => { pressed = false; api()?.point(toPiece(event), false); };
  stage.addEventListener('pointerup', release); stage.addEventListener('pointercancel', release);
  stage.addEventListener('pointerleave', () => { if (!pressed) api()?.point(null, false); });

  const cameraButton = document.querySelector<HTMLButtonElement>('[data-studio-camera]')!;
  const soundButton = document.querySelector<HTMLButtonElement>('[data-studio-sound]')!;
  const recButton = document.querySelector<HTMLButtonElement>('[data-studio-rec]')!;
  cameraButton.addEventListener('click', async () => {
    const piece = api(); if (!piece) return;
    if (piece.state().cameraOn) { piece.stopCamera(); cameraButton.textContent = 'camera on'; return; }
    cameraButton.textContent = 'starting…';
    await piece.startCamera();
    cameraButton.textContent = piece.state().cameraOn ? 'camera off' : 'camera on';
    soundButton.textContent = 'sound on ✓';
  });
  soundButton.addEventListener('click', async () => { await api()?.soundOn(); soundButton.textContent = 'sound on ✓'; });

  // Recording: the desktop at 30 fps with the broken song; it downloads when it stops.
  const toggleRec = async () => {
    if (recording) { recording.recorder.stop(); return; }
    const piece = api(); if (!piece) return;
    await piece.soundOn(); soundButton.textContent = 'sound on ✓';
    const stream = stage.captureStream(30);
    piece.audio()?.getAudioTracks().forEach((track) => stream.addTrack(track));
    const type = ['video/mp4;codecs=avc1.640028,mp4a.40.2', 'video/mp4', 'video/webm;codecs=vp9,opus', 'video/webm'].find((t) => MediaRecorder.isTypeSupported(t)) ?? '';
    const recorder = new MediaRecorder(stream, { mimeType: type || undefined, videoBitsPerSecond: 16_000_000, audioBitsPerSecond: 256_000 });
    const chunks: Blob[] = [];
    recorder.ondataavailable = (event) => { if (event.data.size) chunks.push(event.data); };
    recorder.onstop = () => {
      const ext = recorder.mimeType.includes('mp4') ? 'mp4' : 'webm';
      const link = document.createElement('a');
      link.href = URL.createObjectURL(new Blob(chunks, { type: recorder.mimeType }));
      link.download = `nostalgia-${new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-')}.${ext}`;
      link.click();
      setTimeout(() => URL.revokeObjectURL(link.href), 10_000);
      recording = null; recButton.textContent = '● rec'; recButton.classList.remove('is-on');
      status.textContent = `Saved ${link.download}.`;
    };
    recorder.start(1000);
    recording = { recorder, started: performance.now() };
    recButton.textContent = '■ stop'; recButton.classList.add('is-on');
  };
  recButton.addEventListener('click', toggleRec);
  addEventListener('keydown', (event) => { if (event.key.toLowerCase() === 'r' && !event.metaKey && !event.ctrlKey) toggleRec(); });
</script>

<style is:global>
  html, body { margin: 0; height: 100%; background: #1c1c1c; color: #f2f0ec; font-family: system-ui, -apple-system, 'Helvetica Neue', Arial, sans-serif; }
  .studio { display: flex; align-items: center; justify-content: center; gap: 28px; height: 100vh; padding: 16px; box-sizing: border-box; }
  .studio-stage { height: calc(100vh - 32px); width: auto; max-width: calc(100vw - 32px); aspect-ratio: 9 / 16; border-radius: 8px; cursor: none; touch-action: none; }
  .studio-controls { display: flex; flex-direction: column; gap: 10px; width: 220px; }
  .studio-controls button { padding: 10px 14px; border: 1px solid #555; border-radius: 22px; color: inherit; background: #2a2a2a; font: inherit; font-size: 15px; text-align: left; cursor: pointer; }
  .studio-controls button:hover { background: #333; }
  .studio-controls button:focus-visible { outline: 2px solid #f2f0ec; outline-offset: 2px; }
  .studio-rec.is-on { border-color: #ff5f57; color: #ff5f57; }
  .studio-controls p { margin: 6px 0 0; color: #a8a8a8; font-size: 13px; line-height: 1.4; }
  /* The live piece, rendered at the Preview window's size behind the stage (it is drawn into it). */
  .studio-field { position: fixed; left: 0; top: 0; z-index: -1; opacity: 0; pointer-events: none; }
  .studio-field .nostalgia-field { position: absolute; inset: 0; }
  @media (max-width: 700px) { .studio { flex-direction: column; } .studio-stage { height: auto; width: 100%; } .studio-controls { width: 100%; } }
</style>
