---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectGridItem from '@/components/ProjectGridItem.astro';
import ProjectsStage from '@/components/ProjectsStage.astro';
import { projects } from '@/data/projects';
import { projectLabel } from '@/data/carousel';

const projectBySlug = new Map(projects.map((project) => [project.slug, project]));
const definitions = [
  {
    slug: 'genova',
    width: 'calc((97.23vw - 6px) * .50047)', height: 'auto', ratio: '47.57 / 63.01', eager: true,
  },
  {
    slug: 'winona',
    // Frame at the cover's proportion with a lighter parallax (10% instead of 25%), so the photo shows almost whole.
    width: 'calc((97.23vw - 6px) * .49953)', height: 'auto', ratio: '47.48 / 50.30', eager: true,
    ratioMobile: '47.48 / 50.30', parallaxHeight: '110%', parallaxStart: '-9.0909%', parallaxSpan: '9.0909%',
  },
  {
    slug: 'amazon',
    width: '100%', height: 'auto', ratio: '97.23 / 64.22',
    video: '/02_Projects/03_Amazon/01_Amazon_Loop.mp4',
  },
  {
    slug: 'maxmaher',
    width: '40.58vw', height: 'auto', ratio: '40.58 / 40.07',
  },
  {
    slug: 'outliant',
    width: 'calc((97.23vw - 6px) * .57451)', height: 'auto', ratio: '54.67 / 63.01',
  },
  {
    slug: 'lumen',
    width: 'calc((97.23vw - 6px) * .42549)', height: 'auto', ratio: '40.49 / 40.24',
    video: '/02_Projects/06_Lumen/01_Lumen_Loop.mp4',
  },
  {
    slug: 'blend360',
    width: '100%', height: 'auto', ratio: '97.23 / 64.22',
    // Rendered at 2x for this card's own proportion, so the logo's thin lines stay sharp at full width.
    cover: '/02_Projects/07_Blend360/01_Blend360_Cover.webp',
    video: '/02_Projects/07_Blend360/01_Blend360_Cover.mp4',
    videoMobile: '/02_Projects/07_Blend360/01_Blend360_Cover_Mobile.mp4',
  },
  {
    slug: 'textures-body',
    width: 'calc(100% * 1046 / 1556)', height: 'auto', ratio: '1046 / 767',
    video: '/02_Projects/08_TexturesBody/01_TexturesBody_Loop.mp4',
  },
] as const;

const cards = definitions.map((definition) => {
  const project = projectBySlug.get(definition.slug);
  if (!project) throw new Error(`Unknown project: ${definition.slug}`);
  return {
    ...definition,
    project,
    label: projectLabel(definition.slug),
    eager: 'eager' in definition ? definition.eager : false,
    cover: 'cover' in definition ? definition.cover : undefined,
    video: 'video' in definition ? definition.video : undefined,
    videoMobile: 'videoMobile' in definition ? definition.videoMobile : undefined,
    style: `--project-width:${definition.width};--project-height:${definition.height};--project-ratio:${definition.ratio}${'parallaxSpan' in definition ? `;--parallax-span:${definition.parallaxSpan}` : ''}${'parallaxStart' in definition ? `;--parallax-start:${definition.parallaxStart}` : ''}${'parallaxHeight' in definition ? `;--parallax-height:${definition.parallaxHeight}` : ''}${'ratioMobile' in definition ? `;--project-ratio-mobile:${definition.ratioMobile}` : ''}`,
  };
});

const [genova, winona, amazon, maxMaher, outliant, lumen, blend360, texturesBody] = cards;
---

<BaseLayout
  title="(Picked projects) — Itsmicki"
  description="Selected branding, product design, art direction and motion work by creative director Micaela Galimberti."
  active="projects"
  hideFooter
  customCursor
  themeColor="#fafafa"
  preloadFonts={[
    '/fonts/OTNeueMontreal-MediumSemiSqueezed.otf',
    '/fonts/OTNeueMontreal-MediumExtraSqueezed.otf',
  ]}
>
  <ProjectsStage wordmark="Itsmicki">
      <div class="projects-row projects-row-primary">
        <ProjectGridItem project={genova.project} label={genova.label} style={genova.style} cover={genova.cover} video={genova.video} eager={genova.eager} />
        <ProjectGridItem project={winona.project} label={winona.label} style={winona.style} cover={winona.cover} video={winona.video} eager={winona.eager} />
      </div>

      <ProjectGridItem project={amazon.project} label={amazon.label} style={amazon.style} cover={amazon.cover} video={amazon.video} />
      <ProjectGridItem project={maxMaher.project} label={maxMaher.label} style={maxMaher.style} cover={maxMaher.cover} video={maxMaher.video} />

      <div class="projects-row projects-row-secondary">
        <ProjectGridItem project={lumen.project} label={lumen.label} style={lumen.style} cover={lumen.cover} video={lumen.video} />
        <ProjectGridItem project={outliant.project} label={outliant.label} style={outliant.style} cover={outliant.cover} video={outliant.video} />
      </div>

      <ProjectGridItem project={blend360.project} label={blend360.label} style={blend360.style} cover={blend360.cover} video={blend360.video} videoMobile={blend360.videoMobile} />
      <ProjectGridItem project={texturesBody.project} label={texturesBody.label} style={texturesBody.style} cover={texturesBody.cover} video={texturesBody.video} />
  </ProjectsStage>
</BaseLayout>
