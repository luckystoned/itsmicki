---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCase from '@/components/ProjectCase.astro';
import { projects } from '@/data/projects';
import { projectCases } from '@/data/projectCases';

export function getStaticPaths() {
  return Object.values(projectCases).map((caseStudy) => {
    const project = projects.find((entry) => entry.slug === caseStudy.slug);
    if (!project) throw new Error(`Missing project metadata for ${caseStudy.slug}`);
    return { params: { slug: caseStudy.slug }, props: { project, caseStudy } };
  });
}

const { project, caseStudy } = Astro.props;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: caseStudy.title,
  description: project.summary,
  dateCreated: caseStudy.year,
  url: new URL(`/projects/${caseStudy.slug}`, Astro.site),
  image: project.cover ? new URL(project.cover, Astro.site) : undefined,
  creator: { '@type': 'Person', '@id': `${Astro.site}#person`, name: 'Micaela Galimberti' },
  keywords: ['Creative Direction', 'Art Direction', 'Visual Design', 'Product Design'],
};
---

<BaseLayout
  title={`${caseStudy.title} — Itsmicki`}
  description={project.summary}
  image={project.cover}
  imageAlt={`${caseStudy.title} project by Micaela Galimberti`}
  active="projects"
  ogType="article"
  structuredData={structuredData}
  hideFooter
  customCursor
  themeColor="#fafafa"
  preconnectOrigins={['https://player.vimeo.com', 'https://i.vimeocdn.com']}
  preloadFonts={[
    '/fonts/OTNeueMontreal-MediumSemiSqueezed.otf',
    '/fonts/OTNeueMontreal-MediumExtraSqueezed.otf',
  ]}
>
  <ProjectCase caseStudy={caseStudy} />
</BaseLayout>
