          <span class="deets-desktop-copy">I love shaping brands from start to finish, turning intangible stories into coherent systems that can live across digital and print.</span>
          <span class="deets-mobile-copy">I love shaping brands from start to finish, turning intangible stories into coherent systems that can live across digital<br />and print.</span>
        </p>
        <div class="deets-story-row">
          <p class="deets-node deets-body deets-close-one" data-appear>
            <span class="deets-desktop-copy">I’m drawn to experimental design, visual friction, and identities that refuse a single tone. Design isn’t neutral decoration: it carries culture, ideology, and power. At its best, it doesn’t just change how something looks—it changes how it can be read, felt, and remembered.</span>
            <span class="deets-mobile-copy">I’m drawn to experimental design, visual friction, and identities that refuse a single tone. Design isn’t neutral decoration: it carries culture, ideology, and power. At its best, it doesn’t just change how something looks—it changes how it can be read, felt, and remembered.</span>
          </p>
          <p class="deets-node deets-body deets-close-two" data-appear>
            <span class="deets-desktop-copy">If any of this resonates, say hi. I’m usually somewhere between a Figma file, an unfinished experiment, and two cats with no respect for deadlines ♡*.<span class="deets-email-line">Email me → <a href="mailto:hey@itsmicki.com" target="_blank" rel="noopener noreferrer">hey@itsmicki.com</a></span></span>
            <span class="deets-mobile-copy">If any of this resonates, say hi. I’m usually somewhere between a Figma file, an unfinished experiment, and two cats with no respect for deadlines ♡*.<br />Email me → <a href="mailto:hey@itsmicki.com" target="_blank" rel="noopener noreferrer">hey@itsmicki.com</a></span>
          </p>
        </div>
      </div>
    </article>

    <footer class="deets-footer">
      <div class="deets-footer-wordmark" aria-label="Itsmicki, copyright 2026">
        <span data-footer-reveal>Itsmicki</span>
        <span data-footer-reveal>©2026</span>
      </div>
      <div class="deets-footer-info">
        <span data-footer-reveal style="--reveal-delay:0ms">DEV BY</span>
        <a data-footer-reveal style="--reveal-delay:70ms" href="https://www.instagram.com/luckystoned/" target="_blank" rel="noopener noreferrer">@LUCKYSTONED</a>
        <span data-footer-reveal style="--reveal-delay:140ms">SAY HI</span>
        <a data-footer-reveal style="--reveal-delay:210ms" href="mailto:hey@itsmicki.com" target="_blank" rel="noopener noreferrer">HEY@ITSMICKI.COM</a>
        <span data-footer-reveal style="--reveal-delay:280ms">ALL RIGHTS RESERVED.</span>
        <span class="deets-footer-socials" data-footer-reveal style="--reveal-delay:350ms">
          SOCIALS <a href="https://www.linkedin.com/in/itsmicki/" target="_blank" rel="noopener noreferrer">LINKEDIN</a>,
          {" "}<a href="https://www.behance.net/itsmicki" target="_blank" rel="noopener noreferrer">BEHANCE</a>,
          {" "}<a href="https://dribbble.com/micaelagalimberti" target="_blank" rel="noopener noreferrer">DRIBBBLE</a>,
          {" "}<a href="https://www.instagram.com/its.micki/" target="_blank" rel="noopener noreferrer">INSTAGRAM</a>,
          {" "}<a href="https://www.tiktok.com/@mickivainillla" target="_blank" rel="noopener noreferrer">TIKTOK</a>
        </span>
      </div>
    </footer>
  </div>

  <script>
    import { initPageMotion } from '@/scripts/pageMotion';

    /* ============ SMOOTH SCROLL (inercia, mantiene scroll nativo) ============ */
    (function () {
      const RM = matchMedia('(prefers-reduced-motion:reduce)').matches;
      if (RM || !matchMedia('(pointer:fine)').matches) return;

      let tgt = window.scrollY;
      let cur = tgt;
      let run = false;
      let raf: number | null = null;
      let lock = false;
      let last = 0;

      function max() {
        return Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      }

      function loop(now: number) {
        if (!last) last = now;
        const dt = Math.min(64, now - last) / 1000;
        last = now;
        cur += (tgt - cur) * (1 - Math.exp(-6.5 * dt));
        if (Math.abs(tgt - cur) < 0.12) {
          cur = tgt;
          run = false;
          last = 0;
        }
        lock = true;
        window.scrollTo(0, cur);
        lock = false;
        raf = run ? requestAnimationFrame(loop) : null;
      }

      addEventListener('wheel', function (event) {
        if (event.ctrlKey) return;
        event.preventDefault();
        let delta = event.deltaY;
        if (event.deltaMode === 1) delta *= 16;
        else if (event.deltaMode === 2) delta *= window.innerHeight;
        tgt = Math.max(0, Math.min(max(), tgt + delta));
        if (!run) {
          run = true;
          if (!raf) raf = requestAnimationFrame(loop);
        }
      }, { passive: false });

      addEventListener('scroll', function () {
        if (!lock && !run) tgt = cur = window.scrollY;
      });

      addEventListener('resize', function () {
        tgt = cur = window.scrollY;
      });

      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(function (anchor) {
        anchor.addEventListener('click', function (event) {
          const href = anchor.getAttribute('href');
          if (!href || href === '#') return;
          const target = document.querySelector<HTMLElement>(href);
          if (!target) return;
          event.preventDefault();
          tgt = Math.max(0, Math.min(max(), target.getBoundingClientRect().top + window.scrollY));
          if (!run) {
            run = true;
            if (!raf) raf = requestAnimationFrame(loop);
          }
        });
      });
    })();

    initPageMotion(document.querySelector<HTMLElement>('.deets-page'));

    /* ============ "(my story)" fades out when the page reaches its end ============ */
    const storyTrack = document.querySelector<HTMLElement>('.deets-story-label-track');
    if (storyTrack) {
      const checkEnd = () => {
        const end = document.documentElement.scrollHeight - window.innerHeight;
        storyTrack.classList.toggle('is-at-end', window.scrollY >= end - 40);
      };
      addEventListener('scroll', checkEnd, { passive: true });
      addEventListener('resize', checkEnd);
      checkEnd();
    }

    const footerReveals = document.querySelectorAll<HTMLElement>('[data-footer-reveal]');
    if (footerReveals.length) {
      const footerObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => entry.target.classList.toggle('is-visible', entry.isIntersecting));
      }, { threshold: .02, rootMargin: '-2% 0px -6% 0px' });
      footerReveals.forEach((node) => footerObserver.observe(node));
    }
  </script>
</BaseLayout>

<style is:global>
  @font-face {
    font-family: 'OT Neue Montreal Deets';
    src: url('/fonts/OTNeueMontreal-MediumSemiSqueezed.otf') format('opentype');
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
  }

  @font-face {
    font-family: 'OT Neue Montreal Deets Extra';
    src: url('/fonts/OTNeueMontreal-MediumExtraSqueezed.otf') format('opentype');
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
  }

  html:has(.deets-page),
  body:has(.deets-page) {
    --deets-ink: #2e2e2e;
    --deets-paper: #fafafa;
    --deets-placeholder: #efece7;
    background: var(--deets-paper);
    color: var(--deets-ink);
    cursor: url('/cursors/view.png') 0 0, auto;
    -webkit-font-smoothing: antialiased;
    /* clip (not hidden) so sticky elements keep working */
    overflow-x: clip;
  }

  html:has(.deets-page) {
    scroll-behavior: auto;
  }

  body:has(.deets-page) a {
    cursor: url('/cursors/view.png') 0 0, auto;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  body:has(.deets-page) a:hover,
  body:has(.deets-page) a:focus-visible {
    cursor: url('/cursors/view-hover.png') 0 0, pointer;
  }

  body:has(.deets-page) ::selection {
    background: var(--deets-ink);
    color: var(--deets-paper);
  }

  body:has(.deets-page) .site-header {
    position: absolute;
    z-index: 20;
    inset: 0 0 auto;
    align-items: flex-start;
    padding: 1.450806vw var(--gutter) 0;
    background: transparent;
    color: var(--deets-ink);
    backdrop-filter: none;
    font-family: 'OT Neue Montreal Deets', 'Arial Narrow', sans-serif;
    font-size: clamp(14px, 1.74vw, 27.117px);
    font-weight: 500;
    line-height: normal;
    letter-spacing: -.02em;
  }

  body:has(.deets-page) .site-header nav {
    gap: 10px;
  }

  body:has(.deets-page) .site-header a::after {
    display: none;
  }

  body:has(.deets-page) .site-header a:is(:hover, :focus-visible, .active) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: .08em;
  }

  .deets-page {
    position: relative;
    width: 100%;
    height: 333.455vw;
    overflow: clip;
    background: var(--deets-paper);
    color: var(--deets-ink);
    font-family: 'OT Neue Montreal Deets', 'Arial Narrow', sans-serif;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -.01em;
  }

  .deets-mobile-meta,
  .deets-mobile-copy {
    display: none;
  }

  /* Everything moves up 4.2vw so the heading sits at the height of the Side B title, keeping all spacing. */
