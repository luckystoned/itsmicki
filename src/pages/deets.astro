---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { imageMetadata } from '@/data/imageMetadata';

const image = (src: string, alt: string) => ({ src, alt, ...imageMetadata[src] });
const portrait = image('/03_Deets/01_Deets.webp', 'Micaela resting with her face partly hidden by a white duvet.');
const desk = image('/03_Deets/02_Deets.webp', 'A softly blurred desk with colorful printed materials and design objects.');
const cap = image('/03_Deets/03_Deets.webp', 'Micaela seen from behind wearing a green cap.');
const laptop = image('/03_Deets/04_Deets.webp', 'An open laptop balanced on a pair of boots.');
const shoes = image('/03_Deets/05_Deets.webp', 'A close-up of pale yellow shoes against a dark outfit.');
---

<BaseLayout
  title="About Micaela Galimberti — Itsmicki"
  description="Meet Micaela Galimberti, a Buenos Aires creative director and multidisciplinary designer working across branding, product, motion and digital experiences."
  active="deets"
  hideFooter
  customCursor
  themeColor="#fafafa"
  preloadFonts={[
    '/fonts/OTNeueMontreal-MediumSemiSqueezed.otf',
    '/fonts/OTNeueMontreal-MediumExtraSqueezed.otf',
  ]}
>
  <div class="deets-page">
    <aside class="deets-mobile-meta" aria-label="Contact and social links">
      <span>SAY HI</span>
      <a class="deets-mobile-mail" href="mailto:hey@itsmicki.com">HEY@ITSMICKI.COM</a>
      <span>SOCIALS</span>
      <span class="deets-mobile-socials">
        <a href="https://www.linkedin.com/in/micaelagalimberti/" target="_blank" rel="noreferrer">LINKEDIN</a>,
        <a href="https://www.behance.net/itsmicki" target="_blank" rel="noreferrer">BEHANCE</a>,
        <a href="https://dribbble.com/micaelagalimberti" target="_blank" rel="noreferrer">DRIBBBLE</a>,
        <a href="https://www.instagram.com/its.micki/" target="_blank" rel="noreferrer">INSTAGRAM</a>,
        <span>TIKTOK</span>
      </span>
    </aside>

    <article class="deets-canvas" aria-labelledby="deets-title">
      <h1 class="deets-node deets-title" id="deets-title">
        (Deets, and some cursed<br />stuff about me)
      </h1>

      <p class="deets-node deets-label deets-nutshell-label">In a Nutshell</p>
      <p class="deets-node deets-heading deets-bio">
        <span class="deets-desktop-copy">Hey — I’m micki, a creative director and senior brand + visual designer based in Buenos Aires. Designing professionally since 2016; currently reporting to two insane cats.</span>
        <span class="deets-mobile-copy">Hey — I’m micki, a creative director, designer, and mom of two insane cats. Born and raised in Buenos Aires, Argentina, surviving my late twenties.</span>
      </p>

      <figure class="deets-node deets-image deets-image-one">
        <img src={portrait.src} alt={portrait.alt} width={portrait.width} height={portrait.height} loading="eager" fetchpriority="high" decoding="async" />
      </figure>

      <p class="deets-node deets-label deets-resume-label">Resume</p>
      <a class="deets-node deets-download" href="/Resume/Resume_Micaela%20Galimberti.pdf" download>download (↓)</a>

      <h2 class="deets-node deets-label deets-skills-label">(skills / services)</h2>
      <p class="deets-node deets-heading deets-skills-copy">
        <span class="deets-desktop-copy">Art Direction, Brand Identity Design, Web Design, Product Design, Creative Leadership, Motion Design, Generative AI Art Direction, Illustration, and Image Retouching.</span>
        <span class="deets-mobile-copy">Art Direction, Brand Design, Web Design, Product Design, Management, Motion Design, AI and Illustration.</span>
      </p>

      <figure class="deets-node deets-image deets-image-two">
        <img src={desk.src} alt={desk.alt} width={desk.width} height={desk.height} loading="lazy" decoding="async" />
      </figure>

      <h2 class="deets-node deets-label deets-story-label">(my story)</h2>
      <p class="deets-node deets-body deets-story-one">
        <span class="deets-desktop-copy">Most portfolio intros make everyone sound like a visionary with a caffeine problem, so here’s the less polished version. How did I get here? Let’s rewind. I grew up in my dad’s carpentry shop, where my siblings and I spent our days among design magazines, books, house and furniture sketches, an unreasonable number of Worms matches, decor objects, fabric scraps, and every kind of office stationery.</span>
        <span class="deets-mobile-copy">I apologize in advance for this cheesy and messy intro, but I’m a bit tired of the usual ChatGPT ones. So, how did I get here? Let’s rewind to the beginning. I grew up in my dad’s carpentry shop, where my siblings and I spent our days playing among design mags, house and furniture sketches, countless matches of Worms, decoration items, pieces of fabric, and all kinds of office stationery.</span>
      </p>
      <p class="deets-node deets-body deets-story-two">
        <span class="deets-desktop-copy">From there, the obsession only grew. I decided that when I grew up, I would design magazines and books. I didn’t know this profession had a name until I met Anna, my graphic design teacher, during my final years of high school. Her first assignment? Designing a magazine cover. Obviously.</span>
        <span class="deets-mobile-copy">From then on, I became obsessed with all this stuff, determined that when I grew up, I was going to design magazines and books. Without knowing the name of this incredible profession, I continued my life until I met Anna, my graphic design professor, in my last years of high school. Guess what our first assignment for her class was? Yep, designing a cover for a magazine, lol.</span>
      </p>

      <div class="deets-story-images">
        <figure class="deets-node deets-image deets-image-three">
          <img src={cap.src} alt={cap.alt} width={cap.width} height={cap.height} loading="lazy" decoding="async" />
        </figure>
        <figure class="deets-node deets-image deets-image-four">
          <img src={laptop.src} alt={laptop.alt} width={laptop.width} height={laptop.height} loading="lazy" decoding="async" />
        </figure>
      </div>

      <p class="deets-node deets-body deets-story-three">
        <span class="deets-desktop-copy">That was the beginning of a long, slightly obsessive relationship with design. I knew I had found the field I wanted to stay in, and I haven’t stopped learning, experimenting, or finding new ways to push it since.</span>
        <span class="deets-mobile-copy">Well, I don’t want to bore you with the details of my love relationship with design, but this was the start of my career, and I knew we were meant to be. I’ve never stopped learning and being passionate since then.</span>
      </p>
      <p class="deets-node deets-body deets-story-four">
        <span class="deets-desktop-copy">Since then, I’ve worked across analog craft, print, web and product design—still my favorite territory—as well as illustration, photography, image-making, and motion. I use whichever medium helps an idea become clearer, stranger, or more memorable.</span>
        <span class="deets-mobile-copy">I’ve had the chance to explore all kinds of supports—analog craft, digital to print, and my favorite, web/product design. Occasionally, you can catch me illustrating, taking photos and editing them, or animating when inspiration strikes.</span>
      </p>

      <figure class="deets-node deets-image deets-image-five">
        <img src={shoes.src} alt={shoes.alt} width={shoes.width} height={shoes.height} loading="lazy" decoding="async" />
      </figure>

      <p class="deets-node deets-heading deets-statement">I love to shape brands from start to finish, beginning with their intangible stories and bringing them to life through consistent systems, whether digital or printed.</p>
      <p class="deets-node deets-body deets-close-one">
        <span class="deets-desktop-copy">I’m drawn to experimental design, visual friction, and identities that refuse a single tone. Design isn’t neutral decoration: it carries culture, ideology, and power. At its best, it doesn’t just change how something looks—it changes how it can be read, felt, and remembered.</span>
        <span class="deets-mobile-copy">I’m totally mad about experimental design and not a fan of the idea of being inside a box. I like to think of design as more than just making things look cool—it doesn’t merely transform aesthetics, it reshapes our perspective and the way we experience everything around us.</span>
      </p>
      <p class="deets-node deets-body deets-close-two">
        <span class="deets-desktop-copy">If any of this resonates, say hi. I’m usually somewhere between a Figma file, an unfinished experiment, and two cats with no respect for deadlines ♡*. Email me → <a href="mailto:hey@itsmicki.com">hey@itsmicki.com</a></span>
        <span class="deets-mobile-copy">Feel free to reach out if my story and perspective on design resonate with you ♡*.<br />Email me → <a href="mailto:hey@itsmicki.com">hey@itsmicki.com</a></span>
      </p>
    </article>

    <footer class="deets-footer">
      <div class="deets-footer-wordmark" aria-label="Itsmicki, copyright 2026">
        <span data-footer-reveal>Itsmicki</span>
        <span data-footer-reveal>©2026</span>
      </div>
      <div class="deets-footer-info">
        <span data-footer-reveal style="--reveal-delay:0ms">DEV BY</span>
        <a data-footer-reveal style="--reveal-delay:70ms" href="https://www.instagram.com/luckystoned/" target="_blank" rel="noreferrer">@LUCKYSTONED</a>
        <span data-footer-reveal style="--reveal-delay:140ms">SAY HI</span>
        <a data-footer-reveal style="--reveal-delay:210ms" href="mailto:hey@itsmicki.com">HEY@ITSMICKI.COM</a>
        <span data-footer-reveal style="--reveal-delay:280ms">ALL RIGHTS RESERVED.</span>
        <span class="deets-footer-socials" data-footer-reveal style="--reveal-delay:350ms">
          SOCIALS <a href="https://www.linkedin.com/in/micaelagalimberti/" target="_blank" rel="noreferrer">LINKEDIN</a>,
          <a href="https://www.behance.net/itsmicki" target="_blank" rel="noreferrer">BEHANCE</a>,
          <a href="https://dribbble.com/micaelagalimberti" target="_blank" rel="noreferrer">DRIBBBLE</a>,
          <a href="https://www.instagram.com/its.micki/" target="_blank" rel="noreferrer">INSTAGRAM</a>,
          <span>TIKTOK</span>
        </span>
      </div>
    </footer>
  </div>

  <script>
    /* ============ SMOOTH SCROLL (inercia, mantiene scroll nativo) ============ */
    (function () {
      const RM = matchMedia('(prefers-reduced-motion:reduce)').matches;
      if (RM || !matchMedia('(pointer:fine)').matches) return;

      let tgt = window.scrollY;
      let cur = tgt;
      let run = false;
      let raf: number | null = null;
      let lock = false;
      let last = 0;

      function max() {
        return Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      }

      function loop(now: number) {
        if (!last) last = now;
        const dt = Math.min(64, now - last) / 1000;
        last = now;
        cur += (tgt - cur) * (1 - Math.exp(-6.5 * dt));
        if (Math.abs(tgt - cur) < 0.12) {
          cur = tgt;
          run = false;
          last = 0;
        }
        lock = true;
        window.scrollTo(0, cur);
        lock = false;
        raf = run ? requestAnimationFrame(loop) : null;
      }

      addEventListener('wheel', function (event) {
        if (event.ctrlKey) return;
        event.preventDefault();
        let delta = event.deltaY;
        if (event.deltaMode === 1) delta *= 16;
        else if (event.deltaMode === 2) delta *= window.innerHeight;
        tgt = Math.max(0, Math.min(max(), tgt + delta));
        if (!run) {
          run = true;
          if (!raf) raf = requestAnimationFrame(loop);
        }
      }, { passive: false });

      addEventListener('scroll', function () {
        if (!lock && !run) tgt = cur = window.scrollY;
      });

      addEventListener('resize', function () {
        tgt = cur = window.scrollY;
      });

      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(function (anchor) {
        anchor.addEventListener('click', function (event) {
          const href = anchor.getAttribute('href');
          if (!href || href === '#') return;
          const target = document.querySelector<HTMLElement>(href);
          if (!target) return;
          event.preventDefault();
          tgt = Math.max(0, Math.min(max(), target.getBoundingClientRect().top + window.scrollY));
          if (!run) {
            run = true;
            if (!raf) raf = requestAnimationFrame(loop);
          }
        });
      });
    })();

    const footerReveals = document.querySelectorAll<HTMLElement>('[data-footer-reveal]');
    if (footerReveals.length) {
      const footerObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => entry.target.classList.toggle('is-visible', entry.isIntersecting));
      }, { threshold: .02, rootMargin: '-2% 0px -6% 0px' });
      footerReveals.forEach((node) => footerObserver.observe(node));
    }
  </script>
</BaseLayout>

