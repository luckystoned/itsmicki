    display: block;
    margin-top: 1.5vw;
  }

  .deets-close-two a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: .08em;
  }

  .deets-footer {
    position: absolute;
    top: 298.49vw;
    right: 0;
    left: 0;
    height: 34.965302vw;
    overflow: hidden;
    /* Its box overlaps the end of the closing copy; only its own links take clicks. */
    pointer-events: none;
  }

  .deets-footer a { pointer-events: auto; }

  .deets-footer-wordmark {
    position: absolute;
    top: 0;
    /* Same bleed past the edges as the home wordmark. */
    right: max(-22px, -1.375vw, -2.129719svh);
    left: max(-22.69px, -1.418125vw, -2.196515svh);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    color: var(--deets-ink);
    font-family: 'OT Neue Montreal Deets Extra', Impact, sans-serif;
    font-size: 36.451438vw;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -.04em;
    white-space: nowrap;
  }

