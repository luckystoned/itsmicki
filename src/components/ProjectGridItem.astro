---
import type { Project } from '@/data/projects';
import { imageMetadata } from '@/data/imageMetadata';

type Props = {
  /** A Side A project, or any card with the same few fields (Side B projects have no entry in projects.ts yet). */
  project: Pick<Project, 'slug' | 'title' | 'comingSoon' | 'cover'>;
  label: string;
  style: string;
  eager?: boolean;
  /** Replaces the project's default cover on this grid only. */
  cover?: string;
  /** Muted loop served from the site, over the cover. */
  video?: string;
  /** Case page; defaults to /projects/{slug}. `null` keeps the card without a link. */
  href?: string | null;
};

const { project, label, style, eager = false, cover = project.cover, video } = Astro.props;
const href = project.comingSoon || Astro.props.href === null ? undefined : Astro.props.href ?? `/projects/${project.slug}`;
const dimensions = cover ? imageMetadata[cover] : undefined;

if (!cover || !dimensions) {
  throw new Error(`Missing project cover metadata for ${project.slug}`);
}

---

<article class:list={['project-card', { 'is-coming': project.comingSoon }]} style={style} data-appear>
  {href ? (
    <a class="project-card-inner" data-project-preview="ready" href={href} aria-label={`View ${project.title} case study`}>
      <span class="project-visual" data-parallax>
        <img
          src={cover}
          alt={`${project.title} project cover`}
          width={dimensions.width}
          height={dimensions.height}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
          decoding="async"
        />
        {video && <video src={video} muted loop playsinline disablepictureinpicture preload="none" tabindex="-1" aria-hidden="true" data-autoplay-video></video>}
      </span>
      <span class="project-label">{label}</span>
    </a>
  ) : (
    <div class="project-card-inner" data-project-preview="coming" aria-label={`${project.title}, coming soon`}>
      <span class="project-visual" data-parallax>
        <img
          src={cover}
          alt={`${project.title} project cover`}
          width={dimensions.width}
          height={dimensions.height}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
          decoding="async"
        />
        {video && <video src={video} muted loop playsinline disablepictureinpicture preload="none" tabindex="-1" aria-hidden="true" data-autoplay-video></video>}
      </span>
      <span class="project-label">{label}</span>
    </div>
  )}
</article>
