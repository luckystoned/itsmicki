---
import type { Project } from '@/data/projects';
import { imageMetadata } from '@/data/imageMetadata';

type Props = {
  project: Project;
  label: string;
  style: string;
  eager?: boolean;
  /** Replaces the project's default cover on this grid only. */
  cover?: string;
  /** Vimeo video played muted in a loop over the cover. */
  vimeoId?: string;
};

const { project, label, style, eager = false, cover = project.cover, vimeoId } = Astro.props;
const href = project.comingSoon ? undefined : `/projects/${project.slug}`;
const dimensions = cover ? imageMetadata[cover] : undefined;

if (!cover || !dimensions) {
  throw new Error(`Missing project cover metadata for ${project.slug}`);
}

const videoSrc = vimeoId
  ? `https://player.vimeo.com/video/${vimeoId}?background=1&autoplay=1&loop=1&muted=1&controls=0&quality=1080p&dnt=1`
  : undefined;
---

<article class:list={['project-card', { 'is-coming': project.comingSoon }]} style={style} data-appear data-parallax>
  {href ? (
    <a class="project-card-inner" data-project-preview="ready" href={href} aria-label={`View ${project.title} case study`}>
      <span class="project-visual">
        <img
          src={cover}
          alt={`${project.title} project cover`}
          width={dimensions.width}
          height={dimensions.height}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
          decoding="async"
        />
        {videoSrc && <iframe src={videoSrc} title={`${project.title} project video`} loading="lazy" allow="autoplay; fullscreen; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" tabindex="-1" aria-hidden="true" data-project-video></iframe>}
      </span>
      <span class="project-label">{label}</span>
    </a>
  ) : (
    <div class="project-card-inner" data-project-preview="coming" aria-label={`${project.title}, coming soon`}>
      <span class="project-visual">
        <img
          src={cover}
          alt={`${project.title} project cover`}
          width={dimensions.width}
          height={dimensions.height}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
          decoding="async"
        />
        {videoSrc && <iframe src={videoSrc} title={`${project.title} project video`} loading="lazy" allow="autoplay; fullscreen; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" tabindex="-1" aria-hidden="true" data-project-video></iframe>}
      </span>
      <span class="project-label">{label}</span>
    </div>
  )}
</article>
