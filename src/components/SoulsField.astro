      // from the elbow in her skin, rebuilt on her grid.
      const limb = (length: number, from: number, to: number, colour: string, hand: boolean, sleeve: boolean): Limb => {
        const lp = .08 * u, form = canvasOf((lp * 2 + from * 3.2) * ratio, (length + lp * 2 + (hand ? .07 * u : 0)) * ratio), a = form.getContext('2d')!;
