          d.globalCompositeOperation = 'destination-out';
          const fade = d.createLinearGradient(0, 0, 0, y0 + length * .35);
          fade.addColorStop(0, 'rgba(0, 0, 0, 1)'); fade.addColorStop(.5, 'rgba(0, 0, 0, .45)'); fade.addColorStop(1, 'rgba(0, 0, 0, 0)');
          d.fillStyle = fade; d.fillRect(0, 0, form.width, y0 + length * .35);
