        const dt = soul.drawn ? Math.min(.1, (now - soul.drawn) / 1000) : 0;
        soul.drawn = now;
        const p = soul.actEnd > soul.actStart ? Math.min(1, (now - soul.actStart) / (soul.actEnd - soul.actStart)) : 1;
        if (soul.act === 'walk') { soul.x = soul.fromX + (soul.toX - soul.fromX) * ease(p); soul.y = soul.fromY + (soul.toY - soul.fromY) * ease(p); }
        const unit = unitAt(soul), paintUnit = Math.round(height * PAINT_AT * kindScale(soul.look));
        if (!soul.figure || soul.figure.unit !== paintUnit) soul.figure = paintFigure(soul, paintUnit);
        const figure = soul.figure, k = unit / figure.unit;
        // Its pose for what it is doing, eased in and out so one thing flows into the next.
        const into = ease(Math.min(1, (now - soul.actStart) / 700)) * ease(Math.min(1, Math.max(0, (soul.actEnd - now) / 700)));
        const breath = Math.sin(t * 1.5 + soul.phase);
