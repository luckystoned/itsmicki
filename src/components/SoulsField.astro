      context.globalCompositeOperation = 'source-over';
    };

    // Which soul's name shows, and until when.
    const nameShown = { id: '', until: 0 };
    const nearest = (event: PointerEvent) => {
      const rect = canvas.getBoundingClientRect(), x = event.clientX - rect.left, y = event.clientY - rect.top;
      let best: Soul | null = null, bestDistance = Infinity;
      for (const soul of souls) {
        const unit = unitAt(soul), dx = x - soul.x * width, dy = y - (soul.y * height - unit * .45);
        const distance = Math.hypot(dx, dy * 1.4);
