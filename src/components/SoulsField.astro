        reachUpper: limb(UPPER * u, .028 * u, .019 * u, ['#3a338c', '#4a3d9e'], false, true),
        reachLower: limb(FOREARM * u, .019 * u, .013 * u, ['#4a3d9e', '#7f78d8', '#b0a6f2'], true, false),
        restUpper: limb(UPPER * u, .028 * u, .019 * u, ['#3a338c', '#4a3d9e'], false, true),
