      }
      item.append(figure);
      // The second pass that lets the strip loop: seen, but not read out or reached twice by keyboard.
      if (copy) { item.setAttribute('aria-hidden', 'true'); item.inert = true; }
      return item;
    };
    // Who's here runs as a strip, drifting on its own and looping (held still while hovered, touched or focused, and
    // with reduced motion); it can be scrolled by hand too.
    let drift = 0, driftPos = 0, driftHeld = false, driftLast = 0, loopWidth = 0, listDrawn = 0;
    const DRIFT_SPEED = 32; // px per second
    const driftFrame = (time: number) => {
      if (!listGrid || !listDialog?.open || !loopWidth) { drift = 0; return; }
      const dt = Math.min(.05, (time - (driftLast || time)) / 1000); driftLast = time;
      if (!driftHeld) {
        driftPos += DRIFT_SPEED * dt;
        if (driftPos >= loopWidth) driftPos -= loopWidth;
        listGrid.scrollLeft = driftPos;
      }
      drift = requestAnimationFrame(driftFrame);
    };
    const renderList = () => {
      if (!listGrid) return;
      const order = [...souls].reverse();
      listGrid.replaceChildren(...order.map((soul) => listItem(soul)));
      if (listEmpty) listEmpty.hidden = souls.length > 0;
      loopWidth = 0; listGrid.scrollLeft = driftPos = 0;
      // Measured once the photos are in (each sets its card's width).
      const drawn = ++listDrawn;
      Promise.all([...listGrid.querySelectorAll('img')].map((img) => img.decode().catch(() => undefined))).then(() => {
        if (drawn !== listDrawn) return;
        // Only when they don't all fit: a copy of the strip after it, so it can wrap around without a jump.
        if (calm || !listDialog?.open || listGrid.scrollWidth <= listGrid.clientWidth + 4) return;
        const first = listGrid.firstElementChild as HTMLElement;
        listGrid.append(...order.map((soul) => listItem(soul, true)));
        loopWidth = (listGrid.children[order.length] as HTMLElement).offsetLeft - first.offsetLeft;
        driftLast = 0;
        if (!drift) drift = requestAnimationFrame(driftFrame);
      });
    };
    if (listGrid) {
      const hold = () => { driftHeld = true; };
      const release = () => { driftHeld = false; driftPos = listGrid.scrollLeft; driftLast = 0; };
      listGrid.addEventListener('pointerenter', hold); listGrid.addEventListener('pointerleave', release);
      listGrid.addEventListener('focusin', hold); listGrid.addEventListener('focusout', release);
      listGrid.addEventListener('touchstart', hold, { passive: true }); listGrid.addEventListener('touchend', () => setTimeout(release, 1500), { passive: true });
      // Scrolled by hand past either end of the first pass: the same spot on the other, so it keeps looping.
      listGrid.addEventListener('scroll', () => {
        if (!driftHeld || !loopWidth) return;
        if (listGrid.scrollLeft >= loopWidth) listGrid.scrollLeft -= loopWidth;
        else if (listGrid.scrollLeft <= 0) listGrid.scrollLeft += loopWidth;
      }, { passive: true });
      // A mouse wheel moves it sideways too, without reaching for a scrollbar.
      listGrid.addEventListener('wheel', (event) => {
        if (listGrid.scrollWidth <= listGrid.clientWidth) return;
        const delta = Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.deltaY;
        if (!delta) return;
        event.preventDefault();
        driftHeld = true;
        listGrid.scrollLeft += event.deltaMode === 1 ? delta * 32 : delta;
      }, { passive: false });
      // And it can be dragged with the mouse (fingers already scroll it); a drag doesn't count as a click on a button.
      let dragX = -1, dragFrom = 0, dragged = false;
      listGrid.addEventListener('pointerdown', (event) => {
        if (event.pointerType !== 'mouse' || event.button !== 0) return;
        dragX = event.clientX; dragFrom = listGrid.scrollLeft; dragged = false; driftHeld = true;
      });
      addEventListener('pointermove', (event) => {
        if (dragX < 0) return;
        const moved = event.clientX - dragX;
        if (Math.abs(moved) > 4) { dragged = true; listGrid.classList.add('is-dragging'); }
        if (dragged) listGrid.scrollLeft = dragFrom - moved;
      });
      addEventListener('pointerup', () => { if (dragX < 0) return; dragX = -1; listGrid.classList.remove('is-dragging'); if (!listGrid.matches(':hover')) release(); });
      listGrid.addEventListener('click', (event) => { if (dragged) { event.preventDefault(); event.stopPropagation(); dragged = false; } }, true);
      listGrid.addEventListener('dragstart', (event) => event.preventDefault());
    }
    caption.querySelector<HTMLButtonElement>('[data-souls-list]')?.addEventListener('click', () => {
      if (!listDialog || !listGrid) return;
      listDialog.showModal();
      renderList();
    });
    const reopen = () => { if (addButton) { addButton.disabled = full(); addButton.toggleAttribute('aria-disabled', full()); } };

    // Changing one of theirs: the same form, filled in; its new look replaces the old one (same photo, same place).
    const change = async (soul: Soul) => {
      listDialog?.close();
      const look = await askAbout({ kind: soul.look.kind, pattern: soul.look.pattern, colours: soul.look.colours }, soul.look);
      if (!look) { listDialog?.showModal(); return; }
      const code = lookCode(look), before = soul.id;
      let id = `souls/${stemOf(before)}_${code}`;
      if (isLocal(soul)) keepLocalList(localSouls().map((entry) => (entry.id === before ? { ...entry, id } : entry)));
      else {
        const response = await fetch('/api/souls', { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: before, key: keys()[stemOf(before)], look: code }) }).catch(() => null);
        if (!response?.ok) { setStatus(response?.status === 403 ? 'Only whoever left them can change them.' : 'I couldn’t save that. Try again in a moment.'); return; }
        ({ id } = (await response.json()) as { id: string });
        // Shown under its new id right away; the old one stays hidden until the shared list catches up.
        if (id !== before) { forget(before); unmine(before); rememberMine({ id, photo: soul.photo }); }
      }
      soul.id = id; soul.look = look; soul.figure = undefined;
      if (calm) draw(0);
      setStatus(`${look.name ?? 'They'}: saved.`);
      listDialog?.showModal(); renderList();
    };
    // Taking one of theirs out, after asking.
    const takeOut = async (soul: Soul) => {
      const name = soul.look.name ?? (soul.look.kind === 'cat' ? 'this cat' : 'this dog');
      if (!confirm(`Take ${name} out of her care? Their photo will be deleted.`)) return;
      if (isLocal(soul)) keepLocalList(localSouls().filter((entry) => entry.id !== soul.id));
      else {
        const response = await fetch('/api/souls', { method: 'DELETE', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: soul.id, key: keys()[stemOf(soul.id)] }) }).catch(() => null);
        if (!response?.ok && response?.status !== 404) { setStatus(response?.status === 403 ? 'Only whoever left them can take them out.' : 'I couldn’t take them out. Try again in a moment.'); return; }
        forget(soul.id); unmine(soul.id); setKey(soul.id);
      }
      souls = souls.filter((other) => other !== soul);
      if (calm) draw(0);
      setStatus(`${name[0].toUpperCase()}${name.slice(1)} is no longer in her care.`);
      renderList(); reopen();
    };

    // Adding a pet.
    addButton?.addEventListener('click', () => {
      setStatus('Choose a photo of your cat or dog where their face shows, without people. It will be shown in the list of who’s here, cropped around your pet.');
      input?.click();
    });
    input?.addEventListener('change', async () => {
      const file = input.files?.[0];
      input.value = '';
      if (!file) return;
      if (full()) { showFull(); return; }
      if (addButton) addButton.disabled = true;
      setStatus('Looking for your pet…');
      try {
        const found = await readPet(file);
        if (found === 'none') { setStatus('Something went wrong reading that photo. Try another one.'); return; }
        if (found === 'people') { setStatus('Just your pet, please: a photo without people in it (it will be shown in the list).'); return; }
        setStatus(found.guessed ? 'I couldn’t read them from the photo: pick their colours and coat in the form.' : '');
        // Their words win over the photo where they say something (the form reads them as they type).
        const look = await askAbout(found);
        if (!look) { setStatus('Whenever you’re ready.'); return; }
        const code = lookCode(look);
        let id = `souls/local-${Date.now().toString(36)}_${code}`, photo = found.photo;
        setStatus('Bringing them over…');
        if (shared) {
          const response = await fetch('/api/souls', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ look: code, photo }) }).catch(() => null);
          if (response?.status === 409) { cap = souls.length; showFull(); return; }
          if (response?.ok) { let key: string; ({ id, photo, key } = (await response.json()) as { id: string; photo: string; key: string }); rememberMine({ id, photo }); setKey(id, key); }
          else { shared = false; keepLocally({ id, photo }); }
        } else keepLocally({ id, photo });
        // A newcomer is welcomed under her hand, and she strokes it for a few seconds before it goes to its place.
        const newcomer = meet(id, look, souls.length, performance.now());
        stroke(newcomer, -1, performance.now());
        newcomer.photo = photo;
        souls.push(newcomer);
        if (calm) draw(0);
        setStatus(shared ? 'Welcome. They’re in good company now, for good.' : 'Welcome. They’re in good company now (kept on this device).');
        showFull();
      } catch {
        setStatus('Something went wrong reading that photo. Try another one.');
      } finally {
        if (addButton) addButton.disabled = full();
      }
    });
  });
</script>

<style>
