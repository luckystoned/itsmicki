        }
      });
    };
    layout();
    // How big a soul is where it stands: smaller far away (up near the horizon), larger up close; and by its kind/size.
    const kindScale = (look: Look) => SETTINGS.scale[look.kind][look.size];
    const unitAt = (soul: Soul) => soul.act === 'held' && soul.heldUnit ? soul.heldUnit : height * (.11 + Math.min(1, Math.max(0, (soul.y - SETTINGS.horizon) / (1 - SETTINGS.horizon))) * .2) * kindScale(soul.look);
    const PAINT_AT = .32; // Figures are painted at the largest size they can have (share of the height), then drawn smaller.

    const meet = (id: string, look: Look, index: number, born: number): Soul => {
      const home = homes[index % homes.length], h = hash(id);
      return { id, look, born, hx: home.x, hy: home.y, x: home.x, y: home.y, fromX: home.x, fromY: home.y, toX: home.x, toY: home.y, act: 'sit', actStart: 0, actEnd: 0, face: home.x < .5 ? 1 : -1, faceShown: home.x < .5 ? 1 : -1, blink: 0, phase: (h % 1000) / 1000 * 6.28, drawn: 0 };
    };

    /** What a soul does next. */
    const decide = (soul: Soul, now: number) => {
