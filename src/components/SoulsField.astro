      aura.addColorStop(0, `rgba(255, 236, 205, ${.55 + .08 * Math.sin(t * .7)})`); aura.addColorStop(1, 'rgba(255, 236, 205, 0)');
      context.fillStyle = aura; context.fillRect(0, 0, width, height);

