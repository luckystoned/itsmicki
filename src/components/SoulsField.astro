      if (held && event.pointerId === held.id) {
        const { x, y } = local(event), now = performance.now(), dt = Math.max(.008, (now - held.lastT) / 1000);
        const vx = (x - held.lastX) / dt;
        held.ax = (vx - held.vx) / dt; held.vx = vx; held.lastX = x; held.lastT = now;
        const soul = held.soul, feet = Math.min(height * .99, y + held.offY);
        soul.x = Math.min(.97, Math.max(.03, (x + held.offX) / width));
        soul.air = feet;
        // The ground under it, for its size and for where it lands.
        soul.y = Math.min(.98, Math.max(SETTINGS.horizon + .05, feet / height));
        nameShown.id = soul.id; nameShown.until = now + 900;
        return;
      }
      const soul = nearest(event);
      grabbable(!!soul);
      if (soul) { nameShown.id = soul.id; nameShown.until = performance.now() + 900; }
    });
    const release = (event: PointerEvent) => {
      if (!held || event.pointerId !== held.id) return;
      held.soul.act = 'fall'; held.soul.airV = 0; held.soul.actEnd = Infinity;
      held = null;
      root.removeAttribute('data-grab-active');
      document.dispatchEvent(new Event('project-preview-refresh'));
    };
    root.addEventListener('pointerup', release);
    root.addEventListener('pointercancel', release);
    root.addEventListener('pointerleave', () => grabbable(false));
    // A finger on an animal picks it up instead of scrolling the page.
    root.addEventListener('touchstart', (event) => { const touch = event.touches[0]; if (touch && nearest(touch as unknown as PointerEvent)) event.preventDefault(); }, { passive: false });

    let visible = false, running = false;
    const frame = (time: number) => {
      if (!visible) { running = false; return; }
      draw(time);
      requestAnimationFrame(frame);
    };
    const start = () => { if (!running && visible && !calm) { running = true; requestAnimationFrame(frame); } else if (calm) draw(0); };
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; if (visible) start(); }, { rootMargin: '10%' }).observe(root);
    new ResizeObserver(() => { resize(); draw(performance.now()); }).observe(root);

    const full = () => souls.length >= cap;
    // Full: no more adding (the list stays open to see who's here).
    const showFull = () => { if (full()) { if (addButton) { addButton.disabled = true; addButton.setAttribute('aria-disabled', 'true'); } setStatus('The place is full now. Every soul has company.'); } };

    // The souls already here.
    const load = async () => {
      let entries: Entry[] = [];
      try {
        const response = await fetch('/api/souls', { headers: { accept: 'application/json' } });
        if (!response.ok || !(response.headers.get('content-type') ?? '').includes('json')) throw new Error('No shared place');
        const data = await response.json() as { souls: Entry[]; cap: number };
        entries = data.souls; cap = data.cap;
      } catch {
        shared = false;
        entries = localSouls();
      }
      souls = entries.map((entry) => ({ ...entry, look: readLook(entry.id) })).filter((entry): entry is Entry & { look: Look } => !!entry.look).map(({ id, look, photo }, i) => ({ ...meet(id, look, i, 0), photo }));
      draw(performance.now());
      showFull();
    };
    load();

    // Who they are: name, cat or dog, a few words about the coat, and size (a photo can't tell size).
    const dialog = root.querySelector<HTMLDialogElement>('[data-souls-dialog]');
    // A live preview of them in the form, redrawn as the answers change.
    const preview = root.querySelector<HTMLCanvasElement>('[data-souls-preview]');
    const lookFromForm = (form: HTMLFormElement, found: Omit<Look, 'size' | 'build'>): Look => {
      const data = new FormData(form), coat = coatFrom(String(data.get('coat') ?? ''));
      return {
        kind: data.get('kind') === 'dog' ? 'dog' : 'cat', size: Number(data.get('size') ?? 1) as 0 | 1 | 2, build: Number(data.get('build') ?? 4),
        pattern: coat.pattern ?? found.pattern, colours: coat.colours ?? found.colours,
        name: String(data.get('name') ?? '').trim().slice(0, 20), owner: String(data.get('owner') ?? '').trim().slice(0, 20),
      };
    };
    const drawPreview = (look: Look) => {
      if (!preview) return;
      const w = preview.clientWidth || 300, h = preview.clientHeight || 150;
      preview.width = Math.round(w * ratio); preview.height = Math.round(h * ratio);
      const g = preview.getContext('2d')!, unit = h * 1.12 * SETTINGS.scale[look.kind][look.size] / SETTINGS.scale.dog[2];
      const figure = paintFigure({ id: 'preview', look } as Soul, Math.round(unit));
      g.setTransform(ratio, 0, 0, ratio, 0, 0);
      g.translate(w / 2 - unit * .05, h * .94);
      figure.legs.filter((leg) => !leg.near).forEach((leg) => g.drawImage(leg.canvas, leg.x - leg.pivotX, leg.y - leg.pivotY, leg.w, leg.h));
      g.drawImage(figure.body.canvas, figure.body.x, figure.body.y, figure.body.w, figure.body.h);
      figure.legs.filter((leg) => leg.near).forEach((leg) => g.drawImage(leg.canvas, leg.x - leg.pivotX, leg.y - leg.pivotY, leg.w, leg.h));
      for (const eye of figure.eyes) drawEye(g, eye.x, eye.y, figure.eyeR);
    };
    const askAbout = (found: Omit<Look, 'size' | 'build'>) => new Promise<Look | null>((resolve) => {
      const form = dialog?.querySelector('form');
      if (!dialog || !form) { resolve({ ...found, size: 1, build: 4 }); return; }
      form.reset();
      form.querySelector<HTMLInputElement>(`input[name="kind"][value="${found.kind}"]`)!.checked = true;
      const update = () => drawPreview(lookFromForm(form, found));
      form.addEventListener('input', update);
      requestAnimationFrame(update);
      dialog.addEventListener('close', () => {
        form.removeEventListener('input', update);
        resolve(dialog.returnValue === 'ok' ? lookFromForm(form, found) : null);
      }, { once: true });
      dialog.showModal();
      update();
    });
    // Who's here: their photos, as they are, newest first, with their names and who left them.
    const listDialog = root.querySelector<HTMLDialogElement>('[data-souls-list-dialog]');
    const listGrid = root.querySelector<HTMLElement>('[data-souls-list-grid]');
    const listEmpty = root.querySelector<HTMLElement>('[data-souls-list-empty]');
    caption.querySelector<HTMLButtonElement>('[data-souls-list]')?.addEventListener('click', () => {
      if (!listDialog || !listGrid) return;
      listGrid.replaceChildren(...[...souls].reverse().map((soul) => {
        const item = document.createElement('li'), figure = document.createElement('figure'), label = document.createElement('figcaption');
        if (soul.photo) {
          const img = document.createElement('img');
          img.src = soul.photo; img.alt = `${soul.look.name ?? 'A'} ${soul.look.kind}`; img.loading = 'lazy'; img.decoding = 'async';
          figure.append(img);
        } else {
          const none = document.createElement('div'); none.className = 'souls-list-nophoto';
          none.style.background = `linear-gradient(160deg, ${soul.look.colours[0]}, ${soul.look.colours[1]} 55%, ${soul.look.colours[2]})`;
          figure.append(none);
        }
        const name = document.createElement('strong'); name.textContent = soul.look.name ?? (soul.look.kind === 'cat' ? 'A cat' : 'A dog');
        label.append(name);
        if (soul.look.owner) { const by = document.createElement('span'); by.textContent = `left by ${soul.look.owner}`; label.append(' ', by); }
        figure.append(label); item.append(figure);
        return item;
      }));
      if (listEmpty) listEmpty.hidden = souls.length > 0;
      listDialog.showModal();
    });

    // Adding a pet.
    addButton?.addEventListener('click', () => {
      setStatus('Choose a photo of your whole cat or dog, from ears to paws, without people. It will be shown in the list of who’s here, cropped around your pet.');
      input?.click();
    });
    input?.addEventListener('change', async () => {
      const file = input.files?.[0];
      input.value = '';
      if (!file) return;
      if (full()) { showFull(); return; }
      if (addButton) addButton.disabled = true;
      setStatus('Looking for your pet…');
      try {
        const found = await readPet(file);
        if (found === 'none') { setStatus('I couldn’t find a cat or a dog in that photo. Try another one.'); return; }
        if (found === 'cut') { setStatus('Only whole bodies, please: a photo where all of your pet fits, from ears to paws, with a little room around.'); return; }
        if (found === 'people') { setStatus('Just your pet, please: a photo without people in it (it will be shown in the list).'); return; }
        setStatus('');
        // Their words win over the photo where they say something (the form reads them as they type).
        const look = await askAbout(found);
        if (!look) { setStatus('Whenever you’re ready.'); return; }
        const code = lookCode(look);
        let id = `souls/local-${Date.now().toString(36)}_${code}`, photo = found.photo;
        setStatus('Bringing them over…');
        if (shared) {
          const response = await fetch('/api/souls', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ look: code, photo }) }).catch(() => null);
          if (response?.status === 409) { cap = souls.length; showFull(); return; }
          if (response?.ok) ({ id, photo } = (await response.json()) as { id: string; photo: string });
          else { shared = false; keepLocally({ id, photo }); }
        } else keepLocally({ id, photo });
        // A newcomer is welcomed under her hand, and she strokes it for a few seconds before it goes to its place.
        const newcomer = meet(id, look, souls.length, performance.now());
        const hand = handAt();
        newcomer.x = newcomer.fromX = newcomer.toX = Math.max(.06, hand.x - .03);
        // Standing where its head comes up to her hand (bigger animals stand a little further down).
        let y = hand.y + .2;
        for (let i = 0; i < 4; i++) { newcomer.y = y; y = hand.y + unitAt(newcomer) * .85 / height; }
        newcomer.y = newcomer.fromY = newcomer.toY = Math.min(.97, y);
        newcomer.face = newcomer.faceShown = 1;
        newcomer.act = 'pet'; newcomer.actStart = performance.now(); newcomer.actEnd = newcomer.actStart + 5000;
        newcomer.photo = photo;
        petting = newcomer.actEnd;
        souls.push(newcomer);
        if (calm) draw(0);
        setStatus(shared ? 'Welcome. They’re in good company now, for good.' : 'Welcome. They’re in good company now (kept on this device).');
        showFull();
      } catch {
        setStatus('Something went wrong reading that photo. Try another one.');
      } finally {
        if (addButton) addButton.disabled = full();
      }
    });
  });
</script>

