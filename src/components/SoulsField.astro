        d.globalAlpha = .35; d.drawImage(soften(form, 10), 0, 0, form.width, form.height);
        d.globalAlpha = .95; d.drawImage(soften(form, 2.6), 0, 0, form.width, form.height);
        d.globalCompositeOperation = 'source-in';
