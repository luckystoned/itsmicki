    }
    fine = counted ? fine / counted : 0;
    const pattern: 0 | 1 | 2 = contrast < 50 ? 0 : fine / contrast > .14 ? 1 : 2;
    return { kind: dogs > cats ? 'dog' : 'cat', pattern, colours, photo: keptPhoto };
  };

  document.querySelectorAll<HTMLElement>('[data-souls-field]').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('.souls-field-canvas')!;
    const context = canvas.getContext('2d')!;
    const caption = root.closest('section') ?? document;
    const addButton = caption.querySelector<HTMLButtonElement>('[data-souls-add]');
    const input = caption.querySelector<HTMLInputElement>('[data-souls-input]');
    const status = caption.querySelector<HTMLElement>('[data-souls-status]');
    const setStatus = (text: string) => { if (status) { status.textContent = text; status.hidden = !text; } };

    let width = 0, height = 0, ratio = 1;
    // The size everything is drawn to: the height in a landscape frame; in a tall one (a phone), a share of the width, so
    // the caregiver and the animals keep their proportions and the extra height becomes sky and ground.
    let base = 0;
    const K = () => KEEPER * base / Math.max(1, height); // Her height, as a share of the frame's.
    let souls: Soul[] = [];
    let cap = SETTINGS.cap;
    let shared = true; // False when the shared place cannot be reached: souls are kept on this device.

    // Film grain: a noise tile, shifted every few frames so it lives.
    const grain = canvasOf(160, 160);
    {
      const g = grain.getContext('2d')!, img = g.createImageData(160, 160);
      for (let i = 0; i < img.data.length; i += 4) { const v = Math.random() < .03 ? 255 : Math.random() * 200; img.data[i] = img.data[i + 1] = img.data[i + 2] = v; img.data[i + 3] = 255; }
      g.putImageData(img, 0, 0);
    }

    /** A pet built cell by cell, like the animals of the references, facing right: a long block for the body, a square
        head on its front end with one-cell ears (or a dark floppy ear, and a snout, for a dog), a tail standing up from
        its back and four legs a cell wide, on their own so they can walk and fold. In the palette colours nearest its
        own, its coat and markings painted on the cells; about eleven cells from its feet to the tips of its ears. */
    const paintFigure = (soul: Soul, unit: number): Figure => {
      const { look } = soul, dog = look.kind === 'dog';
      const marks = look.marks ?? 0, has = (mark: keyof typeof MARKS) => (marks & MARKS[mark]) !== 0;
      const floppy = dog && !has('pointedEars');
      let n = hash(soul.id) || 1;
      const random = () => { n = (n * 16807) % 2147483647; return (n - 1) / 2147483646; };
      const [light, mid, dark] = coatColours(look), colours = [mid, light, dark, SETTINGS.colours.pink];
      const MID = 0, LIGHT = 1, DARK = 2, PINK = 3;
      const cell = unit / 11, cellPx = cell * ratio;
      // Proportions, in cells: small dogs stand low, big ones tall; chubby ones are deeper, thin ones shallower.
      const legLen = dog ? [2, 3, 4][look.size] : 3;
      const bodyH = look.build <= 2 ? 2 : look.build >= 7 ? 4 : 3;
      const bodyLen = (dog ? [7, 8, 9][look.size] : 7) + (random() < .5 ? 0 : 1);
      const headH = 4, snout = dog ? 2 : 0;
      const hx0 = bodyLen - 3, hx1 = bodyLen; // The head's columns (it overhangs the chest by one).
      const gw = hx1 + 1 + snout, gh = headH + bodyH; // Row 0 is for the ears; the body's top row is the head's last.
      const grid = gridOf(gw, gh);
      const set = (i: number, j: number, c: number) => { if (i >= 0 && j >= 0 && i < gw && j < gh) grid.cells[j * gw + i] = c; };
      const get = (i: number, j: number) => (i >= 0 && j >= 0 && i < gw && j < gh ? grid.cells[j * gw + i] : -1);
      for (let j = headH; j < gh; j++) for (let i = 0; i < bodyLen; i++) set(i, j, MID); // Body
      for (let j = 1; j <= headH; j++) for (let i = hx0; i <= hx1; i++) set(i, j, MID); // Head
      if (dog) { set(hx1 + 1, 2, MID); set(hx1 + 2, 2, DARK); set(hx1 + 1, 3, MID); set(hx1 + 2, 3, MID); } // Snout, nose at its tip
