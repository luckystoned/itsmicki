  .souls-form-choice legend { width: 100%; margin-bottom: 6px; padding: 0; font-size: 13px; }
  .souls-form-choice label { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; }
  .souls-form-choice input { accent-color: #fafafa; }
  .souls-form-actions { display: flex; justify-content: space-between; gap: 12px; margin-top: 4px; }
  .souls-form-actions button { padding: 0; border: 0; background: none; color: inherit; font: inherit; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .souls-list { width: min(980px, calc(100vw - 32px)); max-height: min(86vh, 900px); }
  .souls-list-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding: 22px 22px 0; }
  .souls-list-close { padding: 0; border: 0; background: none; color: inherit; font: inherit; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .souls-list-empty { margin: 16px 22px 22px; }
  /* A horizontal strip: every photo the same height, its own width; the caption fits under it. */
  .souls-list-grid { display: flex; gap: 14px; margin: 0; padding: 16px 22px 22px; overflow-x: auto; list-style: none; scrollbar-width: none; overscroll-behavior-x: contain; }
  .souls-list-grid::-webkit-scrollbar { display: none; }
  .souls-list-grid.is-dragging { cursor: grabbing; user-select: none; }
  .souls-list-grid :global(li) { flex: none; }
  .souls-list-grid :global(figure) { width: min-content; margin: 0; }
  .souls-list-grid :global(img) { display: block; width: auto; max-width: none; height: min(320px, 46vh); border-radius: 8px; }
  .souls-list-grid :global(.souls-list-nophoto) { height: min(320px, 46vh); aspect-ratio: 4 / 5; border-radius: 8px; filter: blur(.5px); }
  .souls-list-grid :global(figcaption) { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 10px; margin-top: 6px; font-size: 14px; line-height: 1.2; }
  .souls-list-grid :global(figcaption strong) { font-weight: 400; }
  .souls-list-grid :global(figcaption span) { opacity: .6; }
  .souls-list-grid :global(.souls-list-actions) { display: flex; gap: 14px; margin: 4px 0 0; font-size: 13px; }
  .souls-list-grid :global(.souls-list-action) { padding: 0; border: 0; background: none; color: inherit; font: inherit; text-decoration: underline; text-underline-offset: 3px; opacity: .8; cursor: pointer; }
  .souls-list-grid :global(.souls-list-action:is(:hover, :focus-visible)) { opacity: 1; }
  .souls-form-ok { padding: 6px 12px !important; background: #fafafa !important; color: #202020 !important; text-decoration: none !important; border-radius: 4px !important; }
</style>
