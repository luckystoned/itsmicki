      const bodyLength = (dog ? .64 : .56) * (.95 + random() * .1) * (.94 + build * .06), bodyDepth = (dog ? .34 : .32) * (.94 + random() * .12) * build;
      const bodyCx = .56, bodyCy = legTop - bodyDepth * .28;
