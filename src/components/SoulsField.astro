---
// Missing souls: a place drawn like a printed textile (dark brown ground, lime, pink, warm greys, rust, caramel and khaki; every
// shape built from grid cells with rounded corners, round holes for eyes, cross-shaped flowers swaying) where a
// caregiver looks after the animals people leave with her. Anyone can add their cat or dog from a photo where its face shows. The photo is read on
// their device (MediaPipe finds the animal, reads its colours and markings, and turns down photos full of people), then
// a little form asks its name, its owner's, cat or dog, a few words about its coat (which win over the photo), how thin
// or chubby it is (a slider, with a live preview) and its size. In the place it becomes a blocky cat or dog in the palette
// colours nearest its own, its name shown near it on hover; its
// photo, cropped around it and re-drawn (no location or camera details), is kept for the list of who's here. Once here,
// it lives its own little life: it stands, walks about on its paws, hops, stretches, grooms, lies down to nap and blinks;
// a newcomer is first stroked by the caregiver, and anyone can pick one up (legs dangling) and set it down elsewhere.
// The souls are shared by every visitor (api/souls.ts, Vercel Blob) and stay until the place is full; whoever left one
// can change its details or take it out again from the list (their browser keeps the key it was left with). Without
// the shared store (local dev, or before it is connected) they are kept on the visitor's device. With reduced motion
// nothing moves.
type Props = { label: string };
const { label } = Astro.props;
---

<div class="souls-field" data-souls-field>
  <canvas class="souls-field-canvas" role="img" aria-label={label}></canvas>
  <!-- Who they are: asked once the photo is read. The colours and coat start as read from the photo and can be changed;
       the details are drawn on them (a patch over an eye, white paws…). -->
  <dialog class="souls-dialog" data-souls-dialog aria-labelledby="souls-dialog-title">
    <form method="dialog" class="souls-form">
      <p class="souls-form-title" id="souls-dialog-title">Who are you leaving in her care?</p>
      <label class="souls-form-field">Their name <input name="name" maxlength="20" autocomplete="off" required /></label>
      <label class="souls-form-field">Your name <input name="owner" maxlength="20" autocomplete="name" required /></label>
      <fieldset class="souls-form-choice">
        <legend>Cat or dog</legend>
        <label><input type="radio" name="kind" value="cat" /> cat</label>
        <label><input type="radio" name="kind" value="dog" /> dog</label>
      </fieldset>
      <fieldset class="souls-form-choice" data-souls-ears>
        <legend>Ears</legend>
        <label><input type="radio" name="ears" value="floppy" checked /> floppy</label>
        <label><input type="radio" name="ears" value="pointed" /> pointed</label>
      </fieldset>
      <fieldset class="souls-form-choice souls-form-colours">
        <legend>Their colours</legend>
        <label><input type="color" name="c0" value="#f2e6d6" /> light</label>
        <label><input type="color" name="c1" value="#b39780" /> middle</label>
        <label><input type="color" name="c2" value="#5c483c" /> dark</label>
      </fieldset>
      <fieldset class="souls-form-choice">
        <legend>Coat</legend>
        <label><input type="radio" name="pattern" value="0" checked /> plain</label>
        <label><input type="radio" name="pattern" value="1" /> tabby</label>
        <label><input type="radio" name="pattern" value="2" /> patches</label>
        <label><input type="radio" name="pattern" value="3" /> tortoiseshell</label>
      </fieldset>
      <label class="souls-form-field">Details <input name="details" maxlength="120" autocomplete="off" placeholder="e.g. a patch over one eye, white paws, dark ears" /></label>
      <label class="souls-form-field souls-form-build">Build <span><small>thin</small><input type="range" name="build" min="0" max="9" step="1" value="4" /><small>chubby</small></span></label>
      <canvas class="souls-form-preview" data-souls-preview aria-hidden="true"></canvas>
      <fieldset class="souls-form-choice">
        <legend>Size</legend>
        <label><input type="radio" name="size" value="0" /> small</label>
        <label><input type="radio" name="size" value="1" checked /> medium</label>
        <label><input type="radio" name="size" value="2" /> big</label>
      </fieldset>
      <div class="souls-form-actions">
        <button type="submit" value="cancel" formnovalidate>cancel</button>
        <button type="submit" value="ok" class="souls-form-ok">leave them with her</button>
      </div>
    </form>
  </dialog>
  <!-- Who's here: every soul's own photo, as it was, with their name and who left them. -->
  <dialog class="souls-dialog souls-list" data-souls-list-dialog aria-labelledby="souls-list-title">
    <div class="souls-list-head">
      <p class="souls-form-title" id="souls-list-title">Who’s here</p>
      <form method="dialog"><button type="submit" class="souls-list-close">close</button></form>
    </div>
    <p class="souls-list-empty" data-souls-list-empty>No one yet. Be the first to leave someone in her care.</p>
    <ul class="souls-list-grid" data-souls-list-grid></ul>
  </dialog>
</div>

<script>
  import { loadVision } from '@/scripts/camera';

  const SETTINGS = {
    cap: 42, // Souls the place holds (the server has the final word).
    minPet: .005, // Share of the photo the animal has to cover to count as found (its face is enough).
    model: 'https://storage.googleapis.com/mediapipe-models/image_segmenter/deeplab_v3/float32/1/deeplab_v3.tflite',
    // Finds the animal coarsely; then Magic Touch, given points on it, cuts it out with crisp edges.
    edges: 'https://storage.googleapis.com/mediapipe-models/interactive_segmenter/magic_touch/float32/1/magic_touch.tflite',
    classes: { cat: 8, dog: 12, person: 15 }, // DeepLab v3 (PASCAL VOC) labels.
    people: .2, // Photos are shown in the list: a crop where people fill more than this share is turned down.
    photoSide: 1000, // The photo kept: cropped around the animal, at most this many pixels on its longer side.
    // The palette, after the references: a dark brown ground, lime, pink, warm greys, a pinkish grey, rust, caramel
    // and khaki.
    colours: { ground: '#2a2017', lime: '#d4ec3c', pink: '#e8a7bb', grey: '#968b82', mauve: '#ab9285', rust: '#a9481d', caramel: '#7f4316', khaki: '#857348', skin: '#edd3c0' },
    // Coats are drawn in the nearest of these: white, pale grey, pinkish grey, grey, taupe, black, rust, caramel, beige.
    coats: ['#ece5da', '#d6cbbf', '#ab9285', '#a39890', '#6f645c', '#1c1819', '#a9481d', '#7f4316', '#857348'],
    horizon: .38, // Where the ground starts, as a share of the height (high, so there's plenty of ground for them).
    cell: .022, // Grid cell of the plants, as a share of the base size.
    eyes: { dark: '#140e0a', light: '#e9e0d3', shine: '#f6ecdc' }, // Solid eyes, with a little light in them.
    grain: .12, // Strength of the film grain over everything.
    fineGrain: 9, // The ground's fine grain: how far each speck strays from the brown (0–255).
    // How big each kind is next to the others (a medium dog is 1).
    scale: { cat: [.6, .78, .9], dog: [.66, .92, 1.2] },
    // What they do, and how often; lengths in seconds.
    acts: { sit: [.32, 3, 8], walk: [.3, 0, 0], hop: [.06, 1.1, 1.1], stretch: [.1, 1.8, 1.8], groom: [.08, 2.4, 3.4], sleep: [.12, 7, 13] } as Record<string, [number, number, number]>,
    walkSpeed: .045, // Share of the width per second.
  };

  /** What is kept of each pet: cat or dog, size (dogs: 0 small, 1 medium, 2 big), coat (0 plain, 1 tabby, 2 patches,
      3 tortoiseshell), build (0 thin … 9 chubby), its three colours (light, mid, dark) and its markings (bits of MARKS).
      It travels as a short code, e.g. "c12_f2d9b0b98a5e4a3326". */
  type Look = { kind: 'cat' | 'dog'; size: 0 | 1 | 2; pattern: 0 | 1 | 2 | 3; build: number; colours: [string, string, string]; marks?: number; name?: string; owner?: string };
  // Its name travels as hex of its UTF-8 bytes (up to 20), after the look: "c12_f2d9b0b98a5e4a3326_4d696c6f"; its
  // markings, last, as "_x" and their bits in hex.
  const nameHex = (name: string) => [...new TextEncoder().encode(name.trim())].slice(0, 20).map((b) => b.toString(16).padStart(2, '0')).join('');
  const lookCode = (look: Look) => `${look.kind[0]}${look.size}${look.pattern}${look.build}_${look.colours.map((c) => c.slice(1)).join('')}${look.name ? `_${nameHex(look.name)}${look.owner ? `_${nameHex(look.owner)}` : ''}` : ''}${look.marks ? `_x${look.marks.toString(16)}` : ''}`;
  const readLook = (id: string): Look | null => {
    // Kind, size, coat, build (0 thin … 9 chubby; older souls have none), colours, name, owner, markings.
    const m = /([cd])([012])([0-3])([0-9])?_([0-9a-f]{6})([0-9a-f]{6})([0-9a-f]{6})(?:_([0-9a-f]{2,40}))?(?:_([0-9a-f]{2,40}))?(?:_x([0-9a-f]{1,4}))?(?:\.json)?$/.exec(id);
    if (!m) return null;
    const text = (hexText?: string) => { if (!hexText) return undefined; try { return new TextDecoder('utf-8', { fatal: true }).decode(Uint8Array.from(hexText.match(/../g)!.map((b) => parseInt(b, 16)))); } catch { return undefined; } };
    return { kind: m[1] === 'c' ? 'cat' : 'dog', size: Number(m[2]) as 0 | 1 | 2, pattern: Number(m[3]) as 0 | 1 | 2 | 3, build: m[4] ? Number(m[4]) : 4, colours: [`#${m[5]}`, `#${m[6]}`, `#${m[7]}`], name: text(m[8]), owner: text(m[9]), marks: m[10] ? parseInt(m[10], 16) : 0 };
  };

  /** Markings asked for in a few words (English or Spanish), each one drawn: a patch over an eye, white paws… */
  // (pointedEars: a dog's ears standing up like a cat's instead of floppy; chosen in the form, not written.)
  const MARKS = { eye: 1, eyeLight: 2, mask: 4, paws: 8, chest: 16, tailTip: 32, ears: 64, blaze: 128, saddle: 256, muzzle: 512, pointedEars: 1024 };
  const MARK_WORDS: Array<[keyof typeof MARKS, RegExp, string]> = [
    ['eye', /(mancha|manchita|parche|patch|spot)[^,.;]{0,24}(ojo|eye)|(ojo|eye)[^,.;]{0,16}(mancha|parche|patch|spot)/, 'a patch over one eye'],
    ['mask', /(antifaz|m[aá]scara|mask|cara (negra|oscura)|dark face)/, 'a mask'],
    ['paws', /(patas|patitas|pies|manos|paws|feet|legs)[^,.;]{0,16}(blanc|white)|(blanc|white)[^,.;]{0,16}(patas|paws|feet|socks)|medias|botitas|guantes|socks|mittens/, 'white paws'],
    ['chest', /(pecho|panza|pechera|chest|belly)[^,.;]{0,16}(blanc|white)|(blanc|white)[^,.;]{0,16}(pecho|chest|belly|panza)|babero|corbata|bib/, 'a white chest'],
    ['tailTip', /(punta|tip)[^,.;]{0,20}(cola|tail)[^,.;]{0,12}(blanc|white)|(cola|tail)[^,.;]{0,12}(blanc|white)|white[^,.;]{0,6}tip/, 'a white tail tip'],
    ['ears', /(orejas|ears)[^,.;]{0,16}(negr|oscur|black|dark)|(black|dark)[^,.;]{0,8}ears/, 'dark ears'],
    ['blaze', /(lista|franja|raya|l[ií]nea|stripe|blaze)[^,.;]{0,24}(blanc|white|cara|frente|face|nariz|nose)/, 'a white stripe down the face'],
    ['saddle', /(mancha|manch[oó]n|patch|spot|saddle|montura)[^,.;]{0,24}(espalda|lomo|back)/, 'a patch on the back'],
    ['muzzle', /(hocico|trompa|nariz|morro|boca|muzzle|snout|nose)[^,.;]{0,16}(blanc|white)|(white|blanc)[^,.;]{0,8}(muzzle|snout|hocico)/, 'a white muzzle'],
  ];
  const marksFrom = (text: string) => {
    const words = text.toLowerCase();
    let marks = 0;
    for (const [mark, words_] of MARK_WORDS) {
      const found = words_.exec(words);
      if (!found) continue;
      marks |= MARKS[mark];
      // A white (light) patch over the eye, if the words say so.
      if (mark === 'eye' && /(blanc|white|clar|light)/.test(words.slice(Math.max(0, found.index - 12), found.index + found[0].length + 16))) marks |= MARKS.eyeLight;
    }
    return marks;
  };
  const marksText = (marks = 0) => MARK_WORDS.filter(([mark]) => marks & MARKS[mark]).map(([mark, , label]) => (mark === 'eye' && marks & MARKS.eyeLight ? 'a white patch over one eye' : label)).join(', ');

  type Act = 'sit' | 'walk' | 'hop' | 'stretch' | 'groom' | 'sleep' | 'pet' | 'held' | 'fall';
  type Layer = { canvas: HTMLCanvasElement; x: number; y: number; w: number; h: number };
  type Leg = Layer & { pivotX: number; pivotY: number; near: boolean; front: boolean };
  type Figure = { body: Layer; tail: Layer & { pivotX: number; pivotY: number }; legs: Leg[]; eyes: Array<{ x: number; y: number; dark: boolean }>; eyeR: number; legLength: number; unit: number };
  type Soul = {
    id: string; look: Look; born: number; figure?: Figure; photo?: string;
    // Picked up: where its feet are in the air (px), how fast it falls, its legs' pendulum and its lean; when it landed.
    air?: number; airV?: number; swing?: number; swingV?: number; hang?: number; landed?: number; heldUnit?: number;
    // Clicked: when (a cat raises its tail, a dog wags it).
    happy?: number;
    // Life: its home, where it is (feet; shares of the frame), what it is doing and until when.
    hx: number; hy: number; x: number; y: number; fromX: number; fromY: number; toX: number; toY: number;
    act: Act; actStart: number; actEnd: number; face: number; faceShown: number; blink: number; phase: number; drawn: number;
  };
  type Plant = {
    sprite: HTMLCanvasElement; x: number; y: number; w: number; h: number; phase: number; sway: number;
    // The wind: how far it is bent, and how fast; the little ones on the ground can blow away (`fly`) and grow back.
    bend: number; bendV: number; loose?: boolean; regrow?: number;
    fly?: { x: number; y: number; vx: number; vy: number; rot: number; vr: number; since: number };
  };

  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const STORE = 'missing-souls';

  const hash = (text: string) => { let h = 2166136261; for (let i = 0; i < text.length; i++) h = Math.imul(h ^ text.charCodeAt(i), 16777619); return h >>> 0; };
  const canvasOf = (width: number, height: number) => { const c = document.createElement('canvas'); c.width = Math.max(1, Math.round(width)); c.height = Math.max(1, Math.round(height)); return c; };
  const ease = (p: number) => p * p * (3 - 2 * p);
  const hex = (rgb: number[]) => `#${rgb.map((v) => Math.round(Math.min(255, Math.max(0, v))).toString(16).padStart(2, '0')).join('')}`;
  const rgbOf = (colour: string) => [1, 3, 5].map((i) => parseInt(colour.slice(i, i + 2), 16));
  /** An eye: a solid round dot with a little light in it (dark, or light on a dark coat); asleep, a short rounded bar. */
  const drawEye = (g: CanvasRenderingContext2D, x: number, y: number, r: number, asleep = false, onDark = false) => {
    g.save();
    g.fillStyle = onDark ? SETTINGS.eyes.light : SETTINGS.eyes.dark;
    g.beginPath();
    if (asleep) g.roundRect(x - r * 1.1, y - r * .32, r * 2.2, r * .64, r * .32);
    else g.arc(x, y, r, 0, Math.PI * 2);
    g.fill();
    if (!asleep) { g.fillStyle = onDark ? SETTINGS.eyes.dark : SETTINGS.eyes.shine; g.beginPath(); g.arc(x + r * .35, y - r * .35, r * .32, 0, Math.PI * 2); g.fill(); }
    g.restore();
  };
  /** The nearest of a few colours (weighted, roughly as the eye sees it). */
  const closest = (colour: string, options: string[]) => {
    const [r, g, b] = rgbOf(colour);
    let best = options[0], bestDistance = Infinity;
    for (const option of options) {
      const [or, og, ob] = rgbOf(option), mr = (r + or) / 2;
      const distance = (2 + mr / 256) * (r - or) ** 2 + 4 * (g - og) ** 2 + (2 + (255 - mr) / 256) * (b - ob) ** 2;
      if (distance < bestDistance) { best = option; bestDistance = distance; }
    }
    return best;
  };
  /** A pet's three colours as drawn: each the nearest coat colour of the palette. */
  const coatColours = (look: Look) => look.colours.map((colour) => closest(colour, SETTINGS.coats)) as [string, string, string];

  /** Cells of a grid: a colour index per cell, -1 where it is empty. */
  type Cells = { cells: Int16Array; gw: number; gh: number };
  const gridOf = (gw: number, gh: number): Cells => ({ cells: new Int16Array(gw * gh).fill(-1), gw, gh });
  /** Draws grid cells as one shape with rounded corners, like the motifs of the references: outer corners rounded,
      inner (concave) corners filleted, cells side by side merged; a lone cell becomes a dot. Colour seams inside the
      shape stay square. (ox, oy): where the grid starts. `joinDiagonals`: cells touching only at a corner keep that corner
      square, so with the fillets around it the joint reads solid instead of a cross with empty triangles (flowers). */
  const drawCells = (g: CanvasRenderingContext2D, { cells, gw, gh }: Cells, cell: number, colours: string[], ox = 0, oy = 0, joinDiagonals = false) => {
    const at = (i: number, j: number) => (i < 0 || j < 0 || i >= gw || j >= gh ? -1 : cells[j * gw + i]);
    const r = cell * .5, e = .6;
    for (let j = 0; j < gh; j++) for (let i = 0; i < gw; i++) {
      const c = at(i, j), x = ox + i * cell, y = oy + j * cell;
      if (c >= 0) {
        const L = at(i - 1, j) >= 0, R = at(i + 1, j) >= 0, T = at(i, j - 1) >= 0, B = at(i, j + 1) >= 0;
        // A corner stays square where it meets a diagonal neighbour (only when joining diagonals).
        const D = (dx: number, dy: number) => joinDiagonals && at(i + dx, j + dy) >= 0;
        g.fillStyle = colours[c];
        g.beginPath();
        // Overlapping a touch where cells meet, so no hairline shows between them.
        g.roundRect(x - (L ? e : 0), y - (T ? e : 0), cell + (L ? e : 0) + (R ? e : 0), cell + (T ? e : 0) + (B ? e : 0), [!L && !T && !D(-1, -1) ? r : 0, !R && !T && !D(1, -1) ? r : 0, !R && !B && !D(1, 1) ? r : 0, !L && !B && !D(-1, 1) ? r : 0]);
        g.fill();
      } else {
        // Inner corners: where two sides of an empty cell meet filled ones, a fillet rounds the notch.
        for (const [sx, sy] of [[-1, -1], [1, -1], [1, 1], [-1, 1]]) {
          const side = at(i + sx, j), top = at(i, j + sy);
          if (side < 0 || top < 0) continue;
          const px = x + (sx > 0 ? cell : 0), py = y + (sy > 0 ? cell : 0);
          g.fillStyle = colours[side];
          g.beginPath();
          g.moveTo(px - sx * r, py);
          g.arcTo(px, py, px, py - sy * r, r);
          g.lineTo(px, py);
          g.closePath();
          g.fill();
        }
      }
    }
  };
  /** Turns a drawn shape into grid cells: each cell takes the shape's colour there (the nearest of `palette`), or stays
      empty where the shape covers less than `threshold` of it. (ox, oy): where the grid starts, at or left of / above 0. */
  const cellsOf = (source: HTMLCanvasElement, cell: number, palette: string[], threshold = .45, ox = 0, oy = 0): Cells => {
    const gw = Math.ceil((source.width - ox) / cell), gh = Math.ceil((source.height - oy) / cell);
    const tiny = document.createElement('canvas'); tiny.width = gw; tiny.height = gh;
    const t = tiny.getContext('2d', { willReadFrequently: true })!;
    t.imageSmoothingEnabled = true; t.imageSmoothingQuality = 'high';
    t.scale(1 / cell, 1 / cell); t.drawImage(source, -ox, -oy);
    const data = t.getImageData(0, 0, gw, gh).data, grid = gridOf(gw, gh);
    for (let k = 0; k < gw * gh; k++) {
      if (data[k * 4 + 3] < threshold * 255) continue;
      grid.cells[k] = palette.indexOf(closest(hex([data[k * 4], data[k * 4 + 1], data[k * 4 + 2]]), palette));
    }
    return grid;
  };
  /** A drawn shape re-drawn as rounded grid cells in the palette, on a canvas of the same size. */
  const blockify = (source: HTMLCanvasElement, cell: number, palette: string[], threshold = .45, ox = 0, oy = 0) => {
    const out = document.createElement('canvas'); out.width = source.width; out.height = source.height;
    drawCells(out.getContext('2d')!, cellsOf(source, cell, palette, threshold, ox, oy), cell, palette, ox, oy);
    return out;
  };
  /** Where a grid has to start so that `at` falls in the middle of a cell. */
  const alignTo = (at: number, cell: number) => ((at - cell / 2) % cell) - cell;

  // Souls kept on this device, when the shared place cannot be reached. `?souls=reset` in the address clears them.
  try { if (new URLSearchParams(location.search).get('souls') === 'reset') localStorage.removeItem(STORE); } catch { /* No storage. */ }
  type Entry = { id: string; photo?: string; marks?: number };
  // Coats corrected by hand (by stem), where the photo read them wrong: the coat pattern (0 plain … 3 tortoiseshell), its
  // three colours (light, middle, dark) and markings to add. Malbec is all black; Kimchi all grey with pricked ears;
  // Morita beige; Mirko white; Obi a beagle (tan, a black saddle, white chest, paws, muzzle and tail tip); Miley in
  // Morita's beige.
  const FIXES: Record<string, { pattern?: Look['pattern']; colours?: [string, string, string]; marks?: number }> = {
    'mv42v257-2fdc6494': { pattern: 0, colours: ['#4a4446', '#1c1819', '#120f10'] },
    'mv43lknk-47461bb0': { pattern: 0, marks: 1024 },
    'mv438i86-aaf7d16e': { pattern: 0, colours: ['#a8966a', '#857348', '#5e5233'] },
    'mv459j8u-ca3564ca': { pattern: 0, colours: ['#f4efe6', '#ece5da', '#b9b0a5'] },
    'mv4dm2l9-4064d8f8': { pattern: 0, colours: ['#ece5da', '#a9481d', '#1c1819'], marks: 8 | 16 | 32 | 256 | 512 },
    'mv6m63zd-1e500404': { pattern: 0, colours: ['#a8966a', '#857348', '#5e5233'] },
  };
  const localSouls = (): Entry[] => {
    try {
      const list = JSON.parse(localStorage.getItem(STORE) ?? '[]');
      return Array.isArray(list) ? list.map((item) => (typeof item === 'string' ? { id: item } : item)).filter((item) => typeof item?.id === 'string') : [];
    } catch { return []; }
  };
  // Souls this visitor added to the shared place: the shared list is cached for a little while, so until it shows them
  // they are added from here (and then forgotten).
  const MINE = 'missing-souls-mine';
  const mine = (): Entry[] => { try { const list = JSON.parse(localStorage.getItem(MINE) ?? '[]'); return Array.isArray(list) ? list.filter((item) => typeof item?.id === 'string') : []; } catch { return []; } };
  const rememberMine = (entry: Entry) => { try { localStorage.setItem(MINE, JSON.stringify([...mine(), entry])); } catch { /* Blocked: the shared list will show it soon. */ } };
  // The keys of the souls this visitor left (by stem: an edited soul keeps its stem), to change or take them out.
  const KEYS = 'missing-souls-keys';
  const stemOf = (id: string) => id.replace(/^souls\//, '').split('_')[0];
  const keys = (): Record<string, string> => { try { const map = JSON.parse(localStorage.getItem(KEYS) ?? '{}'); return map && typeof map === 'object' ? map : {}; } catch { return {}; } };
  const setKey = (id: string, key?: string) => {
    try { const map = keys(); if (key) map[stemOf(id)] = key; else delete map[stemOf(id)]; localStorage.setItem(KEYS, JSON.stringify(map)); } catch { /* Blocked. */ }
  };
  // Ids this visitor changed or took out, hidden until the cached shared list catches up (then forgotten).
  const GONE = 'missing-souls-gone';
  const gone = (): string[] => { try { const list = JSON.parse(localStorage.getItem(GONE) ?? '[]'); return Array.isArray(list) ? list : []; } catch { return []; } };
  const forget = (id: string) => { try { localStorage.setItem(GONE, JSON.stringify([...gone(), id])); } catch { /* Blocked. */ } };
  const unmine = (id: string) => { try { localStorage.setItem(MINE, JSON.stringify(mine().filter((entry) => entry.id !== id))); } catch { /* Blocked. */ } };
  const keepLocalList = (list: Entry[]) => { try { localStorage.setItem(STORE, JSON.stringify(list)); } catch { /* Blocked. */ } };
  const keepLocally = (entry: Entry) => {
    try { localStorage.setItem(STORE, JSON.stringify([...localSouls(), entry])); } catch {
