        soul.toX = goingHome ? soul.hx : Math.min(.96, Math.max(.04, soul.hx + (Math.random() - .5) * .22));
        soul.toY = goingHome ? soul.hy : Math.min(.98, Math.max(SETTINGS.horizon + .05, soul.hy + (Math.random() - .5) * .1));
        const distance = Math.hypot(soul.toX - soul.x, (soul.toY - soul.y) * height / width);
        length = Math.max(1.2, distance / SETTINGS.walkSpeed);
        if (Math.abs(soul.toX - soul.x) > .005) soul.face = Math.sign(soul.toX - soul.x);
      } else {
        const [, min, max] = SETTINGS.acts[act];
        length = min + Math.random() * (max - min);
