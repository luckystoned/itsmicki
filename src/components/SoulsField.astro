      s.beginPath(); s.ellipse(cx - .05 * u, top + .965 * u, .04 * u, .02 * u, 0, 0, Math.PI * 2); s.fill(); // Shoes
      s.beginPath(); s.ellipse(cx + .05 * u, top + .965 * u, .04 * u, .02 * u, 0, 0, Math.PI * 2); s.fill();
      const W = w + pad * 2, H = size + pad * 2;
      const tint = (source: HTMLCanvasElement, colour: string) => { const c = canvasOf(source.width, source.height), t = c.getContext('2d')!; t.drawImage(source, 0, 0); t.globalCompositeOperation = 'source-in'; t.fillStyle = colour; t.fillRect(0, 0, c.width, c.height); return c; };
      // Her colours, painted onto the crisp figure: deep indigo hair and shoulders, the dress glowing orange from
      // within, legs fading to a soft violet; a little green light on her face.
      const coloured = canvasOf(W, H), c = coloured.getContext('2d')!;
      c.drawImage(shape, 0, 0);
      c.globalCompositeOperation = 'source-in';
      const fill = c.createLinearGradient(0, top, 0, top + size);
      fill.addColorStop(0, '#2c2868'); fill.addColorStop(.22, '#3a338c'); fill.addColorStop(.32, '#5a43a6'); fill.addColorStop(.48, '#ff7a55'); fill.addColorStop(.63, '#ff9d74'); fill.addColorStop(.72, '#7a72d2'); fill.addColorStop(1, '#4e48aa');
      c.fillStyle = fill; c.fillRect(0, 0, W, H);
      c.globalCompositeOperation = 'source-atop';
      const glow = c.createRadialGradient(cx, top + .45 * u, 0, cx, top + .45 * u, .2 * u);
      glow.addColorStop(0, 'rgba(255, 196, 140, .55)'); glow.addColorStop(1, 'rgba(255, 196, 140, 0)');
      c.fillStyle = glow; c.fillRect(0, 0, W, H);
      const cheek = c.createRadialGradient(cx + .02 * u, top + .14 * u, 0, cx + .02 * u, top + .14 * u, .08 * u);
      cheek.addColorStop(0, 'rgba(150, 226, 160, .6)'); cheek.addColorStop(1, 'rgba(150, 226, 160, 0)');
