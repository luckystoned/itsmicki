---
// Missing souls: a warm, glowing place (coral sky, lavender ground, blurred plants swaying) where a caregiver looks
// after the animals people leave with her. Anyone can add their cat or dog from a full-body photo: the photo is read on
// their device (MediaPipe finds the animal and cuts it out) and only its silhouette is kept, painted as a luminous
// figure, so each one keeps its own shape and breed. Once here, each animal lives its own little life: it sits, walks
// about, hops, stretches, grooms, naps and blinks. The souls are shared by every visitor (api/souls.ts, Vercel Blob) and
// stay for good, until the place is full; without the shared store (local dev, or before it is connected) they are kept
// on the visitor's device. With reduced motion nothing moves.
type Props = { label: string };
const { label } = Astro.props;
---

<div class="souls-field" data-souls-field role="img" aria-label={label}>
  <canvas class="souls-field-canvas" aria-hidden="true"></canvas>
</div>

<script>
  import { loadVision } from '@/scripts/camera';

  const SETTINGS = {
    cap: 42, // Souls the place holds (the server has the final word).
    maxSide: 240, // Largest silhouette side kept, in pixels (the server accepts up to this).
    minPet: .008, // Share of the photo the animal has to cover to count as found.
    margin: .012, // Whole body: the animal must not touch the photo's sides or bottom (share of the photo).
    model: 'https://storage.googleapis.com/mediapipe-models/image_segmenter/deeplab_v3/float32/1/deeplab_v3.tflite',
    // Finds the animal coarsely; then Magic Touch, given points on it, cuts it out with crisp edges.
    edges: 'https://storage.googleapis.com/mediapipe-models/interactive_segmenter/magic_touch/float32/1/magic_touch.tflite',
    classes: { cat: 8, dog: 12 }, // DeepLab v3 (PASCAL VOC) labels.
    // The place, after the reference: a coral sky melting into a lavender-blue ground, a warm glow on the floor.
    sky: [[0, '#e46a55'], [.3, '#ec7d60'], [.45, '#f19a7c'], [.56, '#a198e2'], [.8, '#8380d8'], [1, '#716ecb']] as Array<[number, string]>,
    horizon: .5, // Where the ground starts, as a share of the height.
    plants: { back: '#98a3ee', stem: '#6f8f63', front: '#5f8456' }, // Flowers on the horizon, their stems, leaves in front.
    // Each soul's coat: light → mid → shadow. Pale mint and ink, like the two cats of the reference, and warm pastels.
    coats: [
      ['#f4f8e2', '#d9efc8', '#a9d3bb'],
      ['#3b3392', '#1e1a5c', '#100e33'],
      ['#ffe2cc', '#f8b99c', '#d58fb6'],
      ['#d4cdf8', '#a39be8', '#6c67cf'],
      ['#fff6ea', '#f2dccb', '#c7b4ea'],
      ['#4a3f9e', '#2b2672', '#1a2a4c'],
      ['#e8f5d0', '#bfe3a6', '#86c49e'],
      ['#ffd0c0', '#f39c8a', '#a36fc8'],
    ],
    eyes: '#ff4a2a',
    grain: .17, // Strength of the film grain over everything.
    // What they do, and how often; lengths in seconds.
    acts: { sit: [.32, 3, 8], walk: [.3, 0, 0], hop: [.08, .8, .8], stretch: [.1, 1.8, 1.8], groom: [.08, 2.4, 3.4], sleep: [.12, 7, 13] } as Record<string, [number, number, number]>,
    walkSpeed: .045, // Share of the width per second.
  };

  type Act = 'sit' | 'walk' | 'hop' | 'stretch' | 'groom' | 'sleep';
  type Soul = {
    id: string; width: number; height: number; mask: Uint8Array; born: number;
    sprite?: HTMLCanvasElement; spriteFor?: number; eyes?: Array<{ x: number; y: number }>; eyeR?: number; facing?: number;
    // Life: its home, where it is (feet; shares of the frame), what it is doing and until when.
    hx: number; hy: number; x: number; y: number; fromX: number; fromY: number; toX: number; toY: number;
    act: Act; actStart: number; actEnd: number; face: number; blink: number; phase: number;
  };
  type Plant = { sprite: HTMLCanvasElement; x: number; y: number; w: number; h: number; phase: number; sway: number };

  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const STORE = 'missing-souls';

  const hash = (text: string) => { let h = 2166136261; for (let i = 0; i < text.length; i++) h = Math.imul(h ^ text.charCodeAt(i), 16777619); return h >>> 0; };
  const canvasOf = (width: number, height: number) => { const c = document.createElement('canvas'); c.width = Math.max(1, Math.round(width)); c.height = Math.max(1, Math.round(height)); return c; };
  const encode = (width: number, height: number, mask: Uint8Array) => { const out = new Uint8Array(4 + mask.length); out.set([width & 255, width >> 8, height & 255, height >> 8]); out.set(mask, 4); return out; };
  const decode = (bytes: Uint8Array) => {
    if (bytes.length < 4) return null;
    const width = bytes[0] | (bytes[1] << 8), height = bytes[2] | (bytes[3] << 8);
    if (!width || !height || bytes.length !== 4 + width * height) return null;
    return { width, height, mask: bytes.slice(4) };
  };
  const toBase64 = (bytes: Uint8Array) => { let s = ''; bytes.forEach((b) => { s += String.fromCharCode(b); }); return btoa(s); };
  const fromBase64 = (text: string) => Uint8Array.from(atob(text), (c) => c.charCodeAt(0));
  const ease = (p: number) => p * p * (3 - 2 * p);

  // Souls kept on this device, when the shared place cannot be reached.
  const localSouls = (): Array<{ id: string; data: string }> => { try { return JSON.parse(localStorage.getItem(STORE) ?? '[]'); } catch { return []; } };
  const keepLocally = (id: string, bytes: Uint8Array) => { try { localStorage.setItem(STORE, JSON.stringify([...localSouls(), { id, data: toBase64(bytes) }])); } catch { /* Storage full or blocked: it stays for this visit. */ } };

  /** Finds the cat or dog in a photo and returns its silhouette, or why it can't. */
  type Masks = { confidenceMasks?: Array<{ width: number; height: number; getAsFloat32Array: () => Float32Array }>; close: () => void };
  type Point = { x: number; y: number };
  let segmenter: Promise<{ segment: (image: HTMLCanvasElement) => Masks }> | null = null;
  let cutter: Promise<{ segment: (image: HTMLCanvasElement, roi: { scribble: Point[] }) => Masks } | null> | null = null;
  const silhouette = async (file: File): Promise<{ width: number; height: number; mask: Uint8Array } | 'none' | 'cut'> => {
    segmenter ??= (async () => {
      const { module, files } = await loadVision();
      return module.ImageSegmenter.createFromOptions(files, { baseOptions: { modelAssetPath: SETTINGS.model }, runningMode: 'IMAGE', outputCategoryMask: false, outputConfidenceMasks: true });
    })();
    cutter ??= (async () => {
      try {
        const { module, files } = await loadVision();
        return await module.InteractiveSegmenter.createFromOptions(files, { baseOptions: { modelAssetPath: SETTINGS.edges }, outputCategoryMask: false, outputConfidenceMasks: true });
      } catch { return null; }
    })();
    const model = await segmenter;
    const bitmap = await createImageBitmap(file);
    const scale = Math.min(1, 640 / Math.max(bitmap.width, bitmap.height));
    const photo = canvasOf(bitmap.width * scale, bitmap.height * scale);
    photo.getContext('2d')!.drawImage(bitmap, 0, 0, photo.width, photo.height);
    bitmap.close();
    const result = model.segment(photo);
    const masks = result.confidenceMasks;
    if (!masks) { result.close(); return 'none'; }
    const cat = masks[SETTINGS.classes.cat].getAsFloat32Array(), dog = masks[SETTINGS.classes.dog].getAsFloat32Array();
    const { width, height } = masks[SETTINGS.classes.cat];
    result.close();
    // The animal: wherever the model sees a cat or a dog.
    const pet = new Float32Array(width * height);
    let found = 0, x0 = width, y0 = height, x1 = -1, y1 = -1;
    for (let y = 0; y < height; y++) for (let x = 0; x < width; x++) {
      const i = y * width + x, p = Math.max(cat[i], dog[i]);
      pet[i] = p;
      if (p > .5) { found++; if (x < x0) x0 = x; if (x > x1) x1 = x; if (y < y0) y0 = y; if (y > y1) y1 = y; }
    }
    if (found / (width * height) < SETTINGS.minPet) return 'none';
    // Whole body only: an animal running off the sides or the bottom of the photo is cut (a close-up of a face, say).
    const m = SETTINGS.margin;
    if (x0 < width * m || x1 > width * (1 - m) || y1 > height * (1 - m) || y0 < height * m * .5) return 'cut';
    // Crisp edges: points spread over where the model is surest it is the animal, for Magic Touch to cut it out. Its
    // cut is kept only around the animal, so it cannot take the sofa along.
    const sure: Point[] = [];
    const step = Math.max(4, Math.round(Math.sqrt(found / 24)));
    for (let y = y0; y <= y1; y += step) for (let x = x0; x <= x1; x += step) if (pet[y * width + x] > .8) sure.push({ x: x / width, y: y / height });
    const scribble = sure.filter((_, i) => i % Math.max(1, Math.ceil(sure.length / 12)) === 0);
    const edges = await cutter;
    if (edges && scribble.length) {
      try {
        const cut = edges.segment(photo, { scribble });
        const fine = cut.confidenceMasks?.[0];
        if (fine && fine.width === width && fine.height === height) {
          const crisp = fine.getAsFloat32Array();
          for (let i = 0; i < pet.length; i++) pet[i] = pet[i] > .08 ? crisp[i] : 0;
        }
        cut.close();
      } catch { /* Keep the coarse silhouette. */ }
    }
    const pad = Math.round(Math.max(x1 - x0, y1 - y0) * .04);
    x0 = Math.max(0, x0 - pad); y0 = Math.max(0, y0 - pad); x1 = Math.min(width - 1, x1 + pad); y1 = Math.min(height - 1, y1 + pad);
    const boxW = x1 - x0 + 1, boxH = y1 - y0 + 1;
    const full = canvasOf(boxW, boxH), fullContext = full.getContext('2d')!, image = fullContext.createImageData(boxW, boxH);
    for (let y = 0; y < boxH; y++) for (let x = 0; x < boxW; x++) {
      const k = (y * boxW + x) * 4;
      image.data[k] = image.data[k + 1] = image.data[k + 2] = 255;
      image.data[k + 3] = Math.round(Math.min(1, Math.max(0, (pet[(y + y0) * width + x + x0] - .4) / .2)) * 255);
    }
    fullContext.putImageData(image, 0, 0);
    const fit = Math.min(1, SETTINGS.maxSide / Math.max(boxW, boxH));
    const small = canvasOf(boxW * fit, boxH * fit), smallContext = small.getContext('2d')!;
    smallContext.imageSmoothingQuality = 'high';
    smallContext.drawImage(full, 0, 0, small.width, small.height);
    const pixels = smallContext.getImageData(0, 0, small.width, small.height).data;
    const mask = new Uint8Array(small.width * small.height);
    for (let i = 0; i < mask.length; i++) mask[i] = pixels[i * 4 + 3];
    return { width: small.width, height: small.height, mask };
  };

  document.querySelectorAll<HTMLElement>('[data-souls-field]').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('.souls-field-canvas')!;
    const context = canvas.getContext('2d')!;
    const caption = root.closest('section') ?? document;
    const addButton = caption.querySelector<HTMLButtonElement>('[data-souls-add]');
    const input = caption.querySelector<HTMLInputElement>('[data-souls-input]');
    const status = caption.querySelector<HTMLElement>('[data-souls-status]');
    const addLine = caption.querySelector<HTMLElement>('[data-souls-add-line]');
    const setStatus = (text: string) => { if (status) { status.textContent = text; status.hidden = !text; } };

    let width = 0, height = 0, ratio = 1;
    let souls: Soul[] = [];
    let cap = SETTINGS.cap;
    let shared = true; // False when the shared place cannot be reached: souls are kept on this device.

    // Film grain: a noise tile, shifted every few frames so it lives.
    const grain = canvasOf(160, 160);
    {
      const g = grain.getContext('2d')!, img = g.createImageData(160, 160);
      for (let i = 0; i < img.data.length; i += 4) { const v = Math.random() < .03 ? 255 : Math.random() * 200; img.data[i] = img.data[i + 1] = img.data[i + 2] = v; img.data[i + 3] = 255; }
      g.putImageData(img, 0, 0);
    }

    // Soft edges without canvas filters (Safari): halve the image step by step, then double it back up the same way;
    // each step blends neighbours, so the result is a smooth blur (one big jump would look blocky).
    const soften = (source: HTMLCanvasElement, amount: number) => {
      const steps: HTMLCanvasElement[] = [source];
      let scale = 1;
      while (scale * 2 <= amount) {
        const last = steps[steps.length - 1], next = canvasOf(last.width / 2, last.height / 2), n = next.getContext('2d')!;
        n.imageSmoothingQuality = 'high';
        n.drawImage(last, 0, 0, next.width, next.height);
        steps.push(next);
        scale *= 2;
      }
      if (amount / scale > 1.05) {
        const last = steps[steps.length - 1], next = canvasOf(source.width / amount, source.height / amount), n = next.getContext('2d')!;
        n.imageSmoothingQuality = 'high';
        n.drawImage(last, 0, 0, next.width, next.height);
        steps.push(next);
      }
      let up = steps[steps.length - 1];
      for (let i = steps.length - 2; i >= 0; i--) {
        const next = canvasOf(steps[i].width, steps[i].height), n = next.getContext('2d')!;
        n.imageSmoothingQuality = 'high';
        n.drawImage(up, 0, 0, next.width, next.height);
        up = next;
      }
      return up;
    };

    // Each sprite has room around the figure for its glow: this share of its height on every side.
    const ROOM = .2;

    /** A soul as a luminous figure: its silhouette, defined but soft at the edge, filled with its coat. Its eyes are
        found here (in the head, the top of the silhouette) and drawn live, so they can blink and close. */
    const paintSoul = (soul: Soul, size: number) => {
      const coat = SETTINGS.coats[hash(soul.id) % SETTINGS.coats.length];
      const scale = size / soul.height, w = soul.width * scale, h = size, pad = size * ROOM;
      const m = Math.round(Math.max(soul.width, soul.height) * .15);
      const shape = canvasOf(soul.width + m * 2, soul.height + m * 2), s = shape.getContext('2d')!, img = s.createImageData(soul.width, soul.height);
      for (let i = 0; i < soul.mask.length; i++) { img.data[i * 4] = img.data[i * 4 + 1] = img.data[i * 4 + 2] = 255; img.data[i * 4 + 3] = soul.mask[i]; }
      s.putImageData(img, m, m);
      const sx = pad - m * scale, sw = shape.width * scale, sh = shape.height * scale;
      const out = canvasOf((w + pad * 2) * ratio, (h + pad * 2) * ratio), g = out.getContext('2d')!;
      g.scale(ratio, ratio);
      g.imageSmoothingQuality = 'high';
      g.globalAlpha = .28;
      g.drawImage(soften(shape, 6), sx - sw * .04, sx - sh * .04, sw * 1.08, sh * 1.08);
      g.globalAlpha = 1;
      g.drawImage(soften(shape, 1.25), sx, sx, sw, sh);
      g.drawImage(shape, sx, sx, sw, sh);
      // The coat: light at the top, into its colour, into shadow at the bottom; a lighter glow on its back.
      g.globalCompositeOperation = 'source-in';
      const fill = g.createLinearGradient(pad, pad, pad + w * .3, pad + h);
      fill.addColorStop(0, coat[0]); fill.addColorStop(.6, coat[1]); fill.addColorStop(1, coat[2]);
      g.fillStyle = fill;
      g.fillRect(0, 0, out.width, out.height);
      g.globalCompositeOperation = 'source-atop';
      const glow = g.createRadialGradient(pad + w * .45, pad + h * .4, 0, pad + w * .45, pad + h * .4, Math.max(w, h) * .5);
      glow.addColorStop(0, 'rgba(255, 246, 228, .35)'); glow.addColorStop(1, 'rgba(255, 246, 228, 0)');
      g.fillStyle = glow;
      g.fillRect(0, 0, out.width, out.height);
      // Where its eyes are, and which way it faces in the photo (its head left or right of its body).
      let top = -1;
      for (let y = 0; y < soul.height && top < 0; y++) for (let x = 0; x < soul.width; x++) if (soul.mask[y * soul.width + x] > 160) { top = y; break; }
      soul.eyes = [];
      soul.facing = 1;
      if (top >= 0) {
        const bandEnd = Math.min(soul.height, top + Math.round(soul.height * .3));
        let headX = 0, headN = 0, bodyX = 0, bodyN = 0, left = soul.width, right = 0;
        const eyeRow = Math.min(soul.height - 1, top + Math.round(soul.height * .14));
        for (let y = 0; y < soul.height; y++) for (let x = 0; x < soul.width; x++) if (soul.mask[y * soul.width + x] > 160) {
          bodyX += x; bodyN++;
          if (y >= top && y < bandEnd) { headX += x; headN++; }
        }
        for (let x = 0; x < soul.width; x++) if (soul.mask[eyeRow * soul.width + x] > 160) { left = Math.min(left, x); right = Math.max(right, x); }
        if (headN && bodyN && right > left) {
          const cx = headX / headN, apart = Math.min((right - left) * .2, soul.width * .1);
          soul.facing = cx < bodyX / bodyN - soul.width * .04 ? -1 : 1;
          soul.eyes = [cx - apart, cx + apart].map((ex) => ({ x: pad + ex * scale, y: pad + (eyeRow + soul.height * .03) * scale }));
          soul.eyeR = Math.max(1.1, soul.width * .02 * scale);
        }
      }
      soul.sprite = out;
      soul.spriteFor = size;
      return out;
    };

    /** The caregiver: a soft, luminous girl with long hair and a long dress, glowing from her chest, one hand reaching
        down to the animals. Her feet fade into the floor. */
    let keeper: HTMLCanvasElement | null = null;
    const KEEPER = .78; // Her height, as a share of the frame's.
    const paintKeeper = (size: number) => {
      const w = size * .56, pad = size * .2;
      const shape = canvasOf(w + pad * 2, size + pad * 2), s = shape.getContext('2d')!;
      const cx = (w + pad * 2) / 2, top = pad, u = size;
      s.fillStyle = '#fff';
      const round = (x: number, y: number, rw: number, rh: number, r: number) => { s.beginPath(); s.roundRect(cx + x * u - rw * u / 2, top + y * u, rw * u, rh * u, r * u); s.fill(); };
      s.beginPath(); s.ellipse(cx, top + .11 * u, .1 * u, .11 * u, 0, 0, Math.PI * 2); s.fill(); // Head and the crown of her hair
      round(0, .1, .22, .34, .08); // Long hair, falling past her shoulders.
      s.beginPath(); // The dress: from the shoulders, flaring down to the floor.
      s.moveTo(cx - .11 * u, top + .22 * u); s.quadraticCurveTo(cx, top + .2 * u, cx + .11 * u, top + .22 * u);
      s.quadraticCurveTo(cx + .17 * u, top + .6 * u, cx + .25 * u, top + 1 * u);
      s.lineTo(cx - .25 * u, top + 1 * u);
      s.quadraticCurveTo(cx - .17 * u, top + .6 * u, cx - .11 * u, top + .22 * u);
      s.fill();
      s.lineCap = 'round'; s.strokeStyle = '#fff'; s.lineWidth = .055 * u;
      s.beginPath(); s.moveTo(cx - .12 * u, top + .26 * u); s.quadraticCurveTo(cx - .24 * u, top + .42 * u, cx - .3 * u, top + .6 * u); s.stroke(); // Reaching down to an animal.
      s.beginPath(); s.moveTo(cx + .12 * u, top + .26 * u); s.quadraticCurveTo(cx + .17 * u, top + .42 * u, cx + .15 * u, top + .55 * u); s.stroke();
      const out = canvasOf((w + pad * 2) * ratio, (size + pad * 2) * ratio), g = out.getContext('2d')!;
      g.scale(ratio, ratio);
      g.imageSmoothingQuality = 'high';
      g.globalAlpha = .6; g.drawImage(soften(shape, 12), -w * .06, -size * .04, (w + pad * 2) * 1.12, (size + pad * 2) * 1.08);
      g.globalAlpha = 1; g.drawImage(soften(shape, 4), 0, 0, w + pad * 2, size + pad * 2);
      g.drawImage(soften(shape, 2.5), 0, 0, w + pad * 2, size + pad * 2);
      g.globalCompositeOperation = 'source-in';
      const fill = g.createLinearGradient(0, top, 0, top + size);
      fill.addColorStop(0, '#fffaf0'); fill.addColorStop(.3, '#f7f2e4'); fill.addColorStop(.65, '#e6f1c2'); fill.addColorStop(1, '#b9dcb2');
      g.fillStyle = fill; g.fillRect(0, 0, out.width, out.height);
      g.globalCompositeOperation = 'source-atop';
      const heart = g.createRadialGradient(cx, top + .4 * u, 0, cx, top + .4 * u, .26 * u);
      heart.addColorStop(0, 'rgba(255, 120, 70, .6)'); heart.addColorStop(.6, 'rgba(255, 160, 130, .2)'); heart.addColorStop(1, 'rgba(255, 160, 130, 0)');
      g.fillStyle = heart; g.fillRect(0, 0, out.width, out.height);
      // Her reaching arm turns lilac towards the hand.
      const arm = g.createRadialGradient(cx - .28 * u, top + .55 * u, 0, cx - .28 * u, top + .55 * u, .16 * u);
      arm.addColorStop(0, 'rgba(110, 100, 225, .9)'); arm.addColorStop(1, 'rgba(110, 100, 225, 0)');
      g.fillStyle = arm; g.fillRect(0, 0, out.width, out.height);
      // Her feet melt into the floor.
      g.globalCompositeOperation = 'destination-out';
      const floor = g.createLinearGradient(0, top + .78 * u, 0, top + 1.02 * u);
      floor.addColorStop(0, 'rgba(0, 0, 0, 0)'); floor.addColorStop(1, 'rgba(0, 0, 0, 1)');
      g.fillStyle = floor; g.fillRect(0, top + .78 * u, w + pad * 2, size);
      // Face and eyes.
      g.globalCompositeOperation = 'source-over';
      const face = g.createRadialGradient(cx, top + .13 * u, 0, cx, top + .13 * u, .07 * u);
      face.addColorStop(0, 'rgba(255, 150, 112, .95)'); face.addColorStop(.7, 'rgba(255, 170, 130, .5)'); face.addColorStop(1, 'rgba(255, 170, 130, 0)');
      g.fillStyle = face; g.beginPath(); g.ellipse(cx, top + .135 * u, .065 * u, .075 * u, 0, 0, Math.PI * 2); g.fill();
      for (const ex of [-.028, .028]) {
        const x = cx + ex * u, y = top + .13 * u, r = .0075 * u;
        const eye = g.createRadialGradient(x, y, 0, x, y, r * 2.4);
        eye.addColorStop(0, SETTINGS.eyes); eye.addColorStop(.4, SETTINGS.eyes); eye.addColorStop(1, 'rgba(255, 74, 42, 0)');
        g.fillStyle = eye; g.fillRect(x - r * 3, y - r * 3, r * 6, r * 6);
      }
      keeper = out;
    };

    /** Plants, blurred like they are out of focus: flowers on round heads along the horizon, and tall leafy stems in
        front, near the edges. Each sways from its base. */
    let plants: { back: Plant[]; front: Plant[] } = { back: [], front: [] };
    const paintPlant = (kind: 'flower' | 'leaves', w: number, h: number, seed: number, blur: number) => {
      let n = seed;
      const random = () => { n = (n * 16807) % 2147483647; return (n - 1) / 2147483646; };
      const shape = canvasOf(w, h), s = shape.getContext('2d')!;
      s.lineCap = 'round';
      if (kind === 'flower') {
        const stems = 1 + Math.floor(random() * 3);
        for (let i = 0; i < stems; i++) {
          const bx = w * (.35 + random() * .3), tx = bx + (random() - .5) * w * .4, ty = h * (.08 + random() * .35);
          s.strokeStyle = SETTINGS.plants.stem; s.lineWidth = Math.max(1, w * .05);
          s.beginPath(); s.moveTo(bx, h); s.quadraticCurveTo(bx, (h + ty) / 2, tx, ty); s.stroke();
          s.fillStyle = SETTINGS.plants.back;
          s.beginPath(); s.arc(tx, ty, w * (.1 + random() * .07), 0, Math.PI * 2); s.fill();
        }
      } else {
        s.strokeStyle = SETTINGS.plants.front; s.fillStyle = SETTINGS.plants.front;
        const bx = w * .5;
        s.lineWidth = Math.max(1, w * .035);
        s.beginPath(); s.moveTo(bx, h); s.quadraticCurveTo(bx + w * .1, h * .5, bx - w * .05, 0); s.stroke();
        // Long, narrow leaves rising from the stem, alternating sides.
        const leaves = 6 + Math.floor(random() * 4);
        for (let i = 0; i < leaves; i++) {
          const y = h * (.1 + .82 * (i / leaves)), side = i % 2 ? 1 : -1, len = w * (.42 + random() * .12);
          s.save(); s.translate(bx + w * .03 * (1 - y / h), y); s.rotate(side * (.55 + random() * .35));
          s.beginPath(); s.moveTo(0, 0); s.quadraticCurveTo(side * len * .5, -len * .16, side * len, -len * .5); s.quadraticCurveTo(side * len * .45, len * .05, 0, 0); s.fill(); s.restore();
        }
      }
      const out = canvasOf(w * ratio, h * ratio), g = out.getContext('2d')!;
      g.imageSmoothingQuality = 'high';
      g.drawImage(soften(shape, blur), 0, 0, out.width, out.height);
      return out;
    };
    const growPlants = () => {
      let n = 17;
      const random = () => { n = (n * 16807) % 2147483647; return (n - 1) / 2147483646; };
      const back: Plant[] = [], front: Plant[] = [];
      const horizon = height * SETTINGS.horizon;
      const variants = Array.from({ length: 8 }, (_, i) => { const h = height * (.13 + random() * .14), w = h * .7; return { sprite: paintPlant('flower', w, h, 31 + i * 7, 4), w, h }; });
      for (let x = -width * .02; x < width * 1.02; x += width * (.022 + random() * .025)) {
        const v = variants[Math.floor(random() * variants.length)];
        back.push({ ...v, x, y: horizon + height * (random() * .06 - .01), phase: random() * 6.28, sway: .04 + random() * .04 });
      }
      for (const [x, lean] of [[.03, 1], [.1, 1], [.18, 1], [.84, -1], [.92, -1], [.98, -1]] as Array<[number, number]>) {
        const h = height * (.32 + random() * .22), w = h * .5;
        front.push({ sprite: paintPlant('leaves', w, h, 101 + Math.round(x * 100), 6), x: width * x + lean * random() * width * .02, y: height * 1.04, w, h, phase: random() * 6.28, sway: .05 + random() * .03 });
      }
      plants = { back, front };
    };
    const drawPlant = (plant: Plant, t: number, alpha: number) => {
      context.save();
      context.globalAlpha = alpha;
      context.translate(plant.x, plant.y);
      context.rotate(calm ? 0 : Math.sin(t * .7 + plant.phase) * plant.sway + Math.sin(t * 1.9 + plant.phase * 2) * plant.sway * .25);
      context.drawImage(plant.sprite, -plant.w / 2, -plant.h, plant.w, plant.h);
      context.restore();
    };

    // Homes: rings around the caregiver, on the ground (feet between the horizon and the bottom), nearest first.
    let homes: Array<{ x: number; y: number }> = [];
    const layout = () => {
      homes = [];
      const rings = [8, 10, 12, 12];
      let seed = 5;
      const random = () => { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; };
      rings.forEach((count, ring) => {
        const rx = .2 + ring * .09, ry = .15 + ring * .06;
        for (let j = 0; j < count; j++) {
          const a = Math.PI * .72 + (j + (ring % 2) * .5 + random() * .3) / count * Math.PI * 1.56;
          homes.push({ x: Math.min(.95, Math.max(.05, .5 + Math.cos(a) * rx)), y: Math.min(.97, Math.max(SETTINGS.horizon + .06, .78 + Math.sin(a) * ry)) });
        }
      });
    };
    layout();
    // How big a soul is where it stands: smaller far away (up near the horizon), larger up close.
    const sizeAt = (y: number) => height * (.13 + Math.min(1, Math.max(0, (y - SETTINGS.horizon) / (1 - SETTINGS.horizon))) * .27);
    const SPRITE_FOR = .42; // Sprites are painted at the largest size a soul can have, then drawn smaller.

    const meet = (id: string, mask: { width: number; height: number; mask: Uint8Array }, index: number, born: number): Soul => {
      const home = homes[index % homes.length], h = hash(id);
      return { id, ...mask, born, hx: home.x, hy: home.y, x: home.x, y: home.y, fromX: home.x, fromY: home.y, toX: home.x, toY: home.y, act: 'sit', actStart: 0, actEnd: 0, face: home.x < .5 ? 1 : -1, blink: 0, phase: (h % 1000) / 1000 * 6.28 };
    };

    /** What a soul does next. */
    const decide = (soul: Soul, now: number) => {
      const acts = Object.entries(SETTINGS.acts) as Array<[Act, [number, number, number]]>;
      let pick = Math.random(), act: Act = 'sit';
      for (const [name, [weight]] of acts) { pick -= weight; if (pick <= 0) { act = name; break; } }
      soul.fromX = soul.x; soul.fromY = soul.y; soul.toX = soul.x; soul.toY = soul.y;
      let length: number;
      if (act === 'walk') {
        // A short walk around its home, then it faces where it goes.
        soul.toX = Math.min(.96, Math.max(.04, soul.hx + (Math.random() - .5) * .22));
        soul.toY = Math.min(.98, Math.max(SETTINGS.horizon + .05, soul.hy + (Math.random() - .5) * .1));
        const distance = Math.hypot(soul.toX - soul.x, (soul.toY - soul.y) * height / width);
        length = Math.max(1.2, distance / SETTINGS.walkSpeed);
        if (Math.abs(soul.toX - soul.x) > .005) soul.face = Math.sign(soul.toX - soul.x);
      } else {
        const [, min, max] = SETTINGS.acts[act];
        length = min + Math.random() * (max - min);
        // Sitting, it turns towards her now and then.
        if (act === 'sit' && Math.random() < .5) soul.face = soul.x < .5 ? 1 : -1;
      }
      soul.act = act; soul.actStart = now; soul.actEnd = now + length * 1000;
    };

    const resize = () => {
      const rect = root.getBoundingClientRect();
      ratio = Math.min(devicePixelRatio || 1, 2);
      if (Math.round(rect.width) === width && Math.round(rect.height) === height) return;
      width = Math.round(rect.width); height = Math.round(rect.height);
      canvas.width = Math.round(width * ratio); canvas.height = Math.round(height * ratio);
      paintKeeper(height * KEEPER);
      growPlants();
      souls.forEach((soul) => { soul.sprite = undefined; });
    };

    const draw = (time: number) => {
      if (!width) return;
      const t = calm ? 0 : time / 1000, now = performance.now();
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      context.globalCompositeOperation = 'source-over';
      // Coral sky into lavender ground; a warm glow on the floor beneath her.
      const sky = context.createLinearGradient(0, 0, 0, height);
      SETTINGS.sky.forEach(([at, color]) => sky.addColorStop(at, color));
      context.fillStyle = sky; context.fillRect(0, 0, width, height);
      const pool = context.createRadialGradient(width * .5, height * .9, 0, width * .5, height * .9, width * .3);
      pool.addColorStop(0, `rgba(240, 120, 96, ${.6 + .08 * Math.sin(t * .6)})`); pool.addColorStop(1, 'rgba(240, 120, 96, 0)');
      context.save(); context.translate(0, height * .9); context.scale(1, .4); context.translate(0, -height * .9);
      context.fillStyle = pool; context.fillRect(0, 0, width, height * 2.5); context.restore();
      plants.back.forEach((plant) => drawPlant(plant, t, .85));
      const aura = context.createRadialGradient(width * .5, height * .45, 0, width * .5, height * .45, height * .55);
      aura.addColorStop(0, `rgba(255, 236, 205, ${.55 + .08 * Math.sin(t * .7)})`); aura.addColorStop(1, 'rgba(255, 236, 205, 0)');
      context.fillStyle = aura; context.fillRect(0, 0, width, height);

      const drawSoul = (soul: Soul) => {
        if (!calm && now > soul.actEnd) decide(soul, now);
        const p = soul.actEnd > soul.actStart ? Math.min(1, (now - soul.actStart) / (soul.actEnd - soul.actStart)) : 1;
        if (soul.act === 'walk') { soul.x = soul.fromX + (soul.toX - soul.fromX) * ease(p); soul.y = soul.fromY + (soul.toY - soul.fromY) * ease(p); }
        const size = sizeAt(soul.y);
        if (!soul.sprite || soul.spriteFor !== Math.round(height * SPRITE_FOR)) paintSoul(soul, Math.round(height * SPRITE_FOR));
        const sprite = soul.sprite!, k = size / soul.spriteFor!, w = sprite.width / ratio * k, h = sprite.height / ratio * k;
        // Its pose for what it is doing.
        const breath = Math.sin(t * 1.6 + soul.phase);
        let lift = 0, sx = 1, sy = 1 + breath * .012, tilt = 0, eyesOpen = 1;
        if (!calm) {
          if (soul.act === 'walk') { const steps = (now - soul.actStart) / 1000 * 5; lift = Math.abs(Math.sin(steps * Math.PI)) * size * .035; tilt = Math.sin(steps * Math.PI) * .025; }
          if (soul.act === 'hop') { const arc = Math.sin(p * Math.PI); lift = arc * size * .35; sy = 1 + (p < .15 || p > .85 ? -.08 : .05 * arc); sx = 2 - sy; }
          if (soul.act === 'stretch') { const s = Math.sin(p * Math.PI); sx = 1 + s * .12; sy = 1 - s * .1; }
          if (soul.act === 'groom') { tilt = Math.sin((now - soul.actStart) / 1000 * 9) * .05; sy = .97 + breath * .01; }
          if (soul.act === 'sleep') { sy = .84 + Math.sin(t * .9 + soul.phase) * .015; sx = 1.06; eyesOpen = 0; }
          // Blinks.
          if (now > soul.blink + 4200 + (soul.phase * 600)) soul.blink = now;
          if (now - soul.blink < 140) eyesOpen = Math.min(eyesOpen, .1);
        }
        const fade = soul.born ? Math.min(1, (now - soul.born) / 1600) : 1;
        const flip = soul.face * (soul.facing ?? 1);
        context.save();
        context.globalAlpha = fade;
        context.translate(soul.x * width, soul.y * height - lift);
        context.rotate(tilt);
        context.scale(flip * sx, sy);
        // Its feet on the spot (the sprite has room for the glow around the figure).
        const top = -h * (1 + ROOM) / (1 + ROOM * 2);
        // A soft shadow on the floor.
        context.save(); context.globalAlpha = fade * .22 * (1 - Math.min(1, lift / size)); context.scale(1, .18);
        const shade = context.createRadialGradient(0, 0, 0, 0, 0, w * .32); shade.addColorStop(0, '#2b2166'); shade.addColorStop(1, 'rgba(43, 33, 102, 0)');
        context.fillStyle = shade; context.fillRect(-w / 2, -w / 2, w, w); context.restore();
        context.drawImage(sprite, -w / 2, top, w, h);
        if (soul.eyes?.length && eyesOpen > 0) {
          const r = (soul.eyeR ?? 1.5) * k;
          for (const eye of soul.eyes) {
            const x = -w / 2 + eye.x * k, y = top + eye.y * k;
            context.save(); context.translate(x, y); context.scale(1, eyesOpen);
            const glow = context.createRadialGradient(0, 0, 0, 0, 0, r * 2.4);
            glow.addColorStop(0, SETTINGS.eyes); glow.addColorStop(.4, SETTINGS.eyes); glow.addColorStop(1, 'rgba(255, 74, 42, 0)');
            context.fillStyle = glow; context.fillRect(-r * 3, -r * 3, r * 6, r * 6);
            context.restore();
          }
        }
        context.restore();
      };
      // Further away first; those behind her before her, the rest after.
      const order = [...souls].sort((a, b) => a.y - b.y);
      const herLine = .86;
      order.filter((soul) => soul.y < herLine).forEach(drawSoul);
      if (keeper) {
        const w = keeper.width / ratio, h = keeper.height / ratio, size = height * KEEPER, sway = calm ? 0 : Math.sin(t * .5) * height * .003;
        context.drawImage(keeper, width * .5 - w / 2, height * 1.02 - (size * .2 + size) + sway, w, h);
      }
      order.filter((soul) => soul.y >= herLine).forEach(drawSoul);
      plants.front.forEach((plant) => drawPlant(plant, t, .8));

      // Grain over everything.
      context.globalCompositeOperation = 'overlay';
      context.globalAlpha = SETTINGS.grain;
      const shift = calm ? 0 : Math.floor(t * 12);
      context.fillStyle = context.createPattern(grain, 'repeat')!;
      context.save(); context.translate(-(shift * 37) % 160, -(shift * 53) % 160); context.fillRect(0, 0, width + 160, height + 160); context.restore();
      context.globalAlpha = 1;
      context.globalCompositeOperation = 'source-over';
    };

    let visible = false, running = false;
    const frame = (time: number) => {
      if (!visible) { running = false; return; }
      draw(time);
      requestAnimationFrame(frame);
    };
    const start = () => { if (!running && visible && !calm) { running = true; requestAnimationFrame(frame); } else if (calm) draw(0); };
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; if (visible) start(); }, { rootMargin: '10%' }).observe(root);
    new ResizeObserver(() => { resize(); draw(performance.now()); }).observe(root);

    const full = () => souls.length >= cap;
    const showFull = () => { if (full() && addLine) { addLine.hidden = true; setStatus('The place is full now. Every soul has company.'); } };

    // The souls already here.
    const load = async () => {
      let ids: string[] = [];
      try {
        const response = await fetch('/api/souls', { headers: { accept: 'application/json' } });
        if (!response.ok || !(response.headers.get('content-type') ?? '').includes('json')) throw new Error('No shared place');
        const data = await response.json() as { souls: string[]; cap: number };
        ids = data.souls; cap = data.cap;
      } catch {
        shared = false;
      }
      const loaded = shared
        ? await Promise.all(ids.map(async (id) => { try { const r = await fetch(`/api/souls?id=${encodeURIComponent(id)}`); const m = r.ok ? decode(new Uint8Array(await r.arrayBuffer())) : null; return m && { id, m }; } catch { return null; } }))
        : localSouls().map(({ id, data }) => { const m = decode(fromBase64(data)); return m && { id, m }; });
      souls = loaded.filter((entry): entry is { id: string; m: NonNullable<ReturnType<typeof decode>> } => !!entry).map(({ id, m }, i) => meet(id, m, i, 0));
      draw(performance.now());
      showFull();
    };
    load();

    // Adding a pet.
    addButton?.addEventListener('click', () => {
      setStatus('Choose a photo of your whole cat or dog, from ears to paws. It stays on your device: only their silhouette is kept.');
      input?.click();
    });
    input?.addEventListener('change', async () => {
      const file = input.files?.[0];
      input.value = '';
      if (!file) return;
      if (full()) { showFull(); return; }
      if (addButton) addButton.disabled = true;
      setStatus('Looking for your pet…');
      try {
        const found = await silhouette(file);
        if (found === 'none') { setStatus('I couldn’t find a cat or a dog in that photo. Try another one.'); return; }
        if (found === 'cut') { setStatus('Only whole bodies, please: a photo where all of your pet fits, from ears to paws, with a little room around.'); return; }
        const bytes = encode(found.width, found.height, found.mask);
        let id = `souls/local-${Date.now().toString(36)}`;
        if (shared) {
          const response = await fetch('/api/souls', { method: 'POST', headers: { 'content-type': 'application/octet-stream' }, body: bytes }).catch(() => null);
          if (response?.status === 409) { cap = souls.length; showFull(); return; }
          if (response?.ok) id = ((await response.json()) as { id: string }).id;
          else { shared = false; keepLocally(id, bytes); }
        } else keepLocally(id, bytes);
        souls.push(meet(id, found, souls.length, performance.now()));
        if (calm) draw(0);
        setStatus(shared ? 'Welcome. They’re in good company now, for good.' : 'Welcome. They’re in good company now (kept on this device).');
        showFull();
      } catch {
        setStatus('Something went wrong reading that photo. Try another one.');
      } finally {
        if (addButton) addButton.disabled = false;
      }
    });

    // Music, if they want it: the Spotify player loads only when asked for.
    const musicButton = caption.querySelector<HTMLButtonElement>('[data-souls-music]');
    const player = caption.querySelector<HTMLElement>('[data-souls-player]');
    musicButton?.addEventListener('click', () => {
      if (!player) return;
      if (!player.firstElementChild) {
        const frame = document.createElement('iframe');
        frame.src = player.dataset.soulsPlayer ?? '';
        frame.title = 'Spotify player';
        frame.loading = 'lazy';
        frame.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
        player.append(frame);
      }
      player.hidden = !player.hidden;
      musicButton.setAttribute('aria-expanded', String(!player.hidden));
    });
  });
</script>

<style>
  .souls-field { position: absolute; inset: 0; overflow: hidden; }
  .souls-field-canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
</style>
