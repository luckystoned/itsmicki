---
// Missing souls: a warm, glowing place (coral sky, lavender ground, blurred plants swaying) where a caregiver looks
// after the animals people leave with her. Anyone can add their cat or dog from a full-body photo. The photo is read on
// their device (MediaPipe finds the animal and cuts it out) and only a description of it is kept: cat or dog, its
// size (asked, for dogs), its colours and its markings (plain, tabby stripes or patches). Each one becomes a soft,
// ethereal illustrated cat or dog in its own colours, with an aura. Once here, it lives its own little life: it stands,
// walks about on its paws, hops, stretches, grooms, lies down to nap and blinks; and a newcomer is first stroked by the
// caregiver. The souls are shared by every visitor (api/souls.ts, Vercel Blob) and stay for good, until the place is
// full; without the shared store (local dev, or before it is connected) they are kept on the visitor's device. With
// reduced motion nothing moves.
type Props = { label: string };
const { label } = Astro.props;
---

<div class="souls-field" data-souls-field>
  <canvas class="souls-field-canvas" role="img" aria-label={label}></canvas>
  <!-- A song to listen to while here, if they want: the official audio on YouTube (whole song, its own volume control),
       in the top right corner. It never plays on its own. -->
  <iframe
    class="souls-field-music"
    src="https://www.youtube-nocookie.com/embed/Bi8G90nkmDA?rel=0&playsinline=1"
    title="Dauwd — Theory of Colours (official audio, YouTube)"
    loading="lazy"
    allow="encrypted-media; picture-in-picture"
    referrerpolicy="strict-origin-when-cross-origin"
  ></iframe>
</div>

<script>
  import { loadVision } from '@/scripts/camera';

  const SETTINGS = {
    cap: 42, // Souls the place holds (the server has the final word).
    minPet: .008, // Share of the photo the animal has to cover to count as found.
    margin: .012, // Whole body: the animal must not touch the photo's sides or bottom (share of the photo).
    model: 'https://storage.googleapis.com/mediapipe-models/image_segmenter/deeplab_v3/float32/1/deeplab_v3.tflite',
    // Finds the animal coarsely; then Magic Touch, given points on it, cuts it out with crisp edges.
    edges: 'https://storage.googleapis.com/mediapipe-models/interactive_segmenter/magic_touch/float32/1/magic_touch.tflite',
    classes: { cat: 8, dog: 12 }, // DeepLab v3 (PASCAL VOC) labels.
    // The place, after the reference: a coral sky melting into a lavender-blue ground, a warm glow on the floor.
    sky: [[0, '#e46a55'], [.3, '#ec7d60'], [.45, '#f19a7c'], [.56, '#a198e2'], [.8, '#8380d8'], [1, '#716ecb']] as Array<[number, string]>,
    horizon: .5, // Where the ground starts, as a share of the height.
    plants: { back: '#98a3ee', stem: '#6f8f63', front: '#5f8456' }, // Flowers on the horizon, their stems, leaves in front.
    eyes: '#ff4a2a', // Eyes are little arches (∩), smiling shut.
    grain: .17, // Strength of the film grain over everything.
    // How big each kind is next to the others (a medium dog is 1).
    scale: { cat: .78, dog: [.66, .92, 1.2] },
    // What they do, and how often; lengths in seconds.
    acts: { sit: [.32, 3, 8], walk: [.3, 0, 0], hop: [.06, 1.1, 1.1], stretch: [.1, 1.8, 1.8], groom: [.08, 2.4, 3.4], sleep: [.12, 7, 13] } as Record<string, [number, number, number]>,
    walkSpeed: .045, // Share of the width per second.
  };

  /** What is kept of each pet: cat or dog, size (dogs: 0 small, 1 medium, 2 big), markings (0 plain, 1 tabby,
      2 patches) and its colours (light, mid, dark). It travels as a short code, e.g. "c12_f2d9b0b98a5e4a3326". */
  type Look = { kind: 'cat' | 'dog'; size: 0 | 1 | 2; pattern: 0 | 1 | 2; colours: [string, string, string] };
  const lookCode = (look: Look) => `${look.kind[0]}${look.size}${look.pattern}_${look.colours.map((c) => c.slice(1)).join('')}`;
  const readLook = (id: string): Look | null => {
    const m = /([cd])([012])([012])_([0-9a-f]{6})([0-9a-f]{6})([0-9a-f]{6})(?:\.json)?$/.exec(id);
    if (!m) return null;
    return { kind: m[1] === 'c' ? 'cat' : 'dog', size: Number(m[2]) as 0 | 1 | 2, pattern: Number(m[3]) as 0 | 1 | 2, colours: [`#${m[4]}`, `#${m[5]}`, `#${m[6]}`] };
  };

  type Act = 'sit' | 'walk' | 'hop' | 'stretch' | 'groom' | 'sleep' | 'pet';
  type Layer = { canvas: HTMLCanvasElement; x: number; y: number; w: number; h: number };
  type Leg = Layer & { pivotX: number; pivotY: number; near: boolean; front: boolean };
  type Figure = { body: Layer; legs: Leg[]; eyes: Array<{ x: number; y: number }>; eyeR: number; legLength: number; unit: number };
  type Soul = {
    id: string; look: Look; born: number; figure?: Figure;
    // Life: its home, where it is (feet; shares of the frame), what it is doing and until when.
    hx: number; hy: number; x: number; y: number; fromX: number; fromY: number; toX: number; toY: number;
    act: Act; actStart: number; actEnd: number; face: number; faceShown: number; blink: number; phase: number; drawn: number;
  };
  type Plant = { sprite: HTMLCanvasElement; x: number; y: number; w: number; h: number; phase: number; sway: number };

  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const STORE = 'missing-souls';

  const hash = (text: string) => { let h = 2166136261; for (let i = 0; i < text.length; i++) h = Math.imul(h ^ text.charCodeAt(i), 16777619); return h >>> 0; };
  const canvasOf = (width: number, height: number) => { const c = document.createElement('canvas'); c.width = Math.max(1, Math.round(width)); c.height = Math.max(1, Math.round(height)); return c; };
  const ease = (p: number) => p * p * (3 - 2 * p);
  const hex = (rgb: number[]) => `#${rgb.map((v) => Math.round(Math.min(255, Math.max(0, v))).toString(16).padStart(2, '0')).join('')}`;
  const rgbOf = (colour: string) => [1, 3, 5].map((i) => parseInt(colour.slice(i, i + 2), 16));
  const mix = (a: string, b: string, t: number) => { const x = rgbOf(a), y = rgbOf(b); return hex(x.map((v, i) => v + (y[i] - v) * t)); };
  /** An eye: a little arch (∩) with a soft glow; asleep, it turns into a closed curve (∪). */
  const drawEye = (g: CanvasRenderingContext2D, x: number, y: number, r: number, asleep = false) => {
    g.save();
    g.lineCap = 'round';
    g.lineWidth = Math.max(.9, r * .75);
    g.strokeStyle = SETTINGS.eyes;
    g.shadowColor = 'rgba(255, 74, 42, .7)';
    g.shadowBlur = r * 2.2;
    g.beginPath();
    if (asleep) g.arc(x, y - r * .5, r * 1.05, Math.PI * .15, Math.PI * .85);
    else g.arc(x, y + r * .55, r * 1.15, Math.PI * 1.12, Math.PI * 1.88);
    g.stroke();
    g.restore();
  };

  // Souls kept on this device, when the shared place cannot be reached. `?souls=reset` in the address clears them.
  try { if (new URLSearchParams(location.search).get('souls') === 'reset') localStorage.removeItem(STORE); } catch { /* No storage. */ }
  const localSouls = (): string[] => { try { const list = JSON.parse(localStorage.getItem(STORE) ?? '[]'); return Array.isArray(list) ? list.filter((id) => typeof id === 'string') : []; } catch { return []; } };
  const keepLocally = (id: string) => { try { localStorage.setItem(STORE, JSON.stringify([...localSouls(), id])); } catch { /* Storage full or blocked: it stays for this visit. */ } };

  /** Reads a pet from a photo: cat or dog, its colours and its markings; or why it can't. */
  type Masks = { confidenceMasks?: Array<{ width: number; height: number; getAsFloat32Array: () => Float32Array }>; close: () => void };
  type Point = { x: number; y: number };
  let segmenter: Promise<{ segment: (image: HTMLCanvasElement) => Masks }> | null = null;
  let cutter: Promise<{ segment: (image: HTMLCanvasElement, roi: { scribble: Point[] }) => Masks } | null> | null = null;
  const readPet = async (file: File): Promise<Omit<Look, 'size'> | 'none' | 'cut'> => {
    segmenter ??= (async () => {
      const { module, files } = await loadVision();
      return module.ImageSegmenter.createFromOptions(files, { baseOptions: { modelAssetPath: SETTINGS.model }, runningMode: 'IMAGE', outputCategoryMask: false, outputConfidenceMasks: true });
    })();
    cutter ??= (async () => {
      try {
        const { module, files } = await loadVision();
        return await module.InteractiveSegmenter.createFromOptions(files, { baseOptions: { modelAssetPath: SETTINGS.edges }, outputCategoryMask: false, outputConfidenceMasks: true });
      } catch { return null; }
    })();
    const model = await segmenter;
    const bitmap = await createImageBitmap(file);
    const scale = Math.min(1, 640 / Math.max(bitmap.width, bitmap.height));
    const photo = canvasOf(bitmap.width * scale, bitmap.height * scale);
    photo.getContext('2d')!.drawImage(bitmap, 0, 0, photo.width, photo.height);
    bitmap.close();
    const result = model.segment(photo);
    const masks = result.confidenceMasks;
    if (!masks) { result.close(); return 'none'; }
    const cat = masks[SETTINGS.classes.cat].getAsFloat32Array(), dog = masks[SETTINGS.classes.dog].getAsFloat32Array();
    const { width, height } = masks[SETTINGS.classes.cat];
    result.close();
    // The animal: wherever the model sees a cat or a dog; which of the two, by how much it sees of each.
    const pet = new Float32Array(width * height);
    let found = 0, cats = 0, dogs = 0, x0 = width, y0 = height, x1 = -1, y1 = -1;
    for (let y = 0; y < height; y++) for (let x = 0; x < width; x++) {
      const i = y * width + x, p = Math.max(cat[i], dog[i]);
      pet[i] = p; cats += cat[i]; dogs += dog[i];
      if (p > .5) { found++; if (x < x0) x0 = x; if (x > x1) x1 = x; if (y < y0) y0 = y; if (y > y1) y1 = y; }
    }
    if (found / (width * height) < SETTINGS.minPet) return 'none';
    // Whole body only: an animal running off the sides or the bottom of the photo is cut (a close-up of a face, say).
    const m = SETTINGS.margin;
    if (x0 < width * m || x1 > width * (1 - m) || y1 > height * (1 - m) || y0 < height * m * .5) return 'cut';
    // Crisp edges (Magic Touch, from points the model is surest of), so the colours are read from the animal only.
    const sure: Point[] = [];
    const step = Math.max(4, Math.round(Math.sqrt(found / 24)));
    for (let y = y0; y <= y1; y += step) for (let x = x0; x <= x1; x += step) if (pet[y * width + x] > .8) sure.push({ x: x / width, y: y / height });
    const scribble = sure.filter((_, i) => i % Math.max(1, Math.ceil(sure.length / 12)) === 0);
    const edges = await cutter;
    if (edges && scribble.length) {
      try {
        const cut = edges.segment(photo, { scribble });
        const fine = cut.confidenceMasks?.[0];
        if (fine && fine.width === width && fine.height === height) {
          const crisp = fine.getAsFloat32Array();
          for (let i = 0; i < pet.length; i++) pet[i] = pet[i] > .08 ? crisp[i] : 0;
        }
        cut.close();
      } catch { /* Keep the coarse cut. */ }
    }
    // Its colours: the lightest, middle and darkest fifths of its fur.
    const rgb = photo.getContext('2d')!.getImageData(0, 0, width, height).data;
    const luma = new Float32Array(width * height), inside: number[] = [];
    for (let i = 0; i < luma.length; i++) { luma[i] = .299 * rgb[i * 4] + .587 * rgb[i * 4 + 1] + .114 * rgb[i * 4 + 2]; if (pet[i] > .6) inside.push(i); }
    if (inside.length < 50) return 'none';
    inside.sort((a, b) => luma[a] - luma[b]);
    const average = (from: number, to: number) => {
      const slice = inside.slice(Math.floor(inside.length * from), Math.max(Math.floor(inside.length * from) + 1, Math.floor(inside.length * to)));
      const sum = [0, 0, 0];
      slice.forEach((i) => { sum[0] += rgb[i * 4]; sum[1] += rgb[i * 4 + 1]; sum[2] += rgb[i * 4 + 2]; });
      return sum.map((v) => v / slice.length);
    };
    // A little lifted and glowing, but its own colours.
    const glow = (c: number[], lift: number) => c.map((v) => v + (255 - v) * lift);
    const colours: [string, string, string] = [hex(glow(average(.8, 1), .25)), hex(glow(average(.4, .6), .15)), hex(glow(average(0, .2), .1))];
    // Its markings: little contrast is plain fur; contrast in fine detail is tabby stripes; contrast in big areas is patches.
    const contrast = luma[inside[Math.floor(inside.length * .85)]] - luma[inside[Math.floor(inside.length * .15)]];
    let fine = 0, counted = 0;
    for (const i of inside) {
      const x = i % width, y = (i - x) / width;
      if (x < 3 || y < 3 || x > width - 4 || y > height - 4) continue;
      let sum = 0, n = 0;
      for (let dy = -3; dy <= 3; dy += 3) for (let dx = -3; dx <= 3; dx += 3) { const j = i + dy * width + dx; if (pet[j] > .6) { sum += luma[j]; n++; } }
      if (n > 6) { fine += Math.abs(luma[i] - sum / n); counted++; }
    }
    fine = counted ? fine / counted : 0;
    const pattern: 0 | 1 | 2 = contrast < 50 ? 0 : fine / contrast > .14 ? 1 : 2;
    return { kind: dogs > cats ? 'dog' : 'cat', pattern, colours };
  };

  document.querySelectorAll<HTMLElement>('[data-souls-field]').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('.souls-field-canvas')!;
    const context = canvas.getContext('2d')!;
    const caption = root.closest('section') ?? document;
    const addButton = caption.querySelector<HTMLButtonElement>('[data-souls-add]');
    const input = caption.querySelector<HTMLInputElement>('[data-souls-input]');
    const status = caption.querySelector<HTMLElement>('[data-souls-status]');
    const addLine = caption.querySelector<HTMLElement>('[data-souls-add-line]');
    const setStatus = (text: string) => { if (status) { status.textContent = text; status.hidden = !text; } };

    let width = 0, height = 0, ratio = 1;
    let souls: Soul[] = [];
    let cap = SETTINGS.cap;
    let shared = true; // False when the shared place cannot be reached: souls are kept on this device.

    // Film grain: a noise tile, shifted every few frames so it lives.
    const grain = canvasOf(160, 160);
    {
      const g = grain.getContext('2d')!, img = g.createImageData(160, 160);
      for (let i = 0; i < img.data.length; i += 4) { const v = Math.random() < .03 ? 255 : Math.random() * 200; img.data[i] = img.data[i + 1] = img.data[i + 2] = v; img.data[i + 3] = 255; }
      g.putImageData(img, 0, 0);
    }

    // Soft edges without canvas filters (Safari): halve the image step by step, then double it back up the same way;
    // each step blends neighbours, so the result is a smooth blur (one big jump would look blocky).
    const soften = (source: HTMLCanvasElement, amount: number) => {
      const steps: HTMLCanvasElement[] = [source];
      let scale = 1;
      while (scale * 2 <= amount) {
        const last = steps[steps.length - 1], next = canvasOf(last.width / 2, last.height / 2), n = next.getContext('2d')!;
        n.imageSmoothingQuality = 'high';
        n.drawImage(last, 0, 0, next.width, next.height);
        steps.push(next);
        scale *= 2;
      }
      if (amount / scale > 1.05) {
        const last = steps[steps.length - 1], next = canvasOf(source.width / amount, source.height / amount), n = next.getContext('2d')!;
        n.imageSmoothingQuality = 'high';
        n.drawImage(last, 0, 0, next.width, next.height);
        steps.push(next);
      }
      let up = steps[steps.length - 1];
      for (let i = steps.length - 2; i >= 0; i--) {
        const next = canvasOf(steps[i].width, steps[i].height), n = next.getContext('2d')!;
        n.imageSmoothingQuality = 'high';
        n.drawImage(up, 0, 0, next.width, next.height);
        up = next;
      }
      return up;
    };

    /** A pet as a soft illustrated figure, facing right, in its own colours and markings: a body, a head with ears
        (pointed for a cat, floppy with a snout for a dog), a tail, and four legs on their own so they can walk and fold.
        Everything is drawn crisp in unit space (feet at y = 1, about one unit tall), then blurred into a glow. */
    const paintFigure = (soul: Soul, unit: number): Figure => {
      const { look } = soul, dog = look.kind === 'dog';
      let n = hash(soul.id) || 1;
      const random = () => { n = (n * 16807) % 2147483647; return (n - 1) / 2147483646; };
      const [light, mid, dark] = look.colours;
      // Proportions, a little different for every one; small dogs have shorter legs and bigger heads, big dogs longer.
      const legScale = dog ? [.72, 1, 1.12][look.size] : 1;
      const legTop = 1 - (dog ? .38 : .36) * legScale * (.94 + random() * .12);
      const bodyLength = (dog ? .66 : .6) * (.93 + random() * .14), bodyDepth = (dog ? .3 : .26) * (.94 + random() * .12);
      const bodyCx = .56, bodyCy = legTop - bodyDepth * .3;
      const headR = (dog ? [.17, .145, .135][look.size] : .14) * (.95 + random() * .1);
      const headX = bodyCx + bodyLength / 2 + headR * .55, headY = bodyCy - bodyDepth * .55 - headR * .45;
      const legW = (dog ? [.075, .08, .085][look.size] : .062);
      const pad = .3; // Room around the figure for its glow, in units.
      const W = (1.45 + pad * 2) * unit, H = (1.15 + pad * 2) * unit, ox = pad * unit, oy = (pad + .15) * unit; // Unit (0,0) → canvas (ox,oy).
      const X = (u: number) => ox + u * unit, Y = (u: number) => oy + u * unit;

      // Its coat: light on the back and face, into its colour, into shadow towards the belly and paws.
      const coat = (g: CanvasRenderingContext2D, w: number, h: number) => {
        const fill = g.createLinearGradient(0, Y(headY - headR * 1.6), 0, Y(1));
        fill.addColorStop(0, light); fill.addColorStop(.45, mid); fill.addColorStop(1, dark);
        g.fillStyle = fill; g.fillRect(0, 0, w, h);
      };
      const finish = (shape: HTMLCanvasElement, colour: (g: CanvasRenderingContext2D) => void) => {
        const c = shape.getContext('2d')!;
        c.globalCompositeOperation = 'source-atop';
        colour(c);
        // The glow: a wide soft halo in its lightest colour, then the figure itself, soft at the edges.
        const out = canvasOf(shape.width, shape.height), g = out.getContext('2d')!;
        g.imageSmoothingQuality = 'high';
        const halo = soften(shape, 14), h = halo.getContext('2d')!;
        h.globalCompositeOperation = 'source-atop'; h.fillStyle = mix(light, '#fff8ee', .35); h.fillRect(0, 0, halo.width, halo.height);
        g.globalAlpha = .55; g.drawImage(halo, 0, 0);
        g.globalAlpha = 1; g.drawImage(soften(shape, 3.2), 0, 0);
        g.globalAlpha = .7; g.drawImage(soften(shape, 1.6), 0, 0);
        return out;
      };

      // The body, head, ears, tail (and a dog's snout).
      const shape = canvasOf(W * ratio, H * ratio), s = shape.getContext('2d')!;
      s.scale(ratio, ratio); s.fillStyle = '#fff'; s.strokeStyle = '#fff'; s.lineCap = 'round';
      s.beginPath(); s.ellipse(X(bodyCx), Y(bodyCy), bodyLength / 2 * unit, bodyDepth / 2 * unit, 0, 0, Math.PI * 2); s.fill();
      // Neck, from the shoulders up to the head.
      s.beginPath(); s.moveTo(X(bodyCx + bodyLength * .28), Y(bodyCy - bodyDepth * .35)); s.lineTo(X(headX - headR * .3), Y(headY)); s.lineWidth = headR * 1.3 * unit; s.stroke();
      s.beginPath(); s.arc(X(headX), Y(headY), headR * unit, 0, Math.PI * 2); s.fill();
      if (dog) {
        s.beginPath(); s.ellipse(X(headX + headR * .85), Y(headY + headR * .35), headR * .62 * unit, headR * .45 * unit, .1, 0, Math.PI * 2); s.fill();
        // Floppy ears, hanging by the cheeks.
        s.beginPath(); s.ellipse(X(headX - headR * .55), Y(headY + headR * .25), headR * .32 * unit, headR * .7 * unit, .35, 0, Math.PI * 2); s.fill();
      } else {
        // Pointed ears.
        for (const [bx, tip] of [[-.55, -.62], [.35, .5]] as Array<[number, number]>) {
          s.beginPath();
          s.moveTo(X(headX + headR * (bx - .3)), Y(headY - headR * .55));
          s.lineTo(X(headX + headR * tip), Y(headY - headR * 1.55));
          s.lineTo(X(headX + headR * (bx + .45)), Y(headY - headR * .75));
          s.closePath(); s.fill();
        }
      }
      // Tail: a cat's rises in a soft curve; a dog's is shorter and wags up.
      const tailBaseX = bodyCx - bodyLength / 2 + .03, tailBaseY = bodyCy - bodyDepth * .2;
      s.lineWidth = (dog ? .05 : .045) * unit;
      s.beginPath(); s.moveTo(X(tailBaseX), Y(tailBaseY));
      if (dog) s.quadraticCurveTo(X(tailBaseX - .12), Y(tailBaseY - .02), X(tailBaseX - .14), Y(tailBaseY - .2));
      else s.quadraticCurveTo(X(tailBaseX - .2), Y(tailBaseY - .02), X(tailBaseX - .16), Y(tailBaseY - .34 - random() * .06));
      s.stroke();
      const body = finish(shape, (c) => {
        c.setTransform(1, 0, 0, 1, 0, 0); c.scale(ratio, ratio);
        coat(c, W, H);
        // Markings.
        if (look.pattern === 1) {
          // Tabby: soft curved stripes across the back, a few on the forehead, rings on the tail.
          c.strokeStyle = dark; c.globalAlpha = .55; c.lineCap = 'round'; c.lineWidth = .028 * unit;
          for (let i = 0; i < 6; i++) {
            const x = bodyCx - bodyLength * .38 + i * bodyLength * .15;
            c.beginPath(); c.moveTo(X(x - .02), Y(bodyCy - bodyDepth * .55)); c.quadraticCurveTo(X(x + .03), Y(bodyCy), X(x - .01), Y(bodyCy + bodyDepth * .3)); c.stroke();
          }
          for (let i = -1; i <= 1; i++) { c.beginPath(); c.moveTo(X(headX + i * headR * .3), Y(headY - headR * .85)); c.lineTo(X(headX + i * headR * .25), Y(headY - headR * .4)); c.stroke(); }
          for (let i = 1; i <= 3; i++) { c.beginPath(); c.arc(X(tailBaseX - .05 - i * .035), Y(tailBaseY - i * .08), .03 * unit, 0, Math.PI * 2); c.stroke(); }
          c.globalAlpha = 1;
        } else if (look.pattern === 2) {
          // Patches: the darkest colour on the back and head, the lightest on the chest, belly and muzzle.
          c.fillStyle = dark; c.globalAlpha = .7;
          c.beginPath(); c.ellipse(X(bodyCx - bodyLength * .05), Y(bodyCy - bodyDepth * .2), bodyLength * .38 * unit, bodyDepth * .35 * unit, 0, 0, Math.PI * 2); c.fill();
          c.beginPath(); c.arc(X(headX), Y(headY - headR * .3), headR * .85 * unit, 0, Math.PI * 2); c.fill();
          c.fillStyle = mix(light, '#ffffff', .4); c.globalAlpha = .9;
          c.beginPath(); c.ellipse(X(bodyCx + bodyLength * .1), Y(bodyCy + bodyDepth * .3), bodyLength * .3 * unit, bodyDepth * .22 * unit, 0, 0, Math.PI * 2); c.fill();
          c.beginPath(); c.ellipse(X(headX + headR * .3), Y(headY + headR * .45), headR * .5 * unit, headR * .4 * unit, 0, 0, Math.PI * 2); c.fill();
          c.globalAlpha = 1;
        }
        // A lighter glow on the face and chest.
