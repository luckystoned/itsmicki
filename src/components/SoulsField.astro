      if (has('chest')) for (let j = headH + 1; j < gh; j++) { set(bodyLen - 1, j, LIGHT); set(bodyLen - 2, j, LIGHT); }
      if (has('mask')) for (let i = hx0; i <= hx1; i++) set(i, 2, DARK);
      if (has('eye')) { const c = has('eyeLight') ? LIGHT : DARK; set(hx1 - 1, 1, c); set(hx1 - 1, 2, c); set(hx1, 2, c); }
      if (has('blaze')) { set(hx1, 1, LIGHT); set(hx1, 2, LIGHT); }
      if (has('muzzle')) { if (dog) { set(hx1 + 1, 3, LIGHT); set(hx1 + 2, 3, LIGHT); set(hx1 + 1, 2, LIGHT); } else set(hx1 - 1, 3, LIGHT); }
