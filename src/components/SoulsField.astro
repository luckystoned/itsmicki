        context.save();
        context.globalAlpha = nameAlpha;
        context.font = `400 ${Math.max(11, Math.round(height * .028))}px ${getComputedStyle(root).fontFamily}`;
        context.textAlign = 'center';
        context.fillStyle = '#fffaf0';
        context.shadowColor = 'rgba(80, 60, 140, .6)';
        context.shadowBlur = 8;
