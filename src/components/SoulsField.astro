      }
      return best;
    };
    // Picking them up: press on one (or touch it) and drag; let go and it falls back down.
    let held: { soul: Soul; offX: number; offY: number; vx: number; ax: number; lastX: number; lastT: number; id: number } | null = null;
    const local = (event: { clientX: number; clientY: number }) => { const rect = canvas.getBoundingClientRect(); return { x: event.clientX - rect.left, y: event.clientY - rect.top }; };
    const grabbable = (value: boolean) => { if (root.hasAttribute('data-grab') !== value) { root.toggleAttribute('data-grab', value); document.dispatchEvent(new Event('project-preview-refresh')); } };
    root.addEventListener('pointerdown', (event) => {
      const soul = nearest(event);
      if (!soul) return;
      nameShown.id = soul.id; nameShown.until = performance.now() + 2500;
      if (calm) return;
