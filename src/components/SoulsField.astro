---
// Missing souls: a soft, glowing place where a caregiver looks after the animals people leave with her. Anyone can add
// their cat or dog from a photo: the photo is read on their device (MediaPipe finds the animal) and only its silhouette
// is kept, painted in luminous gradients with grain, so each one keeps its own shape and breed. The souls are shared by
// every visitor (api/souls.ts, Vercel Blob) and stay for good, until the place is full. Without the shared store (local
// dev, or before it is connected) they are kept on the visitor's device instead. With reduced motion nothing moves.
type Props = { label: string };
const { label } = Astro.props;
---

<div class="souls-field" data-souls-field role="img" aria-label={label}>
  <canvas class="souls-field-canvas" aria-hidden="true"></canvas>
</div>

<script>
  import { loadVision } from '@/scripts/camera';

  const SETTINGS = {
    cap: 42, // Souls the place holds (the server has the final word).
    maxSide: 160, // Largest silhouette side kept, in pixels.
    minPet: .008, // Share of the photo the animal has to cover to count as found.
    model: 'https://storage.googleapis.com/mediapipe-models/image_segmenter/deeplab_v3/float32/1/deeplab_v3.tflite',
    // Finds the animal coarsely; then Magic Touch, given points on it, cuts it out with crisp edges.
    edges: 'https://storage.googleapis.com/mediapipe-models/interactive_segmenter/magic_touch/float32/1/magic_touch.tflite',
    classes: { cat: 8, dog: 12 }, // DeepLab v3 (PASCAL VOC) labels.
    // The place, after the references: warm paper fading into peach, hazes of lavender, green and coral.
    paper: ['#efe8de', '#f4dccb', '#f2c9b0'],
    haze: [['#b6a6e6', .55], ['#a8dc8c', .45], ['#f29a86', .4], ['#8f86d8', .35]] as Array<[string, number]>,
    // Each soul takes one of these: light → mid → shadow, then its eyes.
    coats: [
      ['#ff8fbf', '#9a7cf0', '#3f4fd0'],
      ['#ff7a52', '#ff9fb8', '#7f6fe8'],
      ['#f2f7dc', '#a8e08a', '#4fb894'],
      ['#ff5a2e', '#ff8f5c', '#c46fe0'],
      ['#8a6ff0', '#33349a', '#3fae86'],
      ['#ffb0cf', '#e05aa8', '#5a66e8'],
      ['#fff0d6', '#ffb38c', '#a07ff0'],
      ['#c2f08c', '#5ccf96', '#5a5ae0'],
    ],
    eyes: '#ff4a2a',
    grain: .2, // Strength of the film grain over everything.
  };

  type Soul = { id: string; width: number; height: number; mask: Uint8Array; born: number; sprite?: HTMLCanvasElement; spriteFor?: number };
  type Slot = { x: number; y: number; size: number; behind: boolean };

  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const STORE = 'missing-souls';

  const hash = (text: string) => { let h = 2166136261; for (let i = 0; i < text.length; i++) h = Math.imul(h ^ text.charCodeAt(i), 16777619); return h >>> 0; };
  const canvasOf = (width: number, height: number) => { const c = document.createElement('canvas'); c.width = Math.max(1, Math.round(width)); c.height = Math.max(1, Math.round(height)); return c; };
  const encode = (width: number, height: number, mask: Uint8Array) => { const out = new Uint8Array(4 + mask.length); out.set([width & 255, width >> 8, height & 255, height >> 8]); out.set(mask, 4); return out; };
  const decode = (id: string, bytes: Uint8Array): Soul | null => {
    if (bytes.length < 4) return null;
    const width = bytes[0] | (bytes[1] << 8), height = bytes[2] | (bytes[3] << 8);
    if (!width || !height || bytes.length !== 4 + width * height) return null;
    return { id, width, height, mask: bytes.slice(4), born: 0 };
  };
  const toBase64 = (bytes: Uint8Array) => { let s = ''; bytes.forEach((b) => { s += String.fromCharCode(b); }); return btoa(s); };
  const fromBase64 = (text: string) => Uint8Array.from(atob(text), (c) => c.charCodeAt(0));

  // Souls kept on this device, when the shared place cannot be reached.
  const localSouls = (): Array<{ id: string; data: string }> => { try { return JSON.parse(localStorage.getItem(STORE) ?? '[]'); } catch { return []; } };
  const keepLocally = (id: string, bytes: Uint8Array) => { try { localStorage.setItem(STORE, JSON.stringify([...localSouls(), { id, data: toBase64(bytes) }])); } catch { /* Storage full or blocked: it stays for this visit. */ } };

  /** Finds the cat or dog in a photo and returns its silhouette, or null when there is none. */
  type Masks = { confidenceMasks?: Array<{ width: number; height: number; getAsFloat32Array: () => Float32Array }>; close: () => void };
  type Point = { x: number; y: number };
  let segmenter: Promise<{ segment: (image: HTMLCanvasElement) => Masks }> | null = null;
  let cutter: Promise<{ segment: (image: HTMLCanvasElement, roi: { scribble: Point[] }) => Masks } | null> | null = null;
  const silhouette = async (file: File) => {
    segmenter ??= (async () => {
      const { module, files } = await loadVision();
      return module.ImageSegmenter.createFromOptions(files, { baseOptions: { modelAssetPath: SETTINGS.model }, runningMode: 'IMAGE', outputCategoryMask: false, outputConfidenceMasks: true });
    })();
    cutter ??= (async () => {
      try {
        const { module, files } = await loadVision();
        return await module.InteractiveSegmenter.createFromOptions(files, { baseOptions: { modelAssetPath: SETTINGS.edges }, outputCategoryMask: false, outputConfidenceMasks: true });
      } catch { return null; }
    })();
    const model = await segmenter;
    const bitmap = await createImageBitmap(file);
    const scale = Math.min(1, 512 / Math.max(bitmap.width, bitmap.height));
    const photo = canvasOf(bitmap.width * scale, bitmap.height * scale);
    photo.getContext('2d')!.drawImage(bitmap, 0, 0, photo.width, photo.height);
    bitmap.close();
    const result = model.segment(photo);
    const masks = result.confidenceMasks;
    if (!masks) { result.close(); return null; }
    const cat = masks[SETTINGS.classes.cat].getAsFloat32Array(), dog = masks[SETTINGS.classes.dog].getAsFloat32Array();
    const { width, height } = masks[SETTINGS.classes.cat];
    result.close();
    // The animal: wherever the model sees a cat or a dog. Then its box, with a little air around it.
    const pet = new Float32Array(width * height);
    let found = 0, x0 = width, y0 = height, x1 = -1, y1 = -1;
    for (let y = 0; y < height; y++) for (let x = 0; x < width; x++) {
      const i = y * width + x, p = Math.max(cat[i], dog[i]);
      pet[i] = p;
      if (p > .5) { found++; if (x < x0) x0 = x; if (x > x1) x1 = x; if (y < y0) y0 = y; if (y > y1) y1 = y; }
    }
    if (found / (width * height) < SETTINGS.minPet) return null;
    // Crisp edges: points spread over where the model is surest it is the animal, for Magic Touch to cut it out. Its
    // cut is kept only around the animal, so it cannot take the sofa along.
    const sure: Point[] = [];
    const step = Math.max(4, Math.round(Math.sqrt(found / 24)));
    for (let y = y0; y <= y1; y += step) for (let x = x0; x <= x1; x += step) if (pet[y * width + x] > .8) sure.push({ x: x / width, y: y / height });
    const scribble = sure.filter((_, i) => i % Math.max(1, Math.ceil(sure.length / 12)) === 0);
    const edges = await cutter;
    if (edges && scribble.length) {
      try {
        const cut = edges.segment(photo, { scribble });
        const fine = cut.confidenceMasks?.[0];
        if (fine && fine.width === width && fine.height === height) {
          const crisp = fine.getAsFloat32Array();
          for (let i = 0; i < pet.length; i++) pet[i] = pet[i] > .08 ? crisp[i] : 0;
        }
        cut.close();
      } catch { /* Keep the coarse silhouette. */ }
    }
    const pad = Math.round(Math.max(x1 - x0, y1 - y0) * .04);
    x0 = Math.max(0, x0 - pad); y0 = Math.max(0, y0 - pad); x1 = Math.min(width - 1, x1 + pad); y1 = Math.min(height - 1, y1 + pad);
    const boxW = x1 - x0 + 1, boxH = y1 - y0 + 1;
    const full = canvasOf(boxW, boxH), fullContext = full.getContext('2d')!, image = fullContext.createImageData(boxW, boxH);
    for (let y = 0; y < boxH; y++) for (let x = 0; x < boxW; x++) {
      const k = (y * boxW + x) * 4;
      image.data[k] = image.data[k + 1] = image.data[k + 2] = 255;
      image.data[k + 3] = Math.round(Math.min(1, Math.max(0, (pet[(y + y0) * width + x + x0] - .35) / .3)) * 255);
    }
    fullContext.putImageData(image, 0, 0);
    const fit = Math.min(1, SETTINGS.maxSide / Math.max(boxW, boxH));
    const small = canvasOf(boxW * fit, boxH * fit), smallContext = small.getContext('2d')!;
    smallContext.imageSmoothingQuality = 'high';
    smallContext.drawImage(full, 0, 0, small.width, small.height);
    const pixels = smallContext.getImageData(0, 0, small.width, small.height).data;
    const mask = new Uint8Array(small.width * small.height);
    for (let i = 0; i < mask.length; i++) mask[i] = pixels[i * 4 + 3];
    return { width: small.width, height: small.height, mask };
  };

  document.querySelectorAll<HTMLElement>('[data-souls-field]').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('.souls-field-canvas')!;
    const context = canvas.getContext('2d')!;
    const caption = root.closest('section') ?? document;
    const addButton = caption.querySelector<HTMLButtonElement>('[data-souls-add]');
    const input = caption.querySelector<HTMLInputElement>('[data-souls-input]');
    const status = caption.querySelector<HTMLElement>('[data-souls-status]');
    const addLine = caption.querySelector<HTMLElement>('[data-souls-add-line]');
    const setStatus = (text: string) => { if (status) { status.textContent = text; status.hidden = !text; } };

    let width = 0, height = 0, ratio = 1;
    let souls: Soul[] = [];
    let cap = SETTINGS.cap;
    let shared = true; // False when the shared place cannot be reached: souls are kept on this device.

    // Film grain: a noise tile, shifted every few frames so it lives.
    const grain = canvasOf(160, 160);
    {
      const g = grain.getContext('2d')!, img = g.createImageData(160, 160);
      for (let i = 0; i < img.data.length; i += 4) { const v = Math.random() * 255; img.data[i] = img.data[i + 1] = img.data[i + 2] = v; img.data[i + 3] = 255; }
      g.putImageData(img, 0, 0);
    }

    // Soft edges without canvas filters (Safari): draw small, then large, and the browser blurs on the way up.
    const soften = (source: HTMLCanvasElement, amount: number) => {
      const tiny = canvasOf(source.width / amount, source.height / amount);
      const t = tiny.getContext('2d')!;
      t.imageSmoothingQuality = 'high';
      t.drawImage(source, 0, 0, tiny.width, tiny.height);
      return tiny;
    };

    /** A soul as a luminous figure: its silhouette, haloed, filled with its coat and two red eyes where its head is. */
    const paintSoul = (soul: Soul, size: number) => {
      const coat = SETTINGS.coats[hash(soul.id) % SETTINGS.coats.length];
      const scale = size / soul.height, w = soul.width * scale, h = size, pad = size * .3;
      // The silhouette with clear room around it, so its blur never meets the edge of its box.
      const m = Math.round(Math.max(soul.width, soul.height) * .2);
      const shape = canvasOf(soul.width + m * 2, soul.height + m * 2), s = shape.getContext('2d')!, img = s.createImageData(soul.width, soul.height);
      for (let i = 0; i < soul.mask.length; i++) { img.data[i * 4] = img.data[i * 4 + 1] = img.data[i * 4 + 2] = 255; img.data[i * 4 + 3] = soul.mask[i]; }
      s.putImageData(img, m, m);
      const sx = pad - m * scale, sw = shape.width * scale, sh = shape.height * scale;
      const out = canvasOf((w + pad * 2) * ratio, (h + pad * 2) * ratio), g = out.getContext('2d')!;
      g.scale(ratio, ratio);
      g.imageSmoothingQuality = 'high';
      // Halo, then the body itself, a little soft at the edge.
      g.globalAlpha = .5;
      g.drawImage(soften(shape, 7), sx - sw * .06, sx - sh * .06, sw * 1.12, sh * 1.12);
      g.globalAlpha = 1;
      g.drawImage(soften(shape, 2.2), sx, sx, sw, sh);
      g.drawImage(soften(shape, 1.4), sx, sx, sw, sh);
      // The coat: light at the top, into its colour, into shadow at the bottom; a lighter glow inside.
      g.globalCompositeOperation = 'source-in';
      const fill = g.createLinearGradient(pad, pad, pad + w * .4, pad + h);
      fill.addColorStop(0, coat[0]); fill.addColorStop(.55, coat[1]); fill.addColorStop(1, coat[2]);
      g.fillStyle = fill;
      g.fillRect(0, 0, out.width, out.height);
      g.globalCompositeOperation = 'source-atop';
      const glow = g.createRadialGradient(pad + w * .5, pad + h * .55, 0, pad + w * .5, pad + h * .55, Math.max(w, h) * .55);
      glow.addColorStop(0, 'rgba(255, 250, 236, .45)'); glow.addColorStop(1, 'rgba(255, 250, 236, 0)');
      g.fillStyle = glow;
      g.fillRect(0, 0, out.width, out.height);
      // Eyes: in the top part of the silhouette (its head), around its middle.
      let top = -1;
      for (let y = 0; y < soul.height && top < 0; y++) for (let x = 0; x < soul.width; x++) if (soul.mask[y * soul.width + x] > 160) { top = y; break; }
      if (top >= 0) {
        const bandEnd = Math.min(soul.height, top + Math.round(soul.height * .3));
        let sum = 0, count = 0, left = soul.width, right = 0;
        const eyeRow = Math.min(soul.height - 1, top + Math.round(soul.height * .14));
        for (let y = top; y < bandEnd; y++) for (let x = 0; x < soul.width; x++) if (soul.mask[y * soul.width + x] > 160) { sum += x; count++; }
        for (let x = 0; x < soul.width; x++) if (soul.mask[eyeRow * soul.width + x] > 160) { left = Math.min(left, x); right = Math.max(right, x); }
        if (count && right > left) {
          const cx = sum / count, apart = Math.min((right - left) * .22, soul.width * .12), r = Math.max(1.2, soul.width * .022) * scale;
          g.globalCompositeOperation = 'source-over';
          for (const ex of [cx - apart, cx + apart]) {
            const x = pad + ex * scale, y = pad + (eyeRow + soul.height * .03) * scale;
            const eye = g.createRadialGradient(x, y, 0, x, y, r * 2.6);
            eye.addColorStop(0, SETTINGS.eyes); eye.addColorStop(.38, SETTINGS.eyes); eye.addColorStop(1, 'rgba(255, 74, 42, 0)');
            g.fillStyle = eye;
            g.fillRect(x - r * 3, y - r * 3, r * 6, r * 6);
          }
        }
      }
      soul.sprite = out;
      soul.spriteFor = size;
      return out;
    };

    /** The caregiver: a soft, luminous girl with long hair and a long dress, glowing from her chest, one hand reaching
        down to the animals. Her feet fade into the floor. */
    let keeper: HTMLCanvasElement | null = null;
    const KEEPER = .8; // Her height, as a share of the frame's.
    const paintKeeper = (size: number) => {
      const w = size * .56, pad = size * .2;
      const shape = canvasOf(w + pad * 2, size + pad * 2), s = shape.getContext('2d')!;
      const cx = (w + pad * 2) / 2, top = pad, u = size;
      s.fillStyle = '#fff';
      const round = (x: number, y: number, rw: number, rh: number, r: number) => { s.beginPath(); s.roundRect(cx + x * u - rw * u / 2, top + y * u, rw * u, rh * u, r * u); s.fill(); };
      s.beginPath(); s.ellipse(cx, top + .11 * u, .1 * u, .11 * u, 0, 0, Math.PI * 2); s.fill(); // Head and the crown of her hair
      round(0, .1, .22, .34, .08); // Long hair, falling past her shoulders.
      s.beginPath(); // The dress: from the shoulders, flaring down to the floor.
      s.moveTo(cx - .11 * u, top + .22 * u); s.quadraticCurveTo(cx, top + .2 * u, cx + .11 * u, top + .22 * u);
      s.quadraticCurveTo(cx + .17 * u, top + .6 * u, cx + .25 * u, top + 1 * u);
      s.lineTo(cx - .25 * u, top + 1 * u);
      s.quadraticCurveTo(cx - .17 * u, top + .6 * u, cx - .11 * u, top + .22 * u);
      s.fill();
      s.lineCap = 'round'; s.strokeStyle = '#fff'; s.lineWidth = .055 * u;
      s.beginPath(); s.moveTo(cx - .12 * u, top + .26 * u); s.quadraticCurveTo(cx - .24 * u, top + .42 * u, cx - .3 * u, top + .6 * u); s.stroke(); // Reaching down to an animal.
      s.beginPath(); s.moveTo(cx + .12 * u, top + .26 * u); s.quadraticCurveTo(cx + .17 * u, top + .42 * u, cx + .15 * u, top + .55 * u); s.stroke();
      const out = canvasOf((w + pad * 2) * ratio, (size + pad * 2) * ratio), g = out.getContext('2d')!;
      g.scale(ratio, ratio);
      g.imageSmoothingQuality = 'high';
      g.globalAlpha = .6; g.drawImage(soften(shape, 12), -w * .06, -size * .04, (w + pad * 2) * 1.12, (size + pad * 2) * 1.08);
      g.globalAlpha = 1; g.drawImage(soften(shape, 4), 0, 0, w + pad * 2, size + pad * 2);
      g.drawImage(soften(shape, 2.5), 0, 0, w + pad * 2, size + pad * 2);
      g.globalCompositeOperation = 'source-in';
      const fill = g.createLinearGradient(0, top, 0, top + size);
      fill.addColorStop(0, '#fffaf0'); fill.addColorStop(.3, '#f7f4e2'); fill.addColorStop(.65, '#e2f4b8'); fill.addColorStop(1, '#a6dca0');
      g.fillStyle = fill; g.fillRect(0, 0, out.width, out.height);
      g.globalCompositeOperation = 'source-atop';
      const heart = g.createRadialGradient(cx, top + .4 * u, 0, cx, top + .4 * u, .26 * u);
      heart.addColorStop(0, 'rgba(255, 120, 70, .6)'); heart.addColorStop(.6, 'rgba(255, 160, 130, .2)'); heart.addColorStop(1, 'rgba(255, 160, 130, 0)');
      g.fillStyle = heart; g.fillRect(0, 0, out.width, out.height);
      const arm = g.createLinearGradient(cx - .34 * u, 0, cx - .12 * u, 0);
      arm.addColorStop(0, 'rgba(110, 100, 225, .85)'); arm.addColorStop(1, 'rgba(110, 100, 225, 0)');
      g.fillStyle = arm; g.fillRect(0, top + .3 * u, cx, .36 * u);
      // Her feet melt into the floor.
      g.globalCompositeOperation = 'destination-out';
      const floor = g.createLinearGradient(0, top + .78 * u, 0, top + 1.02 * u);
      floor.addColorStop(0, 'rgba(0, 0, 0, 0)'); floor.addColorStop(1, 'rgba(0, 0, 0, 1)');
      g.fillStyle = floor; g.fillRect(0, top + .78 * u, w + pad * 2, size);
      // Face and eyes.
      g.globalCompositeOperation = 'source-over';
      const face = g.createRadialGradient(cx, top + .13 * u, 0, cx, top + .13 * u, .07 * u);
      face.addColorStop(0, 'rgba(255, 150, 112, .95)'); face.addColorStop(.7, 'rgba(255, 170, 130, .5)'); face.addColorStop(1, 'rgba(255, 170, 130, 0)');
      g.fillStyle = face; g.beginPath(); g.ellipse(cx, top + .135 * u, .065 * u, .075 * u, 0, 0, Math.PI * 2); g.fill();
      for (const ex of [-.028, .028]) {
        const x = cx + ex * u, y = top + .13 * u, r = .0075 * u;
        const eye = g.createRadialGradient(x, y, 0, x, y, r * 2.4);
        eye.addColorStop(0, SETTINGS.eyes); eye.addColorStop(.4, SETTINGS.eyes); eye.addColorStop(1, 'rgba(255, 74, 42, 0)');
        g.fillStyle = eye; g.fillRect(x - r * 3, y - r * 3, r * 6, r * 6);
      }
      keeper = out;
    };

    // Where the souls go: rings around the caregiver, nearest first; the lower ones are nearer, so larger, and drawn on
    // top of her; the upper ones sit behind her.
    let slots: Slot[] = [];
    const layout = () => {
      slots = [];
      const rings = [8, 10, 12, 12];
      let n = 0, seed = 5;
      const random = () => { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; };
      rings.forEach((count, ring) => {
        const rx = (.2 + ring * .1) * width, ry = (.17 + ring * .08) * height;
        for (let j = 0; j < count && n < cap; j++, n++) {
          // Around her, leaving the space just in front of her clear.
          const a = Math.PI * .5 + (Math.PI * .22) + (j + (ring % 2) * .5 + random() * .3) / count * Math.PI * 1.56;
          // y is where its feet are.
          const x = width * .5 + Math.cos(a) * rx, y = height * .74 + Math.sin(a) * ry;
          const depth = Math.min(1, Math.max(0, (y - height * .4) / (height * .65)));
          slots.push({ x, y, size: height * (.22 + depth * .22) * (1 - ring * .06), behind: y < height * .74 });
        }
      });
    };

    const resize = () => {
      const rect = root.getBoundingClientRect();
      ratio = Math.min(devicePixelRatio || 1, 2);
      if (Math.round(rect.width) === width && Math.round(rect.height) === height) return;
      width = Math.round(rect.width); height = Math.round(rect.height);
      canvas.width = Math.round(width * ratio); canvas.height = Math.round(height * ratio);
      paintKeeper(height * KEEPER);
      souls.forEach((soul) => { soul.sprite = undefined; });
      layout();
    };

    const draw = (time: number) => {
      if (!width) return;
      const t = calm ? 0 : time / 1000;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      context.globalCompositeOperation = 'source-over';
      // The place: paper into peach, with drifting hazes of colour.
      const ground = context.createLinearGradient(0, 0, 0, height);
      ground.addColorStop(0, SETTINGS.paper[0]); ground.addColorStop(.55, SETTINGS.paper[1]); ground.addColorStop(1, SETTINGS.paper[2]);
      context.fillStyle = ground; context.fillRect(0, 0, width, height);
      SETTINGS.haze.forEach(([color, alpha], i) => {
        const x = width * (.2 + .6 * ((i * .37) % 1) + .04 * Math.sin(t * .1 + i)), y = height * (.3 + .4 * ((i * .61) % 1) + .03 * Math.cos(t * .08 + i * 2));
        const r = Math.max(width, height) * (.35 + .1 * i);
        const haze = context.createRadialGradient(x, y, 0, x, y, r);
        haze.addColorStop(0, color); haze.addColorStop(1, 'rgba(255, 255, 255, 0)');
        context.globalAlpha = alpha * .6; context.fillStyle = haze; context.fillRect(0, 0, width, height);
      });
      context.globalAlpha = 1;
      // Her light.
      const aura = context.createRadialGradient(width * .5, height * .45, 0, width * .5, height * .45, height * .55);
      aura.addColorStop(0, `rgba(255, 248, 222, ${.75 + .1 * Math.sin(t * .7)})`); aura.addColorStop(1, 'rgba(255, 248, 222, 0)');
      context.fillStyle = aura; context.fillRect(0, 0, width, height);

      const now = performance.now();
      const drawSoul = (soul: Soul, slot: Slot, index: number) => {
        if (!soul.sprite || soul.spriteFor !== slot.size) paintSoul(soul, slot.size);
        const sprite = soul.sprite!, w = sprite.width / ratio, h = sprite.height / ratio;
        const bob = calm ? 0 : Math.sin(t * .6 + index * 1.7) * height * .004, breathe = calm ? 1 : 1 + Math.sin(t * .9 + index) * .012;
        const fade = soul.born ? Math.min(1, (now - soul.born) / 1600) : 1;
        // Facing her: a soul on the left looks right, one on the right looks left.
        const flip = (slot.x < width / 2) === (hash(soul.id) % 2 === 0) ? -1 : 1;
        context.save();
        context.globalAlpha = fade;
        context.translate(slot.x, slot.y + bob);
        context.scale(flip, breathe);
        context.drawImage(sprite, -w / 2, -h * 1.3 / 1.6, w, h); // Its feet on the slot (the sprite has a margin of .3 of its height).
        context.restore();
      };
      souls.forEach((soul, i) => { if (slots[i]?.behind) drawSoul(soul, slots[i], i); });
      if (keeper) {
        // Her feet near the bottom of the frame (the drawing has a margin of a fifth of her height for the glow).
        const w = keeper.width / ratio, h = keeper.height / ratio, size = height * KEEPER, sway = calm ? 0 : Math.sin(t * .5) * height * .003;
        context.drawImage(keeper, width * .5 - w / 2, height * 1.02 - (size * .2 + size) + sway, w, h);
      }
      // Front souls, nearest last.
      souls.map((soul, i) => [soul, i] as const).filter(([, i]) => slots[i] && !slots[i].behind).sort((a, b) => slots[a[1]].y - slots[b[1]].y).forEach(([soul, i]) => drawSoul(soul, slots[i], i));

      // Grain over everything.
      context.globalCompositeOperation = 'overlay';
      context.globalAlpha = SETTINGS.grain;
      const shift = calm ? 0 : Math.floor(t * 12);
      context.fillStyle = context.createPattern(grain, 'repeat')!;
      context.save(); context.translate(-(shift * 37) % 160, -(shift * 53) % 160); context.fillRect(0, 0, width + 160, height + 160); context.restore();
      context.globalAlpha = 1;
      context.globalCompositeOperation = 'source-over';
    };

    let visible = false, running = false;
    const frame = (time: number) => {
      if (!visible) { running = false; return; }
      draw(time);
      requestAnimationFrame(frame);
    };
    const start = () => { if (!running && visible && !calm) { running = true; requestAnimationFrame(frame); } else if (calm) draw(0); };
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; if (visible) start(); }, { rootMargin: '10%' }).observe(root);
    new ResizeObserver(() => { resize(); draw(performance.now()); }).observe(root);

    const full = () => souls.length >= cap;
    const showFull = () => { if (full() && addLine) { addLine.hidden = true; setStatus('The place is full now. Every soul has company.'); } };

    // The souls already here.
    const load = async () => {
      let ids: string[] = [];
      try {
        const response = await fetch('/api/souls', { headers: { accept: 'application/json' } });
        if (!response.ok || !(response.headers.get('content-type') ?? '').includes('json')) throw new Error('No shared place');
        const data = await response.json() as { souls: string[]; cap: number };
        ids = data.souls; cap = data.cap;
      } catch {
        shared = false;
      }
      const loaded = shared
        ? await Promise.all(ids.map(async (id) => { try { const r = await fetch(`/api/souls?id=${encodeURIComponent(id)}`); return r.ok ? decode(id, new Uint8Array(await r.arrayBuffer())) : null; } catch { return null; } }))
        : localSouls().map(({ id, data }) => decode(id, fromBase64(data)));
      souls = loaded.filter((soul): soul is Soul => !!soul);
      layout();
      draw(performance.now());
      showFull();
    };
    load();

    // Adding a pet.
    addButton?.addEventListener('click', () => {
      setStatus('Choose a photo of your cat or dog. It stays on your device: only their silhouette is kept.');
      input?.click();
    });
    input?.addEventListener('change', async () => {
      const file = input.files?.[0];
      input.value = '';
      if (!file) return;
      if (full()) { showFull(); return; }
      if (addButton) addButton.disabled = true;
      setStatus('Looking for your pet…');
      try {
        const found = await silhouette(file);
        if (!found) { setStatus('I couldn’t find a cat or a dog in that photo. Try one where your pet is in full view.'); return; }
        const bytes = encode(found.width, found.height, found.mask);
        let id = `souls/local-${Date.now().toString(36)}`;
        if (shared) {
          const response = await fetch('/api/souls', { method: 'POST', headers: { 'content-type': 'application/octet-stream' }, body: bytes }).catch(() => null);
          if (response?.status === 409) { cap = souls.length; showFull(); return; }
          if (response?.ok) id = ((await response.json()) as { id: string }).id;
          else { shared = false; keepLocally(id, bytes); }
        } else keepLocally(id, bytes);
        souls.push({ id, width: found.width, height: found.height, mask: found.mask, born: performance.now() });
        if (calm) draw(0);
        setStatus(shared ? 'Welcome. They’re in good company now, for good.' : 'Welcome. They’re in good company now (kept on this device).');
        showFull();
      } catch {
        setStatus('Something went wrong reading that photo. Try another one.');
      } finally {
        if (addButton) addButton.disabled = false;
      }
    });
  });
</script>

<style>
  .souls-field { position: absolute; inset: 0; overflow: hidden; }
  .souls-field-canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
</style>
