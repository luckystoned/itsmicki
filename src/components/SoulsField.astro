      let pick = Math.random(), act: Act = 'sit';
      for (const [name, [weight]] of acts) { pick -= weight; if (pick <= 0) { act = name; break; } }
      // After her welcome, a newcomer walks off to its own place.
      const goingHome = soul.act === 'pet';
      if (goingHome) act = 'walk';
      soul.fromX = soul.x; soul.fromY = soul.y; soul.toX = soul.x; soul.toY = soul.y;
      let length: number;
      if (act === 'walk') {
