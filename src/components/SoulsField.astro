        dots, thin legs, lime socks and rust shoes. Both arms are drawn on their own so they can move. */
    let keeper: HTMLCanvasElement | null = null;
    const KEEPER = .72; // Her height, as a share of the base size (the frame’s height when it is landscape).
    const HER_FEET = .91; // Where her feet stand, as a share of the height (a little back, so they show whole).
    type Limb = { canvas: HTMLCanvasElement; w: number; h: number; pivotX: number; pivotY: number; length: number };
    let keeperArms: { reachUpper: Limb; reachLower: Limb; restUpper: Limb; restLower: Limb } | null = null;
    const UPPER = .13, FOREARM = .15; // Her upper arm and forearm, as shares of her height.
    const KEEPER_PAD = .55; // Room around her canvas, as a share of her height.
    // Her, one letter per cell (h hair, s skin, e eyes, c cheek, m mouth, w collar, d dress, f dots on it, k socks,
    // o shoes; a dot is empty).
    const KEEPER_ART = [
      '......hhhhh......',
      '....hhhhhhhhh....',
      '...hhhhhhhhhhh...',
      '..hhhhhhhhhhhhh..',
      '..hhhhhhhhhhhhh..',
      '..hhssssssssshh..',
      '..hhssesssesshh..',
      '..hhcssssssschh..',
      '..hhssssmsssshh..',
      '..hh.sssssss.hh..',
      '..hh...sss...hh..',
      '......wwwww......',
      '....dddwwwddd....',
      '....ddddwdddd....',
      '....ddddddddd....',
      '....ddddddddd....',
      '...ddfdddddfddd..',
      '...ddddddddddd...',
      '..ddddddddddddd..',
      '..ddddddfdddddd..',
      '.ddddddddddddddd.',
      '.ddfdddddddddfdd.',
      '.ddddddddddddddd.',
      '..ddddddddddddd..',
      ...Array(5).fill('......s...s......'),
      '......k...k......',
      '......k...k......',
      '.....oo...oo.....',
    ];
    const KEEPER_GRID = (() => {
      const letters = 'hscmwdfkoe', gw = KEEPER_ART[0].length, grid = gridOf(gw, KEEPER_ART.length);
      KEEPER_ART.forEach((row, j) => [...row].forEach((letter, i) => { grid.cells[j * gw + i] = letters.indexOf(letter); }));
      return grid;
    })();
    const KEEPER_CELLS = KEEPER_GRID.gh; // Grid cells over her height.
    const paintKeeper = (size: number) => {
      const { lime, pink, rust, skin } = SETTINGS.colours;
      const w = size * .56, pad = size * KEEPER_PAD, u = size, cell = u / KEEPER_CELLS;
      const W = w + pad * 2, H = size + pad * 2, cx = W / 2, top = pad;
      const colours = [rust, skin, pink, '#c4607c', lime, pink, lime, lime, rust, SETTINGS.eyes.dark]; // (Her mouth a deeper pink.)
      const gw = KEEPER_GRID.gw, grid = KEEPER_GRID;
