        s.strokeStyle = SETTINGS.plants.front; s.fillStyle = SETTINGS.plants.front;
        const bx = w * .5;
        s.lineWidth = Math.max(1, w * .035);
        s.beginPath(); s.moveTo(bx, h); s.quadraticCurveTo(bx + w * .1, h * .5, bx - w * .05, 0); s.stroke();
        const leaves = 5 + Math.floor(random() * 4);
        for (let i = 0; i < leaves; i++) {
          const y = h * (.12 + .8 * (i / leaves)), side = i % 2 ? 1 : -1, len = w * (.3 + random() * .2);
          s.save(); s.translate(bx + w * .03 * (1 - y / h), y); s.rotate(side * (.6 + random() * .5));
          s.beginPath(); s.ellipse(side * len / 2, 0, len / 2, len * .14, side * -.5, 0, Math.PI * 2); s.fill(); s.restore();
        }
