      let people = 0;
      for (let i = 0; i < person.length; i++) if (person[i] > .5) people++;
      if (people / person.length > SETTINGS.people) { bitmap.close(); return 'people'; }
      const keep = Math.min(1, SETTINGS.photoSide / Math.max(bitmap.width, bitmap.height));
      const whole = canvasOf(bitmap.width * keep, bitmap.height * keep), w = whole.getContext('2d')!;
      w.fillStyle = '#f4efe8'; w.fillRect(0, 0, whole.width, whole.height);
      w.drawImage(bitmap, 0, 0, whole.width, whole.height);
