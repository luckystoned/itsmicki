      } else if (look.pattern === 2) {
        for (let i = 0; i < bodyLen; i++) { set(i, headH, DARK); if (bodyH > 3) set(i, headH + 1, DARK); set(i, gh - 1, LIGHT); }
        for (let i = hx0; i <= hx1; i++) set(i, 1, DARK);
        if (dog) { set(hx1 + 1, 3, LIGHT); set(hx1 + 2, 3, LIGHT); }
      } else if (look.pattern === 3) {
