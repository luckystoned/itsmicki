            const air = p > .2 && p < .8 ? Math.sin((p - .2) / .6 * Math.PI) : 0;
            const crouch = Math.max(0, 1 - Math.abs(p - .14) / .14) + Math.max(0, 1 - Math.abs(p - .88) / .12);
            lift = Math.pow(air, 1.3) * unit * .16;
            fold = crouch * .25;
            sy = 1 + air * .02;
          }
          if (soul.act === 'stretch') { const e = ease(Math.sin(p * Math.PI)); sx = 1 + e * .06; sy = 1 - e * .03; fold = e * .15; }
          if (soul.act === 'groom') tilt = Math.sin((now - soul.actStart) / 1000 * 3.2) * .02 * into;
          // Lying down to nap: the legs fold under it and it settles low, breathing slowly.
          if (soul.act === 'sleep') { fold = .75 * into; sy = 1 + Math.sin(t * .8 + soul.phase) * .012; }
          if (soul.act === 'pet') { tilt = -soul.face * .025 * into; fold = .15 * into; }
          // Blinks.
          if (now > soul.blink + 4200 + (soul.phase * 600)) soul.blink = now;
          if (now - soul.blink < 140) eyesOpen = 0;
        }
        // Turning round takes a moment: it narrows, then opens the other way.
        soul.faceShown += (soul.face - soul.faceShown) * Math.min(1, dt * 5);
        if (calm) soul.faceShown = soul.face;
        const fade = soul.born ? Math.min(1, (now - soul.born) / 1600) : 1;
        context.save();
        context.globalAlpha = fade;
        context.translate(soul.x * width, soul.y * height - lift);
        // A soft shadow on the floor.
        context.save(); context.globalAlpha = fade * .22 * (1 - Math.min(1, lift / unit)); context.scale(1, .18);
        const shade = context.createRadialGradient(0, 0, 0, 0, 0, unit * .55); shade.addColorStop(0, '#2b2166'); shade.addColorStop(1, 'rgba(43, 33, 102, 0)');
        context.fillStyle = shade; context.fillRect(-unit, -unit, unit * 2, unit * 2); context.restore();
        context.rotate(tilt);
        context.scale(soul.faceShown * sx * k, sy * k);
        // Folded legs lower the body by as much.
        const drop = figure.legLength * fold;
        const drawLeg = (leg: Leg) => {
          // Diagonal pairs step together (back-far with front-near), like a real walk.
          const together = leg.near === leg.front;
          const swing = Math.sin(stride + (together ? 0 : Math.PI)) * .28 * pace;
          context.save();
          context.translate(leg.x, leg.y + drop);
          context.rotate(swing);
          context.scale(1, 1 - fold);
          context.drawImage(leg.canvas, -leg.pivotX, -leg.pivotY, leg.w, leg.h);
          context.restore();
        };
        figure.legs.filter((leg) => !leg.near).forEach(drawLeg);
        context.drawImage(figure.body.canvas, figure.body.x, figure.body.y + drop, figure.body.w, figure.body.h);
        figure.legs.filter((leg) => leg.near).forEach(drawLeg);
        if (eyesOpen > .5 || soul.act === 'sleep') for (const eye of figure.eyes) drawEye(context, eye.x, eye.y + drop, figure.eyeR, soul.act === 'sleep');
        context.restore();
      };
      // Further away first; those behind her before her, the rest after.
      const order = [...souls].sort((a, b) => a.y - b.y);
      const herLine = .86;
      order.filter((soul) => soul.y < herLine).forEach(drawSoul);
      const sway = calm ? 0 : Math.sin(t * .5) * height * .003;
      if (keeperArms) {
        // The arm along her side, behind her glow, swaying a little.
        const idle = calm ? 0 : Math.sin(t * .7 + 1) * .02;
        drawArm(shoulder(1), REST_UPPER + idle, REST_FOREARM + idle * 1.4, keeperArms.restUpper, keeperArms.restLower, sway);
      }
      if (keeper) {
        const w = keeper.width / ratio, h = keeper.height / ratio, size = height * KEEPER;
        context.drawImage(keeper, width * .5 - w / 2, height * 1.02 - (size * .2 + size) + sway, w, h);
      }
      order.filter((soul) => soul.y >= herLine).forEach(drawSoul);
      if (keeperArms) {
        // Her reaching arm: resting, it sways a little; stroking a newcomer, it goes back and forth along its back. The
        // stroke comes from the elbow and wrist, the shoulder barely moves: slow, even, like a real caress.
        const stroking = !calm && now < petting ? ease(Math.min(1, (petting - now) / 600, (now - petting + 5000) / 600)) : 0;
        const idle = calm ? 0 : Math.sin(t * .8) * .02, stroke = Math.sin(t * 2 * Math.PI * .65);
        drawArm(shoulder(-1), UPPER_ANGLE + idle + stroking * (.06 + stroke * .05), FOREARM_ANGLE + idle * 1.5 + stroking * (.12 + stroke * .2), keeperArms.reachUpper, keeperArms.reachLower, sway);
      }
      plants.front.forEach((plant) => drawPlant(plant, t, .8));

      // Grain over everything.
      context.globalCompositeOperation = 'overlay';
      context.globalAlpha = SETTINGS.grain;
      const shift = calm ? 0 : Math.floor(t * 12);
      context.fillStyle = context.createPattern(grain, 'repeat')!;
      context.save(); context.translate(-(shift * 37) % 160, -(shift * 53) % 160); context.fillRect(0, 0, width + 160, height + 160); context.restore();
      context.globalAlpha = 1;
      context.globalCompositeOperation = 'source-over';
    };

    let visible = false, running = false;
    const frame = (time: number) => {
      if (!visible) { running = false; return; }
      draw(time);
      requestAnimationFrame(frame);
    };
    const start = () => { if (!running && visible && !calm) { running = true; requestAnimationFrame(frame); } else if (calm) draw(0); };
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; if (visible) start(); }, { rootMargin: '10%' }).observe(root);
    new ResizeObserver(() => { resize(); draw(performance.now()); }).observe(root);

    const full = () => souls.length >= cap;
    const showFull = () => { if (full() && addLine) { addLine.hidden = true; setStatus('The place is full now. Every soul has company.'); } };

    // The souls already here.
    const load = async () => {
      let ids: string[] = [];
      try {
        const response = await fetch('/api/souls', { headers: { accept: 'application/json' } });
        if (!response.ok || !(response.headers.get('content-type') ?? '').includes('json')) throw new Error('No shared place');
        const data = await response.json() as { souls: string[]; cap: number };
        ids = data.souls; cap = data.cap;
      } catch {
        shared = false;
        ids = localSouls();
      }
      souls = ids.map((id) => ({ id, look: readLook(id) })).filter((entry): entry is { id: string; look: Look } => !!entry.look).map(({ id, look }, i) => meet(id, look, i, 0));
      draw(performance.now());
      showFull();
    };
    load();

    // A dog's size can't be told from a photo, so it is asked.
    const askSize = () => new Promise<0 | 1 | 2>((resolve) => {
      if (!status) { resolve(1); return; }
      status.hidden = false;
      status.textContent = 'Is your dog ';
      (['small', 'medium', 'big'] as const).forEach((label, i) => {
        const button = document.createElement('button');
        button.type = 'button'; button.className = 'case-reveal-camera'; button.textContent = label;
        button.addEventListener('click', () => resolve(i as 0 | 1 | 2), { once: true });
        status.append(button, document.createTextNode(i === 0 ? ', ' : i === 1 ? ' or ' : '?'));
      });
    });

    // Adding a pet.
    addButton?.addEventListener('click', () => {
      setStatus('Choose a photo of your whole cat or dog, from ears to paws. Only a description is kept (cat or dog, colours, markings); the photo never leaves your device.');
      input?.click();
    });
    input?.addEventListener('change', async () => {
      const file = input.files?.[0];
      input.value = '';
      if (!file) return;
      if (full()) { showFull(); return; }
      if (addButton) addButton.disabled = true;
      setStatus('Looking for your pet…');
      try {
        const found = await readPet(file);
        if (found === 'none') { setStatus('I couldn’t find a cat or a dog in that photo. Try another one.'); return; }
        if (found === 'cut') { setStatus('Only whole bodies, please: a photo where all of your pet fits, from ears to paws, with a little room around.'); return; }
        const look: Look = { ...found, size: found.kind === 'dog' ? await askSize() : 1 };
        const code = lookCode(look);
        let id = `souls/local-${Date.now().toString(36)}_${code}`;
        if (shared) {
          const response = await fetch('/api/souls', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ look: code }) }).catch(() => null);
          if (response?.status === 409) { cap = souls.length; showFull(); return; }
          if (response?.ok) id = ((await response.json()) as { id: string }).id;
          else { shared = false; keepLocally(id); }
        } else keepLocally(id);
        // A newcomer is welcomed under her hand, and she strokes it for a few seconds before it goes to its place.
        const newcomer = meet(id, look, souls.length, performance.now());
        const hand = handAt();
        newcomer.x = newcomer.fromX = newcomer.toX = Math.max(.06, hand.x - .03);
        // Standing where its head comes up to her hand (bigger animals stand a little further down).
        let y = hand.y + .2;
        for (let i = 0; i < 4; i++) { newcomer.y = y; y = hand.y + unitAt(newcomer) * .85 / height; }
        newcomer.y = newcomer.fromY = newcomer.toY = Math.min(.97, y);
        newcomer.face = newcomer.faceShown = 1;
        newcomer.act = 'pet'; newcomer.actStart = performance.now(); newcomer.actEnd = newcomer.actStart + 5000;
        petting = newcomer.actEnd;
        souls.push(newcomer);
        if (calm) draw(0);
        setStatus(shared ? 'Welcome. They’re in good company now, for good.' : 'Welcome. They’re in good company now (kept on this device).');
        showFull();
      } catch {
        setStatus('Something went wrong reading that photo. Try another one.');
      } finally {
        if (addButton) addButton.disabled = false;
      }
    });
  });
</script>

<style>
  .souls-field { position: absolute; inset: 0; overflow: hidden; }
  .souls-field-canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  /* Over the case page's own iframe rules (those centre Vimeo videos in their frame). */
  .souls-field .souls-field-music { position: absolute; z-index: 2; inset: .8vw .8vw auto auto; width: min(240px, 34%); height: auto; aspect-ratio: 16 / 9; min-width: 0; min-height: 0; border: 0; border-radius: 10px; transform: none; }

  @media (max-width: 760px) {
    .souls-field .souls-field-music { inset: 8px 8px auto auto; width: min(200px, 46%); }
  }
</style>
