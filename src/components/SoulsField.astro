    for (let i = 0; i < luma.length; i++) { luma[i] = .299 * rgb[i * 4] + .587 * rgb[i * 4 + 1] + .114 * rgb[i * 4 + 2]; if (pet[i] > .6) inside.push(i); }
    if (inside.length < 50) return { kind: dogs > cats ? 'dog' : 'cat', pattern: 0, colours: UNREAD, photo: keptPhoto, guessed: true };
    inside.sort((a, b) => luma[a] - luma[b]);
    const average = (from: number, to: number) => {
      const slice = inside.slice(Math.floor(inside.length * from), Math.max(Math.floor(inside.length * from) + 1, Math.floor(inside.length * to)));
      const sum = [0, 0, 0];
      slice.forEach((i) => { sum[0] += rgb[i * 4]; sum[1] += rgb[i * 4 + 1]; sum[2] += rgb[i * 4 + 2]; });
      return sum.map((v) => v / slice.length);
    };
    // A little lifted and glowing, but its own colours.
    const glow = (c: number[], lift: number) => c.map((v) => v + (255 - v) * lift);
    const colours: [string, string, string] = [hex(glow(average(.8, 1), .25)), hex(glow(average(.4, .6), .15)), hex(glow(average(0, .2), .1))];
    // Its markings: little contrast is plain fur; contrast in fine detail is tabby stripes; contrast in big areas is patches.
    const contrast = luma[inside[Math.floor(inside.length * .85)]] - luma[inside[Math.floor(inside.length * .15)]];
    let fine = 0, counted = 0;
