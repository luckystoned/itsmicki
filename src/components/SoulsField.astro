      return out;
    };
    const growPlants = () => {
      let n = 17;
      const random = () => { n = (n * 16807) % 2147483647; return (n - 1) / 2147483646; };
      const back: Plant[] = [], front: Plant[] = [];
      const horizon = height * SETTINGS.horizon;
      const variants = Array.from({ length: 8 }, (_, i) => { const h = height * (.13 + random() * .14), w = h * .7; return { sprite: paintPlant('flower', w, h, 31 + i * 7, 4), w, h }; });
      for (let x = -width * .02; x < width * 1.02; x += width * (.022 + random() * .025)) {
        const v = variants[Math.floor(random() * variants.length)];
        back.push({ ...v, x, y: horizon + height * (random() * .06 - .01), phase: random() * 6.28, sway: .04 + random() * .04 });
      }
      for (const [x, lean] of [[.03, 1], [.1, 1], [.18, 1], [.84, -1], [.92, -1], [.98, -1]] as Array<[number, number]>) {
        const h = height * (.32 + random() * .22), w = h * .5;
        front.push({ sprite: paintPlant('leaves', w, h, 101 + Math.round(x * 100), 7), x: width * x + lean * random() * width * .02, y: height * 1.04, w, h, phase: random() * 6.28, sway: .05 + random() * .03 });
      }
