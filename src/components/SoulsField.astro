  .souls-form-build small { font-size: 12px; opacity: .7; }
  .souls-form-build input[type='range'] { flex: 1; width: auto; min-width: 0; padding: 0; border: 0; accent-color: #fafafa; }
  .souls-form-preview { display: block; width: 100%; height: 150px; border-radius: 10px; background: #2a2017; }
  .souls-form-title { margin: 0; font-size: 22px; line-height: 1.1; }
  .souls-form-field { display: grid; gap: 6px; font-size: 13px; }
  .souls-form-field input { width: 100%; padding: 8px 0; border: 0; border-bottom: 1px solid rgb(250 250 250 / .4); background: transparent; color: inherit; font: inherit; font-size: 16px; }
  .souls-form-field input:focus-visible { outline: none; border-bottom-color: #fafafa; }
  .souls-form-field input::placeholder { color: rgb(250 250 250 / .4); }
  .souls-form-colours input[type='color'] { width: 34px; height: 26px; padding: 0; border: 1px solid rgb(250 250 250 / .4); border-radius: 4px; background: none; cursor: pointer; }
  .souls-form-choice[hidden] { display: none; }
