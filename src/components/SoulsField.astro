    };
    const drawPlant = (plant: Plant, t: number, alpha: number) => {
      context.save();
      context.globalAlpha = alpha;
      context.translate(plant.x, plant.y);
      context.rotate(calm ? 0 : Math.sin(t * .7 + plant.phase) * plant.sway + Math.sin(t * 1.9 + plant.phase * 2) * plant.sway * .25);
      context.drawImage(plant.sprite, -plant.w / 2, -plant.h, plant.w, plant.h);
      context.restore();
    };

    // Homes: rings around the caregiver, on the ground (feet between the horizon and the bottom), nearest first.
    let homes: Array<{ x: number; y: number }> = [];
    const layout = () => {
      homes = [];
      const rings = [8, 10, 12, 12];
      let seed = 5;
      const random = () => { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; };
      rings.forEach((count, ring) => {
        const rx = .2 + ring * .09, ry = .15 + ring * .06;
        for (let j = 0; j < count; j++) {
