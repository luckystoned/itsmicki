      context.restore();
    };

    /** Plants, blurred like they are out of focus: flowers on round heads along the horizon, and tall leafy stems in
        front, near the edges. Each sways from its base. */
    let plants: { back: Plant[]; front: Plant[] } = { back: [], front: [] };
    const paintPlant = (kind: 'flower' | 'leaves', w: number, h: number, seed: number, blur: number) => {
      let n = seed;
      const random = () => { n = (n * 16807) % 2147483647; return (n - 1) / 2147483646; };
      const shape = canvasOf(w, h), s = shape.getContext('2d')!;
      s.lineCap = 'round';
      if (kind === 'flower') {
        const stems = 1 + Math.floor(random() * 3);
        for (let i = 0; i < stems; i++) {
          const bx = w * (.35 + random() * .3), tx = bx + (random() - .5) * w * .4, ty = h * (.08 + random() * .35);
          s.strokeStyle = SETTINGS.plants.stem; s.lineWidth = Math.max(1, w * .05);
          s.beginPath(); s.moveTo(bx, h); s.quadraticCurveTo(bx, (h + ty) / 2, tx, ty); s.stroke();
          s.fillStyle = SETTINGS.plants.back;
          s.beginPath(); s.arc(tx, ty, w * (.1 + random() * .07), 0, Math.PI * 2); s.fill();
        }
