---
// Missing souls: a warm, glowing place (coral sky, lavender ground, blurred plants swaying) where a caregiver looks
// after the animals people leave with her. Anyone can add their cat or dog from a full-body photo: the photo is read on
// their device (MediaPipe finds the animal and cuts it out) and only the animal is kept (its silhouette and its own light
// and shade, never the background), painted as a luminous figure with an aura, so each one keeps its own face, shape and
// breed. Once here, each animal lives its own little life: it sits, walks
// about, hops, stretches, grooms, naps and blinks. The souls are shared by every visitor (api/souls.ts, Vercel Blob) and
// stay for good, until the place is full; without the shared store (local dev, or before it is connected) they are kept
// on the visitor's device. With reduced motion nothing moves.
type Props = { label: string };
const { label } = Astro.props;
---

<div class="souls-field" data-souls-field>
  <canvas class="souls-field-canvas" role="img" aria-label={label}></canvas>
  <!-- A song to listen to while here, if they want: the official audio on YouTube (whole song, its own volume control),
       in the top right corner. It never plays on its own. -->
  <iframe
    class="souls-field-music"
    src="https://www.youtube-nocookie.com/embed/Bi8G90nkmDA?rel=0&playsinline=1"
    title="Dauwd — Theory of Colours (official audio, YouTube)"
    loading="lazy"
    allow="encrypted-media; picture-in-picture"
    referrerpolicy="strict-origin-when-cross-origin"
  ></iframe>
</div>

<script>
  import { loadVision } from '@/scripts/camera';

  const SETTINGS = {
    cap: 42, // Souls the place holds (the server has the final word).
    maxSide: 240, // Largest silhouette side kept, in pixels (the server accepts up to this).
    minPet: .008, // Share of the photo the animal has to cover to count as found.
    margin: .012, // Whole body: the animal must not touch the photo's sides or bottom (share of the photo).
    model: 'https://storage.googleapis.com/mediapipe-models/image_segmenter/deeplab_v3/float32/1/deeplab_v3.tflite',
    // Finds the animal coarsely; then Magic Touch, given points on it, cuts it out with crisp edges.
    edges: 'https://storage.googleapis.com/mediapipe-models/interactive_segmenter/magic_touch/float32/1/magic_touch.tflite',
    classes: { cat: 8, dog: 12 }, // DeepLab v3 (PASCAL VOC) labels.
    // The place, after the reference: a coral sky melting into a lavender-blue ground, a warm glow on the floor.
    sky: [[0, '#e46a55'], [.3, '#ec7d60'], [.45, '#f19a7c'], [.56, '#a198e2'], [.8, '#8380d8'], [1, '#716ecb']] as Array<[number, string]>,
    horizon: .5, // Where the ground starts, as a share of the height.
    plants: { back: '#98a3ee', stem: '#6f8f63', front: '#5f8456' }, // Flowers on the horizon, their stems, leaves in front.
    // Each soul's coat: light → mid → shadow. Pale mint and ink, like the two cats of the reference, and warm pastels.
    coats: [
      ['#f4f8e2', '#d9efc8', '#a9d3bb'],
      ['#3b3392', '#1e1a5c', '#100e33'],
      ['#ffe2cc', '#f8b99c', '#d58fb6'],
      ['#d4cdf8', '#a39be8', '#6c67cf'],
      ['#fff6ea', '#f2dccb', '#c7b4ea'],
      ['#4a3f9e', '#2b2672', '#1a2a4c'],
      ['#e8f5d0', '#bfe3a6', '#86c49e'],
      ['#ffd0c0', '#f39c8a', '#a36fc8'],
    ],
    eyes: '#ff4a2a', // Eyes are little arches (∩), smiling shut, not round glowing dots.
    grain: .17, // Strength of the film grain over everything.
    // What they do, and how often; lengths in seconds.
    acts: { sit: [.32, 3, 8], walk: [.3, 0, 0], hop: [.06, 1.1, 1.1], stretch: [.1, 1.8, 1.8], groom: [.08, 2.4, 3.4], sleep: [.12, 7, 13] } as Record<string, [number, number, number]>,
    walkSpeed: .045, // Share of the width per second.
  };

  type Act = 'sit' | 'walk' | 'hop' | 'stretch' | 'groom' | 'sleep' | 'pet';
  type Soul = {
    id: string; width: number; height: number; mask: Uint8Array; light?: Uint8Array; born: number;
    sprite?: HTMLCanvasElement; spriteFor?: number; eyes?: Array<{ x: number; y: number }>; eyeR?: number; facing?: number;
    // Walking: the sprite without its legs, and each leg on its own, to swing from the hip (sprite units, CSS px).
    body?: HTMLCanvasElement; legs?: Array<{ canvas: HTMLCanvasElement; x: number; y: number; w: number; h: number }>;
    // Life: its home, where it is (feet; shares of the frame), what it is doing and until when.
    hx: number; hy: number; x: number; y: number; fromX: number; fromY: number; toX: number; toY: number;
    act: Act; actStart: number; actEnd: number; face: number; faceShown: number; blink: number; phase: number; drawn: number;
  };
  type Plant = { sprite: HTMLCanvasElement; x: number; y: number; w: number; h: number; phase: number; sway: number };

  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const STORE = 'missing-souls';

  const hash = (text: string) => { let h = 2166136261; for (let i = 0; i < text.length; i++) h = Math.imul(h ^ text.charCodeAt(i), 16777619); return h >>> 0; };
  const canvasOf = (width: number, height: number) => { const c = document.createElement('canvas'); c.width = Math.max(1, Math.round(width)); c.height = Math.max(1, Math.round(height)); return c; };
  // A soul on the wire: width and height, its silhouette (one byte per pixel) and, after it, its light and shade (the
  // animal's own, from the photo, one grey byte per pixel; older souls have none).
  const encode = (width: number, height: number, mask: Uint8Array, light?: Uint8Array) => {
    const out = new Uint8Array(4 + mask.length + (light?.length ?? 0));
    out.set([width & 255, width >> 8, height & 255, height >> 8]); out.set(mask, 4);
    if (light) out.set(light, 4 + mask.length);
    return out;
  };
  const decode = (bytes: Uint8Array) => {
    if (bytes.length < 4) return null;
    const width = bytes[0] | (bytes[1] << 8), height = bytes[2] | (bytes[3] << 8), n = width * height;
    if (!width || !height || (bytes.length !== 4 + n && bytes.length !== 4 + n * 2)) return null;
    return { width, height, mask: bytes.slice(4, 4 + n), light: bytes.length === 4 + n * 2 ? bytes.slice(4 + n) : undefined };
  };
  const toBase64 = (bytes: Uint8Array) => { let s = ''; bytes.forEach((b) => { s += String.fromCharCode(b); }); return btoa(s); };
  const fromBase64 = (text: string) => Uint8Array.from(atob(text), (c) => c.charCodeAt(0));
  const ease = (p: number) => p * p * (3 - 2 * p);
  /** An eye: a little arch (∩) with a soft glow; asleep, it turns into a closed curve (∪). */
  const drawEye = (g: CanvasRenderingContext2D, x: number, y: number, r: number, asleep = false) => {
    g.save();
    g.lineCap = 'round';
    g.lineWidth = Math.max(.9, r * .75);
    g.strokeStyle = SETTINGS.eyes;
    g.shadowColor = 'rgba(255, 74, 42, .7)';
    g.shadowBlur = r * 2.2;
    g.beginPath();
    if (asleep) g.arc(x, y - r * .5, r * 1.05, Math.PI * .15, Math.PI * .85);
    else g.arc(x, y + r * .55, r * 1.15, Math.PI * 1.12, Math.PI * 1.88);
    g.stroke();
    g.restore();
  };

  // Souls kept on this device, when the shared place cannot be reached.
  // `?souls=reset` in the address clears the souls kept on this device (they never reach anyone else).
  try { if (new URLSearchParams(location.search).get('souls') === 'reset') localStorage.removeItem('missing-souls'); } catch { /* No storage. */ }
  const localSouls = (): Array<{ id: string; data: string }> => { try { return JSON.parse(localStorage.getItem(STORE) ?? '[]'); } catch { return []; } };
  const keepLocally = (id: string, bytes: Uint8Array) => { try { localStorage.setItem(STORE, JSON.stringify([...localSouls(), { id, data: toBase64(bytes) }])); } catch { /* Storage full or blocked: it stays for this visit. */ } };

  /** Finds the cat or dog in a photo and returns its silhouette, or why it can't. */
  type Masks = { confidenceMasks?: Array<{ width: number; height: number; getAsFloat32Array: () => Float32Array }>; close: () => void };
  type Point = { x: number; y: number };
  let segmenter: Promise<{ segment: (image: HTMLCanvasElement) => Masks }> | null = null;
  let cutter: Promise<{ segment: (image: HTMLCanvasElement, roi: { scribble: Point[] }) => Masks } | null> | null = null;
  const silhouette = async (file: File): Promise<{ width: number; height: number; mask: Uint8Array; light: Uint8Array } | 'none' | 'cut'> => {
    segmenter ??= (async () => {
      const { module, files } = await loadVision();
      return module.ImageSegmenter.createFromOptions(files, { baseOptions: { modelAssetPath: SETTINGS.model }, runningMode: 'IMAGE', outputCategoryMask: false, outputConfidenceMasks: true });
    })();
    cutter ??= (async () => {
      try {
        const { module, files } = await loadVision();
        return await module.InteractiveSegmenter.createFromOptions(files, { baseOptions: { modelAssetPath: SETTINGS.edges }, outputCategoryMask: false, outputConfidenceMasks: true });
      } catch { return null; }
    })();
    const model = await segmenter;
    const bitmap = await createImageBitmap(file);
    const scale = Math.min(1, 640 / Math.max(bitmap.width, bitmap.height));
    const photo = canvasOf(bitmap.width * scale, bitmap.height * scale);
    photo.getContext('2d')!.drawImage(bitmap, 0, 0, photo.width, photo.height);
    bitmap.close();
    const result = model.segment(photo);
    const masks = result.confidenceMasks;
    if (!masks) { result.close(); return 'none'; }
    const cat = masks[SETTINGS.classes.cat].getAsFloat32Array(), dog = masks[SETTINGS.classes.dog].getAsFloat32Array();
    const { width, height } = masks[SETTINGS.classes.cat];
    result.close();
    // The animal: wherever the model sees a cat or a dog.
    const pet = new Float32Array(width * height);
    let found = 0, x0 = width, y0 = height, x1 = -1, y1 = -1;
    for (let y = 0; y < height; y++) for (let x = 0; x < width; x++) {
      const i = y * width + x, p = Math.max(cat[i], dog[i]);
      pet[i] = p;
      if (p > .5) { found++; if (x < x0) x0 = x; if (x > x1) x1 = x; if (y < y0) y0 = y; if (y > y1) y1 = y; }
    }
    if (found / (width * height) < SETTINGS.minPet) return 'none';
    // Whole body only: an animal running off the sides or the bottom of the photo is cut (a close-up of a face, say).
    const m = SETTINGS.margin;
    if (x0 < width * m || x1 > width * (1 - m) || y1 > height * (1 - m) || y0 < height * m * .5) return 'cut';
    // Crisp edges: points spread over where the model is surest it is the animal, for Magic Touch to cut it out. Its
    // cut is kept only around the animal, so it cannot take the sofa along.
    const sure: Point[] = [];
    const step = Math.max(4, Math.round(Math.sqrt(found / 24)));
    for (let y = y0; y <= y1; y += step) for (let x = x0; x <= x1; x += step) if (pet[y * width + x] > .8) sure.push({ x: x / width, y: y / height });
    const scribble = sure.filter((_, i) => i % Math.max(1, Math.ceil(sure.length / 12)) === 0);
    const edges = await cutter;
    if (edges && scribble.length) {
      try {
        const cut = edges.segment(photo, { scribble });
        const fine = cut.confidenceMasks?.[0];
        if (fine && fine.width === width && fine.height === height) {
          const crisp = fine.getAsFloat32Array();
          for (let i = 0; i < pet.length; i++) pet[i] = pet[i] > .08 ? crisp[i] : 0;
        }
        cut.close();
      } catch { /* Keep the coarse silhouette. */ }
    }
    const pad = Math.round(Math.max(x1 - x0, y1 - y0) * .04);
    x0 = Math.max(0, x0 - pad); y0 = Math.max(0, y0 - pad); x1 = Math.min(width - 1, x1 + pad); y1 = Math.min(height - 1, y1 + pad);
    const boxW = x1 - x0 + 1, boxH = y1 - y0 + 1;
    const full = canvasOf(boxW, boxH), fullContext = full.getContext('2d')!, image = fullContext.createImageData(boxW, boxH);
    for (let y = 0; y < boxH; y++) for (let x = 0; x < boxW; x++) {
      const k = (y * boxW + x) * 4;
      image.data[k] = image.data[k + 1] = image.data[k + 2] = 255;
      image.data[k + 3] = Math.round(Math.min(1, Math.max(0, (pet[(y + y0) * width + x + x0] - .4) / .2)) * 255);
    }
    fullContext.putImageData(image, 0, 0);
    const fit = Math.min(1, SETTINGS.maxSide / Math.max(boxW, boxH));
    const small = canvasOf(boxW * fit, boxH * fit), smallContext = small.getContext('2d')!;
    smallContext.imageSmoothingQuality = 'high';
    smallContext.drawImage(full, 0, 0, small.width, small.height);
    const pixels = smallContext.getImageData(0, 0, small.width, small.height).data;
    const mask = new Uint8Array(small.width * small.height);
    for (let i = 0; i < mask.length; i++) mask[i] = pixels[i * 4 + 3];
    // Its light and shade (fur, face, eyes, nose), from the photo but only where the animal is, in grey and stretched
    // to its own range, so the figure keeps its real look under the colour.
    const shade = canvasOf(small.width, small.height), shadeContext = shade.getContext('2d')!;
    shadeContext.imageSmoothingQuality = 'high';
    shadeContext.drawImage(photo, x0, y0, boxW, boxH, 0, 0, small.width, small.height);
    const rgb = shadeContext.getImageData(0, 0, small.width, small.height).data;
    const light = new Uint8Array(mask.length), seen: number[] = [];
    for (let i = 0; i < mask.length; i++) { const l = .299 * rgb[i * 4] + .587 * rgb[i * 4 + 1] + .114 * rgb[i * 4 + 2]; light[i] = l; if (mask[i] > 160) seen.push(l); }
    seen.sort((a, b) => a - b);
    const lo = seen[Math.floor(seen.length * .03)] ?? 0, hi = seen[Math.floor(seen.length * .97)] ?? 255, span = Math.max(24, hi - lo);
    for (let i = 0; i < light.length; i++) light[i] = mask[i] > 8 ? Math.round(Math.min(255, Math.max(0, (light[i] - lo) / span * 255))) : 128;
    return { width: small.width, height: small.height, mask, light };
  };

  document.querySelectorAll<HTMLElement>('[data-souls-field]').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('.souls-field-canvas')!;
    const context = canvas.getContext('2d')!;
    const caption = root.closest('section') ?? document;
    const addButton = caption.querySelector<HTMLButtonElement>('[data-souls-add]');
    const input = caption.querySelector<HTMLInputElement>('[data-souls-input]');
    const status = caption.querySelector<HTMLElement>('[data-souls-status]');
    const addLine = caption.querySelector<HTMLElement>('[data-souls-add-line]');
    const setStatus = (text: string) => { if (status) { status.textContent = text; status.hidden = !text; } };

    let width = 0, height = 0, ratio = 1;
    let souls: Soul[] = [];
    let cap = SETTINGS.cap;
    let shared = true; // False when the shared place cannot be reached: souls are kept on this device.

    // Film grain: a noise tile, shifted every few frames so it lives.
    const grain = canvasOf(160, 160);
    {
      const g = grain.getContext('2d')!, img = g.createImageData(160, 160);
      for (let i = 0; i < img.data.length; i += 4) { const v = Math.random() < .03 ? 255 : Math.random() * 200; img.data[i] = img.data[i + 1] = img.data[i + 2] = v; img.data[i + 3] = 255; }
      g.putImageData(img, 0, 0);
    }

    // Soft edges without canvas filters (Safari): halve the image step by step, then double it back up the same way;
    // each step blends neighbours, so the result is a smooth blur (one big jump would look blocky).
    const soften = (source: HTMLCanvasElement, amount: number) => {
      const steps: HTMLCanvasElement[] = [source];
      let scale = 1;
      while (scale * 2 <= amount) {
        const last = steps[steps.length - 1], next = canvasOf(last.width / 2, last.height / 2), n = next.getContext('2d')!;
        n.imageSmoothingQuality = 'high';
        n.drawImage(last, 0, 0, next.width, next.height);
        steps.push(next);
        scale *= 2;
      }
      if (amount / scale > 1.05) {
        const last = steps[steps.length - 1], next = canvasOf(source.width / amount, source.height / amount), n = next.getContext('2d')!;
        n.imageSmoothingQuality = 'high';
        n.drawImage(last, 0, 0, next.width, next.height);
        steps.push(next);
      }
      let up = steps[steps.length - 1];
      for (let i = steps.length - 2; i >= 0; i--) {
        const next = canvasOf(steps[i].width, steps[i].height), n = next.getContext('2d')!;
        n.imageSmoothingQuality = 'high';
        n.drawImage(up, 0, 0, next.width, next.height);
        up = next;
      }
      return up;
    };

    // Each sprite has room around the figure for its glow: this share of its height on every side.
    const ROOM = .2;

    /** A soul as a luminous figure: its silhouette, defined but soft at the edge, filled with its coat. Its eyes are
        found here (in the head, the top of the silhouette) and drawn live, so they can blink and close. */
    const paintSoul = (soul: Soul, size: number) => {
      const coat = SETTINGS.coats[hash(soul.id) % SETTINGS.coats.length];
      const scale = size / soul.height, w = soul.width * scale, h = size, pad = size * ROOM;
      const m = Math.round(Math.max(soul.width, soul.height) * .15);
      const shape = canvasOf(soul.width + m * 2, soul.height + m * 2), s = shape.getContext('2d')!, img = s.createImageData(soul.width, soul.height);
      for (let i = 0; i < soul.mask.length; i++) { img.data[i * 4] = img.data[i * 4 + 1] = img.data[i * 4 + 2] = 255; img.data[i * 4 + 3] = soul.mask[i]; }
      s.putImageData(img, m, m);
      const sx = pad - m * scale, sw = shape.width * scale, sh = shape.height * scale;
      const out = canvasOf((w + pad * 2) * ratio, (h + pad * 2) * ratio), g = out.getContext('2d')!;
      g.scale(ratio, ratio);
      g.imageSmoothingQuality = 'high';
      // Its aura: a wide, soft halo in the lightest colour of its coat.
      const aura = soften(shape, 10), auraContext = aura.getContext('2d')!;
      auraContext.globalCompositeOperation = 'source-in'; auraContext.fillStyle = coat[0]; auraContext.fillRect(0, 0, aura.width, aura.height);
      g.globalAlpha = .6; g.drawImage(aura, sx - sw * .1, sx - sh * .1, sw * 1.2, sh * 1.2);
      g.globalAlpha = .45; g.drawImage(aura, sx - sw * .03, sx - sh * .03, sw * 1.06, sh * 1.06);
      g.globalAlpha = 1;
      // The body: its coat, light at the top into shadow at the bottom, then its own light and shade from the photo on
      // top (overlay keeps the colour, multiply deepens eyes, nose and folds), so it still looks like itself.
      const body = canvasOf(shape.width * 4, shape.height * 4), b = body.getContext('2d')!;
      b.imageSmoothingQuality = 'high';
      b.drawImage(soften(shape, 1.25), 0, 0, body.width, body.height);
      b.drawImage(shape, 0, 0, body.width, body.height);
      b.globalCompositeOperation = 'source-in';
      const fill = b.createLinearGradient(0, body.height * .1, body.width * .3, body.height * .9);
      fill.addColorStop(0, coat[0]); fill.addColorStop(.6, coat[1]); fill.addColorStop(1, coat[2]);
      b.fillStyle = fill; b.fillRect(0, 0, body.width, body.height);
      if (soul.light) {
        const lit = canvasOf(soul.width + m * 2, soul.height + m * 2), l = lit.getContext('2d')!, li = l.createImageData(soul.width, soul.height);
        for (let i = 0; i < soul.light.length; i++) { const v = soul.light[i]; li.data[i * 4] = li.data[i * 4 + 1] = li.data[i * 4 + 2] = v; li.data[i * 4 + 3] = 255; }
        l.putImageData(li, m, m);
        b.globalCompositeOperation = 'overlay'; b.globalAlpha = .75;
        b.drawImage(soften(lit, 1.4), 0, 0, body.width, body.height);
        b.globalCompositeOperation = 'multiply'; b.globalAlpha = .2;
        b.drawImage(soften(lit, 1.4), 0, 0, body.width, body.height);
        b.globalAlpha = 1;
        b.globalCompositeOperation = 'destination-in';
        b.drawImage(soften(shape, 1.25), 0, 0, body.width, body.height);
      }
      b.globalCompositeOperation = 'source-atop';
      const glow = b.createRadialGradient(body.width * .45, body.height * .4, 0, body.width * .45, body.height * .4, Math.max(body.width, body.height) * .5);
      glow.addColorStop(0, 'rgba(255, 246, 228, .3)'); glow.addColorStop(1, 'rgba(255, 246, 228, 0)');
      b.fillStyle = glow; b.fillRect(0, 0, body.width, body.height);
      g.drawImage(body, sx, sx, sw, sh);
      // Where its eyes are, and which way it faces in the photo (its head left or right of its body).
      let top = -1;
      for (let y = 0; y < soul.height && top < 0; y++) for (let x = 0; x < soul.width; x++) if (soul.mask[y * soul.width + x] > 160) { top = y; break; }
      soul.eyes = [];
      soul.facing = 1;
      if (top >= 0) {
        const bandEnd = Math.min(soul.height, top + Math.round(soul.height * .3));
        let headX = 0, headN = 0, bodyX = 0, bodyN = 0, left = soul.width, right = 0;
        const eyeRow = Math.min(soul.height - 1, top + Math.round(soul.height * .14));
        for (let y = 0; y < soul.height; y++) for (let x = 0; x < soul.width; x++) if (soul.mask[y * soul.width + x] > 160) {
          bodyX += x; bodyN++;
          if (y >= top && y < bandEnd) { headX += x; headN++; }
        }
        for (let x = 0; x < soul.width; x++) if (soul.mask[eyeRow * soul.width + x] > 160) { left = Math.min(left, x); right = Math.max(right, x); }
        if (headN && bodyN && right > left) {
          const cx = headX / headN, apart = Math.min((right - left) * .2, soul.width * .1);
          soul.facing = cx < bodyX / bodyN - soul.width * .04 ? -1 : 1;
          soul.eyes = [cx - apart, cx + apart].map((ex) => ({ x: pad + ex * scale, y: pad + (eyeRow + soul.height * .03) * scale }));
          soul.eyeR = Math.max(1.1, soul.width * .02 * scale);
        }
      }
      // Legs: where the silhouette touches the ground in separate patches (paws), each patch is a leg, from its hip
      // (a little over two thirds down) to the floor. With two to five of them, they can walk.
      soul.legs = undefined; soul.body = undefined;
      const footFrom = Math.round(soul.height * .88), hip = Math.round(soul.height * .66), minLeg = Math.max(2, soul.width * .025);
      const runs: Array<[number, number]> = [];
      let open = -1;
      for (let x = 0; x <= soul.width; x++) {
        let solid = false;
        if (x < soul.width) for (let y = footFrom; y < soul.height && !solid; y++) solid = soul.mask[y * soul.width + x] > 128;
        if (solid && open < 0) open = x;
        if (!solid && open >= 0) { if (x - open >= minLeg) runs.push([open, x - 1]); open = -1; }
      }
      if (runs.length >= 2 && runs.length <= 5) {
        const body = canvasOf(out.width, out.height), b = body.getContext('2d')!;
        b.drawImage(out, 0, 0);
        soul.legs = runs.map(([a, z]) => {
          const x = pad + (a - 1.5) * scale, y = pad + hip * scale, lw = (z - a + 3) * scale, lh = (soul.height - hip) * scale + pad;
          const leg = canvasOf(lw * ratio, lh * ratio);
