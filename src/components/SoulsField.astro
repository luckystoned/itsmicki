      return { kind: dogs > cats ? 'dog' : 'cat', pattern: 0, colours: UNREAD, photo: whole.toDataURL('image/jpeg', .82), guessed: true };
    }
    // The photo kept for the list: the animal with some room around it; never one where people fill the crop.
    const room = Math.max(x1 - x0, y1 - y0) * .14;
    const cx0 = Math.max(0, Math.floor(x0 - room)), cy0 = Math.max(0, Math.floor(y0 - room)), cx1 = Math.min(width - 1, Math.ceil(x1 + room)), cy1 = Math.min(height - 1, Math.ceil(y1 + room));
    let people = 0;
    for (let y = cy0; y <= cy1; y++) for (let x = cx0; x <= cx1; x++) if (person[y * width + x] > .5) people++;
    if (people / ((cx1 - cx0 + 1) * (cy1 - cy0 + 1)) > SETTINGS.people) { bitmap.close(); return 'people'; }
    const toBitmap = bitmap.width / width, keepScale = Math.min(1, SETTINGS.photoSide / (Math.max(cx1 - cx0, cy1 - cy0) * toBitmap));
    const kept = canvasOf((cx1 - cx0 + 1) * toBitmap * keepScale, (cy1 - cy0 + 1) * toBitmap * keepScale), keptContext = kept.getContext('2d')!;
