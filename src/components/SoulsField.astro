      };
    };
    let petting = 0; // Until when she is stroking a newcomer.
    // Her shoulders and her reaching hand, in the frame (shares of width and height).
    const shoulder = (side: -1 | 1) => ({ x: .5 + side * (.09 * KEEPER * height) / width, y: 1.02 - KEEPER + .245 * KEEPER });
    // At rest (angles from straight down; positive swings to her right, our left): the reaching arm hangs a little out
    // with the elbow softly bent towards the animals; the other one hangs along her side.
    const UPPER_ANGLE = .26, FOREARM_ANGLE = .5, REST_UPPER = -.14, REST_FOREARM = -.05;
    const handAt = () => {
      const sh = shoulder(-1);
      const dx = -(Math.sin(UPPER_ANGLE) * UPPER + Math.sin(FOREARM_ANGLE) * FOREARM) * KEEPER, dy = (Math.cos(UPPER_ANGLE) * UPPER + Math.cos(FOREARM_ANGLE) * FOREARM) * KEEPER;
      return { x: sh.x + dx * height / width, y: sh.y + dy };
    };
    const drawArm = (from: { x: number; y: number }, upperAngle: number, lowerAngle: number, upperLimb: Limb, lowerLimb: Limb, sway: number) => {
      context.save();
      context.translate(from.x * width, from.y * height + sway);
      context.rotate(upperAngle);
      context.drawImage(upperLimb.canvas, -upperLimb.pivotX, -upperLimb.pivotY, upperLimb.w, upperLimb.h);
      context.translate(0, upperLimb.length);
