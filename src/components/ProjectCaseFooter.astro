    right: 0;
    bottom: -.08em;
    left: 0;
    height: 3px;
    background: currentColor;
    transform: scaleY(1);
    transform-origin: center bottom;
    transition: transform 180ms cubic-bezier(.19, 1, .22, 1);
  }

  @media (hover: hover) {
    .case-more-heading a:hover .case-more-link-label::after,
    .case-more-heading a:hover .case-more-link-plus::after {
      transform: scaleY(1.5);
    }
  }

  .case-more-heading a:focus-visible .case-more-link-label::after,
  .case-more-heading a:focus-visible .case-more-link-plus::after {
    transform: scaleY(1.5);
  }

  .case-strip {
    width: 100vw;
    margin-top: 3.7vw;
    margin-left: calc(50% - 50vw);
    padding-block: 1.8vw 1vw;
    overflow: hidden;
    touch-action: pan-y;
  }

  .case-strip-track,
  .case-strip-set {
    display: flex;
    align-items: flex-start;
  }

  .case-strip-track {
    width: max-content;
    padding-left: 1.37vw;
    cursor: grab;
    will-change: transform;
  }

  .case-strip-track:active {
    cursor: grabbing;
  }

  .case-strip-set {
    flex: none;
    gap: .81vw;
    padding-right: .81vw;
  }

  .case-strip-card {
    position: relative;
    display: block;
    flex: 0 0 auto;
    width: var(--card-width);
    height: var(--card-height);
    color: inherit;
  }

  .case-strip-picture {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #efece7;
    transition: transform .55s cubic-bezier(.16, 1, .3, 1), border-radius .55s cubic-bezier(.16, 1, .3, 1);
  }

  .case-strip-picture img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .55s cubic-bezier(.16, 1, .3, 1);
  }

  .case-strip-name {
    position: absolute;
    top: -1.55vw;
    left: 0;
    z-index: 2;
    font-size: .8vw;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(.5vw);
    transition: opacity .4s cubic-bezier(.16, 1, .3, 1), transform .4s cubic-bezier(.16, 1, .3, 1);
  }

  .case-strip-card:is(:hover, :focus-visible) .case-strip-picture {
    border-radius: 10vw;
    transform: translateY(1.8vw);
  }

  .case-strip-card:is(:hover, :focus-visible) .case-strip-picture img {
    transform: scale(1.18);
  }

  .case-strip-card:is(:hover, :focus-visible) .case-strip-name {
    opacity: 1;
    transform: none;
  }

