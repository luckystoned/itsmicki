---
import { imageMetadata } from '@/data/imageMetadata';
import { projectCases } from '@/data/projectCases';
import { carouselProjects, desktopLength, vimeoBackground } from '@/data/carousel';

const { currentSlug } = Astro.props;
const publishedCaseSlugs = new Set(Object.keys(projectCases));
const loops = [0, 1, 2];
---

<div class="case-more" data-current-case={currentSlug}>
  <div class="case-more-divider" data-case-text-reveal></div>
  <div class="case-more-heading">
    <h2 data-case-text-reveal>Pss, let’s continue</h2>
    <a href="/projects" data-case-text-reveal style="--reveal-delay:70ms"><span class="case-more-link-label">See All</span> (<span class="case-more-link-plus">+</span>)</a>
  </div>

  <!-- Same infinite carousel as the home: cards, sizes, hover, speed, drag and wheel. -->
  <section class="more-carousel" aria-label="More selected projects" data-more-carousel data-case-text-reveal>
    <div class="more-carousel-track" data-more-carousel-track>
      {loops.map((loop) => carouselProjects.map((project) => {
        const dimensions = imageMetadata[project.caseCarouselCover] ?? (project.slug === 'amazon' ? { width: 640, height: 360 } : undefined);
        const cardStyle = `--card-aspect:${project.carouselLayout.width / project.carouselLayout.height};--card-width:${desktopLength(project.carouselLayout.width)}`;
        const content = (
          <>
            <span class="more-carousel-name" aria-hidden="true"><span class="more-carousel-name-text">{project.carouselLayout.label}</span></span>
            <span class="more-carousel-picture">
              <img src={project.caseCarouselCover} alt={loop === 0 ? `${project.title} project` : ''} width={dimensions?.width} height={dimensions?.height} loading="lazy" decoding="async" draggable="false" />
              {project.carouselLayout.vimeoId && <iframe src={vimeoBackground(project.carouselLayout.vimeoId)} title={`${project.title} project video`} loading="lazy" allow="autoplay; fullscreen; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" tabindex="-1" aria-hidden="true" data-carousel-video></iframe>}
            </span>
          </>
        );
        return publishedCaseSlugs.has(project.slug) && !project.comingSoon
          ? <a class="more-carousel-card" data-project-preview="ready" style={cardStyle} href={`/projects/${project.slug}`} aria-current={project.slug === currentSlug ? 'page' : undefined} aria-hidden={loop !== 0 ? 'true' : undefined} tabindex={loop !== 0 ? -1 : undefined}>{content}</a>
          : <div class="more-carousel-card" data-project-preview="coming" aria-label={`${project.title}, coming soon`} style={cardStyle} aria-hidden={loop !== 0 ? 'true' : undefined}>{content}</div>;
      }))}
    </div>
  </section>
</div>

<footer class="case-footer">
  <div class="case-footer-wordmark" aria-label="Itsmicki, copyright 2026">
    <span data-case-footer-reveal>Itsmicki</span>
    <span data-case-footer-reveal>©2026</span>
  </div>
  <div class="case-footer-info">
    <span data-case-footer-reveal style="--reveal-delay:0ms">DEV BY</span>
    <a data-case-footer-reveal style="--reveal-delay:70ms" href="https://www.instagram.com/luckystoned/" target="_blank" rel="noopener noreferrer">@LUCKYSTONED</a>
    <span data-case-footer-reveal style="--reveal-delay:140ms">SAY HI</span>
    <a data-case-footer-reveal style="--reveal-delay:210ms" href="mailto:hey@itsmicki.com" target="_blank" rel="noopener noreferrer">HEY@ITSMICKI.COM</a>
    <span data-case-footer-reveal style="--reveal-delay:280ms">ALL RIGHTS RESERVED.</span>
    <span class="case-footer-socials" data-case-footer-reveal style="--reveal-delay:350ms">
      SOCIALS <a href="https://www.linkedin.com/in/itsmicki/" target="_blank" rel="noopener noreferrer">LINKEDIN</a>,
      {" "}<a href="https://www.behance.net/itsmicki" target="_blank" rel="noopener noreferrer">BEHANCE</a>,
      {" "}<a href="https://dribbble.com/micaelagalimberti" target="_blank" rel="noopener noreferrer">DRIBBBLE</a>,
      {" "}<a href="https://www.instagram.com/its.micki/" target="_blank" rel="noopener noreferrer">INSTAGRAM</a>,
      {" "}<a href="https://www.tiktok.com/@mickivainillla" target="_blank" rel="noopener noreferrer">TIKTOK</a>
    </span>
  </div>
</footer>

<style>
  .case-more {
    width: calc(100% - 2 * var(--gutter)); /* Same side margins as the home. */
    margin: 0 auto;
  }

  .case-more-divider {
    height: 1px;
    margin-top: 5vw;
    background: currentColor;
  }

  .case-more-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 3.8vw;
  }

  .case-more-heading h2 {
    font-size: 3.5vw;
    font-weight: 500;
    line-height: .9;
    letter-spacing: -.03em;
  }

  .case-more-heading a {
    font-size: 2.19vw;
    text-decoration: none;
  }

  .case-more-link-label,
  .case-more-link-plus {
    position: relative;
  }

  .case-more-link-label::after,
  .case-more-link-plus::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -.08em;
    left: 0;
    height: 3px;
    background: currentColor;
    transform: scaleY(1);
    transform-origin: center bottom;
    transition: transform 180ms cubic-bezier(.19, 1, .22, 1);
  }

  @media (hover: hover) {
    .case-more-heading a:hover .case-more-link-label::after,
    .case-more-heading a:hover .case-more-link-plus::after {
      transform: scaleY(1.5);
    }
  }

  .case-more-heading a:focus-visible .case-more-link-label::after,
  .case-more-heading a:focus-visible .case-more-link-plus::after {
    transform: scaleY(1.5);
  }

  /* Same infinite carousel as the home (src/pages/index.astro): card sizes, 6px gaps, names and hover. */
  .more-carousel {
    position: relative;
    z-index: 2;
    width: 100vw;
    margin-top: 3.7vw;
    margin-left: calc(50% - 50vw);
    overflow: visible;
    touch-action: pan-y;
    user-select: none;
  }

  .more-carousel-track { isolation: isolate; display: flex; align-items: flex-start; width: max-content; overflow: visible; will-change: transform; }
  .more-carousel-card { --name-size: min(20px, 1.25vw, 1.936108svh); position: relative; z-index: 0; display: block; flex: 0 0 var(--card-width); aspect-ratio: var(--card-aspect); margin-right: 6px; overflow: visible; color: inherit; }
  .more-carousel-name { position: absolute; z-index: 2; top: 0; left: 0; display: block; max-width: 100%; overflow: hidden; color: #2e2e2e; font-size: var(--name-size); font-weight: 400; line-height: 1.24; letter-spacing: -.01em; white-space: nowrap; pointer-events: none; }
  .more-carousel-name-text { display: block; transform: translateY(105%); transition: transform .16s cubic-bezier(.55,0,.75,0); }
  .more-carousel-picture { position: absolute; z-index: 1; inset: 0; display: block; overflow: hidden; transition: transform .6s cubic-bezier(.65,0,.35,1) .14s; }
  .more-carousel-picture img { display: block; width: 100%; height: 100%; object-fit: cover; pointer-events: none; transition: transform .8s cubic-bezier(.16,1,.3,1); }
  .more-carousel-picture iframe { position: absolute; top: 50%; left: 50%; width: auto; min-width: 100%; height: 100%; aspect-ratio: 426 / 240; border: 0; pointer-events: none; transform: translate(-50%, -50%); transition: transform .8s cubic-bezier(.16,1,.3,1); }
  @media (hover: hover) and (pointer: fine) {
    .more-carousel-card:is(:hover, :focus-visible) { z-index: 1000; }
    .more-carousel-card:is(:hover, :focus-visible) .more-carousel-picture { transform: translateY(calc(var(--name-size) * 1.24 + 8px)); transition: transform .6s cubic-bezier(.65,0,.35,1); }
    .more-carousel-card:is(:hover, :focus-visible) img { transform: scale(1.15); }
    .more-carousel-card:is(:hover, :focus-visible) iframe { transform: translate(-50%, -50%) scale(1.15); }
    .more-carousel-card:is(:hover, :focus-visible) .more-carousel-name-text { transform: none; transition: transform .65s cubic-bezier(.22,1,.36,1) .28s; }
  }
  /* Touch screens (phones, tablets): names always sit above each photo, with no hover motion. */
  @media not ((hover: hover) and (pointer: fine)) {
    .more-carousel-name { top: auto; bottom: calc(100% + 6px); }
    .more-carousel-name-text { transform: none; transition: none; }
  }
  @media (min-width: 761px) and (not ((hover: hover) and (pointer: fine))) {
    .more-carousel-card { --name-size: clamp(12px, 1.25vw, 20px); }
  }

  .case-footer {
    position: relative;
    margin-top: 1vw;
    overflow: hidden;
  }

  .case-footer-wordmark {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    color: currentColor;
    font-family: var(--case-display);
    font-size: 37.4vw;
    font-weight: 500;
    line-height: .79;
    letter-spacing: -.04em;
    white-space: nowrap;
  }

  @media (min-width: 761px) {
    .case-more[data-current-case='maxmaher'] .case-more-divider {
      height: .5px;
      margin-top: 1.125vw;
    }

    .case-more[data-current-case='maxmaher'] .case-more-heading {
      margin-top: 4.7375vw;
    }

    .case-more[data-current-case='maxmaher'] .more-carousel {
      margin-top: 3.1375vw;
    }

    .case-more[data-current-case='maxmaher'] + .case-footer {
      height: 36vw;
      margin-top: 0;
    }

    .case-more[data-current-case='maxmaher'] + .case-footer .case-footer-wordmark {
      transform: translateY(calc(var(--footer-wordmark-edge) - 11px));
    }

    .case-more[data-current-case='outliant'] .case-more-divider {
      height: .5px;
      background: #2e2e2e;
    }

    .case-footer-wordmark {
      font-size: var(--footer-wordmark-size);
      line-height: .8;
      transform: translateY(var(--footer-wordmark-edge));
    }

    /* The ink of "I" and "6" touches both edges of the screen. */
    .case-footer-wordmark > :first-child { margin-left: -.032em !important; }
    .case-footer-wordmark > :last-child { margin-right: .016em !important; }
  }

  .case-footer-wordmark > :first-child {
    margin-left: -1.5vw;
  }

  .case-footer-wordmark > :last-child {
    margin-right: -1.4vw;
  }

  .case-footer-info {
    position: absolute;
    right: 0;
    bottom: 5vw;
    left: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    padding: 0; /* Edge to edge, like the home footer. */
    font-size: clamp(10px, 1.31vw, 21px);
    line-height: 1;
    letter-spacing: -.02em;
    text-transform: uppercase;
  }

  .case-footer-info > * {
    display: inline-block;
    overflow: hidden;
    padding-top: 1px;
    color: var(--case-paper);
    background: var(--case-ink);
    white-space: nowrap;
  }

  .case-footer-info > :nth-child(2) { margin-left: 5.1%; }
  .case-footer-info > :nth-child(3) { margin-left: 5.2%; }
  .case-footer-info > :nth-child(4) { margin-left: 5.1%; }
  .case-footer-info > :nth-child(5) { margin-left: 6.1%; }
  .case-footer-socials { margin-left: auto; }

  [data-case-footer-reveal] {
    opacity: 0;
    transform: translateY(110%);
    transition: opacity .7s cubic-bezier(.19, 1, .22, 1) var(--reveal-delay, 0ms), transform .9s cubic-bezier(.19, 1, .22, 1) var(--reveal-delay, 0ms);
  }

  [data-case-footer-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  [data-case-text-reveal] {
    opacity: 0;
    transform: translate3d(0, 16px, 0);
    transition: opacity .85s cubic-bezier(.19, 1, .22, 1) var(--reveal-delay, 0ms), transform .95s cubic-bezier(.19, 1, .22, 1) var(--reveal-delay, 0ms);
  }

  [data-case-text-reveal].is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  @media (max-width: 760px) {
    .case-more {
      width: calc(100% - 2 * min(9px, 2.307692vw));
    }

    .case-more-divider {
      margin-top: 54px;
    }

    .case-more-heading {
      margin-top: 16px;
    }

    .case-more-heading h2 {
      font-size: 24px;
    }

    .case-more-heading a {
      font-size: 16px;
    }

    /* Home carousel on phones: 65.6vw cards (max 255.786px), 4px gaps and the same 7-card ratio pattern. */
    .more-carousel { margin-top: 20px; padding-top: 22px; }
    .more-carousel-card { --name-size: min(12px, 3.076923vw); flex: 0 0 min(255.786px, 65.586154vw); width: min(255.786px, 65.586154vw); height: auto; margin-right: 4px; }
    .more-carousel-card:nth-child(7n + 1),
    .more-carousel-card:nth-child(7n + 4) { aspect-ratio: 1; }
    .more-carousel-card:nth-child(7n + 2) { aspect-ratio: 3 / 4; }
    .more-carousel-card:nth-child(7n + 3) { aspect-ratio: 3 / 2; }

    .case-footer {
      margin-top: 18px;
      padding-bottom: 20px;
      z-index: 2;
      background: #fafafa;
    }

    .case-footer-wordmark {
      font-size: 46.2vw;
      line-height: .82;
    }

    .case-footer-info {
      position: static;
      flex-direction: column;
      align-items: flex-start;
      gap: 3px;
      padding: 14px;
      font-size: 12px;
    }

    .case-footer-info > * {
      margin-left: 0 !important;
      white-space: normal;
    }

    .case-more[data-current-case='winona'] {
      position: absolute;
      top: 1164.0141vw;
      left: 2.307692vw;
      width: 95.384616vw;
      height: 114.7vw;
      margin: 0;
    }

    .case-more[data-current-case='winona'] .case-more-divider {
      margin: 0;
    }

    .case-more[data-current-case='winona'] .case-more-heading {
      margin-top: 31px;
    }

    .case-more[data-current-case='winona'] .case-more-heading h2 {
      font-size: 24px;
      line-height: 29px;
    }

    .case-more[data-current-case='winona'] .case-more-heading a {
      font-size: 16px;
      line-height: 19px;
    }

    .case-more[data-current-case='winona'] .more-carousel {
      position: absolute;
      top: 88px; /* The tallest home-sized cards end above the footer. */
      left: -2.307692vw;
      width: 100vw;
      height: 94vw;
      margin: 0;
      padding: 20px 0 0;
    }

    .case-more[data-current-case='winona'] + .case-footer {
      position: absolute;
      top: 1281.9497vw;
      left: 0;
      width: 100vw;
      height: 44.4606vw;
      margin: 0;
      padding: 0;
      overflow: hidden;
      background: #fafafa;
    }

    .case-more[data-current-case='winona'] + .case-footer .case-footer-wordmark {
      font-size: 46.2021vw;
      line-height: 1.2;
      transform: none;
    }

    .case-more[data-current-case='winona'] + .case-footer .case-footer-info {
      display: none;
    }

    .case-more[data-current-case='outliant'] {
      position: absolute;
      top: 2173.073vw;
      left: 2.307692vw;
      width: 95.384616vw;
      height: 114.7vw;
      margin: 0;
    }

    .case-more[data-current-case='outliant'] .case-more-divider {
      height: .5px;
      margin: 0;
      background: #2e2e2e;
    }

    .case-more[data-current-case='outliant'] .case-more-heading {
      margin-top: 31px;
    }

    .case-more[data-current-case='outliant'] .case-more-heading h2 {
      font-size: 24px;
      line-height: 29px;
    }

    .case-more[data-current-case='outliant'] .case-more-heading a {
      font-size: 16px;
      line-height: 19px;
    }

    .case-more[data-current-case='outliant'] .more-carousel {
      position: absolute;
      top: 88px; /* The tallest home-sized cards end above the footer. */
      left: -2.307692vw;
      width: 100vw;
      height: 94vw;
      margin: 0;
      padding: 20px 0 0;
    }

    .case-more[data-current-case='outliant'] + .case-footer {
      position: absolute;
      top: 2291.0086vw;
      left: 0;
      width: 100vw;
      height: 44.376vw;
      margin: 0;
      padding: 0;
      overflow: hidden;
      background: #fafafa;
    }

    .case-more[data-current-case='outliant'] + .case-footer .case-footer-wordmark {
      font-size: 46.2021vw;
      line-height: 1.2;
      transform: none;
    }

    .case-more[data-current-case='outliant'] + .case-footer .case-footer-info { display: none; }

    .case-more[data-current-case='lumen'] {
      position: absolute;
      top: 3353.9583vw;
      left: 2.307692vw;
      width: 95.384616vw;
      height: 114.7vw;
      margin: 0;
    }

    .case-more[data-current-case='lumen'] .case-more-divider {
      height: .5px;
      margin: 0;
      background: #2e2e2e;
    }

    .case-more[data-current-case='lumen'] .case-more-heading { margin-top: 31px; }
    .case-more[data-current-case='lumen'] .case-more-heading h2 { font-size: 24px; line-height: 29px; }
    .case-more[data-current-case='lumen'] .case-more-heading a { font-size: 16px; line-height: 19px; }
    .case-more[data-current-case='lumen'] .more-carousel {
      position: absolute;
      top: 88px; /* The tallest home-sized cards end above the footer. */
      left: -2.307692vw;
      width: 100vw;
      height: 94vw;
      margin: 0;
      padding: 20px 0 0;
    }

    .case-more[data-current-case='lumen'] + .case-footer {
      position: absolute;
      top: 3471.8941vw;
      left: 0;
      width: 100vw;
      height: 44.2597vw;
      margin: 0;
      padding: 0;
      overflow: hidden;
      background: #fafafa;
    }
    .case-more[data-current-case='lumen'] + .case-footer .case-footer-wordmark {
      font-size: 46.2021vw;
      line-height: 1.2;
      transform: none;
    }
    .case-more[data-current-case='lumen'] + .case-footer .case-footer-info { display: none; }

    /* "Itsmicki©2026" with the same position and size as the home wordmark. */
    .case-footer .case-footer-wordmark,
    .case-more[data-current-case] + .case-footer .case-footer-wordmark {
      width: max-content;
      margin-left: -1.538462vw;
      justify-content: flex-start;
      font-size: 46.202051vw;
    }

    .case-footer-wordmark > :first-child,
    .case-footer-wordmark > :last-child {
      margin: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-case-footer-reveal],
    [data-case-text-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
