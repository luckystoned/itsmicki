---
import { imageMetadata } from '@/data/imageMetadata';
import { projectCases } from '@/data/projectCases';

const cards = [
  {
    slug: 'winona',
    src: '/02_Projects/01_Winona/01_Winona_Portada.webp',
    label: '01_Winona_UX—UI Lead, Visual & Motion Designer',
    width: '22.0249vw',
    height: '21.8914vw',
    ratio: '22.0249 / 21.8914',
  },
  {
    slug: 'genova',
    src: '/02_Projects/02_Genova/01_Genova_Portada.webp',
    label: '02_Genova_Art Direction+Visual Design',
    width: '22.0694vw',
    height: '29.2331vw',
    ratio: '22.0694 / 29.2331',
  },
  {
    slug: 'amazon',
    src: '/02_Projects/03_Amazon/01_Amazon_Portada.jpg',
    label: '03_Amazon_UXUI Lead+Art Direction+Visual Design',
    width: '21.8914vw',
    height: '14.4608vw',
    ratio: '21.8914 / 14.4608',
  },
  {
    slug: 'maxmaher',
    src: '/02_Projects/04_MaxMaher/01_MaxMaher_Portada.webp',
    label: '04_MaxMaher_Art Direction+Visual Design',
    width: '22.0249vw',
    height: '21.8469vw',
    ratio: '22.0249 / 21.8469',
  },
  {
    slug: 'outliant',
    src: '/02_Projects/05_Outliant/01_Outliant_Portada.webp',
    label: '05_Outliant_Art Direction+Visual Design+UXUI Lead',
    width: '22vw',
    height: '26.0625vw',
    ratio: '22 / 26.0625',
  },
  {
    slug: 'lumen',
    src: '/02_Projects/06_Lumen/01_Lumen_Portada.webp',
    label: '06_Lumen_Art Direction+Visual Design',
    width: '22.0249vw',
    height: '13.1798vw',
    ratio: '22.0249 / 13.1798',
  },
  {
    slug: 'blend360',
    src: '/02_Projects/07_Blend360/01_Blend360_Portada.webp',
    label: '07_Blend360_UX—UI Lead, Visual & Motion Designer',
    width: '22.0694vw',
    height: '29.2331vw',
    ratio: '22.0694 / 29.2331',
  },
] as const;

const { currentSlug } = Astro.props;
const publishedCaseSlugs = new Set(Object.keys(projectCases));
---

<div class="case-more" data-current-case={currentSlug}>
  <div class="case-more-divider" data-case-text-reveal></div>
  <div class="case-more-heading">
    <h2 data-case-text-reveal>Pss, let’s continue</h2>
    <a href="/projects" data-case-text-reveal style="--reveal-delay:70ms"><span class="case-more-link-label">See All</span> (<span class="case-more-link-plus">+</span>)</a>
  </div>

  <div class="case-strip" data-case-strip data-case-text-reveal aria-label="More selected projects">
    <div class="case-strip-track" data-case-strip-track>
      {[0, 1].map((setIndex) => (
        <div class="case-strip-set" data-case-strip-set={setIndex === 0 ? '' : undefined} aria-hidden={setIndex === 1 ? 'true' : undefined}>
          {cards.map((card) => {
            const dimensions = imageMetadata[card.src];
            const style = `--card-width:${card.width};--card-height:${card.height};--card-ratio:${card.ratio}`;
            const href = publishedCaseSlugs.has(card.slug) ? `/projects/${card.slug}` : undefined;
            const content = (
              <>
                <span class="case-strip-name">{card.label}</span>
                <span class="case-strip-picture">
                  <img
                    src={card.src}
                    alt={setIndex === 0 ? `${card.slug} project cover` : ''}
                    width={dimensions.width}
                    height={dimensions.height}
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                  />
                </span>
              </>
            );
            return href ? (
              <a class:list={['case-strip-card', { current: currentSlug === card.slug }]} data-project-preview="ready" href={href} style={style} tabindex={setIndex === 1 ? '-1' : undefined}>
                {content}
              </a>
            ) : (
              <div class="case-strip-card is-coming" data-project-preview="coming" aria-label={`${card.slug}, coming soon`} style={style}>{content}</div>
            );
          })}
        </div>
      ))}
    </div>
  </div>
</div>

<footer class="case-footer">
  <div class="case-footer-wordmark" aria-label="Itsmicki, copyright 2026">
    <span data-case-footer-reveal>Itsmicki</span>
    <span data-case-footer-reveal>©2026</span>
  </div>
  <div class="case-footer-info">
    <span data-case-footer-reveal style="--reveal-delay:0ms">DEV BY</span>
    <a data-case-footer-reveal style="--reveal-delay:70ms" href="https://www.instagram.com/luckystoned/" target="_blank" rel="noopener noreferrer">@LUCKYSTONED</a>
    <span data-case-footer-reveal style="--reveal-delay:140ms">SAY HI</span>
    <a data-case-footer-reveal style="--reveal-delay:210ms" href="mailto:hey@itsmicki.com">HEY@ITSMICKI.COM</a>
    <span data-case-footer-reveal style="--reveal-delay:280ms">ALL RIGHTS RESERVED.</span>
    <span class="case-footer-socials" data-case-footer-reveal style="--reveal-delay:350ms">
      SOCIALS <a href="https://www.linkedin.com/in/micaelagalimberti/" target="_blank" rel="noopener noreferrer">LINKEDIN</a>,
      <a href="https://www.behance.net/itsmicki" target="_blank" rel="noopener noreferrer">BEHANCE</a>,
      <a href="https://dribbble.com/micaelagalimberti" target="_blank" rel="noopener noreferrer">DRIBBBLE</a>,
      <a href="https://www.instagram.com/its.micki/" target="_blank" rel="noopener noreferrer">INSTAGRAM</a>,
      <span>TIKTOK</span>
    </span>
  </div>
</footer>

<style>
  .case-more {
    width: 97.2668vw;
    margin: 0 auto;
  }

  .case-more-divider {
