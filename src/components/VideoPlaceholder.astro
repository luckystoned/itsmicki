---
const { label = 'Vimeo video coming soon', vimeoId } = Astro.props;
---
{vimeoId ? (
  <div class="vimeo-player">
    <iframe
      src={`https://player.vimeo.com/video/${vimeoId}?background=1&autoplay=1&loop=1&controls=0&quality=2K`}
      title={label}
      loading="lazy"
      allow="autoplay; fullscreen; picture-in-picture"
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
  </div>
) : (
  <div class="video-placeholder" role="img" aria-label={label}>
    <span class="video-label">(motion)</span>
    <span class="play-mark" aria-hidden="true">▶</span>
    <span>{label}</span>
  </div>
)}
