---
import ProjectCaseFooter from '@/components/ProjectCaseFooter.astro';
import { imageMetadata } from '@/data/imageMetadata';
import type { CaseMedia, ProjectCase } from '@/data/projectCases';

interface Props {
  caseStudy: ProjectCase;
}

const { caseStudy } = Astro.props;

const ratioValue = (ratio: string) => {
  const [width, height] = ratio.split('/').map(Number);
  return width / height;
};

const mediaStyle = (media: CaseMedia) => {
  let style = `--media-ratio:${media.ratio}`;
  if (media.type === 'video') style += `;--source-ratio:${media.sourceRatio ? ratioValue(media.sourceRatio) : 16 / 9}`;
  if (media.type !== 'video' || !media.sourceRatio) return style;

  const targetRatio = ratioValue(media.ratio);
  const sourceRatio = ratioValue(media.sourceRatio);
  const width = sourceRatio > targetRatio ? (sourceRatio / targetRatio) * 100 : 100;
  const height = sourceRatio < targetRatio ? (targetRatio / sourceRatio) * 100 : 100;
  style += `;--video-width:${width}%;--video-height:${height}%`;
  return style;
};
const cellStyle = (media: CaseMedia & { width: string; height: string }) =>
  `--cell-width:${media.width};--cell-height:${media.height};${mediaStyle(media)}`;
const vimeoUrl = (id: string) =>
  `https://player.vimeo.com/video/${id}?background=1&autoplay=1&loop=1&controls=0&quality=1080p&dnt=1`;
---

<div class="project-case-page" data-case={caseStudy.slug}>
  <aside class="case-mobile-meta" aria-label="Contact and social links" data-scroll-bar>
    <span>SAY HI</span>
    <a class="case-mobile-mail" href="mailto:hey@itsmicki.com" target="_blank" rel="noopener noreferrer">HEY@ITSMICKI.COM</a>
    <span>SOCIALS</span>
    <span class="case-mobile-socials">
      <a href="https://www.linkedin.com/in/itsmicki/" target="_blank" rel="noopener noreferrer">LINKEDIN</a>,
      {" "}<a href="https://www.behance.net/itsmicki" target="_blank" rel="noopener noreferrer">BEHANCE</a>,
      {" "}<a href="https://dribbble.com/micaelagalimberti" target="_blank" rel="noopener noreferrer">DRIBBBLE</a>,
      {" "}<a href="https://www.instagram.com/its.micki/" target="_blank" rel="noopener noreferrer">INSTAGRAM</a>,
      {" "}<a href="https://www.tiktok.com/@mickivainillla" target="_blank" rel="noopener noreferrer">TIKTOK</a>
    </span>
  </aside>

  <article class="project-case-canvas" aria-labelledby="case-title">
    <header class="editorial-case-hero">
      <div class="case-title-line" data-case-text-reveal>
        <h1 class="case-title" id="case-title">({caseStudy.title})</h1>
        <span class="case-year">{caseStudy.year}</span>
      </div>

      {caseStudy.drags.map((drag) => (
        <div
          class="case-drag"
          data-case-drag
          style={`left:${drag.left};top:${drag.top};width:${drag.width};--drag-rotation:${drag.rotation}`}
          aria-hidden="true"
        >
          <img src={drag.src} alt="" width={imageMetadata[drag.src].width} height={imageMetadata[drag.src].height} draggable="false" />
        </div>
      ))}
    </header>

    <section class="case-intro" aria-label="Project overview">
      <div>
        <h2 class="case-label" data-case-text-reveal>Role</h2>
        <p class="case-intro-large" data-case-text-reveal set:html={caseStudy.role} />
      </div>
      <div>
        <h2 class="case-label" data-case-text-reveal>In a nutshell</h2>
        <p class="case-intro-large case-nutshell" data-case-text-reveal set:html={caseStudy.nutshell} />
        {caseStudy.nutshellColumns && (
          <div class="case-intro-columns">
            {caseStudy.nutshellColumns.map((paragraph, index) => (
              <p data-case-text-reveal style={`--reveal-delay:${index * 70}ms`}>{paragraph}</p>
            ))}
          </div>
        )}
      </div>
    </section>

    <div class="case-flow">
      {caseStudy.blocks.map((block) => {
        if (block.type === 'text') {
          return (
            <section class:list={['case-text', `case-text-${block.variant ?? 'columns'}`]}>
              <h2 data-case-text-reveal>{block.title}</h2>
              {block.variant === 'wide' ? (
                <>
                  <p class="case-text-wide-copy" data-case-text-reveal>{block.wide}</p>
                  {caseStudy.slug === 'lumen' && block.title === '(the challenge)' && (
                    <div class="case-lumen-mobile-copy case-lumen-mobile-challenge">
                      <p>The project needed to communicate several ideas at once without becoming overly theoretical: decentralization, experimentation, community, nightlife, and the productive relationship between art and technology.</p>
                      <p>It also needed an identity flexible enough to live across a physical event, interactive installations, printed graphics, merchandise, and fast-moving social content. The main creative challenge was to turn a cultural position into an immediate visual and sensory experience. People did not simply need to understand the message; they needed to feel invited into it.</p>
                    </div>
                  )}
                </>
              ) : (
                <div class="case-text-content">
                  {block.lead && <p class:list={['case-text-lead', { 'case-outliant-visual-desktop': caseStudy.slug === 'outliant' && block.title === '(visual direction)' }]} data-case-text-reveal>{block.lead}</p>}
                  {caseStudy.slug === 'outliant' && block.title === '(visual direction)' && (
                    <div class="case-outliant-mobile-visual">
                      <p>The selected concept—The Professional & Concise Agency—uses simplicity as a sign of confidence.</p>
                      <p>A restrained palette of dark grey, Outliant’s established electric blue, soft neutrals, and white creates a calmer and more intentional foundation for the work to stand out. The freely available Manrope brings clarity and subtle personality to the primary typography, while Fragment Mono introduces a precise technological accent for highlights and coded details without adding licensing costs.</p>
                    </div>
                  )}
                  <div class="case-text-columns">
                    {block.columns?.map((paragraph, index) => (
                      <p data-case-text-reveal style={`--reveal-delay:${index * 70}ms`}>{paragraph}</p>
                    ))}
                  </div>
                  {block.mobile && (
                    <div class="case-text-mobile">
                      {block.mobile.lead && <p class="case-text-mobile-lead" data-case-text-reveal>{block.mobile.lead}</p>}
                      {block.mobile.columns.map((paragraph, index) => (
                        <p data-case-text-reveal style={`--reveal-delay:${index * 70}ms`}>{paragraph}</p>
                      ))}
                    </div>
                  )}
                  {caseStudy.slug === 'lumen' && block.title === '(design process)' && (
                    <div class="case-lumen-mobile-copy case-lumen-mobile-design">
                      <p>I created the brand from the ground up, defining the visual direction and a system capable of moving between the analog and the digital.</p>
                      <p>The identity was designed to feel luminous, kinetic, and slightly unstable—reflecting a program in which sound, image, bodies, and technology are constantly affecting one another.</p>
                      <p>The system was conceived as a living framework rather than a fixed set of assets. Typography, light, contrast, motion, scale, and graphic repetition could shift across formats while preserving a</p>
                      <p>recognizable attitude. This flexibility allowed the brand to support different artists and audiovisual languages without forcing them into a single aesthetic.</p>
                    </div>
                  )}
                </div>
              )}
            </section>
          );
        }

        if (block.layout === 'single') {
          const item = block.item;
          const dimensions = item.type === 'image' && item.src ? imageMetadata[item.src] : undefined;
          return (
            <section class="case-media-block case-media-single" style={mediaStyle(item)}>
              <div class="case-media-surface" data-case-media-reveal>
                <div class:list={['case-media-content', { 'is-rotated': item.rotate === 90 }]}>
                  {item.type === 'image' && item.src && dimensions ? (
                    <img src={item.src} alt={item.alt} width={dimensions.width} height={dimensions.height} loading="lazy" decoding="async" draggable="false" />
                  ) : item.type === 'carousel' && item.slides?.length ? (
                    <div class="case-carousel" data-case-carousel role="group" aria-roledescription="carousel" aria-label={item.alt}>
                      <div class="case-carousel-track">
                        {item.slides.map((slide, slideIndex) => {
                          const slideDimensions = imageMetadata[slide.src];
                          return (
                            <img
                              class="case-carousel-slide"
                              src={slide.src}
                              alt={slide.alt}
                              width={slideDimensions.width}
                              height={slideDimensions.height}
                              loading="lazy"
                              decoding="async"
                              draggable="false"
                              aria-hidden={slideIndex === 0 ? 'false' : 'true'}
                            />
                          );
                        })}
                      </div>
                      <span class="case-carousel-progress" role="group" aria-label="Choose a photo">
                        {item.slides.map((_, slideIndex) => (
                          <button type="button" class:list={['case-carousel-dot', { 'is-active': slideIndex === 0 }]} aria-label={`Show photo ${slideIndex + 1} of ${item.slides!.length}`} aria-current={slideIndex === 0 ? 'true' : undefined}><b></b></button>
                        ))}
                      </span>
                    </div>
                  ) : item.vimeoId ? (
                    <iframe
                      src={vimeoUrl(item.vimeoId)}
                      title={item.alt}
                      loading="lazy"
                      allow="autoplay; fullscreen; picture-in-picture"
                      referrerpolicy="strict-origin-when-cross-origin"
                    ></iframe>
                  ) : null}
                </div>
              </div>
              {item.caption && <p class="case-media-caption" data-case-text-reveal>{item.caption}</p>}
            </section>
          );
        }

        return (
          <section class:list={['case-media-block', 'case-media-pair', { 'case-media-pair-end': block.align === 'end' }]}>
            {block.items.map((item, itemIndex) => {
              const dimensions = item.type === 'image' && item.src ? imageMetadata[item.src] : undefined;
              return (
                <div class="case-media-cell" style={cellStyle(item)}>
                  <div class="case-media-surface" data-case-media-reveal style={`--reveal-delay:${itemIndex * 70}ms`}>
                    <div class="case-media-content">
                      {item.type === 'image' && item.src && dimensions ? (
                        <img src={item.src} alt={item.alt} width={dimensions.width} height={dimensions.height} loading="lazy" decoding="async" draggable="false" />
                      ) : item.type === 'carousel' && item.slides?.length ? (
                        <div class="case-carousel" data-case-carousel role="group" aria-roledescription="carousel" aria-label={item.alt}>
                          <div class="case-carousel-track">
                            {item.slides.map((slide, slideIndex) => {
                              const slideDimensions = imageMetadata[slide.src];
                              return (
                                <img
                                  class="case-carousel-slide"
                                  src={slide.src}
                                  alt={slide.alt}
                                  width={slideDimensions.width}
                                  height={slideDimensions.height}
                                  loading="lazy"
                                  decoding="async"
                                  draggable="false"
                                  aria-hidden={slideIndex === 0 ? 'false' : 'true'}
                                />
                              );
                            })}
                          </div>
                          <span class="case-carousel-progress" role="group" aria-label="Choose a photo">
                        {item.slides.map((_, slideIndex) => (
                          <button type="button" class:list={['case-carousel-dot', { 'is-active': slideIndex === 0 }]} aria-label={`Show photo ${slideIndex + 1} of ${item.slides!.length}`} aria-current={slideIndex === 0 ? 'true' : undefined}><b></b></button>
                        ))}
                      </span>
                        </div>
                      ) : item.vimeoId ? (
                        <iframe
                          src={vimeoUrl(item.vimeoId)}
                          title={item.alt}
                          loading="lazy"
                          allow="autoplay; fullscreen; picture-in-picture"
                          referrerpolicy="strict-origin-when-cross-origin"
                        ></iframe>
                      ) : null}
                    </div>
                  </div>
                  {item.caption && <p class="case-media-caption" data-case-text-reveal>{item.caption}</p>}
                </div>
              );
            })}
          </section>
        );
      })}
    </div>

    <section class="case-credits">
      <h2 data-case-text-reveal>(credits)</h2>
      <div class="case-credit-list">
        {caseStudy.credits.map((credit, index) => (
          <p data-case-text-reveal style={`--reveal-delay:${index * 70}ms`} set:html={credit} />
        ))}
      </div>
    </section>
  </article>

  <ProjectCaseFooter currentSlug={caseStudy.slug} />
</div>

<script>
  /* Native scroll plus the same frame-rate-independent damping as the reference. */
  (function () {
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion || !matchMedia('(pointer: fine)').matches) return;

    let targetY = window.scrollY;
    let currentY = targetY;
    let running = false;
    let frame: number | null = null;
    let locked = false;
    let previousTime = 0;

    const maxScroll = () => Math.max(0, document.documentElement.scrollHeight - window.innerHeight);

    function tick(now: number) {
      if (!previousTime) previousTime = now;
      const deltaTime = Math.min(64, now - previousTime) / 1000;
      previousTime = now;
      currentY += (targetY - currentY) * (1 - Math.exp(-6.5 * deltaTime));
      if (Math.abs(targetY - currentY) < .12) {
        currentY = targetY;
        running = false;
        previousTime = 0;
      }
      locked = true;
      window.scrollTo(0, currentY);
      locked = false;
      frame = running ? requestAnimationFrame(tick) : null;
    }

    addEventListener('wheel', (event) => {
      if (event.ctrlKey) return;
      event.preventDefault();
      let delta = event.deltaY;
      if (event.deltaMode === 1) delta *= 16;
      else if (event.deltaMode === 2) delta *= window.innerHeight;
      targetY = Math.max(0, Math.min(maxScroll(), targetY + delta));
      if (!running) {
        running = true;
        if (!frame) frame = requestAnimationFrame(tick);
      }
    }, { passive: false });

    addEventListener('scroll', () => {
      if (!locked && !running) targetY = currentY = window.scrollY;
    });

    addEventListener('resize', () => {
      targetY = currentY = window.scrollY;
    });
  })();

  const reduceCaseMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const caseCarousels = Array.from(document.querySelectorAll<HTMLElement>('[data-case-carousel]'));

  // Photo carousels inside the cases: they advance on their own while the active bar fills up, and any
  // swipe, drag, trackpad gesture or click on a bar plays the same eased slide to the next photo.
  caseCarousels.forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('.case-carousel-track');
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.case-carousel-slide'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.case-carousel-dot'));
    const duration = 3600;
    const slideTime = 900;
    let activeIndex = 0;
    let timer: number | undefined;
    let isVisible = false;
    let pointerId = -1;
    let startX = 0;
    let startY = 0;
    let swiped = false;
    let wheelDistance = 0;
    let wheelLock = 0;

    if (!track || slides.length < 2) return;

    // A copy of the first slide sits after the last one, so the loop always moves forward and never rewinds.
    const count = slides.length;
    const loopSlide = slides[0].cloneNode(true) as HTMLElement;
    loopSlide.setAttribute('alt', '');
    loopSlide.setAttribute('aria-hidden', 'true');
    loopSlide.removeAttribute('loading');
    track.append(loopSlide);

    const jumpTo = (index: number) => {
      track.style.transition = 'none';
      activeIndex = index;
      track.style.transform = `translate3d(${-activeIndex * 100}%, 0, 0)`;
      void track.offsetWidth;
      track.style.removeProperty('transition');
    };

    track.addEventListener('transitionend', (event) => {
      if (event.target === track && activeIndex === count) jumpTo(0);
    });

    const running = () => !reduceCaseMotion && isVisible && !document.hidden;

    const paint = () => {
      track.style.transform = `translate3d(${-activeIndex * 100}%, 0, 0)`;
      const current = activeIndex % count;
      slides.forEach((slide, index) => slide.setAttribute('aria-hidden', index === current ? 'false' : 'true'));
      dots.forEach((dot, index) => {
        const active = index === current;
        dot.classList.toggle('is-active', active);
        if (active) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
        // The active bar fills up while its photo is on screen; the next photo comes in when it is full.
        const fill = dot.querySelector<HTMLElement>('b');
        if (!fill) return;
        fill.getAnimations().forEach((animation) => animation.cancel());
        if (active && running()) {
          fill.animate([{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }], { duration, easing: 'linear', fill: 'forwards' });
        } else {
          fill.style.transform = active && reduceCaseMotion ? 'scaleX(1)' : 'scaleX(0)';
        }
      });
    };

    const stop = () => {
      if (timer !== undefined) window.clearTimeout(timer);
      timer = undefined;
    };

    const start = () => {
      stop();
      if (!running()) return;
      timer = window.setTimeout(() => go(1), duration);
    };

    const goTo = (nextIndex: number) => {
      if (nextIndex < 0) {
        // Going back from the first photo: start from its copy at the end and slide back one.
        jumpTo(count);
        nextIndex = count - 1;
      } else if (nextIndex > count) {
        jumpTo(0);
        nextIndex = 1;
      }
      activeIndex = nextIndex;
      paint();
      start();
    };

    const go = (step: number) => {
      if (activeIndex >= count) jumpTo(0);
      goTo(activeIndex + step);
    };

    dots.forEach((dot, index) => dot.addEventListener('click', () => {
      if (index === activeIndex % count) return;
      if (activeIndex >= count) jumpTo(0);
      goTo(index);
    }));

    // Swipes and drags only read the direction; the photo never follows the finger.
    carousel.addEventListener('dragstart', (event) => event.preventDefault());
    carousel.addEventListener('pointerdown', (event) => {
      if (!event.isPrimary || event.button !== 0 || (event.target as Element).closest('.case-carousel-dot')) return;
      pointerId = event.pointerId;
      startX = event.clientX;
      startY = event.clientY;
      swiped = false;
    });
    carousel.addEventListener('pointermove', (event) => {
      if (event.pointerId !== pointerId || swiped) return;
      const dx = event.clientX - startX;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(event.clientY - startY)) {
        swiped = true;
        go(dx < 0 ? 1 : -1);
      }
    });
    const endPointer = (event: PointerEvent) => { if (event.pointerId === pointerId) pointerId = -1; };
    carousel.addEventListener('pointerup', endPointer);
    carousel.addEventListener('pointercancel', endPointer);
    carousel.addEventListener('click', (event) => {
      if (swiped) { event.preventDefault(); swiped = false; }
    }, true);

    // Trackpad: one horizontal gesture moves one photo; the rest of its momentum is ignored.
    carousel.addEventListener('wheel', (event) => {
      if (Math.abs(event.deltaX) <= Math.abs(event.deltaY)) return;
      event.preventDefault();
      const now = performance.now();
      if (now < wheelLock) { wheelLock = now + 220; return; }
      const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? carousel.clientWidth : 1;
      wheelDistance += event.deltaX * unit;
      if (Math.abs(wheelDistance) > 40) {
        go(wheelDistance > 0 ? 1 : -1);
        wheelDistance = 0;
        wheelLock = now + slideTime;
      }
    }, { passive: false });

    const visibilityObserver = new IntersectionObserver(([entry]) => {
      isVisible = entry.isIntersecting;
      paint();
      start();
    }, { threshold: .08, rootMargin: '10% 0px' });

    document.addEventListener('visibilitychange', () => { paint(); start(); });
    visibilityObserver.observe(carousel);
    paint();
  });

  const revealNodes = Array.from(document.querySelectorAll<HTMLElement>('[data-case-text-reveal], [data-case-media-reveal], [data-case-footer-reveal]'));

  if (reduceCaseMotion) {
    revealNodes.forEach((node) => node.classList.add('is-visible'));
  } else if (revealNodes.length) {
    const revealMap = new Map<Element, HTMLElement[]>();
    revealNodes.forEach((node) => {
      const usesParentTrigger = node.hasAttribute('data-case-media-reveal') || node.hasAttribute('data-case-footer-reveal');
      const trigger = usesParentTrigger ? node.parentElement ?? node : node;
      const targets = revealMap.get(trigger) ?? [];
      targets.push(node);
      revealMap.set(trigger, targets);
    });
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        revealMap.get(entry.target)?.forEach((node) => node.classList.toggle('is-visible', entry.isIntersecting));
      });
    }, { threshold: .02, rootMargin: '-2% 0px -6% 0px' });
    revealMap.forEach((_, trigger) => revealObserver.observe(trigger));
  }

  const dragNodes = Array.from(document.querySelectorAll<HTMLElement>('[data-case-drag]'));
  // Stickers hang from the finger or mouse on a loose spring: they trail, overshoot a little, swing with the
  // movement like a pendulum, lift while held and keep some momentum when released.
  dragNodes.forEach((node) => {
    let dragging = false;
    let pointerId = -1;
    let startX = 0;
    let startY = 0;
    let originX = 0;
    let originY = 0;
    let targetX = 0;
    let targetY = 0;
    let x = 0;
    let y = 0;
    let speedX = 0;
    let speedY = 0;
    let velocityX = 0;
    let velocityY = 0;
    let tilt = 0;
    let spin = 0;
    let lift = 1;
    let running = false;
    let previousTime = 0;

    const paint = () => {
      node.style.setProperty('--drag-x', `${x.toFixed(2)}px`);
      node.style.setProperty('--drag-y', `${y.toFixed(2)}px`);
      node.style.setProperty('--drag-tilt', `${tilt.toFixed(2)}deg`);
      node.style.setProperty('--drag-scale', lift.toFixed(3));
    };

    const frame = (time: number) => {
      const elapsed = previousTime ? Math.min(time - previousTime, 32) / (1000 / 60) : 1;
      previousTime = time;
      if (!dragging) {
        // Momentum after release, fading out.
        targetX += velocityX * elapsed;
        targetY += velocityY * elapsed;
        velocityX *= Math.pow(.92, elapsed);
        velocityY *= Math.pow(.92, elapsed);
      }
      // Underdamped spring: a small overshoot gives the sticker its bounce.
      const damping = Math.pow(.74, elapsed);
      speedX = (speedX + (targetX - x) * .14 * elapsed) * damping;
      speedY = (speedY + (targetY - y) * .14 * elapsed) * damping;
      x += speedX * elapsed;
      y += speedY * elapsed;
      // The tilt follows the horizontal speed on its own looser spring, so it swings and settles.
      const swing = Math.max(-24, Math.min(24, speedX * 1.5 + speedY * .25));
      spin = (spin + (swing - tilt) * .16 * elapsed) * Math.pow(.8, elapsed);
      tilt += spin * elapsed;
      lift += ((dragging ? 1.07 : 1) - lift) * (1 - Math.pow(1 - .2, elapsed));
      paint();
      const settled = !dragging && Math.abs(targetX - x) < .1 && Math.abs(targetY - y) < .1 && Math.abs(speedX) < .05 && Math.abs(speedY) < .05 && Math.abs(velocityX) < .05 && Math.abs(velocityY) < .05 && Math.abs(tilt) < .05 && Math.abs(spin) < .05 && Math.abs(lift - 1) < .001;
      if (settled) { running = false; previousTime = 0; tilt = 0; spin = 0; lift = 1; x = targetX; y = targetY; paint(); return; }
      requestAnimationFrame(frame);
    };

    const run = () => { if (!running) { running = true; requestAnimationFrame(frame); } };

    node.addEventListener('pointerdown', (event) => {
      event.preventDefault();
      dragging = true;
      pointerId = event.pointerId;
      startX = event.clientX;
      startY = event.clientY;
      originX = targetX;
      originY = targetY;
      velocityX = 0;
      velocityY = 0;
      node.setPointerCapture(pointerId);
      node.classList.add('is-dragging');
      if (!reduceCaseMotion) run();
    });

    node.addEventListener('pointermove', (event) => {
      if (!dragging || event.pointerId !== pointerId) return;
      const nextX = originX + event.clientX - startX;
      const nextY = originY + event.clientY - startY;
      velocityX = velocityX * .6 + (nextX - targetX) * .4;
      velocityY = velocityY * .6 + (nextY - targetY) * .4;
      targetX = nextX;
      targetY = nextY;
      if (reduceCaseMotion) { x = targetX; y = targetY; paint(); }
    });

    const endDrag = (event: PointerEvent) => {
      if (!dragging || event.pointerId !== pointerId) return;
      dragging = false;
      node.classList.remove('is-dragging');
      if (node.hasPointerCapture(pointerId)) node.releasePointerCapture(pointerId);
