  .case-media-cell {
    flex: 0 0 auto;
    width: var(--cell-width);
  }

  .case-media-cell .case-media-surface {
    height: var(--cell-height);
  }

  .case-media-single .case-media-surface {
    aspect-ratio: var(--media-ratio);
  }

  .case-media-surface {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--case-placeholder);
  }

  .case-media-content {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
  }

  .case-media-content img,
  .case-media-content iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .case-media-content iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--video-width, 100%);
    height: var(--video-height, 100%);
    transform: translate(-50%, -50%);
  }

  .case-carousel,
  .case-carousel-track {
    width: 100%;
    height: 100%;
  }

  .case-carousel {
    position: relative;
    overflow: hidden;
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
  }

  .case-carousel:active {
    cursor: grabbing;
  }

  .case-carousel-track {
    display: flex;
    transition: transform .72s cubic-bezier(.16, 1, .3, 1);
    will-change: transform;
  }

  .case-media-content .case-carousel-slide {
    flex: 0 0 100%;
    min-width: 100%;
    object-fit: cover;
  }

  .case-carousel-progress {
    position: absolute;
    bottom: 3.3%;
    left: 50%;
    z-index: 3;
    display: flex;
    width: clamp(74px, 12.1%, 106px);
    height: clamp(15px, 2.68%, 23px);
    align-items: center;
    gap: clamp(2px, .46%, 4px);
    padding: 0 clamp(5px, .9%, 8px);
    border-radius: 48px;
    background: rgb(217 217 217 / 22%);
    backdrop-filter: blur(14px) saturate(1.15);
    transform: translateX(-50%);
  }

  .case-carousel-progress i {
    position: relative;
    display: block;
    min-width: 0;
    height: clamp(3px, .55%, 5px);
    flex: 1 1 0;
    overflow: hidden;
    border-radius: 32px;
    background: rgb(250 250 250 / 30%);
  }

  .case-carousel-progress i.is-active {
    flex-grow: 2.75;
  }

  .case-carousel-progress b {
    position: absolute;
    inset: 0 auto 0 0;
    width: 100%;
    border-radius: inherit;
    background: var(--case-paper);
    transform: scaleX(0);
    transform-origin: left center;
  }

