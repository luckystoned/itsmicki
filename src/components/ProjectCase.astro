    --case-sans: 'OT Neue Montreal Cases', 'Arial Narrow', sans-serif;
    --case-display: 'OT Neue Montreal Cases Extra', 'Arial Narrow', sans-serif;
    color: var(--case-ink);
    background: var(--case-paper);
    cursor: url('/cursors/view.png') 0 0, auto;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  html:has(.project-case-page) {
    scroll-behavior: auto;
  }

  body:has(.project-case-page) a,
  body:has(.project-case-page) [data-case-drag],
  body:has(.project-case-page) [data-case-strip] {
    cursor: url('/cursors/view.png') 0 0, auto;
  }

  body:has(.project-case-page) a:is(:hover, :focus-visible) {
    cursor: url('/cursors/view-hover.png') 0 0, pointer;
  }

  body:has(.project-case-page) ::selection {
    color: var(--case-paper);
    background: var(--case-ink);
  }

  body:has(.project-case-page) .site-header {
    position: relative;
    top: auto;
    z-index: 20;
    padding: 24px clamp(14px, 1.42vw, 22px) 0;
    color: var(--case-ink);
    background: transparent;
    backdrop-filter: none;
    font-family: var(--case-sans);
    font-size: clamp(14px, 1.74vw, 27.117px);
    font-weight: 500;
    line-height: normal;
    letter-spacing: -.02em;
  }

  body:has(.project-case-page) .site-header nav {
    gap: 10px;
  }

  body:has(.project-case-page) .site-header a::after {
    display: none;
  }

  body:has(.project-case-page) .site-header a:is(:hover, :focus-visible, .active) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: .08em;
  }

  .project-case-page {
    position: relative;
    display: flow-root;
    min-height: 100vh;
    color: var(--case-ink);
    background: var(--case-paper);
    font-family: var(--case-sans);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -.01em;
  }

  .project-case-page a {
