  .case-drag {
    --drag-x: 0px;
    --drag-y: 0px;
    --drag-lift: 0px;
    position: absolute;
    z-index: 8;
    user-select: none;
    touch-action: none;
    transform: translate3d(var(--drag-x), calc(var(--drag-y) - var(--drag-lift)), 0) rotate(var(--drag-rotation));
    cursor: grab !important;
    will-change: transform;
  }

  .case-drag.is-dragging {
    cursor: grabbing !important;
  }

  .case-drag img {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
  }

  .case-intro {
    display: grid;
    grid-template-columns: 34.72vw 1fr;
