        return { level: clamp((loud - .04) / .32), onset };
      },
      /** fist 0–1, near 0 (far) – 1 (near). */
      shape: (fist: number, near: number) => {
        if (!graph || !on) return;
        const now = graph.ctx.currentTime;
        if (graph.glitch) {
          // The song keeps its tempo (the breaks are in time with it): the worklet is told where it is.
          graph.glitch.port.postMessage({ song: audio.currentTime, at: graph.ctx.currentTime, rate: audio.playbackRate });
          graph.glitch.parameters.get('amount')!.setTargetAtTime(fist * (.6 + .4 * near), now, .02);
          graph.glitch.parameters.get('near')!.setTargetAtTime(near, now, .05);
        }
        // Far: muffled and drowned in a long echo (ethereal).
        graph.filter.frequency.setTargetAtTime(20000 - fist * (1 - near) * 17500, now, .08);
        graph.wet.gain.setTargetAtTime(fist * (.2 + (1 - near) * .6), now, .15);
        graph.dry.gain.setTargetAtTime(1 - fist * (1 - near) * .25, now, .15);
      },
    };
  };

  document.querySelectorAll<HTMLElement>('[data-nostalgia-field]').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('.nostalgia-field-canvas')!;
    const context = canvas.getContext('2d')!;
    const caption = root.closest('section') ?? document;
    let width = 0, height = 0, ratio = 1, U = 1;
    const film = root.querySelector<HTMLVideoElement>('.nostalgia-field-video')!;
    const stills: Record<'wide' | 'tall', HTMLImageElement> = { wide: new Image(), tall: new Image() };
    stills.wide.src = SETTINGS.stills.wide; stills.tall.src = SETTINGS.stills.tall;
    const tall = () => height > width * 1.05;
    // The footage at the frame's size (cover-fitted), its squashed copy (the soft smear) and the frame grabbed for slicing.
    let footage = canvasOf(1, 1), smear = canvasOf(1, 24), grab = canvasOf(1, 1), grain = canvasOf(1, 1);
    // The home videos once they play; until then (and with reduced motion) the still.
    const source = (): [CanvasImageSource, number, number] | null => {
      if (!calm && film.readyState >= 2 && film.videoWidth) return [film, film.videoWidth, film.videoHeight];
      const img = tall() ? stills.tall : stills.wide;
      return img.complete && img.naturalWidth ? [img, img.naturalWidth, img.naturalHeight] : null;
    };
    // Super 8: 18 frames a second, the gate weaving, warm faded colour, lifted blacks, flicker, a soft vignette, dust and hairs.
    let lastFrame = -1, vignette = canvasOf(1, 1);
    const super8 = (f: CanvasRenderingContext2D, frame: number) => {
      const W = footage.width, H = footage.height;
      f.globalCompositeOperation = 'multiply'; f.fillStyle = '#f3d9b0'; f.fillRect(0, 0, W, H); // warm
      f.globalCompositeOperation = 'screen'; f.fillStyle = '#2a1a10'; f.fillRect(0, 0, W, H); // faded blacks
      f.globalCompositeOperation = 'source-over';
      const flicker = (hash(frame, 41) - .5) * .12;
      f.fillStyle = flicker > 0 ? `rgba(255,236,200,${flicker})` : `rgba(0,0,0,${-flicker})`; f.fillRect(0, 0, W, H);
      f.drawImage(vignette, 0, 0);
      // Dust: a few specks a frame, now and then a hair or a scratch.
      const u = Math.max(1, W / 600);
      for (let k = 0, n = Math.floor(hash(frame, 43) * 5); k < n; k++) {
        f.fillStyle = hash(frame, 44, k) < .7 ? 'rgba(12,8,6,.75)' : 'rgba(255,248,232,.7)';
        f.beginPath(); f.arc(hash(frame, 45, k) * W, hash(frame, 46, k) * H, u * (.6 + hash(frame, 47, k) * 2.2), 0, TAU); f.fill();
      }
      if (hash(frame, 48) < .12) {
        f.strokeStyle = 'rgba(10,6,4,.6)'; f.lineWidth = u * .8; f.beginPath();
        const x0 = hash(frame, 49) * W, y0 = hash(frame, 50) * H; f.moveTo(x0, y0);
        f.quadraticCurveTo(x0 + (hash(frame, 51) - .5) * 60 * u, y0 + 20 * u, x0 + (hash(frame, 52) - .5) * 40 * u, y0 + (15 + hash(frame, 53) * 40) * u); f.stroke();
