---
// Nostalgia as Agony: a memory that won't hold still. Home videos, cut together (silent), are pixel-stretched into vertical
// streaks, with two clusters of tracking boxes where it shows clean and, in hits, thin slices slipping sideways and
// dashed rows of dead pixels, as in the cover. A hand in front of the camera (or the pointer) draws the tracking to
// it and the image opens up there, the glitch growing as it comes near the camera (or up the frame) and shrinking as
// it goes away; a closed fist (or a held press) breaks everything, image and sound: near the camera (or high in the
// frame) the song breaks higher and harsher, far (or low) lower and ethereal. The camera image
// stays on the device; the sound only starts when asked for. With reduced motion only the still shows.
type Props = { label: string };
const { label } = Astro.props;
---

<div class="nostalgia-field" data-nostalgia-field>
  <video class="nostalgia-field-video" src="/04_SideB/Projects/05_Nostalgia/03_Nostalgia_Home.mp4" muted loop playsinline disablepictureinpicture preload="none" aria-hidden="true"></video>
  <canvas class="nostalgia-field-canvas" role="img" aria-label={label}></canvas>
  <!-- With the camera on it fills the screen (with a cross that closes it, camera and sound off) and this switch. -->
  <button type="button" class="nostalgia-field-sound" role="switch" aria-checked="false" data-nostalgia-sound-toggle hidden>
    <span class="nostalgia-field-sound-label">sound</span><span class="nostalgia-field-sound-track" aria-hidden="true"><span></span></span>
  </button>
</div>

<script>
  import { loadVision, openCamera } from '@/scripts/camera';
  import { fullscreenField } from '@/scripts/fullscreenField';

  const SETTINGS = {
    // The footage: a wide and a tall cut (the tall one for phone frames). Videos can take their place later.
    stills: { wide: '/04_SideB/Projects/05_Nostalgia/01_Nostalgia_Still.webp', tall: '/04_SideB/Projects/05_Nostalgia/02_Nostalgia_Still_Tall.webp' },
    track: '/04_SideB/Projects/05_Nostalgia/00_Nostalgia_Track.mp3', // The song (With You, nthng).
    loop: 4, // Seconds the glitch pattern takes to come round.
    hits: [[3, 2], [8, 1], [12, 9], [29, 2], [33, 1], [36, 4], [45, 2], [49, 1], [52, 3], [59, 2], [64, 14], [82, 1], [86, 2], [90, 3]] as Array<[number, number]>, // ta ta piiii tatatta… (in 24ths of a second)
    line: 'rgba(146,168,196,', // The tracking boxes and their wires: a muted blue.
    dashes: ['#0b0a0a', '#151313', '#000000', '#211e1d', '#f2f0ec'], // Dead pixels: black, a near-black or two, now and then white.
    hand: 'https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task',
  };
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hash = (a: number, b: number, c = 0) => { let h = Math.imul(a * 374761393 + b * 668265263 + c * 2147483647, 1274126177); h ^= h >>> 13; h = Math.imul(h, 1103515245); return ((h ^ (h >>> 16)) >>> 0) / 4294967296; };
  const canvasOf = (w: number, h: number) => { const c = document.createElement('canvas'); c.width = Math.max(1, Math.round(w)); c.height = Math.max(1, Math.round(h)); return c; };
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const TAU = Math.PI * 2;

  // The glitch itself, sample by sample (an AudioWorklet), in time with the song (100 BPM): while `amount` is up, each
  // sixteenth plays clean or breaks on purpose, IDM-style: a roll (the last bit repeated in 1/8 to 1/64, its pitch
  // sliding), a reverse, a 1/32 gate, a bit-crush, a dry hole, or, closing the bar, a tape stop. How often, and which,
  // comes from a fixed pattern per bar (so it repeats and grooves), denser with `amount`; `near` makes the rolls
  // shorter and rising, far makes them longer and falling. Each break is told to the page so the image breaks with it.
  const SONG = { bpm: 100, first: .22 }; // Its tempo, and where its first beat falls (seconds).
  const GLITCH = `
    const STEP = 60 / ${SONG.bpm} / 4, FIRST = ${SONG.first};
    const hash = (a, b) => { let h = Math.imul(a * 374761393 + b * 668265263, 1274126177); h ^= h >>> 13; h = Math.imul(h, 1103515245); return ((h ^ (h >>> 16)) >>> 0) / 4294967296; };
    // What a step does, as the glitches at 4:16 in the track: the song keeps going underneath (now and then it
    // stutters or drops too) and a bright digital layer breaks over it: 32nd-note buzzes, ticks that ring, chirps
    // sweeping up or down, blocks of crushed noise. The pattern changes every 2 bars and repeats once, so it reads
    // as a figure, not noise.
    const event = (bar, step, a, near) => {
      const phrase = Math.floor(bar / 2), id = phrase * 31 + step, h = hash(id, 7), k = hash(id, 11), m = hash(id, 13);
      if (step === 15 && hash(phrase, 3) < a * .5) return { kind: 'stop', song: 'stop', art: { type: 'crush', len: 1, d: 6, pan: 0 } };
      const density = a * (.5 + near * .35) * (step % 4 === 0 ? 1.3 : 1);
      if (h > density) return { kind: 'pass' };
      const up = near > .5, song = m < .22 ? 'roll' : m < .3 ? 'hole' : 'pass';
      let art;
      if (k < .28) art = { type: 'buzz', len: hash(id, 17) < .4 ? 2 : 1, f: (up ? 1760 : 880) * [1, 1.5, 2][Math.floor(hash(id, 19) * 3)] };
      else if (k < .5) art = { type: 'ticks', len: hash(id, 21) < .5 ? 2 : 1 };
      else if (k < .76) {
        const hi = 2600 + hash(id, 25) * 1400 * (up ? 1.6 : 1), lo = (up ? 1200 : 700) + hash(id, 27) * 400;
        art = { type: 'chirp', len: 1 + Math.floor(hash(id, 23) * 2), from: hash(id, 29) < .6 ? hi : lo, to: hash(id, 29) < .6 ? lo : hi };
      } else art = { type: 'crush', len: hash(id, 31) < .5 ? 2 : 1, d: 3 + Math.floor(hash(id, 33) * 10) };
      art.pan = (hash(id, 35) - .5) * .8;
      const divs = up ? [.25, .5, .5, 1] : [.5, 1, 1, 2];
      return { kind: song === 'pass' ? art.type : song, song, art, div: divs[Math.floor(hash(id, 37) * 4)], semis: up ? 3 + near * 9 : -(3 + (1 - near) * 9) };
    };
    class Glitch extends AudioWorkletProcessor {
      static get parameterDescriptors() { return [{ name: 'amount', defaultValue: 0, minValue: 0, maxValue: 1 }, { name: 'near', defaultValue: .5, minValue: 0, maxValue: 1 }]; }
      constructor() {
        super();
        this.size = sampleRate * 4 | 0; this.buf = [new Float32Array(this.size), new Float32Array(this.size)]; this.w = 0;
        this.clock = null; this.lastStep = -1; this.ev = { kind: 'pass' }; this.evStart = 0; this.read = 0;
        // The bright layer: what it is, where it is, and its oscillator and sample-and-hold.
        this.art = null; this.artPos = 0; this.artLen = 0; this.ph = 0; this.held = 0; this.heldLeft = 0; this.jitter = 0;
        // The radio under it: a narrow band (its lows given back), static, crackle and a tuning whistle.
        this.hp = [0, 0]; this.lp = [0, 0]; this.low = [0, 0]; this.prev = [0, 0]; this.brown = 0; this.hiss = 0; this.sig = 1;
        this.burst = 0; this.crackle = 0; this.nlp = 0; this.nlp2 = 0; this.nlp3 = 0; this.whistle = 0; this.wFreq = 900; this.wTarget = 900; this.wOn = 0;
        this.port.onmessage = (e) => { this.clock = e.data; };
      }
      // One sample of the bright layer.
      artifact(stepLen) {
        const art = this.art, p = this.artPos, L = this.artLen, sr = sampleRate;
        const edge = Math.min(1, p / 48, (L - p) / 96), grain = stepLen / 2, gp = p % grain, gi = Math.floor(p / grain);
        let y = 0;
        if (art.type === 'buzz') {
          this.ph += art.f / sr; this.ph -= Math.floor(this.ph);
          if (--this.heldLeft <= 0) { this.held = (this.ph < .5 ? 1 : -1) + (this.ph * 2.01 % 1 < .5 ? .5 : -.5); this.heldLeft = 3; }
          y = this.held * Math.exp(-gp / (.03 * sr)) * .13 + (gp < .002 * sr ? (Math.random() * 2 - 1) * .2 : 0);
        } else if (art.type === 'ticks') {
          const f = 1800 + hash(gi, art.len * 7 + 41) * 1800;
          y = Math.sin(2 * Math.PI * f * gp / sr) * Math.exp(-gp / (.01 * sr)) * .22 + (gp < 24 ? (Math.random() * 2 - 1) * .3 : 0);
        } else if (art.type === 'chirp') {
          // Grainy, not clean: the pitch jitters every few ms and the wave is held in steps (it aliases into copies).
          if (p % 128 === 0) this.jitter = (Math.random() - .5) * .14;
          const u = p / L, f = art.from * Math.pow(art.to / art.from, u) * (1 + this.jitter + .04 * Math.sin(2 * Math.PI * 38 * p / sr));
          this.ph += f / sr; this.ph -= Math.floor(this.ph);
          if (--this.heldLeft <= 0) { this.held = Math.sin(2 * Math.PI * this.ph) + .45 * Math.sin(4 * Math.PI * this.ph); this.heldLeft = 3; }
          y = this.held * .14;
        } else if (art.type === 'crush') {
          if (--this.heldLeft <= 0) { this.held = Math.round((Math.random() * 2 - 1) * 3) / 3; this.heldLeft = art.d; }
          y = hash(Math.floor(p / (stepLen / 4)), art.d + 43) < .7 ? this.held * .17 : 0; // cut in 64ths: the holes in it
        }
        return y * edge;
      }
      process(inputs, outputs, params) {
        const input = inputs[0], output = outputs[0];
        if (!input || !input.length) return true;
        const a = params.amount[0], near = params.near[0], n = output[0].length, sr = sampleRate, stepLen = STEP * sr;
        const hpA = Math.exp(-2 * Math.PI * (250 + near * 250) / sr), lpA = 1 - Math.exp(-2 * Math.PI * (2600 + (1 - near) * 600 - near * 900) / sr), lowA = 1 - Math.exp(-2 * Math.PI * 170 / sr);
        const staticLevel = a * (.02 + (1 - near) * .03), wet = Math.min(1, a * 1.1), level = 1 + a * .5, fDepth = a * (.2 + near * .3), artLevel = .7 + a * .5;
        for (let i = 0; i < n; i++) {
          for (let c = 0; c < 2; c++) this.buf[c][this.w] = (input[c] || input[0])[i];
          // Where the song is (it tells us its time; we run on from there).
          const t = this.clock ? this.clock.song + (currentTime + i / sr - this.clock.at) * this.clock.rate : currentTime + i / sr; // (its own clock until told)
          const beats = (t - FIRST) / STEP, s = Math.floor(beats), phase = beats - s;
          if (s !== this.lastStep) {
            this.lastStep = s;
            const bar = Math.floor(s / 16), step = ((s % 16) + 16) % 16;
            this.ev = a > .03 ? event(bar, step, a, near) : { kind: 'pass' };
            this.evStart = this.w; this.read = 0;
            if (this.ev.kind !== 'pass') {
              this.port.postMessage({ kind: this.ev.kind, step, bar });
              this.art = this.ev.art; this.artPos = 0; this.artLen = Math.floor(this.ev.art.len * stepLen); this.heldLeft = 0;
              this.burst = .3 + hash(s, 5) * .4;
              if (hash(s, 9) < .3 + near * .3) this.crackle = Math.floor(stepLen);
            }
            if (step % 4 === 0 && a > .03) { this.wTarget = (300 + hash(bar * 4 + step, 21) * 1400) * (1 + near * 1.6); this.wOn = hash(bar * 4 + step, 23) < a * (.35 + near * .3) ? 1 : 0; }
            if (a <= .03) { this.wOn = 0; this.art = null; }
          }
          const ev = this.ev, song = ev.song || 'pass', edge = Math.min(1, phase * 40, (1 - phase) * 40);
          const sigTarget = a <= .03 ? 1 : song === 'hole' ? (phase < .15 ? 1 : .05) : song === 'stop' ? 1 - phase * .8 : .92;
          this.sig += (sigTarget - this.sig) * .02;
          this.burst *= .9996;
          const tremble = 1 - fDepth * (.5 + .5 * Math.cos(beats * 2 * Math.PI * (near > .5 ? 2 : 1)));
          this.wFreq += (this.wTarget - this.wFreq) * .0004; this.whistle += this.wFreq / sr; if (this.whistle > 1) this.whistle -= 1;
          const white = Math.random() * 2 - 1;
          this.brown = (this.brown + white * .02) * .997; this.hiss += (white - this.hiss) * .35;
          let noise = (this.hiss * .6 + this.brown * 1.6) * (staticLevel + (1 - this.sig) * a * .25 + this.burst * a * .2);
          if (this.crackle > 0 && Math.random() < .25) noise += (Math.random() * 2 - 1) * a * (.12 + near * .15);
          this.nlp += .25 * (noise - this.nlp); this.nlp2 += .25 * (this.nlp - this.nlp2); this.nlp3 += .25 * (this.nlp2 - this.nlp3); noise = this.nlp3 * 1.4; // radio static stays under ~2 kHz (the bright layer has the top)
          const tone = this.wOn ? Math.sin(this.whistle * 2 * Math.PI) * a * .03 * (.5 + .5 * Math.cos(beats * Math.PI)) : 0;
          let bright = 0;
          if (this.art && this.artPos < this.artLen) { bright = this.artifact(stepLen) * artLevel; this.artPos++; }
          for (let c = 0; c < output.length; c++) {
            const ch = c % 2, dry = (input[c] || input[0])[i];
            let y = dry;
            if (song === 'roll') {
              const len = Math.max(32, Math.floor(stepLen * ev.div)), pos = this.read % len;
              const at = (this.evStart - len + Math.floor(pos) + this.size) % this.size, fr = pos - Math.floor(pos);
              y = this.buf[ch][at] * (1 - fr) + this.buf[ch][(at + 1) % this.size] * fr;
              const local = pos / len; y *= Math.min(1, local * 30, (1 - local) * 30); // each repeat clicks in cleanly
            } else if (song === 'stop') {
              y = this.buf[ch][(this.evStart - Math.floor(stepLen) + Math.floor(this.read) + this.size) % this.size];
            }
            const cut = song === 'pass' ? dry : dry * (1 - edge) + y * edge;
            // Through the radio, with the song's lows given back (they keep going, as in the track).
            this.hp[ch] = hpA * (this.hp[ch] + cut - this.prev[ch]); this.prev[ch] = cut;
            this.lp[ch] += lpA * (this.hp[ch] - this.lp[ch]);
            this.low[ch] += lowA * (cut - this.low[ch]);
            const radio = Math.tanh(this.lp[ch] * 1.8) * this.sig * tremble;
            const art = bright * (ch === 0 ? 1 - (this.art ? this.art.pan : 0) : 1 + (this.art ? this.art.pan : 0));
            const out = (cut * (1 - wet) + (radio + this.low[ch] * .9 + noise + tone) * wet) * level + art;
            output[c][i] = a > .03 ? Math.tanh(out) : out; // (a soft limit, so the bursts never clip)
          }
          if (song === 'roll') this.read += Math.pow(2, (ev.semis * phase) / 12);
          else if (song === 'stop') this.read += Math.max(0, 1 - phase);
          else this.read += 1;
          if (this.crackle > 0) this.crackle--;
          this.w = (this.w + 1) % this.size;
        }
        return true;
      }
    }
    registerProcessor('nostalgia-glitch', Glitch);`;

  /** The song, broken by the hand: the glitch above, its pitch and speed, a low-pass and a long, cold echo. */
  const makeSound = (src: string, film: HTMLVideoElement) => {
    const audio = new Audio(src);
    audio.loop = true; audio.preload = 'none';
    (audio as HTMLAudioElement & { preservesPitch?: boolean }).preservesPitch = false;
    (audio as HTMLAudioElement & { webkitPreservesPitch?: boolean }).webkitPreservesPitch = false;
    let graph: { ctx: AudioContext; glitch: AudioWorkletNode | null; filter: BiquadFilterNode; wet: GainNode; dry: GainNode; master: GainNode; ear: AnalyserNode } | null = null;
    let wave = new Float32Array(1024), loud = 0, floor = .02, lastOnset = 0;
    const breaks: Array<{ kind: string; step: number; bar: number; at: number }> = [];
    const build = async () => {
      const ctx = new AudioContext();
      const source = ctx.createMediaElementSource(audio);
      // Listening to the song itself (before it is broken), so the image can glitch with it.
      const ear = ctx.createAnalyser(); ear.fftSize = 1024; source.connect(ear);
      let glitch: AudioWorkletNode | null = null;
      try {
        const url = URL.createObjectURL(new Blob([GLITCH], { type: 'text/javascript' }));
        await ctx.audioWorklet.addModule(url);
        URL.revokeObjectURL(url);
        glitch = new AudioWorkletNode(ctx, 'nostalgia-glitch', { outputChannelCount: [2] });
        glitch.port.onmessage = (e) => { breaks.push({ ...e.data, at: performance.now() }); if (breaks.length > 8) breaks.shift(); };
      } catch { glitch = null; } // Without worklets: pitch, filter and echo only.
      const filter = ctx.createBiquadFilter(); filter.type = 'lowpass'; filter.frequency.value = 20000; filter.Q.value = .8;
      const echo = ctx.createConvolver();
      const length = Math.round(ctx.sampleRate * 3.5), ir = ctx.createBuffer(2, length, ctx.sampleRate);
      for (let ch = 0; ch < 2; ch++) { const d = ir.getChannelData(ch); for (let i = 0; i < length; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / length, 2.6); }
      echo.buffer = ir;
      const dry = ctx.createGain(), wet = ctx.createGain(), master = ctx.createGain();
      wet.gain.value = 0; master.gain.value = 0;
      (glitch ? source.connect(glitch) : source).connect(filter);
      filter.connect(dry).connect(master);
      filter.connect(echo).connect(wet).connect(master);
      master.connect(ctx.destination);
      graph = { ctx, glitch, filter, wet, dry, master, ear };
    };
    let on = false;
    return {
      get on() { return on; },
      available: async () => { try { const r = await fetch(src, { method: 'HEAD' }); return r.ok; } catch { return false; } },
      start: async () => {
        if (!graph) await build();
        await graph!.ctx.resume();
        await audio.play();
        film.play().catch(() => {});
        graph!.master.gain.setTargetAtTime(.9, graph!.ctx.currentTime, .4);
        on = true;
      },
      stop: () => { if (!graph) return; graph.master.gain.setTargetAtTime(0, graph.ctx.currentTime, .15); setTimeout(() => audio.pause(), 500); on = false; },
      /** The films' speed follows the song's (its glitches stretch and rush the image too). */
      get rate() { return audio.playbackRate; },
      /** The latest IDM break, if one happened in the last `within` ms. */
      lastBreak: (within: number) => { const b = breaks[breaks.length - 1]; return b && performance.now() - b.at < within ? b : null; },
      /** How loud the song is now (0–1-ish), and whether a hit (a sudden rise over its recent level) just happened. */
      listen: () => {
        if (!graph || !on) return { level: 0, onset: 0 };
        graph.ear.getFloatTimeDomainData(wave);
        let sum = 0; for (let i = 0; i < wave.length; i++) sum += wave[i] * wave[i];
        const rms = Math.sqrt(sum / wave.length), now = performance.now();
        loud += (rms - loud) * .25; floor += (rms - floor) * .02;
