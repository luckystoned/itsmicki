---
// Hover on the project covers (desktop only). One small, soft spot follows the pointer: inside it the photo is
// frosted (blurred, never lightened) and gently dragged along the pointer's motion, like a drop of oil on glass.
// Blur and distortion share the same centre and falloff, so it always reads as a single point, and both relax in
// place when the pointer stops. The cover is redrawn on a fixed WebGL2 canvas exactly over the card while the
// original image is hidden, so nothing outside the card changes and no page background shows through. Video cards use
// their still frame for the effect, since Vimeo frames cannot be read. Off for touch, reduced motion and browsers
// without WebGL2.
---

<script>
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
  const calm = matchMedia('(prefers-reduced-motion: reduce)');
  const CARDS = '.carousel-card, .more-carousel-card, .project-card-inner';
  const VISUALS = '.carousel-picture, .more-carousel-picture, .project-visual';

  const SETTINGS = {
    radius: .085, // Spot radius, as a share of the card height (gaussian falloff, so its edge is very soft).
    frost: .012, // Blur spread at the spot centre, as a share of the card height.
    soften: 1.6, // Extra mipmap blur at the centre, so the frost is smooth rather than grainy.
    swell: .1, // A slight lens bulge at the centre, so the spot is visible when the pointer is still.
    drag: .07, // Seconds of pointer motion the photo is dragged by inside the spot.
    follow: .22, // How closely the spot follows the pointer per 60 fps frame (1 = no smoothing).
    glide: .12, // How quickly the drag responds to and relaxes after the pointer's motion.
    fade: .08, // How quickly the spot fades in and out.
  };

  const canvas = document.createElement('canvas');
  canvas.className = 'liquid-hover-canvas';
  canvas.setAttribute('aria-hidden', 'true');
  Object.assign(canvas.style, { position: 'fixed', left: '0', top: '0', zIndex: '1500', pointerEvents: 'none' });
  const gl = canvas.getContext('webgl2', { premultipliedAlpha: false, alpha: true, antialias: false });

  const VERT = `#version 300 es
  in vec2 aPos; out vec2 vUv;
  void main() { vUv = vec2(aPos.x * .5 + .5, .5 - aPos.y * .5); gl_Position = vec4(aPos, 0., 1.); }`;
  // The photo with one soft spot: displacement (drag + slight bulge) and blur both follow the same gaussian.
  const FRAG = `#version 300 es
  precision highp float;
  in vec2 vUv; out vec4 outColor;
  uniform sampler2D uImage; uniform vec4 uRect; uniform vec2 uCover; uniform float uAspect;
  uniform vec2 uSpot; uniform vec2 uDrag; uniform float uRadius; uniform float uOn;
  uniform float uFrost; uniform float uSoften; uniform float uSwell;
  vec2 coverUv(vec2 card) { vec2 local = (clamp(card, 0., 1.) - uRect.xy) / uRect.zw; return clamp((local - .5) * uCover + .5, 0., 1.); }
  void main() {
    vec2 scale = vec2(uAspect, 1.);
    vec2 d = (vUv - uSpot) * scale;
    float g = uOn * exp(-dot(d, d) / (uRadius * uRadius));
    vec2 source = vUv - uDrag * g - (vUv - uSpot) * uSwell * g;
    // A small disc of taps, each softened by the mipmaps, spread in proportion to the spot strength.
    vec3 color = vec3(0.);
    float spread = uFrost * g;
    for (int i = 0; i < 12; i++) {
      float a = float(i) * 2.39996;
      float r = sqrt((float(i) + .5) / 12.);
      vec2 tap = source + vec2(cos(a), sin(a)) * r * spread / scale;
      color += texture(uImage, coverUv(tap), uSoften * g).rgb;
    }
    outColor = vec4(color / 12., 1.);
  }`;

  const build = () => {
    if (!gl) return null;
    const shader = (type: number, source: string) => { const s = gl.createShader(type)!; gl.shaderSource(s, source); gl.compileShader(s); return s; };
    const p = gl.createProgram()!;
    gl.attachShader(p, shader(gl.VERTEX_SHADER, VERT));
    gl.attachShader(p, shader(gl.FRAGMENT_SHADER, FRAG));
    gl.bindAttribLocation(p, 0, 'aPos');
    gl.linkProgram(p);
    if (!gl.getProgramParameter(p, gl.LINK_STATUS)) return null;
    const uniforms: Record<string, WebGLUniformLocation | null> = {};
    const count = gl.getProgramParameter(p, gl.ACTIVE_UNIFORMS);
    for (let i = 0; i < count; i++) { const name = gl.getActiveUniform(p, i)!.name; uniforms[name] = gl.getUniformLocation(p, name); }
    return { program: p, uniforms };
  };

  const program = build();

  if (gl && program) {
    gl.useProgram(program.program);
    const quad = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, quad);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
    gl.uniform1i(program.uniforms.uImage, 0);

    const textures = new Map<string, WebGLTexture>();
    const textureFor = (img: HTMLImageElement) => {
      const key = img.currentSrc || img.src;
      let texture = textures.get(key);
      if (!texture) {
        texture = gl.createTexture()!;
        gl.bindTexture(gl.TEXTURE_2D, texture);
        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, img);
        gl.generateMipmap(gl.TEXTURE_2D);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR_MIPMAP_LINEAR);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
        textures.set(key, texture);
      }
      return texture;
    };

    const set = (name: string, ...value: number[]) => {
      const location = program.uniforms[name];
      if (value.length === 1) gl.uniform1f(location, value[0]);
      else if (value.length === 2) gl.uniform2f(location, value[0], value[1]);
      else gl.uniform4f(location, value[0], value[1], value[2], value[3]);
    };

    let visual: HTMLElement | null = null;
    let image: HTMLImageElement | null = null;
    let hovering = false;
    let running = false;
    let previous = 0;
    let pointer = { x: -1, y: -1 }; // Viewport px.
    let spot = { x: -1, y: -1 }; // Viewport px: the single point both the blur and the drag are centred on.
    let motion = { x: 0, y: 0 }; // Smoothed spot velocity, px/s.
    let on = 0;

    const stop = () => {
      running = false;
      previous = 0;
      canvas.remove();
      if (visual) visual.style.opacity = '';
      visual = null;
      image = null;
    };

    const frame = (time: number) => {
      if (!visual || !image) { stop(); return; }
      const dt = Math.min(previous ? (time - previous) / 1000 : 1 / 60, 1 / 30);
      previous = time;
      const step = (rate: number) => 1 - Math.pow(1 - rate, dt * 60);

      // The canvas sits exactly over the card, following it as carousels move and pages scroll.
      const box = visual.getBoundingClientRect();
      const ratio = Math.min(devicePixelRatio || 1, 2);
      const width = Math.round(box.width * ratio);
      const height = Math.round(box.height * ratio);
      if (canvas.width !== width || canvas.height !== height) { canvas.width = width; canvas.height = height; }
      canvas.style.width = `${box.width}px`;
      canvas.style.height = `${box.height}px`;
      canvas.style.transform = `translate3d(${box.left}px, ${box.top}px, 0)`;

      // One point: it glides after the pointer, and its own motion is what drags the photo.
      const k = step(SETTINGS.follow);
      const next = { x: spot.x + (pointer.x - spot.x) * k, y: spot.y + (pointer.y - spot.y) * k };
      const g = step(SETTINGS.glide);
      motion.x += ((next.x - spot.x) / dt - motion.x) * g;
      motion.y += ((next.y - spot.y) / dt - motion.y) * g;
      spot = next;
      on += ((hovering ? 1 : 0) - on) * step(SETTINGS.fade);

      // The drag is capped below the spot radius, so the photo folds smoothly and never tears.
      const radiusPx = SETTINGS.radius * box.height;
      let dragX = motion.x * SETTINGS.drag;
      let dragY = motion.y * SETTINGS.drag;
      const cap = radiusPx * .55;
      const length = Math.hypot(dragX, dragY);
      if (length > cap) { dragX *= cap / length; dragY *= cap / length; }

      // Draw the photo exactly where the <img> sits inside the card.
      const rect = image.getBoundingClientRect();
      const boxAspect = rect.width / rect.height;
      const imageAspect = image.naturalWidth / image.naturalHeight;
      const cover = boxAspect > imageAspect ? [1, imageAspect / boxAspect] : [boxAspect / imageAspect, 1];
      gl.bindFramebuffer(gl.FRAMEBUFFER, null);
      gl.viewport(0, 0, width, height);
      gl.activeTexture(gl.TEXTURE0);
      gl.bindTexture(gl.TEXTURE_2D, textureFor(image));
      set('uRect', (rect.left - box.left) / box.width, (rect.top - box.top) / box.height, rect.width / box.width, rect.height / box.height);
      set('uCover', cover[0], cover[1]);
      set('uAspect', box.width / box.height);
      set('uSpot', (spot.x - box.left) / box.width, (spot.y - box.top) / box.height);
      set('uDrag', dragX / box.width, dragY / box.height);
      set('uRadius', SETTINGS.radius);
      set('uOn', on);
      set('uFrost', SETTINGS.frost);
      set('uSoften', SETTINGS.soften);
      set('uSwell', SETTINGS.swell);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

      // The canvas now shows the cover, so the real image (or video) underneath can hide without a flash.
      if (visual.style.opacity !== '0') visual.style.opacity = '0';

      // Once the pointer has left and the spot has faded, hand the card back to the real image or video.
      if (!hovering && on < .002) { stop(); return; }
      requestAnimationFrame(frame);
    };

    const pointerIn = (card: Element, event: PointerEvent) => {
      if (!finePointer.matches || calm.matches) return;
      const nextVisual = card.querySelector<HTMLElement>(VISUALS);
      const photo = nextVisual?.querySelector<HTMLImageElement>('img');
      // Vimeo frames cannot be read into WebGL, so video cards use their still frame (the <img> under the video).
      const usable = photo?.complete && photo.naturalWidth && new URL(photo.currentSrc || photo.src, location.href).origin === location.origin;
      if (!nextVisual || !photo || !usable) return;
      pointer = { x: event.clientX, y: event.clientY };
      if (nextVisual !== visual) {
        if (visual) visual.style.opacity = '';
        visual = nextVisual;
        image = photo;
        spot = { ...pointer };
        motion = { x: 0, y: 0 };
        on = 0;
        document.body.appendChild(canvas);
      }
      hovering = true;
      if (!running) { running = true; requestAnimationFrame(frame); }
    };

    document.addEventListener('pointerover', (event) => {
      const card = (event.target as Element | null)?.closest?.(CARDS);
      if (card && !card.contains(event.relatedTarget as Node | null)) pointerIn(card, event);
    });
    document.addEventListener('pointerout', (event) => {
      const card = (event.target as Element | null)?.closest?.(CARDS);
      if (card && !card.contains(event.relatedTarget as Node | null)) hovering = false;
    });
    document.addEventListener('pointermove', (event) => { pointer = { x: event.clientX, y: event.clientY }; }, { passive: true });
  }
</script>
