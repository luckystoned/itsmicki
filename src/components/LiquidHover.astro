---
// Organic morphing on the project cover images (desktop hover only), after the Lumina-GL "Organic Morphism"
// reference, tuned to feel like thick oil: around the cursor the photo refracts through a smooth, heavy lens that
// trails the pointer and slowly settles; the card drifts a little toward the pointer, flat. Plain WebGL2, one shared canvas laid over the hovered
// card. Vimeo covers live in a cross-origin layer that cannot be read as a texture, so on video cards the effect
// runs on the video's still frame, which fades in over the video while hovered and out again on leave. Off for touch, reduced motion and browsers without WebGL2.
---

<script>
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
  const calm = matchMedia('(prefers-reduced-motion: reduce)');
  const CARDS = '.carousel-card, .more-carousel-card, .project-card-inner';
  const VISUALS = '.carousel-picture, .more-carousel-picture, .project-visual';

  const canvas = document.createElement('canvas');
  canvas.className = 'liquid-hover-canvas';
  canvas.setAttribute('aria-hidden', 'true');
  Object.assign(canvas.style, { position: 'absolute', inset: '0', width: '100%', height: '100%', zIndex: '2', pointerEvents: 'none', transition: 'opacity .35s cubic-bezier(.22, 1, .36, 1)' });
  const gl = canvas.getContext('webgl2', { premultipliedAlpha: false, antialias: false });

  const VERT = `#version 300 es
  in vec2 aPos; out vec2 vUv;
  void main() { vUv = vec2(aPos.x * .5 + .5, .5 - aPos.y * .5); gl_Position = vec4(aPos, 0., 1.); }`;

  // Energy field: decays every frame; the cursor splats energy and its velocity into it, leaving a trail.
  const ENERGY = `#version 300 es
  precision highp float;
  in vec2 vUv; out vec4 outColor;
  uniform sampler2D uPrev; uniform vec2 uMouse; uniform vec2 uVel; uniform float uAspect; uniform float uSplat; uniform float uDecay;
  void main() {
    vec4 prev = texture(uPrev, vUv);
    float e = prev.r * uDecay;
    vec2 vel = (prev.gb - .5) * uDecay;
    vec2 d = (vUv - uMouse) * vec2(uAspect, 1.);
    float s = exp(-dot(d, d) / .03) * uSplat;
    e += s;
    vel += s * uVel;
    outColor = vec4(clamp(e, 0., 1.), clamp(vel * .5 + .5, 0., 1.), 1.);
  }`;

  const IMAGE = `#version 300 es
  precision highp float;
  in vec2 vUv; out vec4 outColor;
  uniform sampler2D uImage; uniform sampler2D uEnergy; uniform vec4 uRect; uniform vec2 uCover; uniform float uTime; uniform vec2 uRes;
  float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
  float noise(vec2 p) {
    vec2 i = floor(p), f = fract(p); vec2 u = f * f * (3. - 2. * f);
    return mix(mix(hash(i), hash(i + vec2(1, 0)), u.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), u.x), u.y);
  }
  vec2 texUv(vec2 uv) {
    vec2 local = (uv - uRect.xy) / uRect.zw;
    return clamp((local - .5) * uCover + .5, 0., 1.);
  }
  void main() {
    // Oil: the energy field acts like a thick, smooth lens. Its slope bends the photo (refraction), a slow,
    // low-frequency flow adds a viscous drift, and the pointer's motion drags the surface a little.
    vec2 px = 1.5 / uRes;
    float e = smoothstep(0., .9, texture(uEnergy, vUv).r);
    float ex = texture(uEnergy, vUv + vec2(px.x, 0.)).r - texture(uEnergy, vUv - vec2(px.x, 0.)).r;
    float ey = texture(uEnergy, vUv + vec2(0., px.y)).r - texture(uEnergy, vUv - vec2(0., px.y)).r;
    vec2 slope = vec2(ex, ey) / (px * 2.) * .0055;
    vec2 vel = texture(uEnergy, vUv).gb - .5;
    vec2 flow = vec2(noise(vUv * 1.6 + uTime * .12), noise(vUv * 1.6 + 4.1 - uTime * .1)) - .5;
    vec2 offset = -slope * .9 + (flow * .035 + vel * .05) * e;
    outColor = vec4(texture(uImage, texUv(vUv + offset)).rgb, 1.);
  }`;

  const compile = (type: number, source: string) => {
    const shader = gl!.createShader(type)!;
    gl!.shaderSource(shader, source);
    gl!.compileShader(shader);
    return shader;
  };
  const program = (fragment: string) => {
    const p = gl!.createProgram()!;
    gl!.attachShader(p, compile(gl!.VERTEX_SHADER, VERT));
    gl!.attachShader(p, compile(gl!.FRAGMENT_SHADER, fragment));
    gl!.bindAttribLocation(p, 0, 'aPos');
    gl!.linkProgram(p);
    return gl!.getProgramParameter(p, gl!.LINK_STATUS) ? p : null;
  };

  const energyProgram = gl && program(ENERGY);
  const imageProgram = gl && program(IMAGE);

  if (gl && energyProgram && imageProgram) {
    const quad = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, quad);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);

    const FIELD = 128;
    const makeTarget = () => {
      const texture = gl.createTexture()!;
      gl.bindTexture(gl.TEXTURE_2D, texture);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, FIELD, FIELD, 0, gl.RGBA, gl.UNSIGNED_BYTE, null);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      const framebuffer = gl.createFramebuffer()!;
      gl.bindFramebuffer(gl.FRAMEBUFFER, framebuffer);
      gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, texture, 0);
      return { texture, framebuffer };
    };
    let targets = [makeTarget(), makeTarget()];
    const clearField = () => targets.forEach(({ framebuffer }) => {
      gl.bindFramebuffer(gl.FRAMEBUFFER, framebuffer);
      gl.clearColor(0, .5, .5, 1);
      gl.clear(gl.COLOR_BUFFER_BIT);
    });

    const textures = new Map<string, WebGLTexture>();
    const textureFor = (img: HTMLImageElement) => {
      const key = img.currentSrc || img.src;
      let texture = textures.get(key);
      if (!texture) {
        texture = gl.createTexture()!;
        gl.bindTexture(gl.TEXTURE_2D, texture);
        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, img);
        gl.generateMipmap(gl.TEXTURE_2D);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR_MIPMAP_LINEAR);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
        textures.set(key, texture);
      }
      return texture;
    };

    const u = (p: WebGLProgram, name: string) => gl.getUniformLocation(p, name);
    let visual: HTMLElement | null = null;
    let image: HTMLImageElement | null = null;
    let hovering = false;
    let running = false;
    let mouse = { x: .5, y: .5 };
    let oil = { x: .5, y: .5 };
    let last = { x: .5, y: .5 };
    let quiet = 0;
    // Video cards: the effect runs on the video's still frame, which fades in over the video while hovered.
    let videoCard = false;
    // The card follows the pointer a little, with some inertia.
    let tilt = { x: 0, y: 0, shiftX: 0, shiftY: 0 };
    const started = performance.now();
    const resetTilt = (element: HTMLElement | null) => {
      if (!element) return;
      element.style.translate = '';
    };

    const stop = () => {
      running = false;
      canvas.remove();
      resetTilt(visual);
      visual = null;
      image = null;
      tilt = { x: 0, y: 0, shiftX: 0, shiftY: 0 };
    };

    const frame = (time: number) => {
      if (!visual) { stop(); return; }
      if (!image) {
        quiet = hovering ? 0 : quiet + 1;
        if (quiet > 90) { stop(); return; }
        requestAnimationFrame(frame);
        return;
      }
      const box = visual.getBoundingClientRect();
      const ratio = Math.min(devicePixelRatio || 1, 2);
      const width = Math.max(1, Math.round(box.width * ratio));
      const height = Math.max(1, Math.round(box.height * ratio));
      if (canvas.width !== width || canvas.height !== height) { canvas.width = width; canvas.height = height; }

      // 1. Energy field, splatted at an eased point so the oil trails the pointer with some weight.
      oil.x += (mouse.x - oil.x) * .12;
      oil.y += (mouse.y - oil.y) * .12;
      const velocity = { x: (oil.x - last.x) * 6, y: (oil.y - last.y) * 6 };
      const speed = Math.hypot(velocity.x, velocity.y);
      last = { ...oil };
      gl.useProgram(energyProgram);
      gl.bindFramebuffer(gl.FRAMEBUFFER, targets[1].framebuffer);
      gl.viewport(0, 0, FIELD, FIELD);
      gl.activeTexture(gl.TEXTURE0);
      gl.bindTexture(gl.TEXTURE_2D, targets[0].texture);
      gl.uniform1i(u(energyProgram, 'uPrev'), 0);
      gl.uniform2f(u(energyProgram, 'uMouse'), oil.x, oil.y);
      gl.uniform2f(u(energyProgram, 'uVel'), velocity.x, velocity.y);
      gl.uniform1f(u(energyProgram, 'uAspect'), box.width / box.height);
      gl.uniform1f(u(energyProgram, 'uSplat'), hovering ? Math.min(.22, .035 + speed * 1.1) : 0);
      gl.uniform1f(u(energyProgram, 'uDecay'), .972);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      targets = [targets[1], targets[0]];

      // 2. The photo, sampled through the field, placed exactly where the <img> is (parallax and hover scale included).
      const rect = image.getBoundingClientRect();
      const boxAspect = rect.width / rect.height;
      const imageAspect = image.naturalWidth / image.naturalHeight;
      const cover = boxAspect > imageAspect ? [1, imageAspect / boxAspect] : [boxAspect / imageAspect, 1];
      gl.useProgram(imageProgram);
      gl.bindFramebuffer(gl.FRAMEBUFFER, null);
      gl.viewport(0, 0, width, height);
      gl.activeTexture(gl.TEXTURE0);
      gl.bindTexture(gl.TEXTURE_2D, textureFor(image));
      gl.uniform1i(u(imageProgram, 'uImage'), 0);
      gl.activeTexture(gl.TEXTURE1);
      gl.bindTexture(gl.TEXTURE_2D, targets[0].texture);
      gl.uniform1i(u(imageProgram, 'uEnergy'), 1);
      gl.uniform4f(u(imageProgram, 'uRect'), (rect.left - box.left) / box.width, (rect.top - box.top) / box.height, rect.width / box.width, rect.height / box.height);
      gl.uniform2f(u(imageProgram, 'uCover'), cover[0], cover[1]);
      gl.uniform1f(u(imageProgram, 'uTime'), (time - started) / 1000);
      gl.uniform2f(u(imageProgram, 'uRes'), width, height);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

      // Once the pointer has left and the trail has faded, hand the card back to the plain <img> (or the video,
      // which fades back in right away).
      if (videoCard) canvas.style.opacity = hovering ? '1' : '0';
      quiet = hovering ? 0 : quiet + 1;
      if (quiet > (videoCard ? 24 : 90)) { stop(); return; }
      requestAnimationFrame(frame);
    };

    const pointerIn = (card: Element, event: PointerEvent) => {
      if (!finePointer.matches || calm.matches) return;
      const nextVisual = card.querySelector<HTMLElement>(VISUALS);
      if (!nextVisual) return;
      const photo = nextVisual.querySelector<HTMLImageElement>('img');
      // Vimeo frames cannot be read into WebGL, so video cards use their still frame (the <img> under the video).
      const usable = photo?.complete && photo.naturalWidth && new URL(photo.currentSrc || photo.src, location.href).origin === location.origin;
      const nextImage = usable ? photo : null;
      if (nextVisual !== visual) {
        canvas.remove();
        resetTilt(visual);
        tilt = { x: 0, y: 0, shiftX: 0, shiftY: 0 };
        visual = nextVisual;
        image = nextImage;
        videoCard = !!nextVisual.querySelector('iframe');
        if (image) {
          clearField();
          canvas.style.opacity = videoCard ? '0' : '1';
          visual.appendChild(canvas);
        }
      }
      hovering = true;
      move(event);
      oil = { ...mouse };
      last = { ...mouse };
      if (!running) { running = true; requestAnimationFrame(frame); }
    };

    const move = (event: PointerEvent) => {
      if (!visual) return;
      const box = visual.getBoundingClientRect();
      mouse = { x: (event.clientX - box.left) / box.width, y: (event.clientY - box.top) / box.height };
    };

    document.addEventListener('pointerover', (event) => {
      const card = (event.target as Element | null)?.closest?.(CARDS);
      if (card && !card.contains(event.relatedTarget as Node | null)) pointerIn(card, event);
    });
    document.addEventListener('pointerout', (event) => {
      const card = (event.target as Element | null)?.closest?.(CARDS);
      if (card && !card.contains(event.relatedTarget as Node | null)) hovering = false;
    });
    document.addEventListener('pointermove', (event) => { if (hovering) move(event); }, { passive: true });
  }
</script>
