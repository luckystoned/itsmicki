---
// Oil-like hover on the project covers (desktop only). The pointer pushes the photo as if it were a thin layer of
// oil: the image flows with the pointer, tears open into holes that show the page white behind it, can spill past
// the card edges, and then slowly flows back into place. The cover is redrawn on a fixed WebGL2 canvas a bit larger
// than the card (so the oil can leave the card) while the original image is hidden. Video cards use their still
// frame for the effect, since Vimeo frames cannot be read. Off for touch, reduced motion and browsers without WebGL2.
---

<script>
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
  const calm = matchMedia('(prefers-reduced-motion: reduce)');
  const CARDS = '.carousel-card, .more-carousel-card, .project-card-inner';
  const VISUALS = '.carousel-picture, .more-carousel-picture, .project-visual';

  const SETTINGS = {
    field: 192, // Simulation grid over the canvas.
    pad: .22, // Room around the card for the oil to spill into, as a share of the card's longer side.
    radius: .0035, // Pointer footprint, in squared canvas units.
    drag: .55, // How much the pointer's motion drags the oil.
    push: .55, // How much the pointer pushes the oil outward around itself (opens the holes).
    velocityDissipation: .9,
    relax: .955, // How fast the oil flows back into place (closer to 1 = slower).
    tear: .42, // Stretch above which the oil splits open (lower = fewer holes).
  };

  const canvas = document.createElement('canvas');
  canvas.className = 'liquid-hover-canvas';
  canvas.setAttribute('aria-hidden', 'true');
  Object.assign(canvas.style, { position: 'fixed', left: '0', top: '0', zIndex: '1500', pointerEvents: 'none' });
  const gl = canvas.getContext('webgl2', { premultipliedAlpha: false, alpha: true, antialias: false });
  const floatTargets = !!gl?.getExtension('EXT_color_buffer_float');

  const VERT = `#version 300 es
  in vec2 aPos; out vec2 vUv;
  void main() { vUv = vec2(aPos.x * .5 + .5, .5 - aPos.y * .5); gl_Position = vec4(aPos, 0., 1.); }`;
  const HEAD = `#version 300 es
  precision highp float;
  in vec2 vUv; out vec4 outColor;
  `;
  const SOURCES = {
    // Velocity: the pointer drags the oil along its motion and pushes it outward around itself.
    splat: `${HEAD}uniform sampler2D uTarget; uniform vec2 uPoint; uniform vec2 uDrag; uniform float uPush; uniform float uRadius; uniform float uAspect;
      void main() { vec2 p = (vUv - uPoint) * vec2(uAspect, 1.); float g = exp(-dot(p, p) / uRadius);
        vec2 outward = p / (length(p) + .0001) / vec2(uAspect, 1.);
        outColor = vec4(texture(uTarget, vUv).xy + (uDrag + outward * uPush) * g, 0., 1.); }`,
    // Carries a field along the velocity, fading it (velocity) or relaxing it (displacement).
    advect: `${HEAD}uniform sampler2D uVelocity; uniform sampler2D uSource; uniform float uDt; uniform float uKeep; uniform float uGrow;
      void main() { vec2 v = texture(uVelocity, vUv).xy; vec2 coord = vUv - uDt * v;
        outColor = vec4((texture(uSource, coord).xy + v * uDt * uGrow) * uKeep, 0., 1.); }`,
    // The photo, carried by the displacement; where the oil is stretched too thin it tears and the page shows.
    display: `${HEAD}uniform sampler2D uOffset; uniform sampler2D uImage; uniform vec4 uCard; uniform vec4 uRect; uniform vec2 uCover; uniform vec2 uStep; uniform float uTear;
      void main() {
        vec2 d = texture(uOffset, vUv).xy;
        vec2 dx = (texture(uOffset, vUv + vec2(uStep.x, 0.)).xy - texture(uOffset, vUv - vec2(uStep.x, 0.)).xy) / (2. * uStep.x);
        vec2 dy = (texture(uOffset, vUv + vec2(0., uStep.y)).xy - texture(uOffset, vUv - vec2(0., uStep.y)).xy) / (2. * uStep.y);
        float stretch = (1. - dx.x) * (1. - dy.y) - dx.y * dy.x;
        vec2 source = vUv - d;
        vec2 card = (source - uCard.xy) / uCard.zw;
        float inside = step(0., card.x) * step(card.x, 1.) * step(0., card.y) * step(card.y, 1.);
        vec2 local = (card - uRect.xy) / uRect.zw;
        vec2 uv = clamp((local - .5) * uCover + .5, 0., 1.);
        float alpha = inside * smoothstep(uTear, uTear + .06, stretch);
        outColor = vec4(texture(uImage, uv).rgb, alpha);
      }`,
  };

  const build = (fragment: string) => {
    if (!gl) return null;
    const shader = (type: number, source: string) => { const s = gl.createShader(type)!; gl.shaderSource(s, source); gl.compileShader(s); return s; };
    const p = gl.createProgram()!;
    gl.attachShader(p, shader(gl.VERTEX_SHADER, VERT));
    gl.attachShader(p, shader(gl.FRAGMENT_SHADER, fragment));
    gl.bindAttribLocation(p, 0, 'aPos');
    gl.linkProgram(p);
    if (!gl.getProgramParameter(p, gl.LINK_STATUS)) return null;
    const uniforms: Record<string, WebGLUniformLocation | null> = {};
    const count = gl.getProgramParameter(p, gl.ACTIVE_UNIFORMS);
    for (let i = 0; i < count; i++) { const name = gl.getActiveUniform(p, i)!.name; uniforms[name] = gl.getUniformLocation(p, name); }
    return { program: p, uniforms };
  };

  const programs = gl && floatTargets ? Object.fromEntries(Object.entries(SOURCES).map(([key, source]) => [key, build(source)])) : null;

  if (gl && programs && Object.values(programs).every(Boolean)) {
    type Program = { program: WebGLProgram; uniforms: Record<string, WebGLUniformLocation | null> };
    type Target = { texture: WebGLTexture; framebuffer: WebGLFramebuffer };
    const P = programs as Record<keyof typeof SOURCES, Program>;
    const quad = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, quad);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);

    const N = SETTINGS.field;
    const target = (): Target => {
      const texture = gl.createTexture()!;
      gl.bindTexture(gl.TEXTURE_2D, texture);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA16F, N, N, 0, gl.RGBA, gl.HALF_FLOAT, null);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      const framebuffer = gl.createFramebuffer()!;
      gl.bindFramebuffer(gl.FRAMEBUFFER, framebuffer);
      gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, texture, 0);
      return { texture, framebuffer };
    };
    const pair = () => ({ read: target(), write: target(), swap() { [this.read, this.write] = [this.write, this.read]; } });
    const velocity = pair();
    const offset = pair();
    const clearAll = () => [velocity.read, velocity.write, offset.read, offset.write].forEach(({ framebuffer }) => {
      gl.bindFramebuffer(gl.FRAMEBUFFER, framebuffer);
      gl.clearColor(0, 0, 0, 1);
      gl.clear(gl.COLOR_BUFFER_BIT);
    });

    const textures = new Map<string, WebGLTexture>();
    const textureFor = (img: HTMLImageElement) => {
      const key = img.currentSrc || img.src;
      let texture = textures.get(key);
      if (!texture) {
        texture = gl.createTexture()!;
        gl.bindTexture(gl.TEXTURE_2D, texture);
        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, img);
        gl.generateMipmap(gl.TEXTURE_2D);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR_MIPMAP_LINEAR);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
        textures.set(key, texture);
      }
      return texture;
    };

    const run = (p: Program, output: Target | null, inputs: Record<string, WebGLTexture>, values: Record<string, number | number[]>) => {
      gl.useProgram(p.program);
      let unit = 0;
      for (const [name, texture] of Object.entries(inputs)) {
        gl.activeTexture(gl.TEXTURE0 + unit);
        gl.bindTexture(gl.TEXTURE_2D, texture);
        gl.uniform1i(p.uniforms[name], unit++);
      }
      for (const [name, value] of Object.entries(values)) {
        const location = p.uniforms[name];
        if (!location) continue;
        if (!Array.isArray(value)) gl.uniform1f(location, value);
        else if (value.length === 2) gl.uniform2f(location, value[0], value[1]);
        else gl.uniform4f(location, value[0], value[1], value[2], value[3]);
      }
      gl.bindFramebuffer(gl.FRAMEBUFFER, output ? output.framebuffer : null);
      if (output) gl.viewport(0, 0, N, N); else gl.viewport(0, 0, canvas.width, canvas.height);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    };

    let visual: HTMLElement | null = null;
    let image: HTMLImageElement | null = null;
    let hovering = false;
    let running = false;
    let quiet = 0;
    let pointer = { x: -1, y: -1 }; // Viewport px.
    let last = { x: -1, y: -1 };
    let previous = 0;

    const stop = () => {
      running = false;
      previous = 0;
      canvas.remove();
      if (visual) visual.style.opacity = '';
      visual = null;
      image = null;
    };

    const frame = (time: number) => {
      if (!visual || !image) { stop(); return; }
      const dt = Math.min(previous ? (time - previous) / 1000 : 1 / 60, 1 / 30);
      previous = time;

      // The canvas covers the card plus a margin, following it as carousels move and pages scroll.
      const box = visual.getBoundingClientRect();
      const pad = Math.max(box.width, box.height) * SETTINGS.pad;
      const area = { left: box.left - pad, top: box.top - pad, width: box.width + pad * 2, height: box.height + pad * 2 };
      const ratio = Math.min(devicePixelRatio || 1, 2);
      const width = Math.round(area.width * ratio);
      const height = Math.round(area.height * ratio);
      if (canvas.width !== width || canvas.height !== height) { canvas.width = width; canvas.height = height; }
      canvas.style.width = `${area.width}px`;
      canvas.style.height = `${area.height}px`;
      canvas.style.transform = `translate3d(${area.left}px, ${area.top}px, 0)`;
      const aspect = area.width / area.height;
      const at = (x: number, y: number) => [(x - area.left) / area.width, (y - area.top) / area.height];

      // 1. The pointer drags and pushes the oil.
      const moved = Math.hypot(pointer.x - last.x, pointer.y - last.y);
      if (hovering && moved > 0 && last.x >= 0) {
        const [x, y] = at(pointer.x, pointer.y);
        const [lx, ly] = at(last.x, last.y);
        run(P.splat, velocity.write, { uTarget: velocity.read.texture }, {
          uPoint: [x, y], uDrag: [(x - lx) / dt * SETTINGS.drag, (y - ly) / dt * SETTINGS.drag],
          uPush: Math.min(1.2, moved / area.width / dt) * SETTINGS.push, uRadius: SETTINGS.radius, uAspect: aspect,
        });
        velocity.swap();
      }
      last = { ...pointer };

      // 2. Velocity flows and fades; the displacement is carried by it, grows with it, and relaxes back to zero.
      run(P.advect, velocity.write, { uVelocity: velocity.read.texture, uSource: velocity.read.texture }, { uDt: dt, uKeep: SETTINGS.velocityDissipation, uGrow: 0 });
      velocity.swap();
      run(P.advect, offset.write, { uVelocity: velocity.read.texture, uSource: offset.read.texture }, { uDt: dt, uKeep: SETTINGS.relax, uGrow: 1 });
      offset.swap();

      // 3. Draw the photo through the displacement, exactly where the <img> sits inside the card.
      const rect = image.getBoundingClientRect();
      const boxAspect = rect.width / rect.height;
      const imageAspect = image.naturalWidth / image.naturalHeight;
      const cover = boxAspect > imageAspect ? [1, imageAspect / boxAspect] : [boxAspect / imageAspect, 1];
      gl.bindFramebuffer(gl.FRAMEBUFFER, null);
      gl.viewport(0, 0, width, height);
      gl.clearColor(0, 0, 0, 0);
      gl.clear(gl.COLOR_BUFFER_BIT);
      run(P.display, null, { uOffset: offset.read.texture, uImage: textureFor(image) }, {
        uCard: [pad / area.width, pad / area.height, box.width / area.width, box.height / area.height],
        uRect: [(rect.left - box.left) / box.width, (rect.top - box.top) / box.height, rect.width / box.width, rect.height / box.height],
        uCover: cover, uStep: [1 / N, 1 / N], uTear: SETTINGS.tear,
      });

      // The canvas now shows the cover, so the real image (or video) underneath can hide without a flash.
      if (visual.style.opacity !== '0') visual.style.opacity = '0';

      // Once the pointer has left and the oil has settled, hand the card back to the real image or video.
      quiet = hovering ? 0 : quiet + 1;
      if (quiet > 150) { stop(); return; }
      requestAnimationFrame(frame);
    };

    const pointerIn = (card: Element, event: PointerEvent) => {
      if (!finePointer.matches || calm.matches) return;
      const nextVisual = card.querySelector<HTMLElement>(VISUALS);
      const photo = nextVisual?.querySelector<HTMLImageElement>('img');
      // Vimeo frames cannot be read into WebGL, so video cards use their still frame (the <img> under the video).
      const usable = photo?.complete && photo.naturalWidth && new URL(photo.currentSrc || photo.src, location.href).origin === location.origin;
      if (!nextVisual || !photo || !usable) return;
      if (nextVisual !== visual) {
        if (visual) visual.style.opacity = '';
        visual = nextVisual;
        image = photo;
        clearAll();
        document.body.appendChild(canvas);
      }
      hovering = true;
      pointer = { x: event.clientX, y: event.clientY };
      last = { ...pointer };
      if (!running) { running = true; requestAnimationFrame(frame); }
    };

    document.addEventListener('pointerover', (event) => {
      const card = (event.target as Element | null)?.closest?.(CARDS);
      if (card && !card.contains(event.relatedTarget as Node | null)) pointerIn(card, event);
    });
    document.addEventListener('pointerout', (event) => {
      const card = (event.target as Element | null)?.closest?.(CARDS);
      if (card && !card.contains(event.relatedTarget as Node | null)) hovering = false;
    });
    document.addEventListener('pointermove', (event) => { pointer = { x: event.clientX, y: event.clientY }; }, { passive: true });
  }
</script>
