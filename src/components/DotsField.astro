---
// Dark brown dots wandering over a field of drifting pale-blue pixels that gather into abstract shapes (generated, landscape).
// Moving the pointer (or a finger) pulls nearby dots like a magnet; after 5 s holding still they part to the sides; a
// click or tap drops them all to the floor; after 2 s without hover or drag they find their way back. With the camera
// on, the hand is a softer magnet: a fist gathers them, an open hand spreads them, and 5 s holding still lets them
// go back to their flow. With reduced motion nothing moves.
type Props = { label: string };
const { label } = Astro.props;
---

<div class="dots-field" data-dots-field role="img" aria-label={label}>
  <canvas class="dots-field-canvas" aria-hidden="true"></canvas>
</div>

<script>
  import { loadVision, openCamera } from '@/scripts/camera';

  const SETTINGS = {
    count: 1600, // Dots on a 1556px-wide frame; scales with the frame's area.
    clusters: 8, // Groups the dots gather in, like the reference.
    size: [5, 9], // Dot radius range on a 1556px-wide frame (scales with it).
    wander: 26, // How far each dot drifts around its place on its own, in CSS pixels.
    pixel: 3, // Background pixel size, in CSS pixels.
    pixelDensity: .6, // Share of the background grid covered by drifting pixels.
    pixelFlow: 14, // How fast the background pixels drift, in CSS px/s.
    pull: .32, // Magnet: radius (share of the frame width) and strength of the pull while the pointer moves.
    pullStrength: 2200,
    huddle: [14, 110], // Each pulled dot keeps its own distance from the pointer (CSS pixels): a loose cloud, not a ball.
    push: [.2, .38], // Holding still: the dots part like a curtain, this wide and this tall (shares of the width/height).
    stillAfter: 5000, // ms without moving before the pointer counts as still and the dots part.
    returnAfter: 2000, // ms without hover or drag before the dots go home.
    hand: { reach: .6, pull: 26, gather: .35, spread: 2.4, still: 14 }, // Camera: how far the hand's magnet reaches (share of
    // the width) and how hard it pulls; how tight a fist gathers them and how wide an open hand spreads them (times each
    // dot's own distance); how far (CSS px) the hand has to move to count as moving.
    home: 9, // Spring back home.
    gravity: 2600, // Dropped dots: CSS px/s².
    damping: 3.2, // Per second.
    paper: '#f2f6fb', // The palest blue, behind everything.
    blues: ['#e2ecf8', '#d1e1f3', '#bfd5ee', '#a9c6e7', '#93b6df'], // Pale blues, from the faintest to the deepest.
    blobs: 8, // Abstract shapes the background pixels gather into, drifting, merging and splitting.
    ink: '#3a2219',
  };

  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-dots-field]').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('.dots-field-canvas')!;
    const context = canvas.getContext('2d')!;
    let width = 0, height = 0, ratio = 1;
    let background: HTMLCanvasElement | null = null;

    // A seeded random, so the layout is the same on every visit.
    let seed = 7;
    const random = () => { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; };
    const gauss = () => { let u = 0, v = 0; while (!u) u = random(); while (!v) v = random(); return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v); };

    // The background is a field of scattered pixels in pale blues that drift slowly and gather into abstract shapes:
    // soft masses that wander, merge and split. Drawn into a small buffer (one cell per background pixel) and scaled
    // up crisp. Each pixel takes its shade from the shapes where it is, with a little jitter so their edges dither.
    let buffer: HTMLCanvasElement | null = null;
    let bufferContext: CanvasRenderingContext2D | null = null;
    let image: ImageData | null = null;
    const toColor = (hex: string) => ((255 << 24) | (parseInt(hex.slice(5, 7), 16) << 16) | (parseInt(hex.slice(3, 5), 16) << 8) | parseInt(hex.slice(1, 3), 16)) >>> 0;
    const paperColor = toColor(SETTINGS.paper);
    const blueColors = Uint32Array.from(SETTINGS.blues.map(toColor));
    let pixels = new Float32Array(0); // x, y per pixel, in buffer cells.
    let jitter = new Float32Array(0);
    let rowFlow = new Float32Array(0), colFlow = new Float32Array(0);
    // The shapes, on a coarse grid: a sum of moving soft masses.
    let shapeW = 0, shapeH = 0, shape = new Float32Array(0);
    type Blob = { x: number; y: number; r: number; ax: number; ay: number; fx: number; fy: number; p: number };
    let blobs: Blob[] = [];
    const paint = () => {
      const cols = Math.max(16, Math.round(width / SETTINGS.pixel)), rows = Math.max(9, Math.round(height / SETTINGS.pixel));
      seed = 11;
      const count = Math.round(cols * rows * SETTINGS.pixelDensity);
      pixels = new Float32Array(count * 2);
      jitter = new Float32Array(count);
      for (let i = 0; i < count; i++) { pixels[i * 2] = random() * cols; pixels[i * 2 + 1] = random() * rows; jitter[i] = (random() - .5) * .3; }
      shapeW = 96; shapeH = Math.max(12, Math.round(96 * rows / cols)); shape = new Float32Array(shapeW * shapeH);
      blobs = Array.from({ length: SETTINGS.blobs }, () => ({ x: random(), y: random(), r: .1 + random() * .16, ax: .12 + random() * .25, ay: .1 + random() * .2, fx: .03 + random() * .05, fy: .025 + random() * .05, p: random() * Math.PI * 2 }));
      buffer = document.createElement('canvas');
      buffer.width = cols; buffer.height = rows;
      bufferContext = buffer.getContext('2d')!;
      image = bufferContext.createImageData(cols, rows);
      background = buffer;
    };
    const drift = (time: number, dt: number) => {
      if (!buffer || !bufferContext || !image) return;
      const cols = buffer.width, rows = buffer.height;
      const out = new Uint32Array(image.data.buffer);
      out.fill(paperColor);
      const t = calm ? 0 : time / 1000;
      // The shapes: soft masses on slow Lissajous paths, with a slow ripple so their outlines stay organic.
      const aspect = cols / rows;
      for (let gy = 0; gy < shapeH; gy++) for (let gx = 0; gx < shapeW; gx++) {
        const u = gx / (shapeW - 1), v = gy / (shapeH - 1);
        let value = 0;
        for (const b of blobs) {
          const bx = b.x + Math.sin(t * b.fx * 2 * Math.PI + b.p) * b.ax, by = b.y + Math.cos(t * b.fy * 2 * Math.PI + b.p * 1.7) * b.ay;
          const dx = (u - bx) * aspect, dy = v - by;
          value += (b.r * b.r) / (dx * dx + dy * dy + .002);
        }
        value += .25 * Math.sin(u * 9 + t * .3) * Math.sin(v * 7 - t * .25);
        shape[gy * shapeW + gx] = value;
      }
      // The pixels drift (mostly sideways, a vertical sway by column) and wrap around the edges.
      const speed = calm ? 0 : SETTINGS.pixelFlow / SETTINGS.pixel * dt;
      if (rowFlow.length !== rows) rowFlow = new Float32Array(rows);
      if (colFlow.length !== cols) colFlow = new Float32Array(cols);
      for (let y = 0; y < rows; y++) rowFlow[y] = speed * (1 + .6 * Math.cos(Math.sin(y * .045 + t * .35) * 1.6));
      for (let x = 0; x < cols; x++) colFlow[x] = speed * .45 * Math.sin(x * .021 - t * .2 + Math.sin(x * .007 + t * .1) * 2);
      const sx = (shapeW - 1) / cols, sy = (shapeH - 1) / rows, levels = blueColors.length;
      for (let i = 0; i < jitter.length; i++) {
        let x = pixels[i * 2], y = pixels[i * 2 + 1];
        x += rowFlow[y | 0];
        y += colFlow[x | 0] || 0;
        if (x >= cols) x -= cols; else if (x < 0) x += cols;
        if (y >= rows) y -= rows; else if (y < 0) y += rows;
        pixels[i * 2] = x; pixels[i * 2 + 1] = y;
        // Outside the shapes the pixels fade into the paper; inside, deeper blues toward their centres.
        const value = shape[Math.round(y * sy) * shapeW + Math.round(x * sx)] + jitter[i];
        if (value < .55) continue;
        out[(y | 0) * cols + (x | 0)] = blueColors[Math.min(levels - 1, Math.floor((value - .55) * 2.2))];
      }
      bufferContext.putImageData(image, 0, 0);
    };

    // A few dot sprites: irregular, slightly squared blobs with grain, like ink dots.
    const sprites = Array.from({ length: 6 }, (_, index) => {
      const size = 32;
      const c = document.createElement('canvas');
      c.width = c.height = size;
      const g = c.getContext('2d')!;
      seed = 101 + index * 13;
      g.fillStyle = SETTINGS.ink;
      g.beginPath();
      const sides = 9;
      for (let i = 0; i <= sides; i++) {
        const a = (i / sides) * Math.PI * 2, r = size * (.36 + random() * .1);
        const x = size / 2 + Math.cos(a) * r, y = size / 2 + Math.sin(a) * r;
        if (i) g.lineTo(x, y); else g.moveTo(x, y);
      }
      g.closePath();
      g.fill();
      const img = g.getImageData(0, 0, size, size);
      for (let i = 0; i < img.data.length; i += 4) if (img.data[i + 3]) { const n = random(); if (n > .9) img.data[i + 3] *= .4; img.data[i] += (n - .5) * 30; }
      g.putImageData(img, 0, 0);
      return c;
    });

    type Dot = { hx: number; hy: number; x: number; y: number; vx: number; vy: number; r: number; sprite: number; phase: number; spin: number; huddle: number };
    let dots: Dot[] = [];
    const layout = () => {
      seed = 3;
      const count = Math.round(SETTINGS.count * (width * height) / (1556 * 870));
      const centers = Array.from({ length: SETTINGS.clusters }, () => ({ x: random(), y: random(), sx: .03 + random() * .09, sy: .04 + random() * .14, weight: .3 + random() }));
      const total = centers.reduce((sum, c) => sum + c.weight, 0);
      dots = Array.from({ length: count }, () => {
        // Most dots in clusters, a few scattered.
        let hx: number, hy: number;
        if (random() < .12) { hx = random(); hy = random(); } else {
          let pick = random() * total, c = centers[0];
          for (const center of centers) { pick -= center.weight; if (pick <= 0) { c = center; break; } }
          do { hx = c.x + gauss() * c.sx; hy = c.y + gauss() * c.sy; } while (hx < .01 || hx > .99 || hy < .03 || hy > .97);
        }
        hx *= width; hy *= height;
        return { hx, hy, x: hx, y: hy, vx: 0, vy: 0, r: (SETTINGS.size[0] + random() * (SETTINGS.size[1] - SETTINGS.size[0])) * Math.max(.45, width / 1556), sprite: Math.floor(random() * sprites.length), phase: random() * Math.PI * 2, spin: random() * Math.PI * 2, huddle: SETTINGS.huddle[0] + Math.pow(random(), 1.6) * (SETTINGS.huddle[1] - SETTINGS.huddle[0]) };
      });
    };

    const resize = () => {
      const rect = root.getBoundingClientRect();
      ratio = Math.min(devicePixelRatio || 1, 2);
      if (Math.round(rect.width) === width && Math.round(rect.height) === height) return;
      width = Math.round(rect.width); height = Math.round(rect.height);
      canvas.width = Math.round(width * ratio); canvas.height = Math.round(height * ratio);
      paint();
      dots = [];
      layout();
    };

    // Input: the pointer (mouse, finger) or, with the camera on, an open hand. `down` drops the dots.
    let pointer: { x: number; y: number } | null = null;
    let handShape: 'open' | 'closed' | null = null; // Set while the camera follows a hand.
    let lastMove = -1e9, lastInteraction = -1e9;
    let falling = false;
    const at = (clientX: number, clientY: number) => { const r = root.getBoundingClientRect(); return { x: clientX - r.left, y: clientY - r.top }; };
    const move = (point: { x: number; y: number }, still = 1.5) => {
      if (!pointer || Math.hypot(point.x - pointer.x, point.y - pointer.y) > still) lastMove = performance.now();
      pointer = point;
      lastInteraction = performance.now();
      falling = false;
      start();
    };
    const leave = () => { if (pointer) lastInteraction = performance.now(); pointer = null; };
    const drop = () => { falling = true; pointer = null; lastInteraction = performance.now(); dots.forEach((d) => { d.vy += (random() - .5) * 60; }); start(); };

    root.addEventListener('pointermove', (event) => { if (event.pointerType !== 'touch') move(at(event.clientX, event.clientY)); });
    root.addEventListener('pointerleave', (event) => { if (event.pointerType !== 'touch') leave(); });
    root.addEventListener('click', drop);
    // Touch: dragging pulls (the page still scrolls); a short tap fires `click`, which drops them.
    root.addEventListener('touchstart', (event) => { const t = event.touches[0]; if (t) move(at(t.clientX, t.clientY)); }, { passive: true });
    root.addEventListener('touchmove', (event) => { const t = event.touches[0]; if (t) move(at(t.clientX, t.clientY)); }, { passive: true });
    root.addEventListener('touchend', leave, { passive: true });

    // Camera: the hand is a soft magnet. Moving it draws the dots toward it; a fist gathers them in tight, an open hand
    // lets them spread; held still for 5 s, they go back to their own flow.
    const caption = root.closest('section') ?? document;
    const cameraButtons = [...caption.querySelectorAll<HTMLButtonElement>('[data-dots-camera]')];
    const cameraHelp = caption.querySelector<HTMLElement>('[data-dots-camera-help]');
    const cameraStatus = caption.querySelector<HTMLElement>('[data-dots-camera-status]');
    let camera: Awaited<ReturnType<typeof openCamera>> | null = null;
    let hands: { detectForVideo: (video: HTMLVideoElement, time: number) => { landmarks: Array<Array<{ x: number; y: number }>> } } | null = null;
    let handPoint: { x: number; y: number } | null = null;
    let closed = false, lostSince = 0;
    const setLabel = (text: string, on: boolean) => cameraButtons.forEach((button) => { button.textContent = text; button.setAttribute('aria-pressed', String(on)); });
    const setStatus = (text: string) => { if (cameraStatus && cameraStatus.textContent !== text) cameraStatus.textContent = text; };
    const cameraOff = () => { camera?.stop(); camera = null; handPoint = null; handShape = null; closed = false; leave(); if (cameraHelp) cameraHelp.hidden = true; setLabel('turn the camera on', false); };
    const distance = (a: { x: number; y: number }, b: { x: number; y: number }) => Math.hypot(a.x - b.x, a.y - b.y);
    const track = () => {
      if (!camera) return;
      if (hands && camera.video.readyState >= 2) {
        const hand = hands.detectForVideo(camera.video, performance.now()).landmarks[0];
        if (hand) {
          lostSince = 0;
          // Open or closed: how far the fingertips reach from the wrist, against the size of the palm.
          const palm = distance(hand[0], hand[9]) || 1e-3;
          const reach = [8, 12, 16, 20].reduce((sum, tip) => sum + distance(hand[tip], hand[0]), 0) / 4 / palm;
          const isClosed = closed ? reach < 1.35 : reach < 1.05;
          // The middle of the palm, mirrored like a selfie and stretched a little to reach the edges.
          const target = { x: Math.min(1, Math.max(0, .5 - (hand[9].x - .5) * 1.3)) * width, y: Math.min(1, Math.max(0, .5 + (hand[9].y - .5) * 1.3)) * height };
          handPoint = handPoint ? { x: handPoint.x + (target.x - handPoint.x) * .3, y: handPoint.y + (target.y - handPoint.y) * .3 } : target;
          // Opening or closing the hand counts as moving, so the dots answer it even when the hand stays in place.
          if (isClosed !== closed) lastMove = performance.now();
          closed = isClosed;
          handShape = closed ? 'closed' : 'open';
          move(handPoint, SETTINGS.hand.still);
          setStatus(closed ? 'Closed — the dots gather in.' : 'Open — move your hand, close it, or hold still.');
        } else {
          if (handPoint) { handPoint = null; handShape = null; leave(); }
          lostSince ||= performance.now();
          if (performance.now() - lostSince > 600) setStatus('Looking for your hand… show it open, in good light.');
        }
      }
      requestAnimationFrame(track);
    };
    const cameraOn = async () => {
      setLabel('starting the camera…', true);
      try {
        camera = await openCamera();
        if (!hands) {
          const { module, files } = await loadVision();
          hands = await module.HandLandmarker.createFromOptions(files, {
            baseOptions: { modelAssetPath: 'https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task', delegate: 'GPU' },
            runningMode: 'VIDEO',
            numHands: 1,
          });
        }
        if (!camera) return;
        setLabel('turn the camera off', true);
        if (cameraHelp) cameraHelp.hidden = false;
        setStatus('Looking for your hand…');
        requestAnimationFrame(track);
      } catch {
        cameraOff();
        setLabel('camera unavailable', false);
      }
    };
    cameraButtons.forEach((button) => button.addEventListener('click', () => (camera ? cameraOff() : cameraOn())));
    if (!calm && 'mediaDevices' in navigator) caption.querySelectorAll<HTMLElement>('[data-dots-camera-option]').forEach((option) => { option.hidden = false; });
    addEventListener('pagehide', cameraOff);

    // Simulation and drawing.
    let visible = false, running = false, previous = 0;
    function start() { if (!calm && !running && visible) { running = true; previous = 0; requestAnimationFrame(frame); } }
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; if (visible) start(); }, { rootMargin: '10%' }).observe(root);
    new ResizeObserver(() => { resize(); drift(performance.now(), 0); draw(performance.now()); }).observe(root);

    const draw = (time: number) => {
      if (!background) return;
      context.setTransform(1, 0, 0, 1, 0, 0);
      context.imageSmoothingEnabled = false;
      context.drawImage(background, 0, 0, canvas.width, canvas.height);
      context.imageSmoothingEnabled = true;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      for (const d of dots) {
        const angle = d.spin + (calm ? 0 : Math.sin(time / 1700 + d.phase) * .2);
        const cos = Math.cos(angle) * ratio, sin = Math.sin(angle) * ratio, size = d.r * 2;
        context.setTransform(cos, sin, -sin, cos, d.x * ratio, d.y * ratio);
        context.drawImage(sprites[d.sprite], -size / 2, -size / 2, size, size);
      }
      context.setTransform(1, 0, 0, 1, 0, 0);
    };

    function frame(time: number) {
      if (!visible) { running = false; return; }
      const dt = Math.min(previous ? (time - previous) / 1000 : 1 / 60, 1 / 30);
      previous = time;
      const now = performance.now();
      const moving = pointer && now - lastMove < SETTINGS.stillAfter;
      // Home only once nobody has hovered or dragged for a while (holding still over the frame keeps pushing). A hand
      // held still lets them go straight back to their flow.
      const goHome = (!pointer && now - lastInteraction > SETTINGS.returnAfter) || (!!handShape && !moving);
      if (goHome) falling = false;
      const damping = Math.exp(-SETTINGS.damping * dt);
      for (const d of dots) {
        let ax = 0, ay = 0;
        if (falling) {
          ay += SETTINGS.gravity;
        } else if (pointer && moving && handShape) {
          // The hand: a soft, wide magnet. Each dot heads for a spot on its own side of the hand, closer in for a fist,
          // further out for an open hand, and eases there (the damping keeps it smooth).
          const dx = d.x - pointer.x, dy = d.y - pointer.y, dist = Math.hypot(dx, dy) || 1;
          const reach = SETTINGS.hand.reach * width;
          const weight = Math.max(0, 1 - dist / reach) ** .5;
          const spot = d.huddle * (handShape === 'closed' ? SETTINGS.hand.gather : SETTINGS.hand.spread);
          ax += (pointer.x + dx / dist * spot - d.x) * SETTINGS.hand.pull * weight;
          ay += (pointer.y + dy / dist * spot - d.y) * SETTINGS.hand.pull * weight;
          ax -= d.vx * 5 * weight; ay -= d.vy * 5 * weight; // Extra drag near the hand: they glide in, no overshoot.
        } else if (pointer && moving) {
          // Magnet: pulled toward the pointer, gathering in a small cloud around it.
          const dx = pointer.x - d.x, dy = pointer.y - d.y, dist = Math.hypot(dx, dy) || 1;
          const reach = SETTINGS.pull * width;
          if (dist < reach) { const f = SETTINGS.pullStrength * (1 - dist / reach) * Math.max(-1, Math.min(1, (dist - d.huddle) / 30)); ax += dx / dist * f; ay += dy / dist * f; }
        } else if (pointer) {
          // Still: they part like a curtain. Each dot heads for its home moved sideways, away from the pointer, by
          // how close it sits to it, so the pattern keeps its shape on both sides.
          const side = Math.sign(d.hx - pointer.x || d.phase - Math.PI);
          const nearY = Math.exp(-(((d.hy - pointer.y) / (SETTINGS.push[1] * height)) ** 2));
          const nearX = Math.max(0, 1 - Math.abs(d.hx - pointer.x) / (SETTINGS.push[0] * width * 2.2));
          const tx = d.hx + side * SETTINGS.push[0] * width * nearY * nearX;
          ax += (tx - d.x) * SETTINGS.home * SETTINGS.home * .6;
          ay += (d.hy - d.y) * SETTINGS.home * SETTINGS.home * .6;
        }
        if (goHome) {
          // Back home, with a gentle drift around it.
          // On their own they wander: two slow swings and a quicker one, different for every dot.
          const tx = d.hx + (Math.sin(time / 1700 + d.phase) + .5 * Math.sin(time / 610 + d.spin * 3)) * SETTINGS.wander;
          const ty = d.hy + (Math.cos(time / 1450 + d.phase * 1.3) + .5 * Math.cos(time / 530 + d.spin * 2)) * SETTINGS.wander * .8;
          ax += (tx - d.x) * SETTINGS.home * SETTINGS.home * .5; ay += (ty - d.y) * SETTINGS.home * SETTINGS.home * .5;
        }
        d.vx = (d.vx + ax * dt) * damping;
        d.vy = (d.vy + ay * dt) * (falling ? Math.exp(-.4 * dt) : damping);
        d.x += d.vx * dt;
        d.y += d.vy * dt;
        // The floor (and walls): dropped dots bounce a little and settle in a loose pile.
        const floor = height - d.r - (d.phase / (Math.PI * 2)) * 6;
        if (d.y > floor) { d.y = floor; d.vy *= -.25; d.vx *= .6; }
        if (d.x < d.r) { d.x = d.r; d.vx *= -.4; } else if (d.x > width - d.r) { d.x = width - d.r; d.vx *= -.4; }
        if (d.y < d.r) { d.y = d.r; d.vy *= -.4; }
      }
      drift(time, dt);
      draw(time);
      requestAnimationFrame(frame);
    }

    resize();
    drift(performance.now(), 0);
    draw(performance.now());
  });
</script>

<style>
  .dots-field { position: absolute; inset: 0; overflow: hidden; touch-action: pan-y; cursor: crosshair; }
  .dots-field-canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
</style>
