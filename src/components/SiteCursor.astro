<div class="site-pointer" data-site-pointer aria-hidden="true" hidden><span class="site-pointer-shape"><img class="site-pointer-arrow" src="/cursors/pointer.svg" alt="" width="26" height="48" /><img class="site-pointer-hand" src="/cursors/drag-hand.svg" alt="" width="34" height="34" /></span></div>

<script>
  const pointer = document.querySelector<HTMLElement>('[data-site-pointer]');
  const pointerShape = pointer?.querySelector<HTMLElement>('.site-pointer-shape');
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
  const linkable = 'a[href], button, summary, label[for], [role="button"], [data-carousel], [data-project-preview]';
  if (pointer && pointerShape) {
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Resting size and hover size (the hover grows 15% over the resting size).
    const REST = 1.5;
    const HOVER = REST * 1.15;
    let x = -100, y = -100, lastX = -100, tilt = 0, hovering = false, visible = false;
    const morph = (frames: Keyframe[], duration: number) => pointerShape.animate(frames, { duration: calm ? 0 : duration, easing: 'cubic-bezier(.22, 1, .36, 1)', fill: 'forwards' });
    const setVisible = (value: boolean) => {
      visible = value;
      pointer.hidden = !value;
      document.documentElement.classList.toggle('site-pointer-on', value);
    };
    const setHover = (value: boolean) => {
      if (value === hovering) return;
      hovering = value;
      morph(value
        ? [{ transform: `scale(${REST})` }, { transform: `scale(${HOVER * 1.04}, ${HOVER * .967})`, offset: .45 }, { transform: `scale(${HOVER * .98}, ${HOVER * 1.02})`, offset: .75 }, { transform: `scale(${HOVER})` }]
        : [{ transform: `scale(${HOVER})` }, { transform: `scale(${REST})` }], value ? 380 : 220);
    };
    // Over a draggable sticker (or while holding one) the arrow becomes the pixel hand.
    const refresh = (target: Element | null) => {
      pointer.classList.toggle('is-grab', !!target?.closest('[data-case-drag]') || !!document.querySelector('[data-case-drag].is-dragging'));
      setHover(!!target?.closest(linkable));
    };
    const render = () => {
      tilt += (Math.max(-14, Math.min(14, (x - lastX) * .9)) - tilt) * .16;
      lastX += (x - lastX) * .35;
      pointer.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${calm ? 0 : tilt}deg)`;
      if (visible) requestAnimationFrame(render);
    };
    document.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'touch' || !finePointer.matches) { setVisible(false); return; }
      x = event.clientX; y = event.clientY;
      if (!visible) { lastX = x; setVisible(true); requestAnimationFrame(render); }
      refresh(document.elementFromPoint(x, y));
    });
    // Content can slide under a still pointer (carousel, scroll); re-check what is underneath.
    const recheck = () => { if (visible) refresh(document.elementFromPoint(x, y)); };
    document.addEventListener('project-preview-refresh', recheck);
    window.addEventListener('scroll', recheck, { passive: true });
    document.addEventListener('pointerup', () => requestAnimationFrame(recheck));
    document.addEventListener('pointerdown', () => { if (visible) { const size = hovering ? HOVER : REST; morph([{ transform: `scale(${size})` }, { transform: `scale(${size * .9})`, offset: .4 }, { transform: `scale(${size})` }], 300); } });
    // Pointer capture on a dragged sticker fires a pointerout with no relatedTarget; that is not leaving the window.
    document.addEventListener('pointerout', (event) => { if (!event.relatedTarget && !document.querySelector('[data-case-drag].is-dragging')) setVisible(false); });
    window.addEventListener('blur', () => setVisible(false));
    finePointer.addEventListener('change', () => setVisible(false));
  }
</script>

<style>
  .site-pointer { position: fixed; top: 0; left: 0; z-index: 2147483647; width: 26px; height: 48px; pointer-events: none; will-change: transform; transform-origin: 1px 1px; }
  .site-pointer[hidden] { display: none; }
  .site-pointer-shape { display: block; transform-origin: 1px 1px; transform: scale(1.5); /* REST in the script. */ }
  .site-pointer img { display: block; width: 26px; height: 48px; max-width: none; }
  .site-pointer .site-pointer-hand { display: none; position: absolute; top: -17px; left: -17px; width: 34px; height: 34px; }
  .site-pointer.is-grab .site-pointer-arrow { visibility: hidden; }
  .site-pointer.is-grab .site-pointer-hand { display: block; }
  :global(html.site-pointer-on), :global(html.site-pointer-on *), :global(html.site-pointer-on [data-case-drag].is-dragging) { cursor: none !important; }
</style>
